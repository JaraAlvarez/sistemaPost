# Configuración del despliegue del servidor de licencias. Copie a .env (chmod 600) y complete. NUNCA confirme .env en git.
# Contraseñas: use solo letras y dígitos (van dentro de cadenas de conexión), p. ej. `openssl rand -hex 24`.

# Dominio base: el portal y la API quedan en https://licencias.<DOMINIO>
DOMINIO=
# Correo para Let's Encrypt (avisos de vencimiento del certificado).
ACME_EMAIL=

# Superusuario de PostgreSQL (solo lo usan db-init y los scripts de respaldo/restauración).
POSTGRES_SUPERUSER_PASSWORD=
# Roles de la BD pos_cloud (mínimo 12 caracteres).
DB_MIGRATOR_PASSWORD=
DB_APP_PASSWORD=
DB_BACKUP_PASSWORD=

# Clave privada Ed25519 ACTIVA (fuera del repositorio; dueño 1654, permisos 400).
SIGNING_KEY_FILE=./secrets/signing-key.pem
# Clave privada X25519 de los paquetes de sincronización .possync (Fase 16; dueño 1654, permisos 400).
SYNC_KEY_FILE=./secrets/sync-key.txt

# Solo con un Caddy existente (docker-compose.caddy-existente.yml, docs/despliegue-nube.md §18):
# puerto local (127.0.0.1) donde el Caddy existente alcanza la aplicación.
APP_LOCAL_PORT=5080
# Ruta base si la nube se publica bajo una ruta del dominio (p. ej. /businesspost). Vacío = raíz del subdominio (lo recomendado).
CLOUD_PATH_BASE=

# Imagen de la aplicación (por defecto se construye en el servidor desde el repositorio).
POS_CLOUD_IMAGE=pos-cloud:local

# Última versión publicada del POS (opcional; si el POS reporta una menor, el token lleva el aviso de actualización).
LATEST_POS_VERSION=

# ---- Nube de backups de las tiendas (Fase 11, perfil "backups") ----
# Administrador de MinIO (solo para crear el bucket y los usuarios de cada tienda). Mínimo 8 caracteres; use una clave larga.
MINIO_ROOT_USER=posadmin
MINIO_ROOT_PASSWORD=

# ---- Respaldo (deploy/cloud/backup.sh) ----
# Destinatario público de age (age1…): el VPS solo puede CIFRAR; la clave para descifrar vive fuera del VPS.
BACKUP_AGE_RECIPIENT=
# Carpeta local de los respaldos cifrados y días que se conservan.
BACKUP_DIR=/var/backups/pos-cloud
BACKUP_RETENTION_DAYS=14
# Copia FUERA del VPS (recomendado): herramienta "rclone" (BACKUP_REMOTE="b2:mi-bucket/pos-cloud") o "rsync"
# (BACKUP_REMOTE="usuario@host:/ruta"). Vacío = solo copia local (NO basta: si se pierde el VPS se pierde el respaldo).
BACKUP_REMOTE_TOOL=rclone
BACKUP_REMOTE=
