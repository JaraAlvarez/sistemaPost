<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Con Cloud:PathBase (p. ej. /businesspost) la base incluye la ruta: todos los enlaces del portal son relativos a ella. *@
    <base href="@(HttpContext.Request.PathBase + "/")" />
    <title>BusinessPost · Portal</title>
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#111A3A" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="preload" href="fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="@Assets["app.css"]" rel="stylesheet" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>Las páginas de acceso (/cuenta) son formularios renderizados en el servidor (escriben la cookie); el resto es interactivo.</summary>
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.Request.Path.StartsWithSegments("/cuenta") ? null : InteractiveServer;
}
