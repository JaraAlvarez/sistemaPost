<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true && context.User.HasClaim(PortalClaims_Stage, "ACTIVE") && context.User.MustChangePassword())
                {
                    <RedirectToMyAccount />
                }
                else if (context.User.Identity?.IsAuthenticated == true && context.User.HasClaim(PortalClaims_Stage, "ACTIVE")
                         && !context.User.HasPortalPermission(CloudPermissions.DashboardView) && context.User.HasPortalPermission(CloudPermissions.SyncDataView))
                {
                    <RedirectToStores />
                }
                else if (context.User.Identity?.IsAuthenticated == true && context.User.HasClaim(PortalClaims_Stage, "ACTIVE"))
                {
                    <AccessDeniedNotice />
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <PageHeader Title="Página no encontrada" Section="Portal" />
            <MudPaper Elevation="0" Class="bp-card">
                <EmptyState Title="No se encontró la página." Hint="Revise la dirección o vuelva al inicio desde el menú." Icon="@Icons.Material.Outlined.SearchOff">
                    <MudButton Href="./" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2">Ir al inicio</MudButton>
                </EmptyState>
            </MudPaper>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private const string PortalClaims_Stage = Pos.Cloud.Infrastructure.Persistence.PortalClaims.Stage;
}
