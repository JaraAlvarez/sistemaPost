@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<MudThemeProvider @ref="_themeProvider" Theme="PortalTheme.Theme" @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a class="saltar-contenido" href="@SkipLink">Saltar al contenido</a>

<MudLayout>
    <MudAppBar Elevation="0" Class="bp-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)"
                       aria-label="@(_drawerOpen ? "Ocultar el menú" : "Mostrar el menú")" aria-expanded="@(_drawerOpen ? "true" : "false")" aria-controls="menu-principal" />
        <a href="./" class="bp-brand bp-appbar-brand @(_drawerOpen ? "d-flex d-md-none" : "d-flex")" aria-label="BusinessPost, inicio">
            <BrandLogo Size="30" Subtitle="Portal" />
        </a>
        <MudSpacer />
        <MudTooltip Text="@(_dark ? "Usar modo claro" : "Usar modo oscuro")">
            <MudIconButton Icon="@(_dark ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" Color="Color.Inherit"
                           OnClick="ToggleThemeAsync" aria-label="@(_dark ? "Usar modo claro" : "Usar modo oscuro")" />
        </MudTooltip>
        <AuthorizeView>
            <Authorized>
                <div class="bp-user ml-1">
                    <span class="bp-user-text">
                        <span class="bp-user-name" title="@context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value">@context.User.Identity?.Name</span>
                        <span class="bp-user-role">@PortalPageBase.RoleName(context.User.FindFirst(Pos.Cloud.Infrastructure.Persistence.PortalClaims.Role)?.Value)</span>
                    </span>
                    <MudAvatar Color="Color.Primary" Size="Size.Medium" aria-hidden="true">@Initials(context.User.Identity?.Name)</MudAvatar>
                </div>
                <form action="cuenta/salir" method="post" class="ml-1">
                    <AntiforgeryToken />
                    <MudTooltip Text="Cerrar sesión">
                        <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" aria-label="Cerrar sesión" />
                    </MudTooltip>
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" ClipMode="DrawerClipMode.Never" Elevation="0"
               Class="bp-drawer" id="menu-principal">
        <div class="bp-drawer-head">
            <a href="./" class="bp-brand" aria-label="BusinessPost, inicio"><BrandLogo Size="34" Subtitle="Portal de la nube" /></a>
        </div>
        <NavMenu />
        <div class="bp-drawer-foot">Toda la actividad del portal queda en la auditoría.</div>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="bp-content">
            <main id="contenido" tabindex="-1">
                @Body
            </main>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider? _themeProvider;
    private IJSObjectReference? _module;
    private bool _drawerOpen = true;
    private bool _dark;
    private bool _followSystem = true;

    private string SkipLink => $"{Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0]}#contenido";

    /// <summary>Iniciales para el avatar (máximo dos letras).</summary>
    private static string Initials(string? name)
    {
        var parts = (name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => string.Concat(parts[0][..1], parts[^1][..1]).ToUpperInvariant(),
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeProvider is null)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/tema.js");
            var saved = await _module.InvokeAsync<string?>("leer");
            _followSystem = saved is not ("claro" or "oscuro");
            _dark = _followSystem ? await _themeProvider.GetSystemDarkModeAsync() : saved == "oscuro";
            if (_followSystem)
            {
                await _themeProvider.WatchSystemDarkModeAsync(SystemChangedAsync);
            }
        }
        catch (JSException)
        {
            // Sin JavaScript o sin almacenamiento: queda el modo claro.
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        StateHasChanged();
    }

    private Task SystemChangedAsync(bool dark)
    {
        if (_followSystem)
        {
            _dark = dark;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    private async Task ToggleThemeAsync()
    {
        _dark = !_dark;
        _followSystem = false;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("guardar", _dark ? "oscuro" : "claro");
            }
            catch (JSException)
            {
                // La elección dura hasta cerrar la pestaña.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // El circuito ya se cerró.
            }
        }
    }
}
