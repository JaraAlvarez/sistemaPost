@* Menú lateral agrupado por tarea; cada entrada aparece solo con el permiso que exige su página. Enlaces relativos a <base href>. *@
<AuthorizeView>
    <Authorized>
        @{
            var user = context.User;
            var licensing = user.HasPortalPermission(CloudPermissions.LicensingView);
            var stores = user.HasPortalPermission(CloudPermissions.SyncDataView);
            var admin = user.HasPortalPermission(CloudPermissions.PortalUserManage) || user.HasPortalPermission(CloudPermissions.SigningKeyView)
                        || user.HasPortalPermission(CloudPermissions.AuditView);
        }
        <div class="bp-nav">
            <MudNavMenu aria-label="Menú principal">
                @if (user.HasPortalPermission(CloudPermissions.DashboardView))
                {
                    <MudNavLink Href="./" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.SpaceDashboard">Tablero</MudNavLink>
                }

                @if (licensing)
                {
                    <span class="bp-nav-section">Licenciamiento</span>
                    <MudNavLink Href="clientes" Icon="@Icons.Material.Outlined.Business">Clientes</MudNavLink>
                    <MudNavLink Href="empresas" Icon="@Icons.Material.Outlined.Storefront">Empresas</MudNavLink>
                    <MudNavLink Href="suscripciones" Icon="@Icons.Material.Outlined.EventRepeat">Suscripciones</MudNavLink>
                    <MudNavLink Href="instalaciones" Icon="@Icons.Material.Outlined.Computer">Instalaciones y equipos</MudNavLink>
                }

                @if (stores)
                {
                    <span class="bp-nav-section">Operación</span>
                    <MudNavLink Href="tiendas" Icon="@Icons.Material.Outlined.QueryStats">Datos de las tiendas</MudNavLink>
                }

                @if (admin)
                {
                    <span class="bp-nav-section">Administración</span>
                    @if (user.HasPortalPermission(CloudPermissions.PortalUserManage))
                    {
                        <MudNavLink Href="usuarios" Icon="@Icons.Material.Outlined.ManageAccounts">Usuarios del portal</MudNavLink>
                    }
                    @if (user.HasPortalPermission(CloudPermissions.SigningKeyView))
                    {
                        <MudNavLink Href="claves-de-firma" Icon="@Icons.Material.Outlined.Key">Claves de firma</MudNavLink>
                    }
                    @if (user.HasPortalPermission(CloudPermissions.AuditView))
                    {
                        <MudNavLink Href="auditoria" Icon="@Icons.Material.Outlined.Policy">Auditoría</MudNavLink>
                    }
                }

                <span class="bp-nav-section">Personal</span>
                <MudNavLink Href="mi-cuenta" Icon="@Icons.Material.Outlined.AccountCircle">Mi cuenta</MudNavLink>
            </MudNavMenu>
        </div>
    </Authorized>
</AuthorizeView>
