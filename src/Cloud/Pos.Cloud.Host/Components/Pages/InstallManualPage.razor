@page "/descargas/manual"
@attribute [Authorize(Policy = CloudPermissions.DownloadView)]
@using Pos.Cloud.Host.Downloads
@inherits PortalPageBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Manual de instalación (D13B-06): el texto es docs/manual-instalacion.md incrustado al compilar; se convierte con SafeMarkdown, que
   codifica todo el texto (nunca copia HTML del archivo). *@
<PageTitle>Manual de instalación · BusinessPost</PageTitle>
<PageHeader Title="Manual de instalación" Section="Personal" ParentText="Descargas" ParentHref="descargas">
    <Actions>
        @if (_manualPdf is not null)
        {
            <MudButton Href="@_manualPdf" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PictureAsPdf">Descargar manual (PDF)</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Print" OnClick="PrintAsync">Imprimir / Guardar como PDF</MudButton>
        }
    </Actions>
</PageHeader>

<MudPaper Elevation="0" Class="bp-card pa-5 mb-6">
    <article class="bp-manual">@((MarkupString)InstallManual.ToHtml())</article>
</MudPaper>

@code {
    private string? _manualPdf;
    private IJSObjectReference? _module;

    [Inject]
    private DownloadCatalog Catalog { get; set; } = default!;

    protected override void OnInitialized() => _manualPdf = Catalog.GetManualPdfUrl(new Uri(Navigation.BaseUri));

    private async Task PrintAsync()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/imprimir.js");
            await _module.InvokeVoidAsync("imprimir");
        }
        catch (JSException)
        {
            Snackbar.Add("No se pudo abrir la impresión. Use Ctrl+P en el navegador.", Severity.Warning);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // El circuito ya se cerró.
            }
        }
    }
}
