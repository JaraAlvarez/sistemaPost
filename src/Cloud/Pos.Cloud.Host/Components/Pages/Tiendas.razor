@page "/tiendas"
@attribute [Authorize(Policy = CloudPermissions.SyncDataView)]
@inherits PortalPageBase
@using System.Globalization

<PageTitle>Datos de las tiendas · BusinessPost</PageTitle>
<PageHeader Title="Datos de las tiendas" Section="Operación"
            Description="Ventas, cierres de caja y existencias que las tiendas suben a la nube (cada minuto con Internet, o con un paquete .possync cargado aquí).">
    <Actions>
        <AuthorizeView Policy="@CloudPermissions.SyncPackageUpload">
            <MudFileUpload T="IBrowserFile" Accept=".possync" FilesChanged="SubirAsync" MaximumFileCount="1">
                <CustomContent Context="upload">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="Busy" OnClick="@upload.OpenFilePickerAsync">Cargar paquete .possync</MudButton>
                </CustomContent>
            </MudFileUpload>
        </AuthorizeView>
    </Actions>
</PageHeader>

@if (LoadError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@LoadError</MudAlert>
}

<MudPaper Elevation="0" Class="bp-card mb-6">
    <div class="bp-toolbar" style="border-bottom: none">
        <MudSelect T="Guid?" Value="_organization" ValueChanged="OrganizacionAsync" Label="Empresa" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 260px">
            @foreach (var organization in _organizations)
            {
                <MudSelectItem T="Guid?" Value="@organization.Id">@organization.LegalName · @organization.AccountName</MudSelectItem>
            }
        </MudSelect>
        <MudDatePicker Label="Desde" @bind-Date="_from" DateFormat="yyyy-MM-dd" Variant="Variant.Outlined" Margin="Margin.Dense" Class="bp-filter" />
        <MudDatePicker Label="Hasta" @bind-Date="_to" DateFormat="yyyy-MM-dd" Variant="Variant.Outlined" Margin="Margin.Dense" Class="bp-filter" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@(_organization is null || Busy)" OnClick="CargarAsync">Actualizar</MudButton>
    </div>
</MudPaper>

@if (_organization is null)
{
    <MudPaper Elevation="0" Class="bp-card">
        <EmptyState Title="Elija una empresa" Hint="Seleccione la empresa para ver las ventas, los cierres de caja y las existencias de sus sucursales." Icon="@Icons.Material.Outlined.Storefront" />
    </MudPaper>
}
else if (_data is null)
{
    <MudPaper Elevation="0" Class="bp-card"><TableSkeleton /></MudPaper>
}
else
{
    var totalSales = _data.SalesByDay.Sum(d => d.Total);
    var tickets = _data.SalesByDay.Sum(d => d.Tickets);
    <MudGrid Spacing="3" Class="mb-2">
        <MudItem xs="12" sm="6" lg="3"><StatCard Title="Ventas del periodo" Text="@Money(totalSales)" Icon="@Icons.Material.Outlined.Payments" Color="Color.Success" /></MudItem>
        <MudItem xs="12" sm="6" lg="3"><StatCard Title="Tiquetes" Value="@tickets" Icon="@Icons.Material.Outlined.Receipt" /></MudItem>
        <MudItem xs="12" sm="6" lg="3"><StatCard Title="Anuladas" Value="@_data.SalesByDay.Sum(d => d.Voided)" Icon="@Icons.Material.Outlined.RemoveShoppingCart" Color="Color.Warning" /></MudItem>
        <MudItem xs="12" sm="6" lg="3"><StatCard Title="Sucursales" Value="@_data.Installations.Count" Icon="@Icons.Material.Outlined.Store" Color="Color.Secondary" /></MudItem>
    </MudGrid>

    <MudPaper Elevation="0" Class="bp-card bp-section">
        <div class="pa-4 pb-0">
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="bp-section-title"><MudIcon Icon="@Icons.Material.Outlined.Sync" Size="Size.Small" aria-hidden="true" />Sincronización por sucursal</MudText>
        </div>
        @if (_data.Installations.Count == 0)
        {
            <EmptyState Title="Esta empresa aún no ha sincronizado datos." Icon="@Icons.Material.Outlined.CloudOff" />
        }
        else
        {
            <div class="bp-table-wrap">
                <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                    <thead><tr><th scope="col">Sucursal</th><th scope="col">Último lote</th><th scope="col">Vía</th><th scope="col" class="num">Ventas</th><th scope="col" class="num">Cierres</th><th scope="col" class="num">Saldos</th><th scope="col" class="num">Productos</th></tr></thead>
                    <tbody>
                        @foreach (var i in _data.Installations)
                        {
                            <tr>
                                <td>@(i.BranchName ?? i.InstallationId.ToString())</td>
                                <td>@Date(i.LastBatchAt)</td>
                                <td>@(i.LastVia == "FILE" ? "Paquete" : i.LastVia == "ONLINE" ? "En línea" : "—")</td>
                                <td class="num">@i.Sales</td><td class="num">@i.CashSessions</td><td class="num">@i.StockRows</td><td class="num">@i.Products</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
    </MudPaper>

    <MudPaper Elevation="0" Class="bp-card bp-section">
        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" TabPanelsClass="pa-0" Border="true">
            <MudTabPanel Text="Ventas por día" Icon="@Icons.Material.Outlined.CalendarMonth">
                @if (_data.SalesByDay.Count == 0)
                {
                    <EmptyState Title="Sin ventas en el periodo." Icon="@Icons.Material.Outlined.Receipt" />
                }
                else
                {
                    <div class="bp-table-wrap">
                        <MudSimpleTable Dense="true" Striped="true" Elevation="0">
                            <thead><tr><th scope="col">Fecha</th><th scope="col">Sucursal</th><th scope="col" class="num">Tiquetes</th><th scope="col" class="num">Anuladas</th><th scope="col" class="num">Ventas</th></tr></thead>
                            <tbody>
                                @foreach (var d in _data.SalesByDay)
                                {
                                    <tr><td>@d.BusinessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td><td>@d.Branch</td><td class="num">@d.Tickets</td>
                                        <td class="num">@d.Voided</td><td class="num">@Money(d.Total)</td></tr>
                                }
                                <tr><th scope="row" colspan="2">Total</th><td class="num"><b>@tickets</b></td><td></td><td class="num"><b>@Money(totalSales)</b></td></tr>
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }
            </MudTabPanel>
            <MudTabPanel Text="Ventas recientes" Icon="@Icons.Material.Outlined.ReceiptLong">
                @if (_data.RecentSales.Count == 0)
                {
                    <EmptyState Title="Sin ventas recientes." Icon="@Icons.Material.Outlined.ReceiptLong" />
                }
                else
                {
                    <div class="bp-table-wrap">
                        <MudSimpleTable Dense="true" Striped="true" Elevation="0">
                            <thead><tr><th scope="col">Fecha</th><th scope="col">Número</th><th scope="col">Sucursal</th><th scope="col">Caja</th><th scope="col">Cajero</th><th scope="col">Cliente</th><th scope="col">Estado</th><th scope="col" class="num">Total</th></tr></thead>
                            <tbody>
                                @foreach (var s in _data.RecentSales)
                                {
                                    <tr><td>@Date(s.CompletedAt)</td><td>@s.Number</td><td>@s.Branch</td><td>@s.Terminal</td><td>@s.Cashier</td><td>@s.Customer</td>
                                        <td><StatusChip Text="@(s.Status == "VOIDED" ? "Anulada" : "Completada")" Color="@(s.Status == "VOIDED" ? Color.Error : Color.Success)" /></td>
                                        <td class="num">@Money(s.Total)</td></tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }
            </MudTabPanel>
            <MudTabPanel Text="Cierres de caja" Icon="@Icons.Material.Outlined.PointOfSale">
                @if (_data.CashSessions.Count == 0)
                {
                    <EmptyState Title="Sin cierres de caja en el periodo." Icon="@Icons.Material.Outlined.PointOfSale" />
                }
                else
                {
                    <div class="bp-table-wrap">
                        <MudSimpleTable Dense="true" Striped="true" Elevation="0">
                            <thead><tr><th scope="col">Cierre</th><th scope="col">Jornada</th><th scope="col">Sucursal</th><th scope="col">Caja</th><th scope="col">Cajero</th><th scope="col" class="num">Esperado</th><th scope="col" class="num">Contado</th><th scope="col" class="num">Diferencia</th></tr></thead>
                            <tbody>
                                @foreach (var c in _data.CashSessions)
                                {
                                    <tr><td>@Date(c.ClosedAt)</td><td>@c.Number</td><td>@c.Branch</td><td>@c.Terminal</td><td>@c.Cashier</td>
                                        <td class="num">@Money(c.Expected)</td><td class="num">@Money(c.Counted)</td>
                                        <td class="num" style="@(c.Difference is < 0 ? "color: var(--mud-palette-error); font-weight: 600" : null)">@Money(c.Difference)</td></tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }
            </MudTabPanel>
            <MudTabPanel Text="Existencias" Icon="@Icons.Material.Outlined.Inventory2">
                <div class="bp-toolbar">
                    <MudTextField T="string" @bind-Value="_search" Placeholder="Buscar producto (nombre o SKU)" Immediate="true" DebounceInterval="400" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnDebounceIntervalElapsed="@(_ => ExistenciasAsync())" aria-label="Buscar producto" />
                    <span class="bp-toolbar-count" role="status">@_stock.Count filas</span>
                </div>
                @if (_stock.Count == 0)
                {
                    <EmptyState Title="Sin existencias para mostrar." Icon="@Icons.Material.Outlined.Inventory2" />
                }
                else
                {
                    <div class="bp-table-wrap">
                        <MudSimpleTable Dense="true" Striped="true" Elevation="0">
                            <thead><tr><th scope="col">Sucursal</th><th scope="col">Bodega</th><th scope="col">SKU</th><th scope="col">Producto</th><th scope="col" class="num">Cantidad</th><th scope="col" class="num">Valor</th><th scope="col">Último movimiento</th></tr></thead>
                            <tbody>
                                @foreach (var r in _stock)
                                {
                                    <tr><td>@r.Branch</td><td>@r.Warehouse</td><td><span class="mono">@r.Sku</span></td><td>@r.Name</td><td class="num">@r.Quantity.ToString("#,##0.###", Co)</td>
                                        <td class="num">@Money(r.TotalValue)</td><td>@Date(r.LastMovementAt)</td></tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
}

@code {
    private static readonly CultureInfo Co = CultureInfo.GetCultureInfo("es-CO");
    private IReadOnlyList<SyncOrganizationDto> _organizations = [];
    private Guid? _organization;
    private DateTime? _from = DateTime.Today.AddDays(-30);
    private DateTime? _to = DateTime.Today;
    private StoreDataDto? _data;
    private IReadOnlyList<StockRowDto> _stock = [];
    private string? _search;

    private static string Money(decimal? value) => value is { } v ? v.ToString("$ #,##0", Co) : "—";

    protected override async Task OnInitializedAsync()
    {
        _organizations = await LoadAsync(new ListSyncOrganizationsQuery()) ?? [];
        if (_organizations.Count == 1)
        {
            await OrganizacionAsync(_organizations[0].Id);
        }
    }

    private async Task OrganizacionAsync(Guid? organization)
    {
        _organization = organization;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        if (_organization is not { } id)
        {
            return;
        }

        _data = await LoadAsync(new GetStoreDataQuery(id, DateOnly.FromDateTime(_from ?? DateTime.Today.AddDays(-30)), DateOnly.FromDateTime(_to ?? DateTime.Today)));
        await ExistenciasAsync();
    }

    private async Task ExistenciasAsync()
    {
        if (_organization is { } id)
        {
            _stock = await LoadAsync(new SearchStoreStockQuery(id, _search)) ?? [];
        }
    }

    private async Task SubirAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        using var memory = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 200 * 1024 * 1024).CopyToAsync(memory);
        var result = await RunAsync(new UploadPackageCommand(memory.ToArray()), "Paquete cargado.");
        if (result.IsSuccess)
        {
            var r = result.Value;
            Snackbar.Add(r.Duplicate
                ? $"Ese paquete ya se había cargado ({r.OrganizationName} · {r.BranchName})."
                : $"{r.OrganizationName} · {r.BranchName}: {r.Items} datos, {r.Applied} nuevos o actualizados, {r.Ignored} ya estaban.", Severity.Info);
            await CargarAsync();
        }
    }
}
