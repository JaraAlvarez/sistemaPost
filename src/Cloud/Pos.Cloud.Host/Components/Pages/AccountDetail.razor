@page "/clientes/{AccountId:guid}"
@attribute [Authorize(Policy = CloudPermissions.LicensingView)]
@inherits PortalPageBase

<PageTitle>Cliente · Licencias</PageTitle>

@if (LoadError is not null)
{
    <MudAlert Severity="Severity.Error">@LoadError</MudAlert>
}
else if (_account is not null)
{
    <MudText Typo="Typo.h4" GutterBottom="true">@_account.Name</MudText>

    <AuthorizeView Policy="@CloudPermissions.AccountManage">
        <Authorized>
            <MudPaper Class="pa-4 mb-4" Elevation="1">
                <MudText Typo="Typo.h6">Datos del cliente</MudText>
                <AccountForm Input="_edit" />
                <MudCheckBox T="bool" @bind-Value="_active" Label="Activo" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Busy" OnClick="SaveAsync">Guardar</MudButton>
            </MudPaper>

            <MudPaper Class="pa-4 mb-4" Elevation="1">
                <MudText Typo="Typo.h6">Nueva empresa licenciada</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">La licencia es de la razón social: el NIT es único en todo el servidor.</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="5"><MudTextField T="string" @bind-Value="_orgName" Label="Razón social" MaxLength="200" /></MudItem>
                    <MudItem xs="8" md="3"><MudTextField T="string" @bind-Value="_orgNit" Label="NIT (sin DV)" MaxLength="15" /></MudItem>
                    <MudItem xs="4" md="1"><MudTextField T="string" @bind-Value="_orgDv" Label="DV" MaxLength="1" /></MudItem>
                    <MudItem xs="12" md="3"><MudTextField T="string" @bind-Value="_orgCity" Label="Ciudad" MaxLength="120" /></MudItem>
                </MudGrid>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" Disabled="Busy" OnClick="CreateOrganizationAsync">Registrar empresa</MudButton>
            </MudPaper>
        </Authorized>
    </AuthorizeView>

    <MudText Typo="Typo.h6" Class="mb-2">Empresas</MudText>
    <OrganizationTable Rows="_organizations" />
}

@code {
    [Parameter]
    public Guid AccountId { get; set; }

    private AccountDto? _account;
    private IReadOnlyList<OrganizationRowDto> _organizations = [];
    private AccountForm.Model _edit = new();
    private bool _active = true;
    private string? _orgName;
    private string? _orgNit;
    private string? _orgDv;
    private string? _orgCity;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _account = await LoadAsync(new GetAccountQuery(AccountId));
        if (_account is not null)
        {
            _edit = AccountForm.Model.From(_account);
            _active = _account.Status == "ACTIVE";
            _organizations = await LoadAsync(new ListOrganizationsQuery(AccountId)) ?? [];
        }
    }

    private async Task SaveAsync()
    {
        if (await RunAsync(new UpdateAccountCommand(AccountId, _edit.ToInput(), _active), "Cliente actualizado."))
        {
            await LoadAsync();
        }
    }

    private async Task CreateOrganizationAsync()
    {
        var created = await RunAsync(
            new CreateOrganizationCommand(AccountId, _orgName ?? string.Empty, _orgNit ?? string.Empty, _orgDv ?? string.Empty, _orgCity), "Empresa registrada.");
        if (created.IsSuccess)
        {
            (_orgName, _orgNit, _orgDv, _orgCity) = (null, null, null, null);
            await LoadAsync();
        }
    }
}
