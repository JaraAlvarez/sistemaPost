@page "/usuarios"
@attribute [Authorize(Policy = CloudPermissions.PortalUserManage)]
@inherits PortalPageBase
@inject IDialogService Dialogs

<PageTitle>Usuarios del portal · BusinessPost</PageTitle>
<PageHeader Title="Usuarios del portal" Section="Administración"
            Description="El equipo del propietario y los clientes con acceso a sus tiendas. La contraseña inicial es temporal y se cambia en el primer ingreso.">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@(_showNew ? Icons.Material.Filled.Close : Icons.Material.Filled.PersonAdd)"
                   OnClick="@(() => _showNew = !_showNew)" aria-expanded="@(_showNew ? "true" : "false")">
            @(_showNew ? "Cerrar formulario" : "Nuevo usuario")
        </MudButton>
    </Actions>
</PageHeader>

@if (_temporary is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => _temporary = null)">
        <MudText Typo="Typo.subtitle2">Contraseña temporal de @_temporary.Email: se muestra UNA sola vez. Entréguela por un canal seguro.</MudText>
        <div class="key-once">@_temporary.TemporaryPassword</div>
    </MudAlert>
}

@if (_showNew)
{
    <MudPaper Elevation="0" Class="bp-card pa-5 mb-6">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Nuevo usuario</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="_newEmail" Label="Correo" MaxLength="120" InputType="InputType.Email" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="_newName" Label="Nombre" MaxLength="120" /></MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_newRole" Label="Rol">
                    <MudSelectItem T="string" Value="@PortalRoles.Support">@RoleName(PortalRoles.Support)</MudSelectItem>
                    <MudSelectItem T="string" Value="@PortalRoles.Superadmin">@RoleName(PortalRoles.Superadmin)</MudSelectItem>
                    <MudSelectItem T="string" Value="@PortalRoles.Customer">@RoleName(PortalRoles.Customer)</MudSelectItem>
                </MudSelect>
            </MudItem>
            @if (_newRole == PortalRoles.Customer)
            {
                <MudItem xs="12" md="8">
                    <MudSelect T="Guid?" @bind-Value="_newAccount" Label="Cuenta del cliente (solo verá las empresas de esta cuenta)">
                        @foreach (var account in _accounts)
                        {
                            <MudSelectItem T="Guid?" Value="@account.Id">@account.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
        </MudGrid>
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
            <MudButton Variant="Variant.Text" OnClick="@(() => _showNew = false)">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Busy" OnClick="CreateAsync">Crear con contraseña temporal</MudButton>
        </MudStack>
    </MudPaper>
}

@if (LoadError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@LoadError</MudAlert>
}

<MudPaper Elevation="0" Class="bp-card">
    <div class="bp-toolbar">
        <MudTextField T="string" @bind-Value="_search" Placeholder="Buscar por correo o nombre" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" aria-label="Buscar usuarios" />
        <MudSelect T="string" @bind-Value="_roleFilter" Label="Rol" Variant="Variant.Outlined" Margin="Margin.Dense" Class="bp-filter" Dense="true">
            <MudSelectItem T="string" Value="@string.Empty">Todos</MudSelectItem>
            @foreach (var role in new[] { PortalRoles.Superadmin, PortalRoles.Support, PortalRoles.Customer, PortalRoles.Reseller })
            {
                <MudSelectItem T="string" Value="@role">@RoleName(role)</MudSelectItem>
            }
        </MudSelect>
        @if (_users is not null)
        {
            <span class="bp-toolbar-count" role="status">@Filtered.Count() de @_users.Count usuarios</span>
        }
    </div>

    @if (_users is null)
    {
        <TableSkeleton />
    }
    else if (!Filtered.Any())
    {
        <EmptyState Title="Ningún usuario coincide con la búsqueda" Icon="@Icons.Material.Outlined.PersonSearch" />
    }
    else
    {
        <div class="bp-table-wrap">
            <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                <thead><tr><th scope="col">Usuario</th><th scope="col">Rol</th><th scope="col">Estado</th><th scope="col">Doble factor</th><th scope="col">Último ingreso</th><th scope="col"><span class="visualmente-oculto">Acciones</span></th></tr></thead>
                <tbody>
                    @foreach (var u in Filtered)
                    {
                        <tr class="@(u.Id == _selected?.Id ? "row-selected" : null)">
                            <td>
                                <span class="font-weight-medium">@u.DisplayName</span>
                                <span class="cell-sub">@u.Email</span>
                            </td>
                            <td>@RoleName(u.Role)</td>
                            <td>
                                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                    <StatusChip Text="@(u.Status == "ACTIVE" ? "Activo" : "Bloqueado")" Color="@(u.Status == "ACTIVE" ? Color.Success : Color.Error)" />
                                    @if (IsLocked(u))
                                    {
                                        <StatusChip Text="@($"Bloqueado por intentos hasta {Date(u.LockedUntil)}")" Color="Color.Warning" />
                                    }
                                    @if (u.MustChangePassword)
                                    {
                                        <StatusChip Text="Contraseña temporal" Color="Color.Default" />
                                    }
                                </MudStack>
                            </td>
                            <td>@(u.TotpEnabled ? "Configurado" : "Pendiente")</td>
                            <td>@Date(u.LastLoginAt)</td>
                            <td class="text-right">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Tune" OnClick="@(() => SelectAsync(u))"
                                           aria-label="@($"Administrar a {u.Email}")">Administrar</MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    }
</MudPaper>

@if (_selected is { } selected)
{
    <MudPaper Elevation="0" Class="bp-card pa-5 mt-6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.Person" /></MudAvatar>
            <div>
                <MudText Typo="Typo.h6" HtmlTag="h2">@selected.DisplayName</MudText>
                <MudText Typo="Typo.body2" Class="texto-secundario">@selected.Email</MudText>
            </div>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _selected = null)" aria-label="Cerrar la administración del usuario" />
        </MudStack>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="5"><MudTextField T="string" @bind-Value="_editName" Label="Nombre" MaxLength="120" /></MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_editRole" Label="Rol">
                    <MudSelectItem T="string" Value="@PortalRoles.Support">@RoleName(PortalRoles.Support)</MudSelectItem>
                    <MudSelectItem T="string" Value="@PortalRoles.Superadmin">@RoleName(PortalRoles.Superadmin)</MudSelectItem>
                    @if (selected.Role == PortalRoles.Reseller)
                    {
                        <MudSelectItem T="string" Value="@PortalRoles.Reseller">@RoleName(PortalRoles.Reseller)</MudSelectItem>
                    }
                    @if (selected.Role == PortalRoles.Customer)
                    {
                        <MudSelectItem T="string" Value="@PortalRoles.Customer">@RoleName(PortalRoles.Customer)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_editActive" Label="@(_editActive ? "Activo" : "Bloqueado")" Color="Color.Success" /></MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" Class="texto-secundario d-block mt-1">Cambiar el rol o bloquear al usuario cierra todas sus sesiones.</MudText>

        <MudStack Row="true" Wrap="Wrap.Wrap" Class="mt-4" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Busy" OnClick="SaveAsync">Guardar cambios</MudButton>
            @if (IsLocked(selected))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.LockOpen" Disabled="Busy" OnClick="UnlockAsync">Desbloquear (intentos)</MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Password" Disabled="Busy" OnClick="ResetPasswordAsync">Restablecer contraseña</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.PhonelinkErase" Disabled="Busy" OnClick="ResetTotpAsync">Restablecer doble factor</MudButton>
        </MudStack>

        <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="mt-6 mb-2">Sesiones</MudText>
        @if (_sessions.Count == 0)
        {
            <EmptyState Title="Sin sesiones registradas." Icon="@Icons.Material.Outlined.Devices" />
        }
        else
        {
            <div class="bp-table-wrap">
                <MudSimpleTable Dense="true" Outlined="true" Elevation="0">
                    <thead><tr><th scope="col">Canal</th><th scope="col">Etapa</th><th scope="col">Inicio</th><th scope="col">Última actividad</th><th scope="col">Vence</th><th scope="col">IP</th><th scope="col">Navegador</th><th scope="col">Estado</th><th scope="col"><span class="visualmente-oculto">Acciones</span></th></tr></thead>
                    <tbody>
                        @foreach (var s in _sessions)
                        {
                            var open = s.RevokedAt is null && s.ExpiresAt > DateTimeOffset.UtcNow;
                            <tr>
                                <td>@(s.Channel == "API" ? "API" : "Portal")</td>
                                <td>@StageName(s.Stage)</td>
                                <td>@Date(s.CreatedAt)</td>
                                <td>@Date(s.LastSeenAt)</td>
                                <td>@Date(s.ExpiresAt)</td>
                                <td>@(s.IpAddress ?? "—")</td>
                                <td class="cell-ellipsis" title="@s.UserAgent">@(s.UserAgent ?? "—")</td>
                                <td>
                                    @if (s.RevokedAt is not null)
                                    {
                                        <StatusChip Text="Revocada" Color="Color.Default" />
                                        <span class="cell-sub">@Date(s.RevokedAt): @s.RevokedReason</span>
                                    }
                                    else
                                    {
                                        <StatusChip Text="@(open ? "Abierta" : "Vencida")" Color="@(open ? Color.Success : Color.Default)" />
                                    }
                                </td>
                                <td>
                                    @if (open)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="Busy" OnClick="@(() => RevokeSessionAsync(s.Id))">Cerrar</MudButton>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
    </MudPaper>
}

@code {
    private IReadOnlyList<PortalUserDto>? _users;
    private IReadOnlyList<PortalSessionInfoDto> _sessions = [];
    private PortalUserDto? _selected;
    private TemporaryPasswordDto? _temporary;
    private bool _showNew;
    private string? _search;
    private string _roleFilter = string.Empty;
    private string? _newEmail;
    private string? _newName;
    private string _newRole = PortalRoles.Support;
    private Guid? _newAccount;
    private IReadOnlyList<AccountDto> _accounts = [];
    private string? _editName;
    private string _editRole = PortalRoles.Support;
    private bool _editActive;

    private IEnumerable<PortalUserDto> Filtered => (_users ?? [])
        .Where(u => _roleFilter.Length == 0 || u.Role == _roleFilter)
        .Where(u => string.IsNullOrWhiteSpace(_search)
            || u.Email.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || u.DisplayName.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

    private static string StageName(string stage) => stage switch
    {
        "ACTIVE" => "Completa",
        "PENDING_TOTP" => "Esperando código",
        _ => "Enrolando doble factor",
    };

    private static bool IsLocked(PortalUserDto user) => user.LockedUntil is { } until && until > DateTimeOffset.UtcNow;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _users = await LoadAsync(new ListPortalUsersQuery()) ?? [];
        _accounts = await LoadAsync(new ListAccountsQuery()) ?? [];
        if (_selected is not null)
        {
            _selected = _users.FirstOrDefault(u => u.Id == _selected.Id);
            _sessions = _selected is null ? [] : await LoadAsync(new ListPortalSessionsQuery(_selected.Id)) ?? [];
        }
    }

    private async Task SelectAsync(PortalUserDto user)
    {
        _selected = user;
        _editName = user.DisplayName;
        _editRole = user.Role;
        _editActive = user.Status == "ACTIVE";
        _sessions = await LoadAsync(new ListPortalSessionsQuery(user.Id)) ?? [];
    }

    private async Task CreateAsync()
    {
        var created = await RunAsync(
            new CreatePortalUserCommand(_newEmail ?? string.Empty, _newName ?? string.Empty, _newRole, _newRole == PortalRoles.Customer ? _newAccount : null),
            "Usuario creado.");
        if (created.IsSuccess)
        {
            _temporary = created.Value;
            _newEmail = null;
            _newName = null;
            _showNew = false;
            await LoadAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (_selected is { } user
            && await RunAsync(new UpdatePortalUserCommand(user.Id, _editName ?? string.Empty, _editRole, _editRole is PortalRoles.Reseller or PortalRoles.Customer ? user.ResellerAccountId : null, _editActive), "Usuario actualizado."))
        {
            await LoadAsync();
        }
    }

    private async Task UnlockAsync()
    {
        if (_selected is { } user && await RunAsync(new UnlockPortalUserCommand(user.Id), "Usuario desbloqueado."))
        {
            await LoadAsync();
        }
    }

    private async Task ResetPasswordAsync()
    {
        if (_selected is not { } user
            || !await Dialogs.ConfirmAsync("Restablecer contraseña", $"¿Restablecer la contraseña de {user.Email}?", "Restablecer", Color.Warning,
                "Se genera una contraseña temporal nueva (se muestra una sola vez) y se cierran todas sus sesiones."))
        {
            return;
        }

        var reset = await RunAsync(new ResetPortalUserPasswordCommand(user.Id), "Contraseña restablecida.");
        if (reset.IsSuccess)
        {
            _temporary = reset.Value;
            await LoadAsync();
        }
    }

    private async Task ResetTotpAsync()
    {
        if (_selected is not { } user)
        {
            return;
        }

        var reason = await Dialogs.ConfirmWithReasonAsync(
            "Restablecer doble factor", $"¿Restablecer el doble factor de {user.Email}?", "Restablecer doble factor",
            "Motivo (p. ej. teléfono perdido)", detail: "Deberá escanear un código QR nuevo en su próximo ingreso y se cerrarán sus sesiones.");
        if (reason is not null && await RunAsync(new ResetPortalUserTotpCommand(user.Id, reason), "Doble factor restablecido."))
        {
            await LoadAsync();
        }
    }

    private async Task RevokeSessionAsync(Guid sessionId)
    {
        if (await Dialogs.ConfirmAsync("Cerrar sesión", "¿Cerrar esta sesión? La persona tendrá que ingresar de nuevo en ese navegador.", "Cerrar sesión")
            && await RunAsync(new RevokePortalSessionCommand(sessionId, "Cerrada por un superadministrador"), "Sesión cerrada."))
        {
            await LoadAsync();
        }
    }
}
