@page "/empresas"
@attribute [Authorize(Policy = CloudPermissions.LicensingView)]
@inherits PortalPageBase

<PageTitle>Empresas · BusinessPost</PageTitle>
<PageHeader Title="Empresas licenciadas" Crumb="Empresas" Section="Licenciamiento"
            Description="Una licencia por NIT; cada sucursal es una instalación. Las empresas se registran desde la ficha de su cliente." />

@if (LoadError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@LoadError</MudAlert>
}

<MudPaper Elevation="0" Class="bp-card">
    <div class="bp-toolbar">
        <MudTextField T="string" @bind-Value="_search" Placeholder="Buscar por razón social, NIT o ciudad" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="400"
                      OnDebounceIntervalElapsed="@(_ => LoadAsync())" Clearable="true" OnClearButtonClick="@(_ => LoadAsync())" aria-label="Buscar empresas" />
        <MudSelect T="string" @bind-Value="_status" Label="Suscripción" Variant="Variant.Outlined" Margin="Margin.Dense" Class="bp-filter" Dense="true">
            <MudSelectItem T="string" Value="@string.Empty">Todas</MudSelectItem>
            @foreach (var status in Statuses)
            {
                <MudSelectItem T="string" Value="@status">@StatusName(status)</MudSelectItem>
            }
            <MudSelectItem T="string" Value="@("NONE")">Sin suscripción</MudSelectItem>
        </MudSelect>
        <MudSelect T="string" @bind-Value="_profile" Label="Tipo de negocio" Variant="Variant.Outlined" Margin="Margin.Dense" Class="bp-filter" Dense="true">
            <MudSelectItem T="string" Value="@string.Empty">Todos</MudSelectItem>
            @foreach (var profile in BusinessProfileCodes.All)
            {
                <MudSelectItem T="string" Value="@profile">@BusinessProfileCodes.Name(profile) (@Count(profile))</MudSelectItem>
            }
            <MudSelectItem T="string" Value="@("NONE")">Sin informar (@Count(null))</MudSelectItem>
        </MudSelect>
        @if (_rows is not null)
        {
            <span class="bp-toolbar-count" role="status">@Filtered.Count de @_rows.Count empresas</span>
        }
    </div>
    @if (_rows is null)
    {
        <TableSkeleton />
    }
    else
    {
        <OrganizationTable Rows="Filtered" EmptyTitle="Ninguna empresa coincide" EmptyHint="Pruebe con otra búsqueda o filtro." />
    }
</MudPaper>

@code {
    private static readonly string[] Statuses = ["TRIAL", "ACTIVE", "PAST_DUE", "SUSPENDED", "EXPIRED", "CANCELLED"];

    private IReadOnlyList<OrganizationRowDto>? _rows;
    private string? _search;
    private string _status = string.Empty;
    private string _profile = string.Empty;

    private List<OrganizationRowDto> Filtered => (_rows ?? []).Where(o => _status switch
    {
        "" => true,
        "NONE" => o.Subscription is null,
        _ => o.Subscription?.EffectiveStatus == _status,
    }).Where(o => _profile switch
    {
        "" => true,
        "NONE" => o.BusinessProfile is null,
        _ => o.BusinessProfile == _profile,
    }).ToList();

    /// <summary>Empresas de cada tipo de negocio (la tienda lo informa en su check-in, Fase 7-C parte A).</summary>
    private int Count(string? profile) => (_rows ?? []).Count(o => o.BusinessProfile == profile);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _rows = await LoadAsync(new ListOrganizationsQuery(null, _search)) ?? [];
}
