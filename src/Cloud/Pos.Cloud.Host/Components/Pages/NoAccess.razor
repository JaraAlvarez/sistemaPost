@page "/sin-acceso"
@attribute [AllowAnonymous]

<PageTitle>Sin acceso · BusinessPost</PageTitle>
<MudText Typo="Typo.h4" GutterBottom="true">Sin acceso</MudText>

<AuthorizeView>
    <Authorized>
        @if (context.User.HasClaim(Pos.Cloud.Infrastructure.Persistence.PortalClaims.Stage, Pos.Cloud.Infrastructure.Persistence.PortalClaims.ActiveStage))
        {
            <AccessDeniedNotice />
            <MudLink Href="mi-cuenta">Ir a mi cuenta</MudLink>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">Falta completar el ingreso con el código del doble factor.</MudAlert>
            <MudLink Href="@PortalLinks.Local(PortalAuthenticationHandler.LoginPath)">Volver a ingresar</MudLink>
        }
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Info" Class="mb-4">Su sesión no está activa.</MudAlert>
        <MudLink Href="@PortalLinks.Local(PortalAuthenticationHandler.LoginPath)">Ingresar al portal</MudLink>
    </NotAuthorized>
</AuthorizeView>
