@page "/cuenta/vincular-instalador"
@layout AccountLayout
@using System.Globalization
@using Pos.Application.Abstractions.Messaging
@using Pos.Cloud.Infrastructure.Persistence
@using Pos.SharedKernel.Time
@inject IDispatcher Dispatcher
@inject NavigationManager Navigation
@inject IClock Clock

@* "Continuar con Google" del instalador premium (Fase 13-B, parte E). El instalador abre esta página en el navegador del sistema (Google
   no permite su ingreso dentro de un WebView). El dueño entra al portal como siempre (contraseña o Google, misma sesión y cookie) y
   aquí autoriza o cancela. Formulario POST con token antifalsificación, renderizado en el servidor y sin scripts.
   Contra el "phishing" (alguien con la clave crea la solicitud y le envía este enlace al dueño): el dueño ESCRIBE el código que muestra
   SU instalador (la página no lo muestra), debe haber ingresado hace poco, escribe su TOTP si lo tiene activo (también tras Google) y
   ve cuándo y desde qué IP se creó la solicitud. *@

<PageTitle>Autorizar la instalación · BusinessPost</PageTitle>

<h1 class="auth-title">Autorizar la instalación</h1>

@if (_signedIn)
{
    @* El formulario se dibuja SIEMPRE con sesión (aunque no esté pendiente): en un POST, Blazor solo atiende un formulario que esté en
       la página; así una pestaña vieja que envía "Autorizar" ve el estado actual y no un error. *@
    <EditForm Model="Input" method="post" OnSubmit="DecideAsync" FormName="vincular-instalador" class="auth-form">
        @if (_view is { State: OwnerLinkRequestPageState.Pending })
        {
            <p class="auth-lead">
                ¿Autorizar la instalación de BusinessPost para <strong>@_view.LegalName</strong> (NIT @FormatNit(_view.Nit))?
            </p>
            <AuthAlert Warning="true">
                Solo continúe si USTED está instalando BusinessPost en este momento. Si alguien le envió este enlace o le dictó un código por
                teléfono o mensaje, no lo escriba: pulse Cancelar.
            </AuthAlert>
            <p class="auth-hint">Solicitud creada hace @Ago(_view.CreatedAt) desde la dirección @(_view.CreatedIp ?? "desconocida"). Vence en @Minutes(_view.ExpiresAt) minutos.</p>
            @if (_view.Message is not null)
            {
                <AuthAlert>@_view.Message</AuthAlert>
            }

            <div class="auth-field">
                <label for="usercode">Código que muestra el instalador</label>
                <InputText id="usercode" type="text" class="auth-code" @bind-Value="Input.Code" autocomplete="off" maxlength="12" placeholder="XXXX-XXXX" />
            </div>
            @if (_view.TotpRequired)
            {
                <div class="auth-field">
                    <label for="totp">Código de 6 dígitos de su aplicación autenticadora</label>
                    <InputText id="totp" type="text" class="auth-code" @bind-Value="Input.Totp" autocomplete="one-time-code" inputmode="numeric" maxlength="6" />
                </div>
            }

            <div class="auth-actions">
                <button type="submit" name="Input.Decision" value="cancelar" class="auth-button auth-button-secondary">Cancelar</button>
                <button type="submit" name="Input.Decision" value="autorizar" class="auth-button auth-button-primary">Autorizar</button>
            </div>
            <p class="auth-hint">Entrará a BusinessPost como Propietario con su correo @_email.</p>
        }
    </EditForm>
}

@switch (_view?.State)
{
    case OwnerLinkRequestPageState.Approved:
    case OwnerLinkRequestPageState.Used:
        <p class="auth-lead"><strong>Listo: la instalación quedó autorizada.</strong> Vuelva al instalador; ya puede continuar. Puede cerrar esta pestaña.</p>
        break;

    case OwnerLinkRequestPageState.Denied:
        @* PN3: si se canceló por demasiados códigos incorrectos, el aviso lo dice (y qué hacer). *@
        <AuthAlert>Solicitud cancelada. @(_view?.Message ?? "El instalador no recibe acceso a su cuenta. Si fue un error, en el instalador pulse otra vez \"Continuar con Google\".")</AuthAlert>
        break;

    case OwnerLinkRequestPageState.Expired:
        <AuthAlert>La solicitud venció. En el instalador, pulse otra vez "Continuar con Google" para empezar de nuevo.</AuthAlert>
        break;

    case OwnerLinkRequestPageState.ReauthenticationRequired:
        <AuthAlert Warning="true">Por seguridad, para autorizar una instalación debe haber ingresado hace pocos minutos. Ingrese de nuevo (con Google o su contraseña) y volverá a esta página.</AuthAlert>
        <form method="post" action="@PortalLinks.Local("/cuenta/salir")" class="auth-form">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@CurrentUrl" />
            <button type="submit" class="auth-button auth-button-primary">Ingresar de nuevo</button>
        </form>
        break;

    case OwnerLinkRequestPageState.Unavailable:
        @* La misma respuesta si la solicitud no existe o si el usuario no es el dueño: no se confirma su existencia ni la empresa. *@
        <AuthAlert>No encontramos una solicitud del instalador para su usuario. Revise que abrió el enlace completo desde el instalador. Si la licencia es de otra cuenta, salga e ingrese con el correo del dueño.</AuthAlert>
        <form method="post" action="@PortalLinks.Local("/cuenta/salir")" class="auth-form">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@CurrentUrl" />
            <button type="submit" class="auth-button auth-button-primary">Salir y entrar con otra cuenta</button>
        </form>
        break;

    default:
        @if (_error is not null)
        {
            <AuthAlert>@_error</AuthAlert>
        }
        else if (_mustChangePassword)
        {
            <AuthAlert Warning="true">Primero cambie su contraseña temporal en "Mi cuenta". Después vuelva a abrir el enlace del instalador (sigue esperando unos minutos).</AuthAlert>
            <div class="auth-foot"><a href="@PortalLinks.Local(MustChangePasswordMiddleware.MyAccountPath)">Ir a Mi cuenta</a></div>
        }
        break;
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "r")]
    private string? RequestId { get; set; }

    [SupplyParameterFromForm(FormName = "vincular-instalador")]
    private DecisionInput Input { get; set; } = default!;

    private OwnerLinkRequestView? _view;
    private string? _error;
    private string? _email;
    private bool _mustChangePassword;
    private bool _signedIn;

    private string CurrentUrl => $"{PortalCookie.InstallerLinkPath}?r={Uri.EscapeDataString(RequestId ?? string.Empty)}";

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        var user = HttpContext.User;
        if (user.Identity?.IsAuthenticated != true || !user.HasClaim(PortalClaims.Stage, PortalClaims.ActiveStage))
        {
            // Sin sesión: al ingreso de siempre (contraseña o Google) y de vuelta aquí.
            Navigation.NavigateTo(
                $"{PortalLinks.Local(PortalAuthenticationHandler.LoginPath)}?returnUrl={Uri.EscapeDataString(PortalCookie.SafeReturnUrl(CurrentUrl))}", forceLoad: true);
            return;
        }

        if (user.MustChangePassword())
        {
            _mustChangePassword = true;
            return;
        }

        _signedIn = true;
        _email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            await LoadAsync(null);
        }
    }

    private Task DecideAsync() => LoadAsync(Input.Decision switch { "autorizar" => true, "cancelar" => false, _ => null });

    private async Task LoadAsync(bool? approve)
    {
        if (!Guid.TryParse(RequestId, out var id))
        {
            _view = new OwnerLinkRequestView(OwnerLinkRequestPageState.Unavailable);
            return;
        }

        var result = await Dispatcher.Send(new DecideOwnerLinkRequestCommand(id, approve, HttpContext.Connection.RemoteIpAddress, Input.Code, Input.Totp));
        var error = result.IsFailure ? result.Error : result.Value.Error;
        if (error is not null)
        {
            _error = error.Message;
            return;
        }

        _view = result.Value.Value;
        // Los campos no se vuelven a llenar con lo enviado (el código y el TOTP se escriben de nuevo).
        Input.Code = null;
        Input.Totp = null;
    }

    private int Minutes(DateTimeOffset? expiresAt) => expiresAt is { } at ? Math.Max(1, (int)Math.Ceiling((at - Clock.UtcNow).TotalMinutes)) : 0;

    private string Ago(DateTimeOffset? createdAt)
    {
        var minutes = createdAt is { } at ? Math.Max(0, (int)Math.Floor((Clock.UtcNow - at).TotalMinutes)) : 0;
        return minutes < 1 ? "menos de un minuto" : minutes == 1 ? "1 minuto" : $"{minutes} minutos";
    }

    private static string FormatNit(string? nit)
    {
        if (nit is null)
        {
            return string.Empty;
        }

        var parts = nit.Split('-');
        return long.TryParse(parts[0], NumberStyles.None, CultureInfo.InvariantCulture, out var number)
            ? number.ToString("#,0", CultureInfo.GetCultureInfo("es-CO")) + (parts.Length > 1 ? "-" + parts[1] : string.Empty)
            : nit;
    }

    private sealed class DecisionInput
    {
        public string? Decision { get; set; }

        public string? Code { get; set; }

        public string? Totp { get; set; }
    }
}
