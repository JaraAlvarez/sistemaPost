@page "/cuenta/activar-doble-factor"
@layout AccountLayout
@using Pos.Application.Abstractions.Messaging
@inject IDispatcher Dispatcher
@inject NavigationManager Navigation

<PageTitle>Activar doble factor · BusinessPost</PageTitle>

<h1 class="auth-title">Active el doble factor</h1>
<p class="auth-lead">En este portal el doble factor es obligatorio: protege su cuenta aunque alguien conozca su contraseña.</p>

@if (_error is not null)
{
    <AuthAlert>@_error</AuthAlert>
}

@if (_enrollment is not null)
{
    <ol class="auth-steps">
        <li>Instale Google Authenticator, Microsoft Authenticator o Aegis en su teléfono.</li>
        <li>Escanee este código QR con la aplicación.</li>
        <li>Escriba el primer código de 6 dígitos que muestre.</li>
    </ol>
    <img class="auth-qr" src="@QrCodes.ToDataUri(_enrollment.EnrollmentLink)" alt="Código QR del doble factor" width="200" height="200" />
    <p class="auth-hint">Si no puede escanearlo, escriba esta clave en la aplicación:</p>
    <p class="auth-secret">@_enrollment.Secret</p>
}

@if (_enrollment is not null || !HttpMethods.IsGet(HttpContext.Request.Method))
{
    <EditForm Model="Input" method="post" OnValidSubmit="ConfirmAsync" FormName="enroll" class="auth-form">
        <div class="auth-field">
            <label for="code">Primer código</label>
            <InputText id="code" type="text" class="auth-code" @bind-Value="Input.Code" autocomplete="one-time-code" inputmode="numeric" maxlength="6"
                       pattern="[0-9]{6}" required="required" />
        </div>
        <button type="submit" class="auth-button auth-button-primary">Activar y entrar</button>
    </EditForm>
}

<div class="auth-foot"><a href="cuenta/ingresar">Volver a ingresar</a></div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private CodeInput Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private TotpEnrollmentDto? _enrollment;
    private string? _error;

    private string Token => PortalCookie.Read(HttpContext.Request) ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        // El secreto se genera solo al MOSTRAR la página (GET); al enviar el código no se reemplaza.
        if (!HttpMethods.IsGet(HttpContext.Request.Method))
        {
            return;
        }

        var result = await Dispatcher.Send(new BeginTotpEnrollmentCommand(Token));
        var error = result.IsFailure ? result.Error : result.Value.Error;
        if (error is not null)
        {
            _error = error.Message;
            return;
        }

        _enrollment = result.Value.Value;
    }

    private async Task ConfirmAsync()
    {
        var result = await Dispatcher.Send(new CompleteSecondFactorCommand(Token, Input.Code ?? string.Empty));
        var error = result.IsFailure ? result.Error : result.Value.Error;
        if (error is not null)
        {
            _error = $"{error.Message} Si el código QR ya no es válido, vuelva a ingresar para generar otro.";
            return;
        }

        var session = result.Value.Value!;
        PortalCookie.Write(HttpContext.Response, session.Token, session.ExpiresAt);
        Navigation.NavigateTo(PortalLinks.Local(session.User.MustChangePassword ? "/mi-cuenta" : PortalCookie.SafeReturnUrl(ReturnUrl)), forceLoad: true);
    }

    private sealed class CodeInput
    {
        public string? Code { get; set; }
    }
}
