@page "/cuenta/segundo-factor"
@layout AccountLayout
@using Pos.Application.Abstractions.Messaging
@inject IDispatcher Dispatcher
@inject NavigationManager Navigation

<PageTitle>Código de verificación · BusinessPost</PageTitle>

<h1 class="auth-title">Código de verificación</h1>
<p class="auth-lead">Abra su aplicación autenticadora (Google Authenticator, Microsoft Authenticator o Aegis) y escriba el código de 6 dígitos de BusinessPost.</p>

@if (_error is not null)
{
    <AuthAlert>@_error</AuthAlert>
}

<EditForm Model="Input" method="post" OnValidSubmit="VerifyAsync" FormName="totp" class="auth-form">
    <div class="auth-field">
        <label for="code">Código de 6 dígitos</label>
        <InputText id="code" type="text" class="auth-code" @bind-Value="Input.Code" autocomplete="one-time-code" inputmode="numeric" maxlength="6"
                   pattern="[0-9]{6}" required="required" autofocus="autofocus" />
    </div>
    <button type="submit" class="auth-button auth-button-primary">Verificar e ingresar</button>
</EditForm>
<p class="auth-hint">El código cambia cada 30 segundos. Si no le funciona, revise que la hora de su teléfono esté automática.</p>
<div class="auth-foot"><a href="cuenta/ingresar">Volver a ingresar</a></div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private CodeInput Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? _error;

    protected override void OnInitialized() => Input ??= new();

    private async Task VerifyAsync()
    {
        var result = await Dispatcher.Send(new CompleteSecondFactorCommand(PortalCookie.Read(HttpContext.Request) ?? string.Empty, Input.Code ?? string.Empty));
        var error = result.IsFailure ? result.Error : result.Value.Error;
        if (error is not null)
        {
            _error = error.Message;
            return;
        }

        var session = result.Value.Value!;
        PortalCookie.Write(HttpContext.Response, session.Token, session.ExpiresAt);
        Navigation.NavigateTo(PortalLinks.Local(session.User.MustChangePassword ? "/mi-cuenta" : PortalCookie.SafeReturnUrl(ReturnUrl)), forceLoad: true);
    }

    private sealed class CodeInput
    {
        public string? Code { get; set; }
    }
}
