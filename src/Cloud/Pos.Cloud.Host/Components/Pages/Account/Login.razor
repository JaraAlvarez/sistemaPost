@page "/cuenta/ingresar"
@layout AccountLayout
@using Microsoft.Extensions.Options
@using Pos.Application.Abstractions.Messaging
@using Pos.Cloud.PortalIdentity.Domain
@inject IDispatcher Dispatcher
@inject NavigationManager Navigation
@inject IOptions<PortalGoogleOptions> Google

<PageTitle>Ingresar · BusinessPost</PageTitle>

<h1 class="auth-title">Ingresar al portal</h1>
<p class="auth-lead">
    @(Google.Value.IsConfigured
        ? "Use la cuenta de Google autorizada para su usuario o, si lo prefiere, su correo y contraseña."
        : "Escriba el correo y la contraseña de su usuario del portal.")
</p>

@if (_error is not null)
{
    <AuthAlert>@_error</AuthAlert>
}
else if (Notice is { } notice)
{
    <AuthAlert Warning="@(Expired is not null)">@notice</AuthAlert>
}

@if (Google.Value.IsConfigured)
{
    @* Formulario aparte (POST con token antifalsificación) hacia el desafío de Google: /cuenta/google → Google → /signin-google. *@
    <form method="post" action="@PortalLinks.Local(PortalGoogle.ChallengePath)" class="account-google">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@PortalCookie.SafeReturnUrl(ReturnUrl)" />
        @* Botón según las pautas de marca de Google Identity: logotipo "G" oficial a color, sin alterar, y texto "Continuar con Google". *@
        <button type="submit" class="google-button">
            <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                <path fill="none" d="M0 0h48v48H0z" />
            </svg>
            <span>Continuar con Google</span>
        </button>
    </form>
    <div class="auth-divider" role="separator">o con su correo y contraseña</div>
}

<EditForm Model="Input" method="post" OnValidSubmit="LoginAsync" FormName="login" class="auth-form">
    <div class="auth-field">
        <label for="email">Correo electrónico</label>
        <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="username" required="required" />
    </div>
    <div class="auth-field">
        <label for="password">Contraseña</label>
        <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="current-password" required="required" />
    </div>
    <button type="submit" class="auth-button @(Google.Value.IsConfigured ? "auth-button-secondary" : "auth-button-primary")">@(Google.Value.IsConfigured ? "Ingresar con contraseña" : "Ingresar")</button>
</EditForm>
<p class="auth-hint">Si activó el doble factor, después de la contraseña se pide el código de su aplicación autenticadora.</p>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    /// <summary>Resultado del ingreso con Google (<c>rechazado</c>, <c>bloqueado</c>, <c>error</c>).</summary>
    [SupplyParameterFromQuery(Name = "google")]
    private string? GoogleResult { get; set; }

    /// <summary>El formulario anterior venció (token antifalsificación de una sesión que ya no existe).</summary>
    [SupplyParameterFromQuery(Name = "vencido")]
    private string? Expired { get; set; }

    private string? _error;

    private string? Notice =>
        Expired is not null ? "La página de acceso venció (pasaron varios minutos o su sesión cambió). Ingrese de nuevo."
        : GoogleResult switch
        {
            null => null,
            "rechazado" => PortalIdentityErrors.ExternalLoginRejected.Message,
            "bloqueado" => PortalIdentityErrors.UserLocked.Message,
            _ => "No se completó el ingreso con Google. Intente de nuevo o ingrese con su contraseña.",
        };

    protected override void OnInitialized() => Input ??= new();

    private async Task LoginAsync()
    {
        var userAgent = HttpContext.Request.Headers.UserAgent.ToString();
        var result = await Dispatcher.Send(new PortalLoginCommand(
            Input.Email ?? string.Empty, Input.Password ?? string.Empty, SessionChannel.Portal, HttpContext.Connection.RemoteIpAddress,
            userAgent.Length == 0 ? null : userAgent));
        var error = result.IsFailure ? result.Error : result.Value.Error;
        if (error is not null)
        {
            _error = error.Message;
            return;
        }

        var challenge = result.Value.Value!;
        PortalCookie.Write(HttpContext.Response, challenge.Token, challenge.ExpiresAt);
        var returnUrl = PortalCookie.SafeReturnUrl(ReturnUrl);
        if (challenge.Stage == "ACTIVE")
        {
            // Sin doble factor (opcional y no activado): la sesión ya está activa. El middleware lleva a /mi-cuenta si la
            // contraseña es temporal.
            Navigation.NavigateTo(PortalLinks.Local(returnUrl), forceLoad: true);
            return;
        }

        var next = challenge.Stage == "ENROLLMENT_REQUIRED" ? "/cuenta/activar-doble-factor" : "/cuenta/segundo-factor";
        Navigation.NavigateTo($"{PortalLinks.Local(next)}?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }

    private sealed class LoginInput
    {
        public string? Email { get; set; }

        public string? Password { get; set; }
    }
}
