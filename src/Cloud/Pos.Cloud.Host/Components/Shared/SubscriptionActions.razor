@inherits PortalPageBase

@* Acciones sobre una suscripción, según el permiso del usuario (las mismas en la ficha de la empresa y en la lista). *@
<MudGrid Spacing="2">
    <MudItem xs="12" md="6">
        <MudTextField T="string" @bind-Value="_reason" Label="Motivo (suspender, reactivar, cancelar, gracia, edición)" MaxLength="300" />
    </MudItem>
    <MudItem xs="12" md="3"><MudTextField T="string" @bind-Value="_payment" Label="Referencia del pago (renovar)" MaxLength="100" /></MudItem>
    <MudItem xs="6" md="1"><MudNumericField T="int" @bind-Value="_periods" Label="Periodos" Min="1" Max="24" /></MudItem>
    <MudItem xs="6" md="2"><MudNumericField T="int" @bind-Value="_graceDays" Label="Días de gracia extra" Min="1" Max="30" /></MudItem>
</MudGrid>
<MudStack Row="true" Wrap="Wrap.Wrap" Class="mt-3">
    <AuthorizeView Policy="@CloudPermissions.SubscriptionManage">
        <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="Busy" OnClick="@(() => SendAsync(new RenewSubscriptionCommand(SubscriptionId, _payment ?? string.Empty, _periods), "Renovación registrada."))">Renovar</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="Busy" OnClick="@(() => SendAsync(new SuspendSubscriptionCommand(SubscriptionId, _reason ?? string.Empty), "Suscripción suspendida."))">Suspender</MudButton>
        <MudButton Variant="Variant.Outlined" Disabled="Busy" OnClick="@(() => SendAsync(new ChangeEditionCommand(SubscriptionId, Edition == "SINGLE" ? "MULTI" : "SINGLE", _reason ?? string.Empty), "Edición cambiada."))">
            Cambiar a @(Edition == "SINGLE" ? "Multicaja" : "Caja Única")
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="Busy" OnClick="@(() => SendAsync(new CancelSubscriptionCommand(SubscriptionId, _reason ?? string.Empty), "Suscripción cancelada y clave revocada."))">Cancelar</MudButton>
    </AuthorizeView>
    <AuthorizeView Policy="@CloudPermissions.SubscriptionSupport">
        <MudButton Variant="Variant.Outlined" Color="Color.Success" Disabled="Busy" OnClick="@(() => SendAsync(new ReactivateSubscriptionCommand(SubscriptionId, _reason ?? string.Empty), "Suscripción reactivada."))">Reactivar</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="Busy" OnClick="@(() => SendAsync(new ExtendGraceCommand(SubscriptionId, _graceDays, _reason ?? string.Empty), "Gracia extendida."))">Extender gracia</MudButton>
    </AuthorizeView>
</MudStack>
<MudText Typo="Typo.caption" Class="mt-2">Los cambios llegan a las tiendas en su siguiente check-in (máximo 24 h, o al pulsar "verificar licencia" en el POS).</MudText>

@code {
    [Parameter, EditorRequired]
    public Guid SubscriptionId { get; set; }

    [Parameter, EditorRequired]
    public string Edition { get; set; } = "SINGLE";

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private string? _payment;
    private string? _reason;
    private int _periods = 1;
    private int _graceDays = 7;

    private async Task SendAsync(Pos.Application.Abstractions.Messaging.IRequest<Pos.SharedKernel.Results.Result> command, string message)
    {
        if (await RunAsync(command, message))
        {
            _reason = null;
            _payment = null;
            await OnChanged.InvokeAsync();
        }
    }
}
