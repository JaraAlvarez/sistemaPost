<MudText Typo="Typo.h6" Class="mt-6 mb-2">@Title</MudText>
@if (Rows.Count == 0)
{
    <MudText Typo="Typo.body2">@Empty</MudText>
}
else
{
    <MudSimpleTable Dense="true" Hover="true" Outlined="true">
        <thead>
            <tr><th>Empresa</th><th>NIT</th><th>Edición</th><th>Estado</th><th>Vigente hasta</th><th>Gracia hasta</th><th>Días</th></tr>
        </thead>
        <tbody>
            @foreach (var s in Rows)
            {
                <tr>
                    <td><MudLink Href="@($"/empresas/{s.OrganizationId}")">@s.OrganizationName</MudLink></td>
                    <td>@s.Nit</td>
                    <td>@PortalPageBase.EditionName(s.Edition)</td>
                    <td><MudChip T="string" Size="Size.Small" Color="@PortalPageBase.StatusColor(s.Status)">@PortalPageBase.StatusName(s.Status)</MudChip></td>
                    <td>@PortalPageBase.Day(s.ValidUntil)</td>
                    <td>@PortalPageBase.Day(s.GraceUntil)</td>
                    <td>@s.DaysLeft</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<SubscriptionRowDto> Rows { get; set; } = [];

    [Parameter]
    public string Empty { get; set; } = "Sin registros.";
}
