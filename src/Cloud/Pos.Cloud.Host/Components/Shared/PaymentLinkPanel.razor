@* Enlace público de pago de una suscripción (D12C-07): dirección, "Copiar enlace de pago" y su QR para enviarlo por WhatsApp o
   pagar desde el celular. Con PaymentManage, "Regenerar" (el anterior deja de funcionar). *@
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IAsyncDisposable

@if (Link is not null)
{
    var url = Url;
    <MudGrid Spacing="3">
        <MudItem xs="12" md="8">
            <MudTextField T="string" Value="url" Label="Enlace de pago" ReadOnly="true" Variant="Variant.Outlined" Class="mono" />
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyAsync">Copiar enlace de pago</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.OpenInNew" Href="@url" Target="_blank">Abrir</MudButton>
                @if (OnRegenerate.HasDelegate)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Autorenew" Disabled="Busy" OnClick="OnRegenerate">Regenerar enlace</MudButton>
                }
            </MudStack>
            <MudText Typo="Typo.caption" Class="d-block mt-3 texto-secundario">
                La página del enlace muestra solo el nombre de la empresa, la edición, el vencimiento y el valor. El cliente paga en Wompi y la
                suscripción se renueva sola al confirmarse el pago.
            </MudText>
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex justify-center">
            <img src="@QrCodes.ToDataUri(url)" alt="Código QR del enlace de pago" width="180" height="180" style="background: #fff; padding: 8px; border-radius: 8px" />
        </MudItem>
    </MudGrid>
}

@code {
    private IJSObjectReference? _module;

    [Parameter, EditorRequired]
    public PaymentLinkDto? Link { get; set; }

    [Parameter]
    public EventCallback OnRegenerate { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    private string Url => Navigation.BaseUri + Link!.Path;

    private async Task CopyAsync()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/portapapeles.js");
            var copied = await _module.InvokeAsync<bool>("copiar", Url);
            Snackbar.Add(copied ? "Enlace copiado." : "No se pudo copiar: selecciónelo y cópielo a mano.", copied ? Severity.Success : Severity.Warning);
        }
        catch (JSException)
        {
            Snackbar.Add("No se pudo copiar: selecciónelo y cópielo a mano.", Severity.Warning);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // El circuito ya se cerró.
            }
        }
    }
}
