@inherits PortalPageBase
@inject IDialogService Dialogs

@if (Rows.Count == 0)
{
    <EmptyState Title="@EmptyTitle" Hint="Se crean cuando una sucursal activa el POS con la clave de licencia." Icon="@Icons.Material.Outlined.Computer" />
}
else
{
    <MudStack Spacing="3" Class="@Class">
        @foreach (var i in Rows)
        {
            <MudPaper Elevation="0" Class="bp-card pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Outlined.Storefront" aria-hidden="true" Class="texto-secundario" />
                    <MudText Typo="Typo.subtitle1" HtmlTag="h3">
                        @if (ShowOrganization)
                        {
                            <MudLink Href="@($"empresas/{i.OrganizationId}")">@i.OrganizationName</MudLink>
                            <span> · </span>
                        }
                        @(i.BranchName ?? "Sucursal sin nombre")
                    </MudText>
                    <StatusChip Text="@(i.Status == "ACTIVE" ? "Con equipo activo" : "Sin equipo")" Color="@(i.Status == "ACTIVE" ? Color.Success : Color.Default)" />
                </MudStack>
                <MudText Typo="Typo.body2" Class="texto-secundario mt-1">
                    Versión @i.AppVersion · último check-in @Date(i.LastCheckinAt)@(i.LastIp is null ? null : $" desde {i.LastIp}")@(i.ActiveTerminals is null ? null : $" · {i.ActiveTerminals} cajas")
                    · primera activación @Date(i.FirstActivatedAt)
                </MudText>
                <MudText Typo="Typo.caption" Class="texto-secundario d-block">installation_id <span class="mono">@i.InstallationId</span></MudText>

                @if (i.Activations.Count > 0)
                {
                    <div class="bp-table-wrap mt-3">
                        <MudSimpleTable Dense="true" Outlined="true" Elevation="0">
                            <thead><tr><th scope="col">Equipo</th><th scope="col">Rol</th><th scope="col">Activación</th><th scope="col">Desde</th><th scope="col">Liberada</th><th scope="col"><span class="visualmente-oculto">Acciones</span></th></tr></thead>
                            <tbody>
                                @foreach (var a in i.Activations)
                                {
                                    var device = i.Devices.FirstOrDefault(d => d.Id == a.DeviceId);
                                    <tr>
                                        <td>@(device?.DeviceName ?? "—")<span class="cell-sub">@device?.OperatingSystem</span></td>
                                        <td>@(device?.Role == "STORE_SERVER" ? "Servidor de tienda" : "Equipo único")</td>
                                        <td><StatusChip Status="@a.Status" /></td>
                                        <td>@Date(a.ActivatedAt)</td>
                                        <td style="white-space: normal">@(a.ReleasedAt is null ? "—" : $"{Date(a.ReleasedAt)} por {a.ReleasedByName}: {a.ReleaseReason}")</td>
                                        <td class="text-right">
                                            @if (a.Status == "ACTIVE")
                                            {
                                                <AuthorizeView Policy="@CloudPermissions.DeviceRelease">
                                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.LinkOff" Disabled="Busy"
                                                               OnClick="@(() => ReleaseAsync(a.Id, device?.DeviceName, i.BranchName))">Liberar equipo</MudButton>
                                                </AuthorizeView>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }
            </MudPaper>
        }
    </MudStack>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<InstallationDto> Rows { get; set; } = [];

    [Parameter]
    public bool ShowOrganization { get; set; }

    [Parameter]
    public string EmptyTitle { get; set; } = "Sin instalaciones";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private async Task ReleaseAsync(Guid activationId, string? deviceName, string? branchName)
    {
        var reason = await Dialogs.ConfirmWithReasonAsync(
            "Liberar equipo", $"¿Liberar el equipo {deviceName ?? "sin nombre"} de la sucursal {branchName ?? "sin nombre"}?", "Liberar equipo",
            "Motivo (cambio de PC, equipo dañado…)", Color.Warning,
            detail: "El equipo actual deja de estar autorizado y la sucursal podrá activar uno nuevo con la misma clave.");
        if (reason is not null
            && await RunAsync(new ReleaseActivationCommand(activationId, reason), "Equipo liberado: la sucursal puede activar el nuevo equipo con su clave."))
        {
            await OnChanged.InvokeAsync();
        }
    }
}
