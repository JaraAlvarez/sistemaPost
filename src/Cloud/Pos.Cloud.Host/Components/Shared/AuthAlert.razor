@* Mensaje de las pantallas de acceso (renderizadas en el servidor): error (rojo) o aviso (ámbar), anunciado por lectores de pantalla. *@
<div class="auth-alert @(Warning ? "auth-alert-warning" : "auth-alert-error")" role="alert">
    @if (!Warning)
    {
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 7a1 1 0 0 1 1 1v5a1 1 0 1 1-2 0V8a1 1 0 0 1 1-1zm0 9.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zM12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20zm0 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16z" /></svg>
    }
    else
    {
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10.3 3.6a2 2 0 0 1 3.4 0l8.2 14.2A2 2 0 0 1 20.2 21H3.8a2 2 0 0 1-1.7-3.2zM12 9a1 1 0 0 0-1 1v4a1 1 0 1 0 2 0v-4a1 1 0 0 0-1-1zm0 7.25a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5z" /></svg>
    }
    <div>@ChildContent</div>
</div>

@code {
    /// <summary>Aviso informativo (p. ej. la página venció) en vez de error.</summary>
    [Parameter]
    public bool Warning { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
