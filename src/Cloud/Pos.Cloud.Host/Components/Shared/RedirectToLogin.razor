@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var returnUrl = PortalCookie.SafeReturnUrl("/" + Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.NavigateTo($"{PortalLinks.Local(PortalAuthenticationHandler.LoginPath)}?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
