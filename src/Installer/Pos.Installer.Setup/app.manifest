<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="BusinessPost.Setup" />
  <!--
    asInvoker: el programa pide permisos de administrador UNA sola vez y solo cuando hace falta. Abierto desde el paquete descargable
    (BusinessPost-Setup-<versión>.exe ya pidió el permiso) hereda la elevación sin otro aviso; abierto desde "Aplicaciones instaladas"
    (desinstalar) se vuelve a abrir como administrador con un solo aviso de Windows. Con ‑‑maqueta no pide permisos (no instala nada).
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 y 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
