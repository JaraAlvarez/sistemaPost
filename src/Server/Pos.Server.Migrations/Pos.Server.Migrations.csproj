<Project Sdk="Microsoft.NET.Sdk">
  <!-- Motor de migraciones SQL-first y scripts versionados (incrustados). Lo usan el migrador, el host y las pruebas. -->
  <PropertyGroup>
    <RootNamespace>Pos.Server.Migrations</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scripts\**\*.sql" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pos.Database.Tests" />
  </ItemGroup>
</Project>
