@* Primer ingreso a una tienda recién instalada y SIN Propietario (instalador premium 1.2.1: el instalador no pide ningún dato).
   Opciones: "Continuar con Google" (la principal), "Mi cuenta de BusinessPost" (correo y contraseña del portal
   businesspost.tutiendanueva.com) y "Tengo una clave de licencia". El primer ingreso convierte esa cuenta en el Propietario; si su
   empresa tiene licencia, se activa sola; si no, la tienda sigue en la prueba de 30 días como Supermercado.
   - Google: el mismo mecanismo del instalador anterior (solicitud en la nube, el portal en el navegador del sistema, código para
     comparar y consulta hasta que se autoriza). Quien no tiene cuenta en el portal se registra solo al entrar con Google (cliente
     nuevo; el portal lo lista en "Registros nuevos"). Como no hay contraseña del portal que reutilizar, se crea una contraseña de
     BusinessPost (12+ caracteres, letras y números) para entrar en este equipo, también sin internet.
   - Correo y contraseña: POST setup/owner/portal-link (la nube valida la cuenta).
   Luego: POST setup/owner (crea al Propietario con el enlace firmado) → login → activar la licencia (con la clave o con el enlace). *@
@implements IDisposable
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation
@inject IJSRuntime Js

<MudText Typo="Typo.body2" Class="mt-2 mb-3">
    Es la primera vez que se abre BusinessPost en este equipo. Entre con su cuenta de BusinessPost: quedará como el <b>Propietario</b>
    de la tienda. ¿No tiene cuenta? Con Google se crea sola y empieza la prueba gratis de 30 días.
</MudText>

@if (_google is null)
{
    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Large" FullWidth="true" Disabled="_busy" OnClick="GoogleAsync" Class="primer-google">
        <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true" style="margin-right:10px"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
        Continuar con Google
    </MudButton>
    <MudText Typo="Typo.caption" Class="d-block mt-2 mb-1" Align="Align.Center">o con su correo y contraseña del portal</MudText>
}
else if (_google == "esperando")
{
    <MudAlert Severity="Severity.Info" Class="my-3" Icon="@Icons.Material.Outlined.OpenInBrowser">
        Le abrimos el navegador para entrar con Google. Entre al portal de BusinessPost, <b>escriba este código</b> en la página que se
        abrió y pulse <b>Autorizar</b>. Nunca se lo dé a otra persona.
    </MudAlert>
    <div class="primer-codigo" aria-label="Código para escribir en la página">@(_inicio?.UserCode ?? "····-····")</div>
    <div class="d-flex gap-2 mt-3">
        @if (_inicio is not null)
        {
            <MudButton Variant="Variant.Text" Href="@_inicio.BrowserUrl" Target="_blank" StartIcon="@Icons.Material.Outlined.OpenInNew">Abrir el navegador otra vez</MudButton>
        }
        <MudSpacer />
        <MudButton Variant="Variant.Text" OnClick="CancelarGoogle">Cancelar</MudButton>
    </div>
}
else
{
    <MudAlert Severity="Severity.Success" Class="my-3">
        Autorizó la entrada con <b>@_enlace!.Email</b>. Cree una <b>contraseña de BusinessPost</b>: con su correo y esta contraseña entrará
        en este equipo, también sin internet. Mínimo 12 caracteres, con letras y números.
    </MudAlert>
    <EditForm Model="this" OnSubmit="TerminarGoogleAsync">
        <MudTextField @bind-Value="_nueva" Label="Contraseña de BusinessPost" InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true"
                      autocomplete="new-password" />
        <MudTextField @bind-Value="_confirmacion" Label="Escríbala otra vez" InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true" Class="mt-3"
                      autocomplete="new-password" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Class="mt-5" Disabled="_busy"
                   StartIcon="@Icons.Material.Outlined.Login">@(_busy ? _paso : "Entrar")</MudButton>
        <MudButton Variant="Variant.Text" Class="mt-2" OnClick="CancelarGoogle">Usar otra cuenta</MudButton>
    </EditForm>
}

@if (_google is null)
{
    <MudTabs @bind-ActivePanelIndex="_tab" Elevation="0" ApplyEffectsToContainer="true">
        <MudTabPanel Text="Mi cuenta de BusinessPost" Icon="@Icons.Material.Outlined.AccountCircle">
            <MudText Typo="Typo.caption" Class="d-block mt-3">La cuenta del portal businesspost.tutiendanueva.com. Si tiene una licencia, se activa sola.</MudText>
        </MudTabPanel>
        <MudTabPanel Text="Tengo una clave de licencia" Icon="@Icons.Material.Outlined.Key">
            <MudTextField @bind-Value="_clave" Label="Clave de licencia" Placeholder="POS-XXXXX-XXXXX-XXXXX-XXXXX" Variant="Variant.Outlined" Immediate="true" Class="mt-4"
                          autocomplete="off" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Key" />
            <MudText Typo="Typo.caption" Class="d-block mt-1">Entre (con Google o con su correo) con la cuenta del portal con la que se compró la licencia.</MudText>
        </MudTabPanel>
    </MudTabs>
    <EditForm Model="this" OnSubmit="EntrarAsync">
        <MudTextField @bind-Value="_correo" Label="Correo de su cuenta de BusinessPost" Variant="Variant.Outlined" Immediate="true" Class="mt-3" autocomplete="username"
                      InputType="InputType.Email" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Email" />
        <MudTextField @bind-Value="_clavePortal" Label="Contraseña del portal" InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true" Class="mt-3"
                      autocomplete="current-password" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Lock" />
        @if (_pideTotp)
        {
            <MudTextField @bind-Value="_totp" Label="Código de verificación (6 dígitos de su aplicación)" Variant="Variant.Outlined" Immediate="true" Class="mt-3"
                          InputMode="InputMode.numeric" MaxLength="6" autocomplete="one-time-code" />
        }
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Class="mt-5" Disabled="_busy"
                   StartIcon="@Icons.Material.Outlined.Login">@(_busy ? _paso : "Entrar")</MudButton>
    </EditForm>
    <MudText Typo="Typo.caption" Class="d-block mt-3">
        Los datos de la empresa (razón social, NIT y dirección) los completa después en Configuración.
    </MudText>
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4" role="alert">@_error</MudAlert>
}

@code {
    private sealed record EnlacePropietario(string Token, string Email, string DisplayName, DateTimeOffset ExpiresAt, string? OrganizationName = null,
        string? OrganizationNit = null, bool HasLicense = false);

    private sealed record InicioGoogle(Guid RequestId, string PollToken, string BrowserUrl, string UserCode, int ExpiresIn, int Interval);

    private sealed record ConsultaGoogle(string Status, int Interval, EnlacePropietario? Link = null);

    private readonly CancellationTokenSource _cierre = new();
    private int _tab;
    private bool _busy, _pideTotp;
    private string _paso = "Entrando…";
    private string? _clave, _correo, _clavePortal, _totp, _error, _nueva, _confirmacion;

    // "Continuar con Google": null, "esperando" (navegador abierto) o "autorizada" (falta la contraseña local).
    private string? _google;
    private InicioGoogle? _inicio;
    private EnlacePropietario? _enlace;
    private CancellationTokenSource? _espera;

    private string? ClaveEscrita => _tab == 1 && !string.IsNullOrWhiteSpace(_clave) ? _clave.Trim() : null;

    private async Task EntrarAsync()
    {
        _error = null;
        if (_tab == 1 && ClaveEscrita is null)
        {
            _error = "Escriba la clave de licencia.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_correo) || string.IsNullOrEmpty(_clavePortal))
        {
            _error = "Escriba el correo y la contraseña de su cuenta de BusinessPost.";
            return;
        }

        _busy = true;
        try
        {
            _paso = "Validando su cuenta…";
            var enlace = await Api.PostAsync<EnlacePropietario>("api/v1/setup/owner/portal-link", new
            {
                email = _correo.Trim(), password = _clavePortal, totpCode = string.IsNullOrWhiteSpace(_totp) ? null : _totp.Trim(), licenseKey = ClaveEscrita,
            });

            // El Propietario es la cuenta validada por la nube, con la MISMA contraseña del portal.
            await TerminarAsync(enlace, _clavePortal);
        }
        catch (ApiException ex)
        {
            if (ex.Code == "LICENSE.OWNER_TOTP_REQUIRED")
            {
                _pideTotp = true;
            }

            _error = ex.Texto;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con el servidor de la tienda.";
        }
        finally
        {
            _busy = false;
        }
    }

    // ───── "Continuar con Google" ─────
    private async Task GoogleAsync()
    {
        _error = null;
        if (_tab == 1 && ClaveEscrita is null)
        {
            _error = "Escriba la clave de licencia o elija \"Mi cuenta de BusinessPost\".";
            return;
        }

        _busy = true;
        try
        {
            _inicio = await Api.PostAsync<InicioGoogle>("api/v1/setup/owner/google/start", new { licenseKey = ClaveEscrita });
            _google = "esperando";
            try
            {
                await Js.InvokeVoidAsync("open", _inicio.BrowserUrl, "_blank");
            }
            catch (JSException)
            {
                // Queda el botón "Abrir el navegador otra vez".
            }

            _espera?.Cancel();
            _espera = CancellationTokenSource.CreateLinkedTokenSource(_cierre.Token);
            _ = EsperarAsync(_inicio, _espera.Token);
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con el servidor de la tienda.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Consulta cada pocos segundos hasta que el dueño autoriza, cancela o vence la solicitud (nada queda esperando para siempre).</summary>
    private async Task EsperarAsync(InicioGoogle inicio, CancellationToken ct)
    {
        var intervalo = Math.Max(5, inicio.Interval);
        var vence = DateTimeOffset.UtcNow.AddSeconds(inicio.ExpiresIn + 30);
        try
        {
            while (!ct.IsCancellationRequested && DateTimeOffset.UtcNow < vence)
            {
                await Task.Delay(TimeSpan.FromSeconds(intervalo), ct);
                ConsultaGoogle consulta;
                try
                {
                    consulta = await Api.PostAsync<ConsultaGoogle>("api/v1/setup/owner/google/poll", new { requestId = inicio.RequestId, pollToken = inicio.PollToken });
                }
                catch (ApiException ex) when (ex.Code == "LICENSE.OWNER_LINK_SLOW_DOWN")
                {
                    intervalo += 5;
                    continue;
                }
                catch (HttpRequestException)
                {
                    continue;
                }

                intervalo = Math.Max(5, consulta.Interval);
                if (consulta.Status == "PENDING")
                {
                    continue;
                }

                if (consulta.Status == "APPROVED" && consulta.Link is { } enlace)
                {
                    _enlace = enlace;
                    _google = "autorizada";
                }
                else
                {
                    _google = null;
                    _error = consulta.Status == "DENIED" ? "La entrada con Google se canceló en el navegador." : "La solicitud venció. Pulse otra vez \"Continuar con Google\".";
                }

                await InvokeAsync(StateHasChanged);
                return;
            }

            if (!ct.IsCancellationRequested)
            {
                _google = null;
                _error = "La solicitud venció. Pulse otra vez \"Continuar con Google\".";
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Cancelada o se cerró la página.
        }
        catch (ApiException ex)
        {
            _google = null;
            _error = ex.Texto;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelarGoogle()
    {
        _espera?.Cancel();
        _google = null;
        _inicio = null;
        _enlace = null;
        _nueva = _confirmacion = null;
    }

    private async Task TerminarGoogleAsync()
    {
        _error = ProblemaContrasena(_nueva ?? string.Empty, _confirmacion ?? string.Empty, _enlace!.Email);
        if (_error is not null)
        {
            return;
        }

        _busy = true;
        try
        {
            await TerminarAsync(_enlace, _nueva!);
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con el servidor de la tienda.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Contraseña de BusinessPost con Google: la misma regla del portal (12+ caracteres, letras y números) y no fácil de adivinar.</summary>
    private static string? ProblemaContrasena(string contrasena, string confirmacion, string correo)
    {
        if (contrasena.Length < 12)
        {
            return "La contraseña debe tener al menos 12 caracteres.";
        }

        if (contrasena.Length > 128)
        {
            return "La contraseña es demasiado larga (máximo 128 caracteres).";
        }

        if (!contrasena.Any(char.IsLetter) || !contrasena.Any(char.IsDigit))
        {
            return "Use letras y números en la contraseña.";
        }

        var usuario = correo.Split('@')[0];
        if (contrasena.Distinct().Count() <= 3 || (usuario.Length >= 4 && contrasena.Contains(usuario, StringComparison.OrdinalIgnoreCase)))
        {
            return "Esa contraseña es muy fácil de adivinar. Use una frase o mezcle letras y números.";
        }

        return contrasena == confirmacion ? null : "Las dos contraseñas no coinciden.";
    }

    /// <summary>Crea al Propietario con el enlace firmado, entra y activa la licencia (la clave escrita o la de la empresa de la cuenta).</summary>
    private async Task TerminarAsync(EnlacePropietario enlace, string contrasena)
    {
        _paso = "Preparando su tienda…";
        await Api.PostAsync<System.Text.Json.JsonElement>("api/v1/setup/owner", new
        {
            username = enlace.Email, displayName = enlace.DisplayName, password = contrasena, email = enlace.Email, portalLinkToken = enlace.Token,
        });
        Session.SignIn(await Api.PostAsync<LoginResult>("api/v1/auth/login", new { username = enlace.Email, password = contrasena }));

        // Si la activación falla, sigue la prueba: la administración muestra el estado de la licencia y cómo activarla.
        var clave = ClaveEscrita;
        if (clave is not null || enlace.HasLicense)
        {
            _paso = "Activando la licencia…";
            try
            {
                await Api.PostAsync<System.Text.Json.JsonElement>("api/v1/license/activate",
                    new { licenseKey = clave, ownerLinkToken = clave is null ? enlace.Token : null });
            }
            catch (ApiException)
            {
                // Se activa después en Administración → Licencia.
            }
        }

        Navigation.NavigateTo("/admin");
    }

    public void Dispose()
    {
        _cierre.Cancel();
        _cierre.Dispose();
        _espera?.Dispose();
    }
}
