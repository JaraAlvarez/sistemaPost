@* Logo de BusinessPost: símbolo (bolsa de mercado con código de barras sobre el degradado índigo → verde azulado) y nombre.
   Mismo dibujo que wwwroot/img/businesspost.svg (icono de la pestaña). docs/guia-diseno.md §4. *@
<span class="bp-logo @(SobreOscuro ? "bp-logo-claro" : null) @Class" style="--bp-logo: @(Tamano)px">
    <svg viewBox="0 0 40 40" width="@Tamano" height="@Tamano" aria-hidden="true" focusable="false">
        <defs>
            <linearGradient id="@_id" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#4353C9" />
                <stop offset="1" stop-color="#0F766E" />
            </linearGradient>
        </defs>
        <rect width="40" height="40" rx="10" fill="url(#@_id)" />
        <path d="M15.5 15v-2.5a4.5 4.5 0 0 1 9 0V15" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
        <path d="M10.8 15h18.4l-1.35 15.1a2 2 0 0 1-2 1.9H14.15a2 2 0 0 1-2-1.9Z" fill="#fff" />
        <g fill="#3341B0">
            <rect x="14.8" y="19.5" width="1.8" height="8.5" rx=".4" />
            <rect x="17.8" y="19.5" width="1" height="8.5" />
            <rect x="20" y="19.5" width="2.2" height="8.5" rx=".4" />
            <rect x="23.4" y="19.5" width="1" height="8.5" />
        </g>
    </svg>
    @if (ConNombre)
    {
        <span class="bp-logo-nombre">Business<span>Post</span></span>
    }
    else
    {
        <span class="visualmente-oculto">BusinessPost</span>
    }
</span>

@code {
    private readonly string _id = "bp-" + Guid.NewGuid().ToString("N")[..8];

    /// <summary>Lado del símbolo en píxeles; el nombre escala con él.</summary>
    [Parameter]
    public int Tamano { get; set; } = 32;

    [Parameter]
    public bool ConNombre { get; set; } = true;

    /// <summary>Nombre en blanco (sobre la barra de la caja o el menú lateral).</summary>
    [Parameter]
    public bool SobreOscuro { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
