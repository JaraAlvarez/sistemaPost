@inherits LayoutComponentBase
@implements IDisposable
@inject SessionState Session
@inject ApiClient Api
@inject NavigationManager Navigation

<Providers />

@if (!Session.IsSignedIn)
{
    <Redirigir A="/ingresar" />
}
else if (Session.IsTerminal)
{
    <Redirigir A="/caja" />
}
else
{
    <MudLayout>
        <MudAppBar Elevation="1" Dense="true">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawer = !_drawer)" />
            <MudText Typo="Typo.h6" Class="ml-2">POS Supermercado</MudText>
            <MudSpacer />
            <MudText Typo="Typo.body2" Class="mr-3">@Session.Me!.DisplayName</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout" OnClick="SalirAsync">Salir</MudButton>
        </MudAppBar>
        <MudDrawer @bind-Open="_drawer" Elevation="1" ClipMode="DrawerClipMode.Always">
            <MudNavMenu>
                <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Tablero</MudNavLink>
                @if (Session.Has("cash.report.view") || Session.Has("expenses.expense.view") || Session.Has("billing.document.view") || Session.Has("billing.settings.manage") || Session.Me!.Permissions.Any(p => p.StartsWith("reporting.", StringComparison.Ordinal)))
                {
                    <MudNavGroup Title="Ventas y caja" Icon="@Icons.Material.Filled.PointOfSale" Expanded="false">
                        @if (Session.Has("cash.report.view")) { <MudNavLink Href="/admin/jornadas" Icon="@Icons.Material.Filled.EventNote">Jornadas de caja</MudNavLink> }
                        @if (Session.Has("expenses.expense.view")) { <MudNavLink Href="/admin/gastos" Icon="@Icons.Material.Filled.Payments">Gastos</MudNavLink> }
                        @if (Session.Me!.Permissions.Any(p => p.StartsWith("reporting.", StringComparison.Ordinal))) { <MudNavLink Href="/admin/reportes" Icon="@Icons.Material.Filled.Assessment">Reportes</MudNavLink> }
                        @if (Session.Has("billing.document.view") || Session.Has("billing.settings.manage")) { <MudNavLink Href="/admin/facturacion" Icon="@Icons.Material.Filled.ReceiptLong">Facturación electrónica</MudNavLink> }
                    </MudNavGroup>
                }
                @if (Session.Has("catalog.product.view") || Session.Has("inventory.stock.view") || Session.Has("inventory.count.register") || Session.Has("catalog.import.run") || Session.Has("inventory.adjustment.manage"))
                {
                    <MudNavGroup Title="Inventario" Icon="@Icons.Material.Filled.Warehouse" Expanded="false">
                        @if (Session.Has("catalog.product.view")) { <MudNavLink Href="/admin/productos" Icon="@Icons.Material.Filled.Inventory2">Productos y precios</MudNavLink> }
                        @if (Session.Has("inventory.stock.view")) { <MudNavLink Href="/admin/existencias" Icon="@Icons.Material.Filled.Warehouse">Existencias</MudNavLink> }
                        @if (Session.Has("inventory.count.register")) { <MudNavLink Href="/admin/conteos" Icon="@Icons.Material.Filled.FactCheck">Conteos</MudNavLink> }
                        @if (Session.Has("inventory.stock.view")) { <MudNavLink Href="/admin/traslados" Icon="@Icons.Material.Filled.LocalShipping">Traslados</MudNavLink> }
                        @if (Session.Has("inventory.stock.view")) { <MudNavLink Href="/admin/ajustes" Icon="@Icons.Material.Filled.Tune">Ajustes</MudNavLink> }
                        @if (Session.Has("catalog.import.run") || Session.Has("inventory.adjustment.manage")) { <MudNavLink Href="/admin/importar" Icon="@Icons.Material.Filled.UploadFile">Importar desde Excel</MudNavLink> }
                    </MudNavGroup>
                }
                @if (Session.Has("purchasing.purchase.view") || Session.Has("purchasing.supplier.manage") || Session.Has("purchasing.purchase.view") || Session.Has("purchasing.payable.view"))
                {
                    <MudNavGroup Title="Compras y proveedores" Icon="@Icons.Material.Filled.ShoppingCart" Expanded="false">
                        @if (Session.Has("purchasing.purchase.view")) { <MudNavLink Href="/admin/compras" Icon="@Icons.Material.Filled.ShoppingCart">Compras</MudNavLink> }
                        @if (Session.Has("purchasing.purchase.view")) { <MudNavLink Href="/admin/proveedores" Icon="@Icons.Material.Filled.LocalShipping">Proveedores</MudNavLink> }
                        @if (Session.Has("purchasing.payable.view")) { <MudNavLink Href="/admin/cuentas-por-pagar" Icon="@Icons.Material.Filled.AccountBalance">Cuentas por pagar</MudNavLink> }
                    </MudNavGroup>
                }
                @if (Session.Has("customers.customer.view") || Session.Has("promotions.promotion.view"))
                {
                    <MudNavGroup Title="Clientes y promociones" Icon="@Icons.Material.Filled.Groups" Expanded="false">
                        @if (Session.Has("customers.customer.view")) { <MudNavLink Href="/admin/clientes" Icon="@Icons.Material.Filled.Groups">Clientes</MudNavLink> }
                        @if (Session.Has("promotions.promotion.view")) { <MudNavLink Href="/admin/promociones" Icon="@Icons.Material.Filled.LocalOffer">Promociones</MudNavLink> }
                    </MudNavGroup>
                }
                @if (Session.Has("identity.user.view") || Session.Has("organization.company.view") || Session.Has("organization.branch.view") || Session.Has("settings.setting.view") || Session.Has("organization.branch.view") || Session.Has("audit.log.view") || Session.Has("licensing.license.view") || Session.Has("sync.sync.view") || Session.Has("backup.backup.view") || Session.Has("system.update.view"))
                {
                    <MudNavGroup Title="Administración" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
                        @if (Session.Has("identity.user.view")) { <MudNavLink Href="/admin/usuarios" Icon="@Icons.Material.Filled.People">Usuarios</MudNavLink> }
                        @if (Session.Has("organization.company.view") || Session.Has("organization.branch.view") || Session.Has("settings.setting.view")) { <MudNavLink Href="/admin/configuracion" Icon="@Icons.Material.Filled.Settings">Configuración</MudNavLink> }
                        @if (Session.Has("organization.branch.view")) { <MudNavLink Href="/admin/cajas" Icon="@Icons.Material.Filled.Print">Cajas e impresoras</MudNavLink> }
                        @if (Session.Has("audit.log.view")) { <MudNavLink Href="/admin/auditoria" Icon="@Icons.Material.Filled.Policy">Auditoría</MudNavLink> }
                        @if (Session.Has("licensing.license.view")) { <MudNavLink Href="/admin/licencia" Icon="@Icons.Material.Filled.VerifiedUser">Licencia</MudNavLink> }
                        @if (Session.Has("sync.sync.view")) { <MudNavLink Href="/admin/sincronizacion" Icon="@Icons.Material.Filled.CloudSync">Sincronización</MudNavLink> }
                        @if (Session.Has("backup.backup.view")) { <MudNavLink Href="/admin/backups" Icon="@Icons.Material.Filled.Backup">Backups</MudNavLink> }
                        @if (Session.Has("system.update.view")) { <MudNavLink Href="/admin/actualizaciones" Icon="@Icons.Material.Filled.SystemUpdate">Actualizaciones</MudNavLink> }
                    </MudNavGroup>
                }
                <MudDivider Class="my-2" />
                @if (Session.Has("sales.sale.create")) { <MudNavLink Href="/caja" Icon="@Icons.Material.Filled.PointOfSale">Ir a la caja</MudNavLink> }
            </MudNavMenu>
        </MudDrawer>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
                <Avisos />
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool _drawer = true;

    protected override void OnInitialized()
    {
        Session.Changed += StateHasChanged;
        Api.Unauthorized += OnUnauthorized;
    }

    private void OnUnauthorized()
    {
        Session.SignOut();
        Navigation.NavigateTo("/ingresar");
    }

    private async Task SalirAsync()
    {
        try
        {
            await Api.PostAsync("api/v1/auth/logout");
        }
        catch (ApiException)
        {
            // La sesión ya no existía.
        }

        Session.SignOut();
        Navigation.NavigateTo("/ingresar");
    }

    public void Dispose()
    {
        Session.Changed -= StateHasChanged;
        Api.Unauthorized -= OnUnauthorized;
    }
}
