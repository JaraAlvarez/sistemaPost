@* Diseño de la administración (docs/guia-diseno.md §5): menú lateral agrupado y colapsable (Services/Navegacion.cs), encabezado con la
   sucursal, el acceso a la caja, el modo claro/oscuro y el menú del usuario; avisos permanentes arriba del contenido. *@
@inherits LayoutComponentBase
@implements IDisposable
@inject SessionState Session
@inject ApiClient Api
@inject Tema Tema
@inject NavigationManager Navigation

<Providers />

@if (!Session.IsSignedIn)
{
    <Redirigir A="/ingresar" />
}
else if (Session.IsTerminal)
{
    <Redirigir A="/caja" />
}
else
{
    <a class="saltar-contenido" href="@(Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0])#contenido">Saltar al contenido</a>
    <MudLayout Class="bp-admin">
        <MudAppBar Elevation="0" Class="bp-appbar" Fixed="true">
            <MudTooltip Text="@(_compacto ? "Expandir el menú" : "Contraer el menú")">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="AlternarMenuAsync"
                               aria-label="@(_compacto ? "Expandir el menú" : "Contraer el menú")" aria-expanded="@((!_compacto).ToString().ToLowerInvariant())" />
            </MudTooltip>
            <div class="bp-appbar-contexto">
                <MudIcon Icon="@Icons.Material.Outlined.Storefront" Size="Size.Small" aria-hidden="true" />
                <span class="bp-appbar-sucursal">@(_sucursal ?? "Sucursal")</span>
                @if (_empresa is not null)
                {
                    <span class="bp-appbar-empresa">· @_empresa</span>
                }
            </div>
            <MudSpacer />
            @if (Session.Has("sales.sale.create"))
            {
                <MudButton Href="/caja" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PointOfSale" Class="bp-ir-caja mr-2">Ir a la caja</MudButton>
            }
            <MudTooltip Text="@(Tema.EsOscuro ? "Cambiar a modo claro" : "Cambiar a modo oscuro")">
                <MudIconButton Icon="@(Tema.EsOscuro ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" Color="Color.Inherit"
                               OnClick="Tema.AlternarAsync" aria-label="@(Tema.EsOscuro ? "Cambiar a modo claro" : "Cambiar a modo oscuro")" />
            </MudTooltip>
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="ml-1" aria-label="Menú del usuario">
                <ActivatorContent>
                    <div class="bp-usuario" title="@Session.Me!.DisplayName">
                        <span class="bp-avatar" aria-hidden="true">@Iniciales(Session.Me!.DisplayName)</span>
                        <span class="bp-usuario-nombre">@Session.Me!.DisplayName</span>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" aria-hidden="true" />
                    </div>
                </ActivatorContent>
                <ChildContent>
                    <div class="bp-menu-usuario-cabeza">
                        <b>@Session.Me!.DisplayName</b>
                        <span>@Session.Me!.Username</span>
                    </div>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Outlined.Password" Href="/cambiar-clave">Cambiar contraseña</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.LightMode" OnClick="@(() => Tema.ElegirAsync(Tema.Claro))">Modo claro @(Tema.Preferencia == Tema.Claro ? "✓" : null)</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.DarkMode" OnClick="@(() => Tema.ElegirAsync(Tema.Oscuro))">Modo oscuro @(Tema.Preferencia == Tema.Oscuro ? "✓" : null)</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.SettingsBrightness" OnClick="@(() => Tema.ElegirAsync(Tema.Sistema))">Como el sistema @(Tema.Preferencia == Tema.Sistema ? "✓" : null)</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="SalirAsync">Salir</MudMenuItem>
                </ChildContent>
            </MudMenu>
        </MudAppBar>

        <MudDrawer Open="@(!_compacto)" Variant="DrawerVariant.Mini" MiniWidth="68px" Elevation="0" ClipMode="DrawerClipMode.Never" Class="@($"bp-drawer {(_compacto ? "bp-drawer-compacto" : null)}")"
                   OpenMiniOnHover="false" Width="264px" Fixed="true" aria-label="Menú principal">
            <div class="bp-drawer-marca">
                <a href="/admin" aria-label="BusinessPost · ir al tablero"><Logo Tamano="34" ConNombre="@(!_compacto)" SobreOscuro="true" /></a>
            </div>
            <nav class="bp-nav" aria-label="Secciones">
                @if (_compacto)
                {
                    <MudTooltip Text="Tablero" Placement="Placement.Right">
                        <a class="bp-nav-icono @(EsActual("/admin") ? "activo" : null)" href="/admin" aria-label="Tablero" aria-current="@(EsActual("/admin") ? "page" : null)">
                            <MudIcon Icon="@Icons.Material.Outlined.SpaceDashboard" />
                        </a>
                    </MudTooltip>
                    @foreach (var grupo in Navegacion.Grupos.Where(g => g.Visibles(Session).Any()))
                    {
                        <div class="bp-nav-separador" role="separator" aria-label="@grupo.Titulo"></div>
                        @foreach (var opcion in grupo.Visibles(Session))
                        {
                            <MudTooltip Text="@opcion.Titulo" Placement="Placement.Right">
                                <a class="bp-nav-icono @(EsActual(opcion.Ruta) ? "activo" : null)" href="@opcion.Ruta" aria-label="@opcion.Titulo" aria-current="@(EsActual(opcion.Ruta) ? "page" : null)">
                                    <MudIcon Icon="@opcion.Icono" />
                                </a>
                            </MudTooltip>
                        }
                    }
                }
                else
                {
                    <MudNavMenu Class="bp-navmenu" Dense="false">
                        <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.SpaceDashboard">Tablero</MudNavLink>
                        @foreach (var grupo in Navegacion.Grupos.Where(g => g.Visibles(Session).Any()))
                        {
                            <MudNavGroup Title="@grupo.Titulo" Icon="@grupo.Icono" Expanded="@Expandido(grupo)" ExpandedChanged="@(v => _expandidos[grupo.Titulo] = v)">
                                @foreach (var opcion in grupo.Visibles(Session))
                                {
                                    <MudNavLink Href="@opcion.Ruta" Match="NavLinkMatch.Prefix" Icon="@opcion.Icono">@opcion.Titulo</MudNavLink>
                                }
                            </MudNavGroup>
                        }
                    </MudNavMenu>
                }
            </nav>
            <div class="bp-drawer-pie">
                @if (!_compacto)
                {
                    <span>BusinessPost @_version</span>
                }
            </div>
        </MudDrawer>

        <MudMainContent Class="bp-main">
            <main id="contenido" class="bp-contenido" tabindex="-1">
                <AvisoActualizacion />
                <Avisos />
                @Body
            </main>
        </MudMainContent>
    </MudLayout>
}

@code {
    private readonly Dictionary<string, bool> _expandidos = [];
    private readonly string _version = typeof(App).Assembly.GetName().Version is { } v ? $"v{v.Major}.{v.Minor}.{v.Build}" : "";
    private bool _compacto;
    private string? _sucursal, _empresa;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += Refrescar;
        Tema.Changed += Refrescar;
        Api.Unauthorized += OnUnauthorized;
        Navigation.LocationChanged += CambioDeRuta;
        _compacto = Tema.MenuCompacto;

        if (Session.IsSignedIn && !Session.IsTerminal)
        {
            await CargarContextoAsync();
        }
    }

    /// <summary>Nombre de la sucursal y de la empresa para el encabezado (solo si el usuario puede verlos).</summary>
    private async Task CargarContextoAsync()
    {
        try
        {
            if (Session.Has("organization.branch.view"))
            {
                var detalle = await Api.GetAsync<JsonElement>($"api/v1/organization/branches/{Session.Me!.BranchId}");
                _sucursal = detalle.Prop("branch").Str("name") is { Length: > 0 } name ? name : null;
            }

            if (Session.Has("organization.company.view"))
            {
                var empresa = await Api.GetAsync<JsonElement>("api/v1/organization/company");
                _empresa = empresa.Str("tradeName") is { Length: > 0 } comercial ? comercial : empresa.Str("legalName") is { Length: > 0 } legal ? legal : null;
            }
        }
        catch (ApiException)
        {
            // El encabezado se queda con "Sucursal".
        }
        catch (HttpRequestException)
        {
            // Sin conexión: la pantalla informará el error.
        }
    }

    private bool EsActual(string ruta)
    {
        var actual = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        return ruta == "/admin" ? actual == "/admin" : actual.StartsWith(ruta, StringComparison.OrdinalIgnoreCase);
    }

    private bool Expandido(GrupoMenu grupo) =>
        _expandidos.TryGetValue(grupo.Titulo, out var abierto) ? abierto : grupo.Opciones.Any(o => EsActual(o.Ruta));

    private static string Iniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length switch
        {
            0 => "?",
            1 => partes[0][..1].ToUpperInvariant(),
            _ => (partes[0][..1] + partes[^1][..1]).ToUpperInvariant(),
        };
    }

    private async Task AlternarMenuAsync()
    {
        _compacto = !_compacto;
        await Tema.CompactarMenuAsync(_compacto);
    }

    private void Refrescar()
    {
        _compacto = Tema.MenuCompacto;
        InvokeAsync(StateHasChanged);
    }

    private void CambioDeRuta(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private void OnUnauthorized()
    {
        Session.SignOut();
        Navigation.NavigateTo("/ingresar");
    }

    private async Task SalirAsync()
    {
        try
        {
            await Api.PostAsync("api/v1/auth/logout");
        }
        catch (ApiException)
        {
            // La sesión ya no existía.
        }

        Session.SignOut();
        Navigation.NavigateTo("/ingresar");
    }

    public void Dispose()
    {
        Session.Changed -= Refrescar;
        Tema.Changed -= Refrescar;
        Api.Unauthorized -= OnUnauthorized;
        Navigation.LocationChanged -= CambioDeRuta;
    }
}
