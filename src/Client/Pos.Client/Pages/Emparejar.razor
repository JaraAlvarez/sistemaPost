@page "/emparejar"
@layout EmptyLayout
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>Emparejar equipo · BusinessPost</PageTitle>

<PantallaAcceso Titulo="Emparejar este equipo" Ayuda="Conecte esta caja con el servidor de la tienda. Solo se hace una vez por equipo.">
    <ol class="pasos-emparejar">
        <li>En la administración, vaya a <b>Cajas e impresoras</b> y genere un <b>código de emparejamiento</b> para esta caja.</li>
        <li>El administrador le muestra la huella del certificado del servidor: compruebe que coincide con la del navegador.</li>
        <li>Escriba el código y el nombre de este equipo.</li>
    </ol>
    <EditForm Model="this" OnSubmit="EmparejarAsync">
        <MudTextField @bind-Value="_code" Label="Código de emparejamiento" Variant="Variant.Outlined" Immediate="true" AutoFocus="true" autocomplete="off" Class="mt-2"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Key" />
        <MudTextField @bind-Value="_name" Label="Nombre de este equipo" Variant="Variant.Outlined" Immediate="true" Placeholder="CAJA-02" Class="mt-3"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Computer" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Class="mt-5"
                   Disabled="@(_busy || string.IsNullOrWhiteSpace(_code))" StartIcon="@Icons.Material.Outlined.Link">@(_busy ? "Emparejando…" : "Emparejar")</MudButton>
        <MudButton Variant="Variant.Text" FullWidth="true" Class="mt-2" Href="/ingresar">Volver</MudButton>
    </EditForm>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4" role="alert">@_error</MudAlert>
    }
</PantallaAcceso>

@code {
    private string? _code, _name, _error;
    private bool _busy;

    private async Task EmparejarAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            // Huella del equipo: aleatoria y guardada con la credencial (el navegador no puede leer el hardware).
            var fingerprint = Convert.ToHexStringLower(System.Security.Cryptography.RandomNumberGenerator.GetBytes(32));
            var agent = await Js.InvokeAsync<string>("pos.userAgent");
            var device = await Api.PostAsync<DeviceCredential>("api/v1/devices/pair", new
            {
                code = _code?.Trim(), hostname = string.IsNullOrWhiteSpace(_name) ? "CAJA" : _name.Trim(), machineFingerprintHash = fingerprint,
                osVersion = agent.Length > 100 ? agent[..100] : agent, appVersion = typeof(App).Assembly.GetName().Version?.ToString() ?? "1.0.0",
            });
            await Session.SaveDeviceAsync(device);
            Navigation.NavigateTo("/ingresar");
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }
        finally
        {
            _busy = false;
        }
    }
}
