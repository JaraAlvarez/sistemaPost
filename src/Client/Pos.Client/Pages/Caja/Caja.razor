@page "/caja"
@layout EmptyLayout
@implements IAsyncDisposable

<PageTitle>Caja · BusinessPost</PageTitle>

@if (!Session.IsSignedIn)
{
    <Redirigir A="/ingresar" />
}
else if (!Session.IsTerminal)
{
    <div class="acceso">
        <div class="acceso-marca">
            <Logo Tamano="40" SobreOscuro="true" />
            <div>
                <p class="acceso-lema">La caja se abre con el código del cajero.</p>
                <p class="acceso-texto">Así cada venta, cada jornada y cada arqueo quedan a nombre de quien cobra.</p>
            </div>
            <div class="acceso-pie">BusinessPost · caja</div>
        </div>
        <div class="acceso-formulario">
            <div class="acceso-tarjeta bp-tarjeta pa-8">
                <MudText Typo="Typo.h5" HtmlTag="h1">Para vender, entre como cajero</MudText>
                <p class="acceso-ayuda">Usted entró a la administración. Salga y entre con su código y PIN de cajero en un equipo de caja.</p>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" StartIcon="@Icons.Material.Outlined.PointOfSale" OnClick="SalirAsync">Entrar con código de caja</MudButton>
                <MudButton Variant="Variant.Text" FullWidth="true" Class="mt-2" Href="/admin">Volver a la administración</MudButton>
            </div>
        </div>
    </div>
}
else
{
    <div class="caja">
        @* ------------------------------------------------------------------------------------------------ Barra superior *@
        <header class="caja-barra">
            <Logo Tamano="28" SobreOscuro="true" ConNombre="false" />
            <div class="caja-barra-dato">
                <small>Caja</small>
                <b>@(_session?.TerminalCode ?? "—")</b>
            </div>
            <div class="caja-barra-dato">
                <small>Jornada</small>
                <b>@(_session is null ? "Sin abrir" : _session.Number)</b>
            </div>
            <div class="caja-barra-dato opcional">
                <small>Cajero</small>
                <b>@Session.Me!.DisplayName</b>
            </div>
            <span class="espacio"></span>
            @if (_offline)
            {
                <span class="caja-estado error" role="status"><span class="punto"></span>Sin conexión</span>
            }
            else
            {
                <span class="caja-estado ok" title="Conectado con el servidor de la tienda"><span class="punto"></span>En línea</span>
            }
            @if (Session.Me.License is { State: not "VALID" and not "VALID_OFFLINE" } license)
            {
                <span class="caja-estado @(license.State is "RESTRICTED" or "REACTIVATION_REQUIRED" ? "error" : "alerta")">
                    <MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" Size="Size.Small" />@EstadoLicencia(license)
                </span>
            }
            @if (_heldCount > 0)
            {
                <button type="button" class="caja-estado info" style="border:0;cursor:pointer" @onclick="VerSuspendidasAsync" title="Ver ventas suspendidas (F9)">
                    <MudIcon Icon="@Icons.Material.Outlined.PauseCircle" Size="Size.Small" />@_heldCount suspendida@(_heldCount == 1 ? "" : "s")
                </button>
            }
            <span class="caja-reloj" aria-label="Hora">@_ahora.ToString("HH:mm", Format.Colombia)</span>
            @if (_lastReceipt is not null)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Print" OnClick="ReimprimirAsync" Disabled="_busy" title="Reimprimir la última venta"><span class="texto-boton">Reimprimir</span></MudButton>
            }
            @if (_session is not null && _session.Status == "OPEN")
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.LockClock" OnClick="IniciarCierreAsync" Disabled="_busy" title="Cerrar jornada"><span class="texto-boton">Cerrar jornada</span></MudButton>
            }
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Logout" OnClick="SalirAsync" title="Salir"><span class="texto-boton">Salir</span></MudButton>
        </header>

        @* ------------------------------------------------------------------------------------------------ Avisos *@
        <div class="caja-avisos" aria-live="polite">
            @if (_offline)
            {
                <div class="caja-aviso error">
                    <MudIcon Icon="@Icons.Material.Outlined.CloudOff" />
                    Sin conexión con el servidor de la tienda. La venta en curso no se pierde; se reintenta cada 15 segundos. Si sigue así, avise al administrador.
                </div>
            }
            @if (Session.Me.License is { State: "RESTRICTED" or "REACTIVATION_REQUIRED" })
            {
                <div class="caja-aviso alerta">
                    <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" />
                    La licencia está restringida: algunas funciones pueden no estar disponibles. Avise al administrador.
                </div>
            }
            else if (Session.Me.License is { State: "DEMO" } demo)
            {
                <div class="caja-aviso info">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" />
                    Modo demostración: quedan @demo.DaysLeft días. Las ventas son reales; active la licencia desde la administración.
                </div>
            }
        </div>
        <div class="caja-progreso @(_busy ? "activo" : null)" aria-hidden="true"></div>

        @* ------------------------------------------------------------------------------------------------ Escáner y líneas *@
        <section class="caja-izquierda" aria-label="Venta en curso">
            <div class="caja-escaner">
                <MudTextField @ref="_scanner" T="string" @bind-Value="_scan" Placeholder="Escanee o escriba el código de barras, PLU o SKU"
                              Variant="Variant.Outlined" Immediate="true" OnKeyDown="EscanerTeclaAsync" Disabled="@(_session is null || _busy)" AutoFocus="true" id="escaner"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.QrCodeScanner" AdornmentAriaLabel="Escáner"
                              aria-label="Código del producto. Cantidad por código: 3*código" autocomplete="off" spellcheck="false" FullWidth="true" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Search" OnClick="AbrirBuscar" Disabled="@(_session is null)">
                    Buscar&nbsp;<kbd>F2</kbd>
                </MudButton>
            </div>
            <div class="caja-lineas">
                @if (_loading)
                {
                    <div class="caja-vacia"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /><b>Preparando la caja…</b></div>
                }
                else if (_session is null)
                {
                    <div class="caja-vacia">
                        <MudIcon Icon="@Icons.Material.Outlined.LockOpen" />
                        <b>Sin jornada abierta</b>
                        <span>Cuente la base del cajón y abra la jornada para empezar a vender.</span>
                    </div>
                }
                else if (_sale is null || !_sale.Lines.Any())
                {
                    <div class="caja-vacia">
                        <MudIcon Icon="@Icons.Material.Outlined.QrCodeScanner" />
                        <b>Lista para vender</b>
                        <span>Escanee un producto o escriba su código y pulse Enter. Para varias unidades: <kbd>3</kbd>&nbsp;*&nbsp;código.</span>
                    </div>
                }
                else
                {
                    <table aria-label="Productos de la venta">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Producto</th>
                                <th scope="col" class="num">Cant.</th>
                                <th scope="col" class="num">Precio</th>
                                <th scope="col" class="num">Descuento</th>
                                <th scope="col" class="num">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in _sale.Lines)
                            {
                                var descuento = line.PromotionDiscount + line.LineDiscount;
                                <tr id="linea-@line.Id" class="@(line.Status != "ACTIVE" ? "anulada" : line.Id == _selected ? "seleccion" : null) @(line.Id == _nueva ? "nueva" : null)"
                                    @onclick="@(() => Seleccionar(line))" aria-selected="@(line.Id == _selected ? "true" : "false")">
                                    <td class="linea-no">@line.LineNo</td>
                                    <td>
                                        <div class="linea-nombre">@line.Name</div>
                                        <div class="linea-detalle">
                                            <span>@line.Sku</span>
                                            @if (line.PromotionName is not null)
                                            {
                                                <span class="etiqueta promo"><MudIcon Icon="@Icons.Material.Outlined.LocalOffer" Style="font-size:14px" />@line.PromotionName</span>
                                            }
                                            @if (line.LineDiscount > 0)
                                            {
                                                <span class="etiqueta promo">Descuento manual</span>
                                            }
                                            @if (line.Status != "ACTIVE")
                                            {
                                                <span class="etiqueta neutra">Anulada</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="num linea-cantidad">@Format.Quantity(line.Quantity)</td>
                                    <td class="num">@Format.Money(line.UnitPrice)</td>
                                    <td class="num linea-descuento">@(descuento == 0 ? "" : Format.Money(-descuento))</td>
                                    <td class="num linea-total">@Format.Money(line.Total)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </section>

        @* ------------------------------------------------------------------------------------------------ Total y acciones *@
        <aside class="caja-lateral" aria-label="Total y acciones">
            @if (!HayLineas && _lastChange is { } change && _lastReceipt is not null)
            {
                <div class="caja-resultado" role="status" aria-live="assertive">
                    <div class="caja-resultado-titulo"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" />Venta @_lastReceipt.Sale.Number cobrada</div>
                    <div class="caja-subtotal mt-1"><span>Total</span><b>@Format.Money(_lastReceipt.Sale.Total)</b></div>
                    <div class="caja-subtotal"><span>Recibido</span><b>@Format.Money(_lastReceipt.Sale.Payments.Sum(p => p.Tendered))</b></div>
                    <div class="caja-total-etiqueta mt-2" style="color:inherit"><span>Cambio</span></div>
                    <div class="caja-cambio">@Format.Money(change)</div>
                    @if (EstadoFiscal() is { } fiscal)
                    {
                        <div class="caja-resultado-fiscal"><span class="etiqueta @(fiscal.Tono == "exito" ? "promo" : fiscal.Tono == "info" ? "neutra" : "alerta")"><MudIcon Icon="@fiscal.Icono" Style="font-size:14px" />@fiscal.Texto</span></div>
                    }
                </div>
            }

            @if (HayLineas || _lastChange is null)
            {
                <div class="caja-total-caja">
                    <div class="caja-total-etiqueta">
                        <span>Total a pagar</span>
                        <span>@(_sale?.ActiveLines.Sum(l => l.Quantity).ToString("0.###", Format.Colombia) ?? "0") art.</span>
                    </div>
                    <div class="caja-total" aria-live="polite">@Format.Money(_sale?.AmountDue ?? 0)</div>
                </div>
            }

            <div class="caja-desglose">
                <div class="caja-subtotal"><span>Subtotal</span><span>@Format.Money(_sale?.Subtotal ?? 0)</span></div>
                <div class="caja-subtotal"><span>Impuestos</span><span>@Format.Money(_sale?.TaxTotal ?? 0)</span></div>
                @if ((_sale?.PromotionTotal ?? 0) + (_sale?.DiscountTotal ?? 0) > 0)
                {
                    <div class="caja-subtotal ahorro"><span>Ahorro del cliente</span><span>@Format.Money(-((_sale?.PromotionTotal ?? 0) + (_sale?.DiscountTotal ?? 0)))</span></div>
                }
                @if ((_sale?.RoundingAdjustment ?? 0) != 0)
                {
                    <div class="caja-subtotal"><span>Redondeo</span><span>@Format.Money(_sale!.RoundingAdjustment)</span></div>
                }
            </div>

            <div class="caja-cliente">
                <MudIcon Icon="@Icons.Material.Outlined.Person" />
                <div style="flex:1;min-width:0">
                    @if (_sale?.Customer is { PartyId: not null } cliente)
                    {
                        <b>@cliente.Name</b>
                        <small>@cliente.IdentificationType @cliente.Identification</small>
                    }
                    else
                    {
                        <b>Consumidor final</b>
                        <small>Sin cliente asignado</small>
                    }
                </div>
            </div>

            @foreach (var warning in _sale?.Warnings ?? [])
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined">@warning</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" FullWidth="true" Class="caja-cobrar" Disabled="@(!HayLineas || _busy)" OnClick="AbrirCobro">
                Cobrar <kbd>F10</kbd>
            </MudButton>

            <div class="caja-acciones">
                <MudButton Class="caja-accion" Variant="Variant.Outlined" Disabled="@(_session is null)" OnClick="AbrirCliente">
                    <span class="accion-texto"><MudIcon Icon="@Icons.Material.Outlined.PersonSearch" Size="Size.Small" />Cliente</span><kbd>F3</kbd>
                </MudButton>
                <MudButton Class="caja-accion" Variant="Variant.Outlined" Disabled="@(_selected is null)" OnClick="AbrirCantidad">
                    <span class="accion-texto"><MudIcon Icon="@Icons.Material.Outlined.Numbers" Size="Size.Small" />Cantidad</span><kbd>F4</kbd>
                </MudButton>
                <MudButton Class="caja-accion" Variant="Variant.Outlined" Disabled="@(!HayLineas)" OnClick="AbrirDescuento">
                    <span class="accion-texto"><MudIcon Icon="@Icons.Material.Outlined.Percent" Size="Size.Small" />Descuento</span><kbd>F6</kbd>
                </MudButton>
                <MudButton Class="caja-accion" Variant="Variant.Outlined" Color="Color.Error" Disabled="@(_selected is null)" OnClick="AnularLineaAsync">
                    <span class="accion-texto"><MudIcon Icon="@Icons.Material.Outlined.RemoveShoppingCart" Size="Size.Small" />Anular línea</span><kbd>Supr</kbd>
                </MudButton>
                <MudButton Class="caja-accion" Variant="Variant.Outlined" Disabled="@(!HayLineas)" OnClick="SuspenderAsync">
                    <span class="accion-texto"><MudIcon Icon="@Icons.Material.Outlined.PauseCircle" Size="Size.Small" />Suspender</span><kbd>F8</kbd>
                </MudButton>
                <MudButton Class="caja-accion" Variant="Variant.Outlined" Disabled="@(_session is null)" OnClick="VerSuspendidasAsync">
                    <span class="accion-texto"><MudIcon Icon="@Icons.Material.Outlined.PlayCircle" Size="Size.Small" />Recuperar</span><kbd>F9</kbd>
                </MudButton>
                <MudButton Class="caja-accion" Variant="Variant.Outlined" Color="Color.Error" Disabled="@(_sale is null)" OnClick="PedirCancelarVenta" Style="grid-column: 1 / -1">
                    <span class="accion-texto"><MudIcon Icon="@Icons.Material.Outlined.DeleteSweep" Size="Size.Small" />Cancelar venta</span><kbd>F7</kbd>
                </MudButton>
            </div>
        </aside>

        <footer class="caja-pie">
            <span><kbd>↑</kbd><kbd>↓</kbd> elegir línea</span>
            <span><kbd>3</kbd>*código varias unidades</span>
            <span><kbd>Esc</kbd> cerrar ventana</span>
            <span><kbd>F1</kbd> todos los atajos</span>
        </footer>
    </div>

    @* ---------------------------------------------------------------- Abrir jornada *@
    @if (_session is null && !_loading)
    {
        <div class="panel-fondo">
            <div class="panel" role="dialog" aria-modal="true" aria-labelledby="t-abrir">
                <h2 id="t-abrir">Abrir jornada</h2>
                <MudText Typo="Typo.body2" Class="mb-3">Cuente el efectivo inicial del cajón (la base) y escriba cuántos billetes y monedas hay de cada valor.</MudText>
                <Conteo Denominaciones="_cashDenominations" Cantidades="_opening" OnChanged="@(() => StateHasChanged())" />
                <div class="conteo-total"><span>Base del cajón</span><span class="cifra">@Format.Money(Total(_opening))</span></div>
                <div class="acciones">
                    <MudButton Variant="Variant.Text" OnClick="SalirAsync">Salir</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Disabled="_busy" OnClick="AbrirJornadaAsync" StartIcon="@Icons.Material.Outlined.LockOpen">Abrir jornada</MudButton>
                </div>
            </div>
        </div>
    }

    @* ---------------------------------------------------------------- Buscar producto (F2) *@
    @if (_panel == Panel.Buscar)
    {
        <div class="panel-fondo">
            <div class="panel" style="width:min(680px, 96vw)" role="dialog" aria-modal="true" aria-labelledby="t-buscar">
                <h2 id="t-buscar">Buscar producto</h2>
                <MudTextField T="string" @bind-Value="_search" Label="Nombre, SKU o código" Variant="Variant.Outlined" Immediate="true" DebounceInterval="300"
                              OnDebounceIntervalElapsed="BuscarAsync" AutoFocus="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
                @if (_buscando)
                {
                    <MudProgressLinear Indeterminate="true" Class="mt-2" />
                }
                <div class="lista-elegir">
                    @foreach (var product in _found)
                    {
                        <button type="button" @onclick="@(() => AgregarProductoAsync(product))">
                            <span><b>@product.Str("name")</b><small>@product.Str("sku") @(product.Str("primaryBarcode") is { Length: > 0 } barcode ? $"· {barcode}" : null)</small></span>
                            @if (product.Str("price").Length > 0)
                            {
                                <span class="precio">@Format.Money(product.Dec("price"))</span>
                            }
                        </button>
                    }
                </div>
                @if (!_buscando && _found.Count == 0 && (_search?.Length ?? 0) >= 2)
                {
                    <EstadoVacio Mensaje="No encontramos productos con ese texto." Detalle="Pruebe con otra parte del nombre o con el código." Compacto="true" />
                }
                <div class="acciones"><MudButton OnClick="CerrarPanel">Cerrar <kbd class="ml-2">Esc</kbd></MudButton></div>
            </div>
        </div>
    }

    @* ---------------------------------------------------------------- Cantidad (F4) *@
    @if (_panel == Panel.Cantidad)
    {
        <div class="panel-fondo">
            <div class="panel" style="width:min(440px, 96vw)" role="dialog" aria-modal="true" aria-labelledby="t-cantidad">
                <h2 id="t-cantidad">Cambiar cantidad</h2>
                <MudText Typo="Typo.body2" Class="mb-2">@LineaSeleccionada?.Name</MudText>
                <MudNumericField T="decimal" @bind-Value="_quantity" Min="0.001m" AutoFocus="true" Label="Nueva cantidad" Variant="Variant.Outlined" Class="cobro-valor"
                                 Immediate="true" OnKeyDown="CantidadTeclaAsync" HideSpinButtons="true" />
                <div class="acciones">
                    <MudButton OnClick="CerrarPanel">Cancelar</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CambiarCantidadAsync">Aplicar <kbd class="ml-2">Enter</kbd></MudButton>
                </div>
            </div>
        </div>
    }

    @* ---------------------------------------------------------------- Cliente (F3) *@
    @if (_panel == Panel.Cliente)
    {
        <div class="panel-fondo">
            <div class="panel" style="width:min(620px, 96vw)" role="dialog" aria-modal="true" aria-labelledby="t-cliente">
                <h2 id="t-cliente">Cliente de la venta</h2>
                <MudText Typo="Typo.body2" Class="mb-2">Busque por cédula/NIT, nombre o celular. Con cliente, la venta usa sus precios y puede salir con factura a su nombre.</MudText>
                <MudTextField T="string" @bind-Value="_customerSearch" Label="Cédula, NIT, nombre o celular" Variant="Variant.Outlined" Immediate="true" DebounceInterval="350"
                              OnDebounceIntervalElapsed="BuscarClienteAsync" AutoFocus="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.PersonSearch" />
                @if (_customerError is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_customerError</MudAlert>
                }
                <div class="lista-elegir">
                    <button type="button" @onclick="@(() => AsignarClienteAsync(null))">
                        <span><b>Consumidor final</b><small>Venta sin cliente</small></span>
                        <MudIcon Icon="@Icons.Material.Outlined.PersonOff" />
                    </button>
                    @foreach (var customer in _customers)
                    {
                        <button type="button" @onclick="@(() => AsignarClienteAsync(customer.GetProperty("partyId").GetGuid()))">
                            <span><b>@customer.Str("displayName")</b><small>@customer.Str("identificationType") @customer.Str("identificationNumber") @(customer.Str("phone") is { Length: > 0 } phone ? $"· {phone}" : null)</small></span>
                            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" />
                        </button>
                    }
                </div>
                @if (_customers.Count == 0 && _customerError is null && (_customerSearch?.Length ?? 0) >= 2)
                {
                    <EstadoVacio Mensaje="No encontramos clientes con ese dato." Detalle="Revise la cédula o el NIT. Los clientes nuevos se crean en la administración (Clientes)." Compacto="true" />
                }
                <div class="acciones"><MudButton OnClick="CerrarPanel">Cerrar <kbd class="ml-2">Esc</kbd></MudButton></div>
            </div>
        </div>
    }

    @* ---------------------------------------------------------------- Descuento (F6) *@
    @if (_panel == Panel.Descuento)
    {
        <div class="panel-fondo">
            <div class="panel" style="width:min(520px, 96vw)" role="dialog" aria-modal="true" aria-labelledby="t-descuento">
                <h2 id="t-descuento">Descuento</h2>
                <MudText Typo="Typo.body2" Class="mb-2">Queda registrado con el motivo; si su usuario no puede darlo, se pide la autorización de un supervisor.</MudText>
                <MudToggleGroup T="bool" @bind-Value="_descuentoVenta" Color="Color.Primary" FixedContent="true" Class="mb-3" Style="width:100%">
                    <MudToggleItem Value="false" Disabled="@(_selected is null)">A la línea seleccionada</MudToggleItem>
                    <MudToggleItem Value="true">A toda la venta</MudToggleItem>
                </MudToggleGroup>
                @if (!_descuentoVenta && LineaSeleccionada is { } seleccionada)
                {
                    <MudText Typo="Typo.body2" Class="mb-2"><b>@seleccionada.Name</b> · @Format.Money(seleccionada.Total)</MudText>
                }
                <MudToggleGroup T="bool" @bind-Value="_descuentoPorcentaje" Color="Color.Secondary" FixedContent="true" Class="mb-3" Style="width:100%">
                    <MudToggleItem Value="true">Porcentaje (%)</MudToggleItem>
                    <MudToggleItem Value="false">Valor en pesos ($)</MudToggleItem>
                </MudToggleGroup>
                <MudNumericField T="decimal" @bind-Value="_descuentoValor" Min="0" Max="@(_descuentoPorcentaje ? 100m : decimal.MaxValue)" AutoFocus="true" Variant="Variant.Outlined" Class="cobro-valor"
                                 Label="@(_descuentoPorcentaje ? "Porcentaje" : "Valor")" HideSpinButtons="true" Immediate="true"
                                 Adornment="Adornment.End" AdornmentText="@(_descuentoPorcentaje ? "%" : "$")" />
                <MudTextField @bind-Value="_descuentoMotivo" Label="Motivo (obligatorio)" Variant="Variant.Outlined" Immediate="true" Class="mt-2" />
                <div class="acciones">
                    <MudButton OnClick="CerrarPanel">Cancelar</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || _descuentoValor <= 0 || string.IsNullOrWhiteSpace(_descuentoMotivo))" OnClick="AplicarDescuentoAsync">Aplicar descuento</MudButton>
                </div>
            </div>
        </div>
    }

    @* ---------------------------------------------------------------- Cobro (F10) *@
    @if (_panel == Panel.Cobro && _sale is not null)
    {
        var diferencia = _sale.AmountDue - PagadoConEscrito;
        <div class="panel-fondo">
            <div class="panel cobro" role="dialog" aria-modal="true" aria-labelledby="t-cobro">
                <h2 id="t-cobro">Cobrar</h2>
                <div class="cobro-cuerpo">
                    <div class="cobro-cifras">
                        <div class="cobro-cifra total"><small>Total a pagar</small><b>@Format.Money(_sale.AmountDue)</b></div>
                        <div class="cobro-cifra"><small>Recibido</small><b>@Format.Money(PagadoConEscrito)</b></div>
                        <div class="cobro-cifra @(diferencia <= 0 ? "cambio" : "falta")" aria-live="polite">
                            <small>@(diferencia <= 0 ? "Cambio" : "Falta")</small>
                            <b>@Format.Money(Math.Abs(diferencia))</b>
                        </div>
                        @if (_payments.Count > 0)
                        {
                            <div class="cobro-pagos">
                                @foreach (var payment in _payments)
                                {
                                    <div class="cobro-pago">
                                        <span>@_methods.First(m => m.Id == payment.PaymentMethodId).Name @(payment.Reference is null ? null : $"({payment.Reference})")</span>
                                        <span>
                                            <b>@Format.Money(payment.Amount)</b>
                                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close" OnClick="@(() => _payments.Remove(payment))" aria-label="Quitar este pago" />
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Medio de pago</MudText>
                        <div class="cobro-medios" role="group" aria-label="Medios de pago">
                            @foreach (var method in _methods)
                            {
                                <MudButton Class="cobro-medio" Variant="@(method == _methodSelected ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
                                           OnClick="@(() => AgregarPago(method))" aria-pressed="@(method == _methodSelected ? "true" : "false")">
                                    <MudIcon Icon="@IconoMedio(method)" />@method.Name
                                </MudButton>
                            }
                        </div>
                        <MudNumericField T="decimal" @bind-Value="_amount" Label="@($"Valor recibido en {_methodSelected?.Name ?? "el medio elegido"} (Enter confirma)")" Min="0" Class="mt-3 cobro-valor"
                                         Variant="Variant.Outlined" AutoFocus="true" Immediate="true" OnKeyDown="CobroTeclaAsync" HideSpinButtons="true" Culture="@Format.Colombia" Format="#,##0.##"
                                         Adornment="Adornment.Start" AdornmentText="$" />
                        @if (_methodSelected?.AffectsCashDrawer == true)
                        {
                            <div class="cobro-rapidos" role="group" aria-label="Valores rápidos">
                                @foreach (var valor in ValoresRapidos())
                                {
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => UsarValor(valor))">@Format.Money(valor)</MudButton>
                                }
                            </div>
                        }
                        @if (_methodSelected?.RequiresReference == true)
                        {
                            <MudTextField @bind-Value="_reference" Label="Referencia (aprobación del datáfono)" Variant="Variant.Outlined" Immediate="true" Class="mt-2" />
                        }
                        <MudText Typo="Typo.caption" Class="d-block mt-2 texto-secundario">Pago mixto: escriba el valor, pulse otra vez el medio para agregarlo y elija el siguiente.</MudText>
                    </div>
                </div>
                <div class="acciones">
                    <MudButton OnClick="CerrarPanel" Size="Size.Large">Volver <kbd class="ml-2">Esc</kbd></MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" Disabled="@(_busy || PagadoConEscrito < _sale.AmountDue)" OnClick="CobrarAsync"
                               StartIcon="@Icons.Material.Outlined.CheckCircle">Confirmar cobro <kbd class="ml-2">F10</kbd></MudButton>
                </div>
            </div>
        </div>
    }

    @* ---------------------------------------------------------------- Suspendidas (F9) *@
    @if (_panel == Panel.Suspendidas)
    {
        <div class="panel-fondo">
            <div class="panel" role="dialog" aria-modal="true" aria-labelledby="t-suspendidas">
                <h2 id="t-suspendidas">Ventas suspendidas</h2>
                @if (_held.Count == 0)
                {
                    <EstadoVacio Mensaje="No hay ventas suspendidas en esta caja." Detalle="Suspenda una venta con F8 para atender a otro cliente y recupérela aquí." Compacto="true" />
                }
                <div class="lista-elegir">
                    @foreach (var held in _held)
                    {
                        <button type="button" @onclick="@(() => RecuperarAsync(held))">
                            <span><b>@(held.HoldLabel ?? "Sin nombre")</b><small>@Format.Date(held.OpenedAt) · @held.CustomerName</small></span>
                            <span class="precio">@Format.Money(held.Total)</span>
                        </button>
                    }
                </div>
                <div class="acciones"><MudButton OnClick="CerrarPanel">Cerrar <kbd class="ml-2">Esc</kbd></MudButton></div>
            </div>
        </div>
    }

    @* ---------------------------------------------------------------- Cancelar venta (F7) *@
    @if (_panel == Panel.CancelarVenta && _sale is not null)
    {
        <div class="panel-fondo">
            <div class="panel" style="width:min(460px, 96vw)" role="alertdialog" aria-modal="true" aria-labelledby="t-cancelar">
                <h2 id="t-cancelar">¿Cancelar la venta?</h2>
                <MudText>Se quitan los @_sale.ActiveLines.Count() producto(s) por @Format.Money(_sale.Total). Queda registrado en la auditoría y puede pedir la autorización de un supervisor.</MudText>
                <div class="acciones">
                    <MudButton OnClick="CerrarPanel" Size="Size.Large" autofocus>No, seguir vendiendo</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Large" Disabled="_busy" OnClick="CancelarVentaAsync">Sí, cancelar venta</MudButton>
                </div>
            </div>
        </div>
    }

    @* ---------------------------------------------------------------- Autorización de supervisor *@
    @if (_panel == Panel.Supervisor && _pending is not null)
    {
        <div class="panel-fondo">
            <div class="panel" style="width:min(480px, 96vw)" role="dialog" aria-modal="true" aria-labelledby="t-supervisor">
                <h2 id="t-supervisor">Autorización de supervisor</h2>
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Outlined.AdminPanelSettings">@_pending.Error.Message</MudAlert>
                <MudTextField @bind-Value="_supervisorCode" Label="Código del supervisor" InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true" AutoFocus="true" autocomplete="off" />
                <MudTextField @bind-Value="_supervisorPin" Label="PIN" InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true" Class="mt-2" OnKeyDown="SupervisorTeclaAsync" autocomplete="off" />
                <MudTextField @bind-Value="_supervisorReason" Label="Motivo (opcional)" Variant="Variant.Outlined" Immediate="true" Class="mt-2" OnKeyDown="SupervisorTeclaAsync" />
                <div class="acciones">
                    <MudButton OnClick="CerrarPanel">Cancelar</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="AutorizarAsync" StartIcon="@Icons.Material.Outlined.VerifiedUser">Autorizar</MudButton>
                </div>
            </div>
        </div>
    }

    @* ---------------------------------------------------------------- Ayuda (F1) *@
    @if (_panel == Panel.Ayuda)
    {
        <div class="panel-fondo">
            <div class="panel" style="width:min(640px, 96vw)" role="dialog" aria-modal="true" aria-labelledby="t-ayuda">
                <h2 id="t-ayuda">Atajos de la caja</h2>
                <div class="atajos">
                    <div><kbd>Enter</kbd>Agregar el código escrito</div>
                    <div><kbd>3*</kbd>Varias unidades: 3*código</div>
                    <div><kbd>↑ ↓</kbd>Elegir línea</div>
                    <div><kbd>F2</kbd>Buscar producto</div>
                    <div><kbd>F3</kbd>Cliente de la venta</div>
                    <div><kbd>F4</kbd>Cambiar cantidad</div>
                    <div><kbd>F6</kbd>Descuento</div>
                    <div><kbd>F7</kbd>Cancelar venta</div>
                    <div><kbd>F8</kbd>Suspender venta</div>
                    <div><kbd>F9</kbd>Recuperar suspendida</div>
                    <div><kbd>F10</kbd>Cobrar / confirmar cobro</div>
                    <div><kbd>Supr</kbd>Anular línea</div>
                    <div><kbd>Esc</kbd>Cerrar ventana</div>
                    <div><kbd>F1</kbd>Esta ayuda</div>
                </div>
                <div class="acciones"><MudButton OnClick="CerrarPanel" autofocus>Entendido</MudButton></div>
            </div>
        </div>
    }

    @* ---------------------------------------------------------------- Cierre de jornada *@
    @if (_panel == Panel.Cierre)
    {
        <div class="panel-fondo">
            <div class="panel" style="width:min(640px, 96vw)" role="dialog" aria-modal="true" aria-labelledby="t-cierre">
                @if (_zReport is null)
                {
                    <h2 id="t-cierre">Cerrar jornada @_session?.Number</h2>
                    <MudText Typo="Typo.body2" Class="mb-3">Arqueo ciego: cuente el efectivo del cajón por denominación y escriba el total de los demás medios. El sistema compara al confirmar.</MudText>
                    <Conteo Denominaciones="_cashDenominations" Cantidades="_closing" OnChanged="@(() => StateHasChanged())" />
                    <div class="conteo-total mb-3"><span>Efectivo contado</span><span class="cifra">@Format.Money(Total(_closing))</span></div>
                    <MudGrid Spacing="2">
                        @foreach (var method in _methods.Where(m => !m.AffectsCashDrawer))
                        {
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal" Value="@_closingOthers.GetValueOrDefault(method.Id)" ValueChanged="@(v => _closingOthers[method.Id] = v)" Label="@method.Name" Min="0"
                                                 Variant="Variant.Outlined" HideSpinButtons="true" Adornment="Adornment.Start" AdornmentText="$" />
                            </MudItem>
                        }
                    </MudGrid>
                    <MudTextField @bind-Value="_closingNote" Label="Nota sobre la diferencia (si la hay)" Variant="Variant.Outlined" Immediate="true" Class="mt-2" Lines="2" />
                    <div class="acciones">
                        <MudButton OnClick="CancelarCierreAsync">Volver a vender</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Disabled="_busy" OnClick="CerrarJornadaAsync" StartIcon="@Icons.Material.Outlined.LockClock">Confirmar cierre</MudButton>
                    </div>
                }
                else
                {
                    <h2 id="t-cierre">Jornada cerrada · Reporte Z</h2>
                    <MudText Typo="Typo.body2" Class="mb-2">La jornada quedó cerrada y sellada. Guarde el reporte con el efectivo.</MudText>
                    <div class="tiquete">@_zReport.Text</div>
                    <div class="acciones"><MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="SalirAsync">Terminar</MudButton></div>
                }
            </div>
        </div>
    }
}
