@page "/admin"
@using Pos.Modules.Billing.Contracts
@using Pos.Modules.Reporting.Contracts
@inject ApiClient Api
@inject SessionState Session

<PageTitle>Tablero · BusinessPost</PageTitle>

<Pagina Titulo="@Saludo()" Subtitulo="@Subtitulo()" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (_puedeVer)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Refresh" OnClick="CargarAsync" Disabled="_loading">Actualizar</MudButton>
        }
        @if (Session.Has("catalog.product.view"))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Sell" Href="/admin/productos">Productos y precios</MudButton>
        }
    </Acciones>
    <ChildContent>
        @if (_datosPendientes)
        {
            @* Instalador 1.2.1: la empresa se crea con datos provisionales (sin preguntar razón social, NIT ni dirección). *@
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                Complete los datos de su empresa (necesarios para facturar).
                <MudButton Size="Size.Small" Class="ml-2" Href="/admin/configuracion">Ir a Configuración</MudButton>
            </MudAlert>
        }
        @if (_fiscal?.ConnectionNotice is { Length: > 0 } aviso)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                @aviso
                @if (Session.Has("billing.settings.manage"))
                {
                    <MudButton Size="Size.Small" Class="ml-2" Href="/admin/facturacion">Ir a Facturación</MudButton>
                }
            </MudAlert>
        }
        @if (_data is { } data)
        {
            var today = data.Today;
            var last = data.SameDayLastWeek;
            var alertas = Alertas().ToList();

            <section aria-labelledby="t-atencion" class="mb-6">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3" id="t-atencion">Requiere atención</MudText>
                @if (alertas.Count == 0)
                {
                    <div class="bp-tarjeta tablero-ok">
                        <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Color="Color.Success" />
                        <div><b>Todo en orden.</b> No hay diferencias de caja por revisar, productos agotándose ni alertas de backups o auditoría.</div>
                    </div>
                }
                else
                {
                    <div class="tablero-alertas">
                        @foreach (var alerta in alertas)
                        {
                            <a class="tablero-alerta bp-tono-@alerta.Tono" href="@alerta.Href">
                                <span class="bp-indicador-icono" aria-hidden="true"><MudIcon Icon="@alerta.Icono" Size="Size.Small" /></span>
                                <span class="tablero-alerta-texto"><b>@alerta.Cantidad</b> @alerta.Texto</span>
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" aria-hidden="true" />
                            </a>
                        }
                    </div>
                }
            </section>

            <section aria-labelledby="t-ventas" class="mb-6">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3" id="t-ventas">Ventas de hoy</MudText>
                <div class="tablero-indicadores">
                    <Tarjeta Titulo="Ventas netas" Valor="@Format.Money(today.NetSales)" Icono="@Icons.Material.Outlined.Payments" Tono="primario"
                             Variacion="@Variacion(today.NetSales, last.NetSales)" Detalle="@($"vs. {Format.Money(last.NetSales)} hace una semana")" />
                    <Tarjeta Titulo="Tiquetes" Valor="@today.Tickets.ToString("#,##0", Format.Colombia)" Icono="@Icons.Material.Outlined.ReceiptLong" Tono="secundario"
                             Variacion="@Variacion(today.Tickets, last.Tickets)" Detalle="@($"vs. {last.Tickets:#,##0} hace una semana")" />
                    <Tarjeta Titulo="Ticket promedio" Valor="@Format.Money(today.AverageTicket)" Icono="@Icons.Material.Outlined.ShoppingBasket" Tono="info"
                             Variacion="@Variacion(today.AverageTicket, last.AverageTicket)" Detalle="@($"vs. {Format.Money(last.AverageTicket)}")" />
                    @if (data.GrossProfitToday is { } utilidad)
                    {
                        <Tarjeta Titulo="Utilidad bruta" Valor="@Format.Money(utilidad)" Icono="@Icons.Material.Outlined.TrendingUp" Tono="exito"
                                 Detalle="@Margen(utilidad, today.NetSales)" />
                    }
                    else
                    {
                        <Tarjeta Titulo="Turnos abiertos" Valor="@data.OpenCashSessions.ToString("0")" Icono="@Icons.Material.Outlined.PointOfSale" Tono="neutro"
                                 Href="@(Session.Has("cash.report.view") ? "/admin/jornadas" : null)" Detalle="cajas vendiendo ahora" />
                    }
                </div>
            </section>

            <div class="tablero-columnas mb-6">
                <section class="bp-tarjeta" aria-labelledby="t-horas">
                    <div class="tablero-seccion-cabeza">
                        <MudText Typo="Typo.h6" HtmlTag="h2" id="t-horas">Ventas por hora</MudText>
                        <span class="texto-secundario">@Format.Money(today.NetSales) en total</span>
                    </div>
                    @{
                        var horas = data.SalesByHour.Where(h => h.Tickets > 0 || h.Sales != 0).ToList();
                        var maximo = horas.Count == 0 ? 0 : horas.Max(h => h.Sales);
                    }
                    @if (horas.Count == 0)
                    {
                        <EstadoVacio Mensaje="Aún no hay ventas hoy." Detalle="Las ventas aparecen aquí por hora a medida que las cajas cobran." Compacto="true" />
                    }
                    else
                    {
                        <div class="grafico-horas" role="img" aria-label="@DescribirHoras(horas)">
                            @foreach (var hora in horas)
                            {
                                var alto = maximo <= 0 ? 0 : Math.Max(4, (double)(hora.Sales / maximo) * 100);
                                <div class="grafico-barra" title="@($"{hora.Hour:00}:00 · {Format.Money(hora.Sales)} · {hora.Tickets:0} tiquetes")">
                                    <span class="grafico-valor">@Compacto(hora.Sales)</span>
                                    <span class="grafico-columna" style="height:@(alto.ToString("0.#", CultureInfo.InvariantCulture))%"></span>
                                    <span class="grafico-etiqueta">@hora.Hour.ToString("00")h</span>
                                </div>
                            }
                        </div>
                    }
                </section>

                <section class="bp-tarjeta" aria-labelledby="t-top">
                    <div class="tablero-seccion-cabeza">
                        <MudText Typo="Typo.h6" HtmlTag="h2" id="t-top">Más vendidos hoy</MudText>
                        @if (Session.Me!.Permissions.Any(p => p.StartsWith("reporting.", StringComparison.Ordinal)))
                        {
                            <MudLink Href="/admin/reportes" Typo="Typo.body2">Ver reportes</MudLink>
                        }
                    </div>
                    @{
                        var top = data.TopProducts;
                        var mayor = top.Count == 0 ? 0 : top.Max(p => p.Sales);
                    }
                    @if (top.Count == 0)
                    {
                        <EstadoVacio Mensaje="Sin productos vendidos todavía." Compacto="true" />
                    }
                    else
                    {
                        <ol class="tablero-top">
                            @foreach (var product in top)
                            {
                                <li>
                                    <div class="tablero-top-fila">
                                        <span class="tablero-top-nombre"><b>@product.Name</b><small>@product.Sku · @Format.Quantity(product.Quantity) und.</small></span>
                                        <span class="num"><b>@Format.Money(product.Sales)</b></span>
                                    </div>
                                    <span class="tablero-top-barra" style="width:@((mayor <= 0 ? 0 : (double)(product.Sales / mayor) * 100).ToString("0.#", CultureInfo.InvariantCulture))%"></span>
                                </li>
                            }
                        </ol>
                    }
                </section>
            </div>

            <section aria-labelledby="t-operacion">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3" id="t-operacion">Operación</MudText>
                <div class="tablero-indicadores">
                    <Tarjeta Titulo="Productos bajo el mínimo" Valor="@data.ProductsBelowMinimum.ToString("0")" Icono="@Icons.Material.Outlined.Inventory2"
                             Tono="@(data.ProductsBelowMinimum > 0 ? "advertencia" : "neutro")" Href="@(Session.Has("inventory.stock.view") ? "/admin/existencias" : null)" Detalle="por agotarse: pedir al proveedor" />
                    <Tarjeta Titulo="Lotes por vencer" Valor="@data.LotsExpiringSoon.ToString("0")" Icono="@Icons.Material.Outlined.EventBusy"
                             Tono="@(data.LotsExpiringSoon > 0 ? "advertencia" : "neutro")" Detalle="en los próximos días" />
                    <Tarjeta Titulo="Anulados hoy" Valor="@today.VoidedTickets.ToString("0")" Icono="@Icons.Material.Outlined.Block"
                             Tono="@(today.VoidedTickets > 0 ? "error" : "neutro")" Detalle="@($"hace una semana: {last.VoidedTickets:0}")" />
                    <Tarjeta Titulo="Turnos abiertos" Valor="@data.OpenCashSessions.ToString("0")" Icono="@Icons.Material.Outlined.PointOfSale" Tono="neutro"
                             Href="@(Session.Has("cash.report.view") ? "/admin/jornadas" : null)" Detalle="@($"{data.ClosingsWithUnreviewedDifference:0} cierre(s) con diferencia sin revisar")" />
                </div>
                <MudText Typo="Typo.caption" Class="d-block mt-3 texto-secundario">Datos generados a las @Format.Date(data.GeneratedAt).</MudText>
            </section>
        }
        else if (!_puedeVer)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">Su usuario no tiene permiso para ver las cifras de ventas. Estas son las secciones a las que puede entrar:</MudAlert>
            <div class="tablero-accesos">
                @foreach (var grupo in Navegacion.Grupos)
                {
                    @foreach (var opcion in grupo.Visibles(Session))
                    {
                        <a class="bp-tarjeta bp-tarjeta-enlace tablero-acceso" href="@opcion.Ruta">
                            <span class="pagina-icono" aria-hidden="true"><MudIcon Icon="@opcion.Icono" /></span>
                            <span><b>@opcion.Titulo</b><small>@grupo.Titulo</small></span>
                        </a>
                    }
                }
            </div>
        }
    </ChildContent>
</Pagina>

@code {
    private sealed record Alerta(int Cantidad, string Texto, string Href, string Icono, string Tono);

    private DashboardDto? _data;
    private FiscalAlertsDto? _fiscal;
    private bool _datosPendientes;
    private List<Pos.Modules.Organization.Contracts.ScaleKeyChangeDto> _basculas = [];
    private bool _loading = true;
    private bool _puedeVer;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _puedeVer = Session.Me!.Permissions.Any(p => p == "reporting.sales.basic");
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _loading = true;
        try
        {
            if (_puedeVer)
            {
                _data = await Api.GetAsync<DashboardDto>("api/v1/reports/dashboard");
            }

            Session.Refresh(await Api.GetAsync<MeInfo>("api/v1/auth/me"));
            // Aviso de la facturación electrónica apagada al actualizar (PA1): quien puede ver la facturación lo ve aunque no vea las ventas.
            _fiscal = await AlertasFiscalesAsync();
            _datosPendientes = await DatosPendientesAsync();
            await CargarBasculasAsync();
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con el servidor de la tienda.";
        }

        _loading = false;
    }

    private async Task<FiscalAlertsDto?> AlertasFiscalesAsync()
    {
        if (!Session.Has("billing.document.view"))
        {
            return null;
        }

        try
        {
            return await Api.GetAsync<FiscalAlertsDto>("api/v1/billing/alerts");
        }
        catch (ApiException)
        {
            return null; // el aviso es secundario: no tumba el tablero
        }
    }

    /// <summary>¿La empresa tiene datos provisionales del instalador? Solo para quien puede ver la empresa; si falla, no tumba el tablero.</summary>
    private async Task<bool> DatosPendientesAsync()
    {
        if (!Session.Has("organization.company.view"))
        {
            return false;
        }

        try
        {
            return (await Api.GetAsync<Pos.Modules.Organization.Contracts.CompanyDto>("api/v1/organization/company")).DataPending;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or System.Text.Json.JsonException)
        {
            return false;
        }
    }

    /// <summary>BK7: las alertas de báscula van aparte: si fallan, el Tablero se muestra igual (sin ellas).</summary>
    private async Task CargarBasculasAsync()
    {
        _basculas = [];
        if (!Session.Has("organization.terminal.manage"))
        {
            return;
        }

        try
        {
            _basculas = await Api.GetAsync<List<Pos.Modules.Organization.Contracts.ScaleKeyChangeDto>>("api/v1/organization/terminals/scale-key-changes");
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or System.Text.Json.JsonException)
        {
            // Sin las alertas de báscula: el resto del Tablero sigue.
        }
    }

    private string Saludo()
    {
        var nombre = Session.Me?.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        var hora = DateTime.Now.Hour;
        var saludo = hora < 12 ? "Buenos días" : hora < 19 ? "Buenas tardes" : "Buenas noches";
        return nombre is null ? saludo : $"{saludo}, {nombre}";
    }

    private static string Subtitulo()
    {
        var hoy = DateTime.Now.ToString("dddd d 'de' MMMM 'de' yyyy", Format.Colombia);
        return $"Tablero del día · {char.ToUpper(hoy[0], Format.Colombia)}{hoy[1..]}";
    }

    /// <summary>Alertas de operación con su pantalla (solo las que tienen algo y a las que el usuario puede entrar).</summary>
    private IEnumerable<Alerta> Alertas()
    {
        var me = Session.Me!;
        if (_data is not { } data)
        {
            yield break;
        }

        var diferencias = data.ClosingsWithUnreviewedDifference;
        if (diferencias > 0 && Session.Has("cash.report.view"))
        {
            yield return new(diferencias, diferencias == 1 ? "cierre de caja con diferencia por revisar" : "cierres de caja con diferencia por revisar", "/admin/jornadas", Icons.Material.Outlined.PointOfSale, "advertencia");
        }

        var bajos = data.ProductsBelowMinimum;
        if (bajos > 0 && Session.Has("inventory.stock.view"))
        {
            yield return new(bajos, bajos == 1 ? "producto bajo el mínimo" : "productos bajo el mínimo", "/admin/existencias", Icons.Material.Outlined.Inventory2, "advertencia");
        }

        var incidentes = Math.Max(data.OpenIntegrityIncidents, me.OpenIntegrityIncidents);
        if (incidentes > 0 && Session.Has("audit.log.view"))
        {
            yield return new(incidentes, "incidente(s) de integridad de la auditoría", "/admin/auditoria", Icons.Material.Outlined.Policy, "error");
        }

        var backups = Math.Max(data.BackupAlerts, me.BackupAlerts);
        if (backups > 0 && Session.Has("backup.backup.view"))
        {
            yield return new(backups, "alerta(s) de backups", "/admin/backups", Icons.Material.Outlined.Backup, "error");
        }

        // BB2: vincular o cambiar la clave de la báscula de una caja cambia quién puede firmar los pesos: se muestra aquí 7 días.
        foreach (var bascula in _basculas)
        {
            yield return bascula is { Linked: true, ChangedAt: { } cambio }
                ? new(1, $"La clave de la báscula de la caja {bascula.TerminalCode} cambió ({cambio.ToLocalTime():dd/MM HH:mm}): revise la auditoría si no fue usted.",
                    "/admin/auditoria", Icons.Material.Outlined.Scale, "advertencia")
                : new(1, $"La báscula de la caja {bascula.TerminalCode} no está vinculada: en esa caja, F1 → Vincular báscula (con un supervisor).",
                    "/admin/cajas", Icons.Material.Outlined.Scale, "advertencia");
        }

        var solicitudes = data.DataRequestsDueSoon;
        if (solicitudes > 0 && Session.Has("customers.customer.view"))
        {
            yield return new(solicitudes, "solicitud(es) de datos personales por vencer", "/admin/clientes", Icons.Material.Outlined.PrivacyTip, "info");
        }
    }

    private static decimal? Variacion(decimal hoy, decimal antes) => antes == 0 ? null : Math.Round((hoy - antes) / antes * 100, 1);

    private static string? Margen(decimal utilidad, decimal ventas) =>
        ventas == 0 ? null : $"margen {(utilidad / ventas * 100).ToString("0.#", Format.Colombia)} % de las ventas";

    /// <summary>Cifra corta para las barras: 1,2 M · 850 mil.</summary>
    private static string Compacto(decimal valor) => Math.Abs(valor) switch
    {
        >= 1_000_000 => (valor / 1_000_000).ToString("0.#", Format.Colombia) + " M",
        >= 1_000 => (valor / 1_000).ToString("0", Format.Colombia) + " mil",
        _ => valor.ToString("0", Format.Colombia),
    };

    private static string DescribirHoras(List<DashboardHourDto> horas) =>
        "Ventas por hora: " + string.Join("; ", horas.Select(h => $"{h.Hour:00} horas, {Format.Money(h.Sales)}"));
}
