@page "/admin/compras/nueva"
@page "/admin/compras/{Id:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject Bodegas Bodegas
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@using Pos.Modules.Cash.Contracts
@using Pos.Modules.Purchasing.Contracts

<PageTitle>@TituloPagina · BusinessPost</PageTitle>

<Pagina Titulo="@TituloPagina" Subtitulo="@Resumen" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (Id is null)
        {
            <MudButton Variant="Variant.Text" Href="/admin/compras">Cancelar</MudButton>
            @if (Session.Has("purchasing.purchase.manage"))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="_busy || _loading" OnClick="CrearAsync" Class="ml-2">Guardar borrador</MudButton>
            }
        }
        else if (_compra is { } compra)
        {
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/admin/compras">Volver a la lista</MudButton>
            @if (EnumText.Same(compra.Status, "DRAFT") && Session.Has("purchasing.purchase.manage"))
            {
                <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="GuardarTotalAsync" Class="ml-2">Guardar total</MudButton>
            }
            @if (EnumText.Same(compra.Status, "DRAFT") && Session.Has("purchasing.purchase.post"))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="ContabilizarAsync" Class="ml-2">Confirmar compra</MudButton>
            }
            @if (EnumText.Same(compra.Status, "POSTED") && Session.Has("purchasing.purchase.void"))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="PedirAnulacion" Class="ml-2">Anular</MudButton>
            }
        }
    </Acciones>
    <ChildContent>
        @if (Id is null)
        {
            @if (_ordenId is not null)
            {
                <MudAlert Severity="Severity.Info" Class="mb-3">Se registra contra la orden @_ordenNumero. Si no agrega líneas, se propone lo pendiente de la orden.</MudAlert>
            }
            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Datos de la factura</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudSelect T="Guid?" @bind-Value="_proveedor" Label="Proveedor" Disabled="_ordenId is not null">
                            @foreach (var supplier in _proveedores)
                            {
                                <MudSelectItem T="Guid?" Value="@supplier.Id">@supplier.Name (@supplier.Identification)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="Guid?" @bind-Value="_bodega" Label="Bodega que recibe" Disabled="_ordenId is not null">
                            @foreach (var warehouse in Bodegas.Elegibles)
                            {
                                <MudSelectItem T="Guid?" Value="@warehouse.GetProperty("id").GetGuid()">@Bodegas.Etiqueta(warehouse)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="_factura" Label="Número de la factura del proveedor" Immediate="true" /></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudDatePicker @bind-Date="_fecha" Label="Fecha de la factura" DateFormat="dd/MM/yyyy" /></MudItem>
                    <MudItem xs="12" sm="6" md="4"><MudNumericField Culture="@Format.Colombia" T="decimal?" @bind-Value="_totalFactura" Label="Total de la factura (se compara al confirmar la compra)" Min="0" /></MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudSelect T="string" @bind-Value="_modo" Label="Forma de pago">
                            <MudSelectItem T="string" Value="@("Credit")">A crédito (plazo del proveedor)</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Cash")">De contado</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    @if (_modo == "Cash")
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="Guid?" @bind-Value="_medio" Label="Medio de pago">
                                @foreach (var method in _medios)
                                {
                                    <MudSelectItem T="Guid?" Value="@method.Id">@method.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="_referencia" Label="Referencia del pago (transferencia, cheque…)" Immediate="true" /></MudItem>
                    }
                    <MudItem xs="12"><MudTextField @bind-Value="_notas" Label="Notas" Immediate="true" /></MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Productos</MudText>
                <LineasProductos Lineas="_lineas" Compra="true" />
            </MudPaper>
        }
        else if (_compra is { } compra)
        {
            <MudChip T="string" Size="Size.Small" Color="@ColorEstado(compra.Status)" Class="ml-0 mb-3">@Compras.EstadoCompra(compra.Status)</MudChip>
            @foreach (var alert in compra.Alerts)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-1">@alert.Sku @alert.ProductName: @alert.Message</MudAlert>
            }
            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Productos</MudText>
                <MudSimpleTable Dense="true" Outlined="true">
                    <thead>
                        <tr><th>Producto</th><th class="num">Cantidad</th><th class="num">Costo unitario</th><th class="num">Descuento</th><th class="num">Impuestos</th><th class="num">Total</th><th>Lote</th><th>Vence</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var line in compra.Lines)
                        {
                            <tr>
                                <td>@line.Sku · @line.ProductName</td>
                                <td class="num">@Format.Quantity(line.Quantity)@(line.Factor != 1 ? $" × {Format.Quantity(line.Factor)}" : "")</td>
                                <td class="num">@Format.Money(line.UnitCost)</td>
                                <td class="num">@Format.Money(line.DiscountAmount)</td>
                                <td class="num">@Format.Money(line.TaxAmount)</td>
                                <td class="num">@Format.Money(line.LineTotal)</td>
                                <td>@line.LotNumber</td>
                                <td>@Compras.Dia(line.ExpiryDate)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="7">
                    @if (EnumText.Same(compra.Status, "DRAFT"))
                    {
                        <MudPaper Outlined="true" Class="pa-4">
                            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Total de la factura del proveedor</MudText>
                            <MudNumericField Culture="@Format.Colombia" T="decimal?" @bind-Value="_totalFactura" Label="Total de la factura del proveedor (se compara con el calculado al confirmar la compraizar)" Min="0" />
                        </MudPaper>
                    }
                    else if (EnumText.Same(compra.Status, "VOIDED"))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Anulada el @Format.Date(compra.VoidedAt): @compra.VoidReason</MudAlert>
                    }
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudSimpleTable Dense="true" Outlined="true">
                        <tbody>
                            <tr><td>Subtotal</td><td class="num">@Format.Money(compra.Subtotal)</td></tr>
                            <tr><td>Descuentos</td><td class="num">@Format.Money(compra.DiscountTotal)</td></tr>
                            <tr><td>Impuestos</td><td class="num">@Format.Money(compra.TaxTotal)</td></tr>
                            <tr><td>Cargos</td><td class="num">@Format.Money(compra.ChargesTotal)</td></tr>
                            <tr><td><b>Total</b></td><td class="num"><b>@Format.Money(compra.Total)</b></td></tr>
                            <tr><td>Retenciones</td><td class="num">@Format.Money(compra.WithholdingTotal)</td></tr>
                            <tr><td>A pagar al proveedor</td><td class="num">@Format.Money(compra.PayableTotal)</td></tr>
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
            </MudGrid>
        }
    </ChildContent>
</Pagina>

@if (_anulando && _compra is { } anular)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true">
            <h2>Anular la compra @anular.Number</h2>
            <MudText Typo="Typo.body2">Se reversan las entradas al inventario y la cuenta por pagar. No se puede si ya tiene pagos o devoluciones, o si deja existencias negativas.</MudText>
            <MudTextField @bind-Value="_motivo" Label="Motivo (5 a 300 caracteres)" Immediate="true" AutoFocus="true" Lines="2" />
            <div class="acciones">
                <MudButton OnClick="@(() => _anulando = false)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="_busy" OnClick="AnularAsync">Anular</MudButton>
            </div>
        </div>
    </div>
}

@code {
    private List<SupplierDto> _proveedores = [];
    private List<PaymentMethodDto> _medios = [];
    private List<LineaProducto> _lineas = [];
    private string _modo = "Credit";
    private string? _error, _factura, _referencia, _notas, _motivo, _ordenNumero, _clave;
    private Guid? _proveedor, _bodega, _medio, _ordenId;
    private DateTime? _fecha;
    private decimal? _totalFactura;
    private bool _loading = true, _busy, _anulando;
    private PurchaseDto? _compra;

    /// <summary>La compra que se muestra; sin valor (ruta <c>/nueva</c>), el formulario de una factura nueva.</summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>En <c>/nueva?orden={id}</c>: la orden de compra contra la que se registra la factura.</summary>
    [SupplyParameterFromQuery(Name = "orden")]
    public Guid? Orden { get; set; }

    private string TituloPagina => Id is null
        ? "Nueva factura de compra"
        : _compra is { } compra ? $"Compra {compra.Number}" : "Compra";

    private string? Resumen => Id is null || _compra is not { } compra
        ? null
        : $"{compra.SupplierName} · factura {compra.SupplierInvoiceNumber} del {Compras.Dia(compra.InvoiceDate)} · vence {Compras.Dia(compra.DueDate)} · "
          + (EnumText.Same(compra.PaymentMode, "CASH") ? "de contado" : "a crédito")
          + (compra.RequiresSupportDocument ? " · requiere documento soporte" : "");

    protected override async Task OnParametersSetAsync()
    {
        // La misma instancia sirve /nueva y /{id}: solo se recarga cuando cambia lo que se muestra (al guardar el borrador ya se tiene).
        var clave = $"{Id}|{Orden}";
        if (clave == _clave)
        {
            return;
        }

        _clave = clave;
        _loading = true;
        _error = null;
        _anulando = false;
        try
        {
            if (Id is { } id)
            {
                _compra = await Api.GetAsync<PurchaseDto>($"api/v1/purchasing/purchases/{id}");
                _totalFactura = _compra.InvoiceTotal;
            }
            else
            {
                _compra = null;
                await PrepararNuevaAsync();
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    /// <summary>El valor de la base de datos (CREDIT, VALUE, RETEFUENTE) como lo recibe la API (Credit, Value, Retefuente).</summary>
    private static string Enumeracion(string value) => value.Length == 0 ? value : value[..1].ToUpperInvariant() + value[1..].ToLowerInvariant();

    private static string? Texto(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static Color ColorEstado(string status) => EnumText.Normalize(status) switch
    {
        "POSTED" => Color.Success,
        "VOIDED" => Color.Error,
        _ => Color.Default,
    };

    private async Task PrepararNuevaAsync()
    {
        _proveedores = [.. await Api.GetAsync<List<SupplierDto>>("api/v1/purchasing/suppliers")];
        _medios = [.. await Api.GetAsync<List<PaymentMethodDto>>("api/v1/cash/payment-methods")];
        await Bodegas.CargarAsync();

        var order = Orden is { } orderId ? await Api.GetAsync<PurchaseOrderDto>($"api/v1/purchasing/orders/{orderId}") : null;
        _lineas = [];
        _factura = _referencia = _notas = null;
        _fecha = DateTime.Today;
        _totalFactura = null;
        _modo = "Credit";
        _medio = null;
        _ordenId = order?.Id;
        _ordenNumero = order?.Number;
        _proveedor = order?.SupplierId;
        _bodega = order?.WarehouseId ?? Bodegas.Primera(Bodegas.Elegibles);
    }

    private async Task CrearAsync()
    {
        if (_proveedor is null || _bodega is null)
        {
            Snackbar.Add("Seleccione el proveedor y la bodega.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var purchase = await Api.PostAsync<PurchaseDto>("api/v1/purchasing/purchases", new
            {
                supplierId = _proveedor, warehouseId = _bodega, purchaseOrderId = _ordenId, supplierInvoiceNumber = (_factura ?? "").Trim(),
                invoiceDate = DateOnly.FromDateTime(_fecha ?? DateTime.Today), businessDate = (DateOnly?)null, dueDate = (DateOnly?)null,
                paymentMode = _modo, paymentMethodId = _modo == "Cash" ? _medio : null, paymentReference = _modo == "Cash" ? Texto(_referencia) : null,
                invoiceTotal = _totalFactura, proration = "Value", chargesTotal = 0m, chargesNotes = (string?)null, notes = Texto(_notas),
                lines = _lineas.Count == 0 && _ordenId is not null ? null : _lineas.Select(l => new
                {
                    productId = l.ProductId, code = (string?)null, packagingId = l.EmpaqueId == Guid.Empty ? (Guid?)null : l.EmpaqueId, quantity = l.Cantidad, unitCost = l.Costo,
                    discount = l.Descuento, taxes = (object[]?)null, manualCharges = (decimal?)null, lotNumber = l.Lotes ? Texto(l.Lote) : null,
                    expiryDate = l.Vence && l.Vencimiento is { } expiry ? DateOnly.FromDateTime(expiry) : (DateOnly?)null, orderLineId = (Guid?)null,
                }).ToList(),
                withholdings = (object[]?)null,
            });
            Snackbar.Add($"Compra {purchase.Number} guardada en borrador.", Severity.Success);
            var id = purchase.Id;
            _compra = purchase;
            _totalFactura = purchase.InvoiceTotal;
            _clave = $"{id}|";
            Navigation.NavigateTo($"/admin/compras/{id}", replace: true);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    /// <summary>Reenvía el borrador tal como está, cambiando solo el total de la factura digitado.</summary>
    private async Task ActualizarTotalAsync(PurchaseDto p)
    {
        var manual = EnumText.Same(p.ProrationMethod, "MANUAL");
        _compra = await Api.PutAsync<PurchaseDto>($"api/v1/purchasing/purchases/{p.Id}", new
        {
            supplierId = p.SupplierId, warehouseId = p.WarehouseId, purchaseOrderId = p.PurchaseOrderId,
            supplierInvoiceNumber = p.SupplierInvoiceNumber, invoiceDate = p.InvoiceDate, businessDate = p.BusinessDate, dueDate = (string?)null,
            paymentMode = Enumeracion(p.PaymentMode), paymentMethodId = p.PaymentMethodId, paymentReference = Texto(p.PaymentReference),
            invoiceTotal = _totalFactura, proration = Enumeracion(p.ProrationMethod), chargesTotal = p.ChargesTotal, chargesNotes = Texto(p.ChargesNotes),
            notes = Texto(p.Notes),
            lines = p.Lines.Select(l => new
            {
                productId = l.ProductId, code = (string?)null, packagingId = l.PackagingId, quantity = l.Quantity,
                unitCost = (decimal?)l.UnitCost, discount = l.DiscountAmount, taxes = (object[]?)null, manualCharges = manual ? l.ChargesAmount : (decimal?)null,
                lotNumber = Texto(l.LotNumber), expiryDate = l.ExpiryDate, orderLineId = l.OrderLineId,
            }).ToList(),
            withholdings = p.Withholdings.Select(w => new
            {
                kind = Enumeracion(w.Kind), @base = w.Base, rate = w.Rate, amount = (decimal?)w.Amount,
            }).ToList(),
        });
    }

    private async Task GuardarTotalAsync()
    {
        if (_compra is not { } compra)
        {
            return;
        }

        _busy = true;
        try
        {
            await ActualizarTotalAsync(compra);
            Snackbar.Add("Total de la factura guardado.", Severity.Success);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    /// <summary>
    /// Contabiliza (guardando antes el total si cambió). Se queda con la respuesta del servidor en lugar de volver a leer la compra: es el
    /// documento completo y trae las alertas de costo, que no vuelven en una lectura posterior.
    /// </summary>
    private async Task ContabilizarAsync()
    {
        if (_compra is not { } compra)
        {
            return;
        }

        _busy = true;
        try
        {
            if (_totalFactura != compra.InvoiceTotal)
            {
                await ActualizarTotalAsync(compra);
            }

            var posted = await Api.PostAsync<PurchaseDto>($"api/v1/purchasing/purchases/{compra.Id}/post", new { cashSessionId = (Guid?)null });
            Snackbar.Add($"Compra {posted.Number} confirmada: entró al inventario y a cuentas por pagar.", Severity.Success);
            _compra = posted;
            _totalFactura = posted.InvoiceTotal;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private void PedirAnulacion()
    {
        _motivo = null;
        _anulando = true;
    }

    private async Task AnularAsync()
    {
        if (_compra is not { } compra)
        {
            return;
        }

        _busy = true;
        try
        {
            var id = compra.Id;
            await Api.PostAsync<PurchaseDto>($"api/v1/purchasing/purchases/{id}/void", new { reason = (_motivo ?? "").Trim() });
            Snackbar.Add($"Compra {compra.Number} anulada.", Severity.Success);
            _anulando = false;
            _compra = await Api.GetAsync<PurchaseDto>($"api/v1/purchasing/purchases/{id}");
            _totalFactura = _compra.InvoiceTotal;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }
}
