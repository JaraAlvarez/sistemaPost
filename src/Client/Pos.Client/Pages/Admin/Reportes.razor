@page "/admin/reportes"
@inject ApiClient Api
@inject IJSRuntime Js
@inject ISnackbar Snackbar

<PageTitle>Reportes · BusinessPost</PageTitle>

<Pagina Titulo="Reportes" Cargando="_loading" Error="@_error">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-2" Elevation="1" Style="max-height: 75vh; overflow-y: auto;">
                @foreach (var group in _reports.GroupBy(r => r.Group))
                {
                    <MudText Typo="Typo.overline" Class="px-2">@group.Key</MudText>
                    <MudList T="ReportInfo" Dense="true">
                        @foreach (var report in group)
                        {
                            <MudListItem T="ReportInfo" OnClick="@(() => Elegir(report))" Class="@(report == _selected ? "mud-selected-item" : null)">@report.Name</MudListItem>
                        }
                    </MudList>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="8">
            @if (_selected is null)
            {
                <MudAlert Severity="Severity.Info">Elija un reporte de la lista.</MudAlert>
            }
            else
            {
                <MudText Typo="Typo.h6">@_selected.Name</MudText>
                <MudText Typo="Typo.body2" Class="mb-3">@_selected.Description</MudText>
                <MudGrid Spacing="2">
                    @foreach (var parameter in _selected.Parameters)
                    {
                        <MudItem xs="12" sm="6">
                            @if (parameter.Type == "Date")
                            {
                                <MudDatePicker Label="@parameter.Label" DateFormat="dd/MM/yyyy" Date="@Fecha(parameter.Name)" DateChanged="@(d => _values[parameter.Name] = d?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" />
                            }
                            else
                            {
                                <MudTextField T="string" Label="@parameter.Label" Value="@_values.GetValueOrDefault(parameter.Name)" ValueChanged="@(v => _values[parameter.Name] = v)" />
                            }
                        </MudItem>
                    }
                </MudGrid>
                <MudStack Row="true" Class="my-3" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="VerAsync">Ver</MudButton>
                    <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="@(() => ExportarAsync("xlsx"))">Excel</MudButton>
                    <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="@(() => ExportarAsync("csv"))">CSV</MudButton>
                    <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="@(() => ExportarAsync("pdf"))">PDF</MudButton>
                </MudStack>
                @if (_result is not null)
                {
                    @if (_result.Note is not null)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@_result.Note</MudAlert>
                    }
                    @if (EsMapaDeCalor)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
                            <MudToggleGroup T="bool" @bind-Value="_verMapa" Size="Size.Small" Color="Color.Primary" Outlined="true">
                                <MudToggleItem Value="false" Text="Tabla" />
                                <MudToggleItem Value="true" Text="Mapa de calor" />
                            </MudToggleGroup>
                            @if (_verMapa)
                            {
                                <MudText Typo="Typo.caption">Más oscuro = más ventas en esa hora y ese día.</MudText>
                            }
                        </MudStack>
                    }
                    <div style="overflow-x: auto;">
                        <MudSimpleTable Dense="true" Outlined="true" Striped="@(!_verMapa || !EsMapaDeCalor)">
                            <thead><tr>@foreach (var column in _result.Columns) { <th class="@(Numeric(column) ? "num" : null)">@column.Label</th> }</tr></thead>
                            <tbody>
                                @foreach (var row in _result.Rows)
                                {
                                    <tr>
                                        @foreach (var column in _result.Columns)
                                        {
                                            var value = row.GetValueOrDefault(column.Key);
                                            <td class="@(Numeric(column) ? "num" : null)" style="@EstiloCelda(column, value)">
                                                @if (column.Style == "AbcClass" && value.ValueKind == JsonValueKind.String)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="@ColorAbc(value.GetString())" Class="ma-0">@value.GetString()</MudChip>
                                                }
                                                else if (EsVariacion(column))
                                                {
                                                    <span style="@ColorVariacion(value)">@Variacion(value, column)</span>
                                                }
                                                else
                                                {
                                                    @Format.Cell(value, column.Type)
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                                @if (_result.Totals.Count > 0)
                                {
                                    <tr>@foreach (var column in _result.Columns) { <td class="num"><b>@(_result.Totals.TryGetValue(column.Key, out var total) ? (EsVariacion(column) ? Variacion(total, column) : Format.Cell(total, column.Type)) : "")</b></td> }</tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                    <MudText Typo="Typo.caption">@_result.TotalRows fila(s)@(_result.TotalRows > _result.Rows.Count ? $"; se muestran {_result.Rows.Count}. Exporte para verlas todas." : ".")</MudText>
                }
            }
        </MudItem>
    </MudGrid>
</Pagina>

@code {
    private List<ReportInfo> _reports = [];
    private ReportInfo? _selected;
    private ReportResult? _result;
    private readonly Dictionary<string, string?> _values = [];
    private bool _loading = true, _busy, _verMapa = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _reports = await Api.GetAsync<List<ReportInfo>>("api/v1/reports");
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private void Elegir(ReportInfo report)
    {
        _selected = report;
        _result = null;
        _values.Clear();
        _verMapa = true;
        foreach (var parameter in report.Parameters)
        {
            _values[parameter.Name] = parameter.Type == "Date" ? FechaPorDefecto(parameter.DefaultValue, report.Today) : parameter.DefaultValue;
        }
    }

    /// <summary>
    /// "today" y "today-N" (p. ej. los últimos 7 días de los comparativos) se muestran ya resueltos en el selector de fecha, con la fecha de
    /// negocio del servidor (cerca de la medianoche el reloj del equipo puede ir en otro día).
    /// </summary>
    private static string? FechaPorDefecto(string? value, DateOnly? serverToday)
    {
        if (value is null || !value.StartsWith("today", StringComparison.OrdinalIgnoreCase))
        {
            return value;
        }

        var offset = value.Length > 5 && int.TryParse(value[5..], NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out var o) ? o : 0;
        var today = serverToday ?? DateOnly.FromDateTime(DateTime.Today);
        return today.AddDays(offset).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    private bool EsMapaDeCalor => _result?.Columns.Any(c => c.Style == "Heat") == true;

    /// <summary>Celda del mapa de calor: más oscura cuanto mayor la venta frente a la mayor celda de la tabla.</summary>
    private string? EstiloCelda(ReportColumn column, JsonElement value)
    {
        if (!_verMapa || column.Style != "Heat" || value.ValueKind != JsonValueKind.Number || _result is null)
        {
            return null;
        }

        var max = _result.Rows
            .SelectMany(r => _result.Columns.Where(c => c.Style == "Heat").Select(c => r.GetValueOrDefault(c.Key)))
            .Where(v => v.ValueKind == JsonValueKind.Number)
            .Select(v => v.GetDecimal())
            .DefaultIfEmpty(0m)
            .Max();
        var level = Pos.Modules.Reporting.Contracts.HeatmapScale.Level(value.GetDecimal(), max);
        if (level == 0)
        {
            return null;
        }

        var alpha = (0.12m + 0.16m * (level - 1)).ToString("0.00", CultureInfo.InvariantCulture);
        return $"background-color: rgba(var(--mud-palette-primary-rgb), {alpha});" + (level >= 4 ? " color: var(--mud-palette-primary-text);" : string.Empty);
    }

    private static bool EsVariacion(ReportColumn column) => column.Style is "Variation" or "PointChange";

    private static Color ColorAbc(string? clase) => clase switch
    {
        "A" => Color.Success,
        "B" => Color.Warning,
        _ => Color.Default,
    };

    private static string? ColorVariacion(JsonElement value) =>
        value.ValueKind != JsonValueKind.Number ? null
        : value.GetDecimal() > 0 ? "color: var(--mud-palette-success);"
        : value.GetDecimal() < 0 ? "color: var(--mud-palette-error);"
        : null;

    /// <summary>Variación con flecha: ▲ sube, ▼ baja; el margen va en puntos porcentuales (pp).</summary>
    private static string Variacion(JsonElement value, ReportColumn column)
    {
        if (value.ValueKind != JsonValueKind.Number)
        {
            return "";
        }

        var number = value.GetDecimal();
        var unit = column.Style == "PointChange" ? " pp" : " %";
        var arrow = number > 0 ? "▲ " : number < 0 ? "▼ " : "";
        return arrow + Math.Abs(number).ToString("0.##", Format.Colombia) + unit;
    }

    private DateTime? Fecha(string name) =>
        DateTime.TryParseExact(_values.GetValueOrDefault(name), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) ? date : null;

    private string Query() =>
        string.Join("&", _values.Where(v => !string.IsNullOrWhiteSpace(v.Value)).Select(v => $"{Uri.EscapeDataString(v.Key)}={Uri.EscapeDataString(v.Value!)}"));

    private static bool Numeric(ReportColumn column) => column.Type is "Money" or "Count" or "Quantity" or "Percent";

    private async Task VerAsync()
    {
        _busy = true;
        try
        {
            _result = await Api.GetAsync<ReportResult>($"api/v1/reports/{_selected!.Code}?pageSize=200&{Query()}");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private async Task ExportarAsync(string format)
    {
        _busy = true;
        try
        {
            var (name, type, content) = await Api.DownloadAsync($"api/v1/reports/{_selected!.Code}?format={format}&{Query()}");
            await Js.InvokeVoidAsync("pos.download", name, type, Convert.ToBase64String(content));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }
}
