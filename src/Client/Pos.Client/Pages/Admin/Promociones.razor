@page "/admin/promociones"
@using Pos.Modules.Promotions.Contracts
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>Promociones · BusinessPost</PageTitle>

<Pagina Funcion="PROMOTIONS" Titulo="Promociones" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (Session.Has("promotions.promotion.manage"))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/admin/promociones/nueva">Nueva promoción</MudButton>
        }
    </Acciones>
    <ChildContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Se aplican solas en la caja mientras están activas. Abra una para simularla, activarla, pausarla o terminarla.
        </MudText>
        <MudSelect T="string" Value="_statusFilter" ValueChanged="@(v => FiltrarAsync(v))" Label="Estado" Style="max-width: 220px" Class="mb-3">
            <MudSelectItem T="string" Value="@("")">Todas</MudSelectItem>
            <MudSelectItem T="string" Value="@("Draft")">Borradores</MudSelectItem>
            <MudSelectItem T="string" Value="@("Active")">Activas</MudSelectItem>
            <MudSelectItem T="string" Value="@("Paused")">Pausadas</MudSelectItem>
            <MudSelectItem T="string" Value="@("Ended")">Terminadas</MudSelectItem>
        </MudSelect>
        <MudTable RowsPerPage="25" Items="_items" Dense="true" Hover="true" Striped="true" Class="fila-clic"
                  OnRowClick="@((TableRowClickEventArgs<PromotionSummaryDto> e) => Abrir(e.Item))">
            <HeaderContent>
                <MudTh>Número</MudTh><MudTh>Nombre</MudTh><MudTh>Tipo</MudTh><MudTh>Estado</MudTh><MudTh>Desde</MudTh><MudTh>Hasta</MudTh><MudTh>Rige ahora</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><a href="@($"/admin/promociones/{context.Id}")" @onclick:stopPropagation="true">@context.Number</a></MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@PromocionDetalle.NombreTipo(context.Type)</MudTd>
                <MudTd>@PromocionDetalle.NombreEstado(context.Status)</MudTd>
                <MudTd>@Format.Date(context.ValidFrom)</MudTd>
                <MudTd>@Format.Date(context.ValidTo)</MudTd>
                <MudTd>@(context.InEffectNow ? "Sí" : "No")</MudTd>
            </RowTemplate>
            <NoRecordsContent><EstadoVacio Mensaje="No hay promociones." /></NoRecordsContent>
            <PagerContent><Paginador /></PagerContent>
        </MudTable>
    </ChildContent>
</Pagina>

@code {
    private IReadOnlyList<PromotionSummaryDto> _items = [];
    private string _statusFilter = "";
    private string? _error;
    private bool _loading = true;

    private static readonly string[] Estados = ["Draft", "Active", "Paused", "Ended"];

    [SupplyParameterFromQuery(Name = "estado")]
    public string? EstadoQuery { get; set; }

    protected override Task OnInitializedAsync()
    {
        if (EstadoQuery is { } estado && Estados.Contains(estado, StringComparer.Ordinal))
        {
            _statusFilter = estado;
        }

        return CargarAsync();
    }

    private async Task CargarAsync()
    {
        _loading = true;
        try
        {
            var filter = string.IsNullOrEmpty(_statusFilter) ? "" : $"?status={_statusFilter}";
            _items = await Api.GetAsync<IReadOnlyList<PromotionSummaryDto>>($"api/v1/promotions{filter}");
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private Task FiltrarAsync(string status)
    {
        _statusFilter = status;
        Filtros.Actualizar(Navigation, new Dictionary<string, object?> { ["estado"] = _statusFilter });
        return CargarAsync();
    }

    private void Abrir(PromotionSummaryDto? promotion)
    {
        if (promotion is not null)
        {
            Navigation.NavigateTo($"/admin/promociones/{promotion.Id}");
        }
    }
}
