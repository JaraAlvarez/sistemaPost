@page "/admin/promociones"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>Promociones · BusinessPost</PageTitle>

<Pagina Titulo="Promociones" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (Session.Has("promotions.promotion.manage"))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/admin/promociones/nueva">Nueva promoción</MudButton>
        }
    </Acciones>
    <ChildContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Las promociones se aplican solas en la caja mientras están activas y vigentes. Solo el encargado las crea y administra; una promoción activa no se edita:
            se pausa o se termina y se crea otra. Abra una promoción para simularla, activarla, pausarla o terminarla.
        </MudText>
        <MudSelect T="string" Value="_statusFilter" ValueChanged="@(v => FiltrarAsync(v))" Label="Estado" Style="max-width: 220px" Class="mb-3">
            <MudSelectItem T="string" Value="@("")">Todas</MudSelectItem>
            <MudSelectItem T="string" Value="@("Draft")">Borradores</MudSelectItem>
            <MudSelectItem T="string" Value="@("Active")">Activas</MudSelectItem>
            <MudSelectItem T="string" Value="@("Paused")">Pausadas</MudSelectItem>
            <MudSelectItem T="string" Value="@("Ended")">Terminadas</MudSelectItem>
        </MudSelect>
        <MudTable RowsPerPage="25" Items="_items" Dense="true" Hover="true" Striped="true" RowStyle="cursor: pointer"
                  OnRowClick="@((TableRowClickEventArgs<JsonElement> e) => Abrir(e.Item))">
            <HeaderContent>
                <MudTh>Número</MudTh><MudTh>Nombre</MudTh><MudTh>Tipo</MudTh><MudTh>Estado</MudTh><MudTh>Desde</MudTh><MudTh>Hasta</MudTh><MudTh>Rige ahora</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><a href="@($"/admin/promociones/{context.Str("id")}")" @onclick:stopPropagation="true">@context.Str("number")</a></MudTd>
                <MudTd>@context.Str("name")</MudTd>
                <MudTd>@PromocionDetalle.NombreTipo(context.Str("type"))</MudTd>
                <MudTd>@PromocionDetalle.NombreEstado(context.Str("status"))</MudTd>
                <MudTd>@Format.Date(context.Date("validFrom"))</MudTd>
                <MudTd>@Format.Date(context.Date("validTo"))</MudTd>
                <MudTd>@(context.Bool("inEffectNow") ? "Sí" : "No")</MudTd>
            </RowTemplate>
            <NoRecordsContent><EstadoVacio Mensaje="No hay promociones." /></NoRecordsContent>
            <PagerContent><Paginador /></PagerContent>
        </MudTable>
    </ChildContent>
</Pagina>

@code {
    private List<JsonElement> _items = [];
    private string _statusFilter = "";
    private string? _error;
    private bool _loading = true;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        _loading = true;
        try
        {
            var filter = string.IsNullOrEmpty(_statusFilter) ? "" : $"?status={_statusFilter}";
            _items = (await Api.GetAsync<JsonElement>($"api/v1/promotions{filter}")).Items();
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private Task FiltrarAsync(string status)
    {
        _statusFilter = status;
        return CargarAsync();
    }

    private void Abrir(JsonElement promotion) => Navigation.NavigateTo($"/admin/promociones/{promotion.GetProperty("id").GetGuid()}");
}
