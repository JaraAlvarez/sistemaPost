@page "/admin/licencia"
@inject ApiClient Api
@inject SessionState Session
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Licencia · BusinessPost</PageTitle>

<Pagina Titulo="Licencia" Cargando="_loading" Error="@_error">
    @if (_status.ValueKind == JsonValueKind.Object)
    {
        <MudAlert Severity="@(_status.Bool("isRestricted") ? Severity.Error : _status.Str("state") is "VALID" or "VALID_OFFLINE" ? Severity.Success : Severity.Warning)" Class="mb-4">
            <b>@Estado(_status.Str("state"))</b> · @_status.Str("reason")
            @if (_status.Str("daysLeft") != "")
            {
                <span> Quedan @_status.Str("daysLeft") día(s).</span>
            }
        </MudAlert>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr><td>Empresa</td><td>@_status.Str("organizationName") @_status.Str("organizationNit")</td></tr>
                        <tr><td>Edición</td><td>@(_status.Str("edition") == "MULTI" ? "Multicaja" : _status.Str("edition") == "SINGLE" ? "Caja Única" : "—")</td></tr>
                        <tr><td>Clave</td><td>@(_status.Str("licenseKeyPrefix") is { Length: > 0 } prefix ? prefix + "…" : "Sin activar")</td></tr>
                        <tr><td>Vigente hasta</td><td>@Format.Date(_status.Date("validUntil"))</td></tr>
                        <tr><td>Última verificación</td><td>@Format.Date(_status.Date("lastCheckinAt")) @_status.Str("lastCheckinError")</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudItem>
            <MudItem xs="12" md="6">
                @if (Session.Has("licensing.license.manage"))
                {
                    <MudTextField @bind-Value="_key" Label="Clave de licencia (POS-XXXXX-XXXXX-XXXXX-XXXXX)" Immediate="true" />
                    <MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="ActivarAsync">Activar</MudButton>
                }
                @if (Session.Has("licensing.license.check") && _status.Str("licenseKeyPrefix") != "")
                {
                    <MudButton Class="mt-2 ml-2" Variant="Variant.Outlined" Disabled="_busy" OnClick="VerificarAsync">Verificar ahora</MudButton>
                }
                @if (Session.Has("licensing.license.manage") && _status.Str("licenseKeyPrefix") != "")
                {
                    <MudButton Class="mt-2 ml-2" Variant="Variant.Outlined" Color="Color.Error" Disabled="_busy" OnClick="@(async () => { if (await Dialogs.ConfirmarAsync("Liberar este equipo", "La licencia deja de estar activada en este equipo para que pueda activarla en otro.", "Liberar", true)) { await LiberarAsync(); } })">Liberar este equipo</MudButton>
                }
            </MudItem>
        </MudGrid>
    }
</Pagina>

@code {
    private JsonElement _status;
    private bool _loading = true, _busy;
    private string? _error, _key;

    protected override async Task OnInitializedAsync()
    {
        await Ejecutar(() => Api.GetAsync<JsonElement>("api/v1/license"), null);
        _loading = false;
    }

    private static string Estado(string state) => state switch
    {
        "DEMO" => "Demostración",
        "VALID" => "Vigente",
        "VALID_OFFLINE" => "Vigente (sin conexión reciente)",
        "GRACE" => "En gracia",
        "RESTRICTED" => "Restringida",
        "REACTIVATION_REQUIRED" => "Requiere reactivación",
        _ => state,
    };

    private Task ActivarAsync() => Ejecutar(() => Api.PostAsync<JsonElement>("api/v1/license/activate", new { licenseKey = _key }), "Licencia activada.");

    private Task VerificarAsync() => Ejecutar(() => Api.PostAsync<JsonElement>("api/v1/license/check"), "Verificación terminada.");

    private Task LiberarAsync() => Ejecutar(() => Api.PostAsync<JsonElement>("api/v1/license/deactivate", new { reason = "Liberado desde la administración" }), "Equipo liberado.");

    private async Task Ejecutar(Func<Task<JsonElement>> action, string? message)
    {
        _busy = true;
        try
        {
            _status = await action();
            if (message is not null)
            {
                Snackbar.Add(message, Severity.Success);
                Session.Refresh(await Api.GetAsync<MeInfo>("api/v1/auth/me"));
            }
        }
        catch (ApiException ex)
        {
            if (message is null)
            {
                _error = ex.Texto;
            }
            else
            {
                Snackbar.Add(ex.Texto, Severity.Error);
            }
        }

        _busy = false;
    }
}
