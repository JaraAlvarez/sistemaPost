@page "/admin/gastos"
@using Pos.Modules.Cash.Contracts
@using Pos.Modules.Expenses.Contracts
@inject ApiClient Api
@inject SessionState Session
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Gastos · BusinessPost</PageTitle>

<Pagina Titulo="Gastos" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (Session.Has("expenses.expense.manage"))
        {
            @if (_tab == 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NuevoAsync">Registrar gasto</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NuevaCategoria">Nueva categoría</MudButton>
            }
        }
    </Acciones>
    <ChildContent>
        <MudTabs ActivePanelIndex="_tab" ActivePanelIndexChanged="CambiarPestana">
            <MudTabPanel Text="Gastos">
                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="my-3">
                    <MudDatePicker @bind-Date="_desde" Label="Desde" DateFormat="dd/MM/yyyy" Style="max-width: 180px" />
                    <MudDatePicker @bind-Date="_hasta" Label="Hasta" DateFormat="dd/MM/yyyy" Style="max-width: 180px" />
                    <MudSelect T="Guid?" @bind-Value="_filtroCategoria" Label="Categoría" Style="max-width: 280px">
                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">Todas</MudSelectItem>
                        @foreach (var category in _categories)
                        {
                            <MudSelectItem T="Guid?" Value="@category.Id">@NombreCategoria(category)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Search" OnClick="FiltrarAsync">Consultar</MudButton>
                </MudStack>
                <MudTable RowsPerPage="25" Items="_items" Dense="true" Hover="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Número</MudTh><MudTh>Fecha</MudTh><MudTh>Categoría</MudTh><MudTh>Descripción</MudTh><MudTh>Medio de pago</MudTh><MudTh>Referencia</MudTh>
                        <MudTh>De la caja</MudTh><MudTh Class="num">Valor</MudTh><MudTh Class="num">IVA</MudTh><MudTh>Estado</MudTh><MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Number</MudTd>
                        <MudTd>@context.BusinessDate.ToString("dd/MM/yyyy", Format.Colombia)</MudTd>
                        <MudTd>@context.CategoryName</MudTd>
                        <MudTd>@context.Description</MudTd>
                        <MudTd>@NombreMedio(context.PaymentMethodId)</MudTd>
                        <MudTd>@context.Reference</MudTd>
                        <MudTd>@(context.CashSessionId is not null ? "Sí" : "")</MudTd>
                        <MudTd Class="num">@Format.Money(context.Amount)</MudTd>
                        <MudTd Class="num">@Format.Money(context.TaxAmount)</MudTd>
                        <MudTd>
                            @if (Anulado(context))
                            {
                                <span title="@context.VoidReason">Anulado</span>
                            }
                            else
                            {
                                <span>Registrado</span>
                            }
                        </MudTd>
                        <MudTd>
                            @if (Session.Has("expenses.expense.manage") && !Anulado(context))
                            {
                                <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => Anular(context))">Anular</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><EstadoVacio Mensaje="No hay gastos en el periodo." /></NoRecordsContent>
                    <PagerContent><Paginador /></PagerContent>
                </MudTable>
                <MudText Typo="Typo.body2" Class="mt-2">
                    @_items.Count gasto(s) · Total registrado (sin anulados): <b>@Format.Money(_items.Where(e => !Anulado(e)).Sum(e => e.Amount))</b>
                </MudText>
            </MudTabPanel>
            <MudTabPanel Text="Categorías">
                <MudTable RowsPerPage="25" Items="_categories" Dense="true" Hover="true" Striped="true" Class="mt-3">
                    <HeaderContent>
                        <MudTh>Categoría</MudTh><MudTh Class="num">Orden</MudTh><MudTh>Estado</MudTh><MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@NombreCategoria(context)</MudTd>
                        <MudTd Class="num">@context.SortOrder</MudTd>
                        <MudTd>@(EnumText.Same(context.Status, "ACTIVE") ? "Activa" : "Inactiva")</MudTd>
                        <MudTd>
                            @if (Session.Has("expenses.expense.manage"))
                            {
                                <MudButton Size="Size.Small" OnClick="@(() => EditarCategoria(context))">Editar</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><EstadoVacio Mensaje="No hay categorías de gasto." /></NoRecordsContent>
                    <PagerContent><Paginador /></PagerContent>
                </MudTable>
            </MudTabPanel>
        </MudTabs>
    </ChildContent>
</Pagina>

@if (_nuevo)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true">
            <h2>Registrar gasto</h2>
            <MudSelect T="Guid?" @bind-Value="_categoria" Label="Categoría">
                @foreach (var category in _categories.Where(c => EnumText.Same(c.Status, "ACTIVE")))
                {
                    <MudSelectItem T="Guid?" Value="@category.Id">@NombreCategoria(category)</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_descripcion" Label="Descripción" Immediate="true" />
            <MudStack Row="true">
                <MudNumericField Culture="@Format.Colombia" T="decimal" @bind-Value="_valor" Label="Valor total pagado" Min="0" />
                <MudNumericField Culture="@Format.Colombia" T="decimal" @bind-Value="_iva" Label="IVA incluido (si aplica)" Min="0" />
            </MudStack>
            <MudSelect T="Guid?" @bind-Value="_medio" Label="Medio de pago">
                @foreach (var method in _methods)
                {
                    <MudSelectItem T="Guid?" Value="@method.Id">@method.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_referencia" Label="Referencia o número de factura (opcional)" Immediate="true" />
            <MudDatePicker @bind-Date="_fecha" Label="Fecha del gasto (vacío = hoy)" DateFormat="dd/MM/yyyy" />
            @if (_sessions.Count > 0)
            {
                <MudSelect T="Guid?" @bind-Value="_jornada" Label="Pagado con dinero de la caja (opcional)">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">No, se pagó fuera de la caja</MudSelectItem>
                    @foreach (var session in _sessions)
                    {
                        <MudSelectItem T="Guid?" Value="@session.Id">
                            Turno @session.Number · caja @session.TerminalCode · @session.CashierName
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.caption">Si sale de la caja, el efectivo se descuenta de ese turno en el mismo momento.</MudText>
            }
            <div class="acciones">
                <MudButton OnClick="@(() => _nuevo = false)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="RegistrarAsync">Registrar</MudButton>
            </div>
        </div>
    </div>
}

@if (_anular is not null)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true">
            <h2>Anular gasto @_anular.Number</h2>
            <MudText Typo="Typo.body2">
                @_anular.Description por @Format.Money(_anular.Amount).
                @if (_anular.CashSessionId is not null)
                {
                    <span> Salió de la caja: el dinero vuelve a ese turno con una corrección.</span>
                }
            </MudText>
            <MudTextField @bind-Value="_motivo" Label="Motivo de la anulación" Immediate="true" AutoFocus="true" />
            <div class="acciones">
                <MudButton OnClick="@(() => _anular = null)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="_busy" OnClick="AnularAsync">Anular</MudButton>
            </div>
        </div>
    </div>
}

@if (_categoriaForm)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true">
            <h2>@(_categoriaId is null ? "Nueva categoría de gasto" : "Editar categoría")</h2>
            <MudTextField @bind-Value="_categoriaNombre" Label="Nombre" Immediate="true" />
            @if (_categoriaId is null)
            {
                <MudSelect T="Guid?" @bind-Value="_categoriaPadre" Label="Dentro de (opcional)">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">Ninguna (categoría principal)</MudSelectItem>
                    @foreach (var category in _categories.Where(c => c.ParentId is null))
                    {
                        <MudSelectItem T="Guid?" Value="@category.Id">@category.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudNumericField Culture="@Format.Colombia" T="int" @bind-Value="_categoriaOrden" Label="Orden" Min="0" />
            @if (_categoriaId is not null)
            {
                <MudCheckBox T="bool" @bind-Value="_categoriaActiva" Label="Activa" />
            }
            <div class="acciones">
                <MudButton OnClick="@(() => _categoriaForm = false)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="GuardarCategoriaAsync">Guardar</MudButton>
            </div>
        </div>
    </div>
}

@code {
    private List<ExpenseDto> _items = [];
    private List<ExpenseCategoryDto> _categories = [];
    private List<PaymentMethodDto> _methods = [];
    private List<CashSessionSummaryDto> _sessions = [];
    private int _tab, _categoriaOrden;
    private string? _error, _descripcion, _referencia, _motivo, _categoriaNombre;
    private bool _loading = true, _busy, _nuevo, _categoriaForm, _categoriaActiva;
    private DateTime? _desde = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1), _hasta = DateTime.Today, _fecha;
    private Guid? _filtroCategoria, _categoria, _medio, _jornada, _categoriaId, _categoriaPadre;
    private decimal _valor, _iva;
    private ExpenseDto? _anular;

    [SupplyParameterFromQuery(Name = "desde")]
    public string? Desde { get; set; }

    [SupplyParameterFromQuery(Name = "hasta")]
    public string? Hasta { get; set; }

    [SupplyParameterFromQuery(Name = "categoria")]
    public string? CategoriaQuery { get; set; }

    /// <summary>"categorias" abre la pestaña de categorías.</summary>
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Pestana { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Sin fechas en la dirección se conserva el rango por omisión (mes en curso).
        _desde = Filtros.Fecha(Desde) ?? _desde;
        _hasta = Filtros.Fecha(Hasta) ?? _hasta;
        _tab = Pestana == "categorias" ? 1 : 0;
        await CargarCategoriasAsync();
        if (Guid.TryParse(CategoriaQuery, out var categoria) && _categories.Any(c => c.Id == categoria))
        {
            _filtroCategoria = categoria;
        }

        try
        {
            _methods = await Api.GetAsync<List<PaymentMethodDto>>("api/v1/cash/payment-methods");
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        await BuscarAsync();
    }

    private void ActualizarFiltros() => Filtros.Actualizar(Navigation, new Dictionary<string, object?>
    {
        ["desde"] = _desde,
        ["hasta"] = _hasta,
        ["categoria"] = _filtroCategoria,
        ["tab"] = _tab == 1 ? "categorias" : null,
    });

    private void CambiarPestana(int tab)
    {
        _tab = tab;
        ActualizarFiltros();
    }

    private Task FiltrarAsync()
    {
        ActualizarFiltros();
        return BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        _loading = true;
        try
        {
            var query = new List<string>();
            if (_desde is { } desde)
            {
                query.Add("from=" + desde.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture));
            }

            if (_hasta is { } hasta)
            {
                query.Add("to=" + hasta.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture));
            }

            if (_filtroCategoria is { } category)
            {
                query.Add($"categoryId={category}");
            }

            _items = await Api.GetAsync<List<ExpenseDto>>($"api/v1/expenses?{string.Join("&", query)}");
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private async Task CargarCategoriasAsync()
    {
        try
        {
            _categories = await Api.GetAsync<List<ExpenseCategoryDto>>("api/v1/expenses/categories");
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }
    }

    private string NombreCategoria(ExpenseCategoryDto category)
    {
        if (category.ParentId is not { } parentId)
        {
            return category.Name;
        }

        var parent = _categories.FirstOrDefault(c => c.Id == parentId)?.Name;
        return !string.IsNullOrEmpty(parent) ? $"{parent} › {category.Name}" : category.Name;
    }

    private string NombreMedio(Guid id) => _methods.FirstOrDefault(m => m.Id == id)?.Name ?? "";

    private static bool Anulado(ExpenseDto expense) => EnumText.Same(expense.Status, "VOIDED");

    private static string? Nulo(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task NuevoAsync()
    {
        _sessions = [];
        if (Session.Has("cash.report.view"))
        {
            try
            {
                _sessions = await Api.GetAsync<List<CashSessionSummaryDto>>("api/v1/cash/sessions?status=OPEN");
            }
            catch (ApiException)
            {
                // Sin jornadas abiertas visibles: el gasto se registra fuera de la caja.
            }
        }

        _categoria = _medio = _jornada = null;
        _descripcion = _referencia = null;
        _valor = _iva = 0;
        _fecha = null;
        _nuevo = true;
    }

    private async Task RegistrarAsync()
    {
        if (_categoria is null || _medio is null)
        {
            Snackbar.Add("Elija la categoría y el medio de pago.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await Api.PostAsync<JsonElement>("api/v1/expenses", new
            {
                categoryId = _categoria,
                description = Nulo(_descripcion),
                amount = _valor,
                taxAmount = _iva,
                paymentMethodId = _medio,
                partyId = (Guid?)null,
                cashSessionId = _jornada,
                reference = Nulo(_referencia),
                businessDate = _fecha is { } fecha ? DateOnly.FromDateTime(fecha) : (DateOnly?)null,
            });
            Snackbar.Add("Gasto registrado.", Severity.Success);
            _nuevo = false;
            await BuscarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private void Anular(ExpenseDto expense)
    {
        _anular = expense;
        _motivo = null;
    }

    private async Task AnularAsync()
    {
        if (_anular is null)
        {
            return;
        }

        _busy = true;
        try
        {
            await Api.PostAsync<JsonElement>($"api/v1/expenses/{_anular.Id}/void", new { reason = Nulo(_motivo) });
            Snackbar.Add("Gasto anulado.", Severity.Success);
            _anular = null;
            await BuscarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private void NuevaCategoria()
    {
        _categoriaId = _categoriaPadre = null;
        _categoriaNombre = null;
        _categoriaOrden = (_categories.Count + 1) * 10;
        _categoriaActiva = true;
        _categoriaForm = true;
    }

    private void EditarCategoria(ExpenseCategoryDto category)
    {
        _categoriaId = category.Id;
        _categoriaPadre = null;
        _categoriaNombre = category.Name;
        _categoriaOrden = category.SortOrder;
        _categoriaActiva = EnumText.Same(category.Status, "ACTIVE");
        _categoriaForm = true;
    }

    private async Task GuardarCategoriaAsync()
    {
        _busy = true;
        try
        {
            if (_categoriaId is { } id)
            {
                await Api.PutAsync<JsonElement>($"api/v1/expenses/categories/{id}", new { name = Nulo(_categoriaNombre), sortOrder = _categoriaOrden, isActive = _categoriaActiva });
                Snackbar.Add("Categoría actualizada.", Severity.Success);
            }
            else
            {
                await Api.PostAsync<JsonElement>("api/v1/expenses/categories", new { name = Nulo(_categoriaNombre), parentId = _categoriaPadre, sortOrder = _categoriaOrden });
                Snackbar.Add("Categoría creada.", Severity.Success);
            }

            _categoriaForm = false;
            await CargarCategoriasAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }
}
