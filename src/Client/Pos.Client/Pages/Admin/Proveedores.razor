@page "/admin/proveedores"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>Proveedores · BusinessPost</PageTitle>

<Pagina Titulo="Proveedores" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (Session.Has("purchasing.supplier.manage"))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/admin/proveedores/nuevo">Nuevo proveedor</MudButton>
        }
    </Acciones>
    <ChildContent>
        <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.Center">
            <MudTextField T="string" @bind-Value="_search" Label="Buscar por nombre, código o identificación" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" DebounceInterval="350" OnDebounceIntervalElapsed="@(_ => FiltrarAsync(_inactivos))" />
            <MudCheckBox T="bool" Value="_inactivos" ValueChanged="@(v => FiltrarAsync(v))" Label="Incluir inactivos" />
        </MudStack>
        <MudTable RowsPerPage="25" Items="_items" Dense="true" Hover="true" Striped="true" RowStyle="cursor:pointer"
                  OnRowClick="@((TableRowClickEventArgs<JsonElement> fila) => Abrir(fila.Item))">
            <HeaderContent>
                <MudTh>Código</MudTh><MudTh>Nombre</MudTh><MudTh>Identificación</MudTh><MudTh Class="num">Plazo</MudTh><MudTh>Factura electrónica</MudTh>
                <MudTh>Estado</MudTh><MudTh Class="num">Saldo por pagar</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Str("code")</MudTd>
                <MudTd><a href="/admin/proveedores/@context.Str("id")" @onclick:stopPropagation="true">@context.Str("name")</a></MudTd>
                <MudTd>@context.Str("identification")</MudTd>
                <MudTd Class="num">@context.Dec("paymentTermDays") días</MudTd>
                <MudTd>@(context.Bool("issuesInvoices") ? "Sí" : "No (documento soporte)")</MudTd>
                <MudTd>@Estado(context.Str("status"))</MudTd>
                <MudTd Class="num">@Format.Money(context.Dec("openBalance"))</MudTd>
            </RowTemplate>
            <NoRecordsContent><EstadoVacio Mensaje="No hay proveedores que coincidan." /></NoRecordsContent>
            <PagerContent><Paginador /></PagerContent>
        </MudTable>
    </ChildContent>
</Pagina>

@code {
    private List<JsonElement> _items = [];
    private string? _search, _error;
    private bool _loading = true, _inactivos;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "inactivos")]
    public string? Inactivos { get; set; }

    protected override Task OnInitializedAsync()
    {
        _search = Q;
        _inactivos = string.Equals(Inactivos, "true", StringComparison.OrdinalIgnoreCase);
        return CargarAsync();
    }

    private static string Estado(string status) => status switch
    {
        "ACTIVE" => "Activo",
        "BLOCKED" => "Bloqueado",
        "INACTIVE" => "Inactivo",
        _ => status,
    };

    private void Abrir(JsonElement supplier) => Navigation.NavigateTo($"/admin/proveedores/{supplier.GetProperty("id").GetGuid()}");

    private async Task FiltrarAsync(bool inactivos)
    {
        _inactivos = inactivos;
        Filtros.Actualizar(Navigation, new Dictionary<string, object?> { ["q"] = _search, ["inactivos"] = _inactivos });
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _loading = true;
        try
        {
            var inactive = _inactivos ? "true" : "false";
            _items = (await Api.GetAsync<JsonElement>($"api/v1/purchasing/suppliers?search={Uri.EscapeDataString(_search ?? "")}&includeInactive={inactive}")).Items();
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }
}
