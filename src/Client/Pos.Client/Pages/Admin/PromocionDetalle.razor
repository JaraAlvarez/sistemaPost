@page "/admin/promociones/nueva"
@page "/admin/promociones/{Id:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@Titulo · BusinessPost</PageTitle>

<Pagina Titulo="@Titulo" Miga="@Miga" Subtitulo="@Subtitulo" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (Id is not null && _promo.ValueKind == JsonValueKind.Object && Session.Has("promotions.promotion.manage"))
        {
            var status = _promo.Str("status");
            if (status is "DRAFT" or "PAUSED")
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PlayArrow" Disabled="_busy"
                           OnClick="@(() => AccionAsync("activate", "Promoción activada."))">Activar</MudButton>
            }
            if (status == "ACTIVE")
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Pause" Disabled="_busy"
                           OnClick="@(() => AccionAsync("pause", "Promoción pausada."))">Pausar</MudButton>
            }
            if (status is "DRAFT" or "ACTIVE" or "PAUSED")
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Stop" Disabled="_busy"
                           OnClick="@(() => _terminar = true)">Terminar</MudButton>
            }
        }
    </Acciones>
    <ChildContent>
        @if (Id is null)
        {
            if (_formListo)
            {
                <MudPaper Outlined="true" Class="pa-4">
                    @Formulario
                </MudPaper>
            }
        }
        else if (_promo.ValueKind == JsonValueKind.Object)
        {
            <MudTabs Elevation="0" Outlined="true" TabPanelsClass="pa-3">
                <MudTabPanel Text="@(Editable ? "Datos" : "Resumen")">
                    @if (Editable)
                    {
                        <MudText Typo="Typo.body2" Class="mb-3">La promoción está en borrador: puede corregirla, simularla y activarla cuando esté lista.</MudText>
                        @Formulario
                    }
                    else
                    {
                        @Resumen
                    }
                </MudTabPanel>
                @if (Session.Has("promotions.promotion.manage"))
                {
                    <MudTabPanel Text="Simular">
                        @Simulador
                    </MudTabPanel>
                }
            </MudTabs>
        }
    </ChildContent>
</Pagina>

@if (_terminar)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true">
            <h2>Terminar @_promo.Str("name")</h2>
            <MudText>Una promoción terminada deja de aplicarse y no se puede volver a activar. ¿Terminarla?</MudText>
            <div class="acciones">
                <MudButton OnClick="@(() => _terminar = false)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="_busy" OnClick="TerminarAsync">Terminar</MudButton>
            </div>
        </div>
    </div>
}

@code {
    private RenderFragment Formulario => __builder =>
    {
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="7">
                <MudTextField @bind-Value="_name" Label="Nombre (3 a 80 caracteres)" Immediate="true" />
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudSelect T="string" @bind-Value="_type" Label="Tipo de promoción">
                    @foreach (var type in Tipos)
                    {
                        <MudSelectItem T="string" Value="@type.Value">@type.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @switch (_type)
            {
                case "MultiBuy":
                    <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="_buy" Label="Lleve (unidades)" Min="2" Max="100" /></MudItem>
                    <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="_pay" Label="Pague (unidades)" Min="0" /></MudItem>
                    break;
                case "SpecialPrice":
                    <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_price" Label="Precio especial por unidad (IVA incluido)" Min="0" /></MudItem>
                    break;
                case "PercentOff":
                    <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_percent" Label="Porcentaje de descuento" Min="0" Max="100" Adornment="Adornment.End" AdornmentText="%" /></MudItem>
                    break;
                case "QuantityPrice":
                    <MudItem xs="6" sm="3"><MudNumericField T="decimal" @bind-Value="_minQty" Label="Desde (cantidad)" Min="0" /></MudItem>
                    <MudItem xs="6" sm="3"><MudNumericField T="decimal" @bind-Value="_price" Label="Precio por unidad (IVA incluido)" Min="0" /></MudItem>
                    break;
                case "Combo":
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal" @bind-Value="_price" Label="Precio del combo (IVA incluido)" Min="0" />
                        <MudText Typo="Typo.caption">El combo lleva dos o más productos distintos; la cantidad de cada uno se indica en la lista.</MudText>
                    </MudItem>
                    break;
            }
        </MudGrid>

        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-5">@(_type == "Combo" ? "Productos del combo" : "Aplica a")</MudText>
        if (_itemsForm.Count == 0)
        {
            <MudText Typo="Typo.body2">Agregue al menos un producto@(_type == "Combo" ? "" : ", categoría o marca").</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true">
                <tbody>
                    @foreach (var item in _itemsForm)
                    {
                        <tr>
                            <td>@item.Kind</td>
                            <td>@item.Label</td>
                            <td style="width: 130px">
                                @if (_type == "Combo")
                                {
                                    <MudNumericField T="decimal" @bind-Value="item.Quantity" Label="Cantidad" Min="0" Margin="Margin.Dense" />
                                }
                            </td>
                            <td><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="Quitar" OnClick="@(() => _itemsForm.Remove(item))" /></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudSelect T="string" @bind-Value="_itemKind" Label="Agregar" Style="max-width: 160px">
                <MudSelectItem T="string" Value="@("product")">Producto</MudSelectItem>
                @if (_type != "Combo")
                {
                    <MudSelectItem T="string" Value="@("category")">Categoría</MudSelectItem>
                    <MudSelectItem T="string" Value="@("brand")">Marca</MudSelectItem>
                }
            </MudSelect>
            @if (_itemKind == "category" && _type != "Combo")
            {
                <MudSelect T="Guid?" @bind-Value="_categorySel" Label="Categoría (incluye sus subcategorías)">
                    @foreach (var category in _categories)
                    {
                        <MudSelectItem T="Guid?" Value="@category.GetProperty("id").GetGuid()">@category.Str("path")</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Size="Size.Small" OnClick="AgregarCategoria">Agregar</MudButton>
            }
            else if (_itemKind == "brand" && _type != "Combo")
            {
                <MudSelect T="Guid?" @bind-Value="_brandSel" Label="Marca">
                    @foreach (var brand in _brands)
                    {
                        <MudSelectItem T="Guid?" Value="@brand.GetProperty("id").GetGuid()">@brand.Str("name")</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Size="Size.Small" OnClick="AgregarMarca">Agregar</MudButton>
            }
            else
            {
                <MudTextField T="string" @bind-Value="_productSearch" Label="Buscar producto por nombre, SKU o código" Immediate="true" DebounceInterval="350"
                              OnDebounceIntervalElapsed="BuscarProductosFormAsync" />
            }
        </MudStack>
        if ((_itemKind == "product" || _type == "Combo") && _productResults.Count > 0)
        {
            <MudSimpleTable Dense="true">
                <tbody>
                    @foreach (var product in _productResults)
                    {
                        <tr>
                            <td>@product.Str("sku")</td>
                            <td>@product.Str("name")</td>
                            <td class="num">@Format.Money(product.Dec("price"))</td>
                            <td><MudButton Size="Size.Small" OnClick="@(() => AgregarProducto(product))">Agregar</MudButton></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-5">Vigencia</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="_desde" Label="Desde el día" DateFormat="dd/MM/yyyy" /></MudItem>
            <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="_hasta" Label="Hasta el día, inclusive (opcional)" DateFormat="dd/MM/yyyy" /></MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.caption">Días de la semana (ninguno marcado = todos los días)</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="0">
                    @foreach (var day in Dias)
                    {
                        <MudCheckBox T="bool" Value="@_dias.Contains(day.Day)" ValueChanged="@((bool v) => CambiarDia(day.Day, v))" Label="@day.Label" />
                    }
                </MudStack>
            </MudItem>
            <MudItem xs="12" sm="6"><MudTimePicker @bind-Time="_horaDesde" Label="Desde la hora (opcional)" /></MudItem>
            <MudItem xs="12" sm="6"><MudTimePicker @bind-Time="_horaHasta" Label="Hasta la hora (opcional)" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="int?" @bind-Value="_maxApp" Label="Máximo de aplicaciones por venta (opcional)" Min="1" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_ticket" Label="Texto en el tiquete (opcional, 40 caracteres)" MaxLength="40" Immediate="true" /></MudItem>
        </MudGrid>
        if (_branchIds.Count > 0)
        {
            <MudText Typo="Typo.caption">Rige solo en @_branchIds.Count sucursal(es) elegidas; se conservan.</MudText>
        }
        else
        {
            <MudText Typo="Typo.caption">Rige en todas las sucursales.</MudText>
        }
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
            @if (Id is null)
            {
                <MudButton Href="/admin/promociones">Cancelar</MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="GuardarAsync">@(Id is null ? "Guardar borrador" : "Guardar cambios")</MudButton>
        </MudStack>
    };

    private RenderFragment Resumen => __builder =>
    {
        <MudSimpleTable Dense="true">
            <tbody>
                <tr><td>Tipo</td><td>@NombreTipo(_promo.Str("type"))</td></tr>
                <tr><td>Condición</td><td>@Condicion(_promo)</td></tr>
                <tr><td>Desde</td><td>@Format.Date(_promo.Date("validFrom"))</td></tr>
                <tr><td>Hasta</td><td>@(_promo.Date("validTo") is { } to ? $"{to.ToLocalTime().AddTicks(-1).ToString("dd/MM/yyyy", Format.Colombia)}, inclusive" : "Sin fecha de fin")</td></tr>
                <tr><td>Días</td><td>@DiasTexto(_promo)</td></tr>
                <tr><td>Horario</td><td>@(_promo.Str("startTime").Length > 0 || _promo.Str("endTime").Length > 0 ? $"{Texto(_promo.Str("startTime"))} a {Texto(_promo.Str("endTime"))}" : "Todo el día")</td></tr>
                <tr><td>Máximo por venta</td><td>@(_promo.Dec("maxApplications") > 0 ? Format.Quantity(_promo.Dec("maxApplications")) : "Sin límite")</td></tr>
                <tr><td>Texto en el tiquete</td><td>@Texto(_promo.Str("ticketText"))</td></tr>
                <tr><td>Sucursales</td><td>@(_promo.Prop("branchIds").Items().Count is > 0 and var n ? $"Solo {n} sucursal(es) elegidas" : "Todas")</td></tr>
                <tr><td>Activada</td><td>@Format.Date(_promo.Date("activatedAt"))</td></tr>
                <tr><td>Terminada</td><td>@Format.Date(_promo.Date("endedAt"))</td></tr>
            </tbody>
        </MudSimpleTable>
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-5">@(_promo.Str("type") == "COMBO" ? "Productos del combo" : "Aplica a")</MudText>
        if (_promo.Prop("items").Items() is { Count: > 0 } items)
        {
            <MudSimpleTable Dense="true">
                <thead><tr><th>Tipo</th><th>Nombre</th><th class="num">Cantidad</th></tr></thead>
                <tbody>
                    @foreach (var i in items)
                    {
                        <tr>
                            <td>@(i.Str("productId").Length > 0 ? "Producto" : i.Str("categoryId").Length > 0 ? "Categoría" : "Marca")</td>
                            <td>@(i.Str("productName") is { Length: > 0 } pn ? pn : i.Str("categoryName") is { Length: > 0 } cn ? cn : i.Str("brandName"))</td>
                            <td class="num">@Format.Quantity(i.Dec("quantity"))</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
        else
        {
            <EstadoVacio Compacto="true" Mensaje="La promoción no tiene productos, categorías ni marcas." />
        }
    };

    private RenderFragment Simulador => __builder =>
    {
        <MudText Typo="Typo.body2">Venta de ejemplo calculada con el mismo motor de la caja. No se guarda nada.</MudText>
        <MudSimpleTable Dense="true" Class="mt-2">
            <tbody>
                @foreach (var line in _lineas)
                {
                    <tr>
                        <td>@line.Label</td>
                        <td style="width: 140px"><MudNumericField T="decimal" @bind-Value="line.Quantity" Label="Cantidad" Min="0" Margin="Margin.Dense" /></td>
                        <td><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="Quitar" OnClick="@(() => _lineas.Remove(line))" /></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        <MudTextField T="string" @bind-Value="_simSearch" Label="Agregar producto (nombre, SKU o código)" Immediate="true" DebounceInterval="350"
                      OnDebounceIntervalElapsed="BuscarProductosSimAsync" />
        if (_simResults.Count > 0)
        {
            <MudSimpleTable Dense="true">
                <tbody>
                    @foreach (var product in _simResults)
                    {
                        <tr>
                            <td>@product.Str("sku")</td>
                            <td>@product.Str("name")</td>
                            <td class="num">@Format.Money(product.Dec("price"))</td>
                            <td><MudButton Size="Size.Small" OnClick="@(() => AgregarLinea(product))">Agregar</MudButton></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Calculate" Disabled="_busy" OnClick="EjecutarSimulacionAsync">Simular</MudButton>
        </MudStack>
        if (_resultado.ValueKind == JsonValueKind.Object)
        {
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-3">Resultado</MudText>
            <div style="overflow-x: auto">
                <MudSimpleTable Dense="true">
                    <thead>
                        <tr><th>Producto</th><th class="num">Cantidad</th><th class="num">Precio</th><th class="num">Bruto</th><th>Promoción</th><th class="num">Descuento</th><th class="num">Total</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _resultado.Prop("lines").Items())
                        {
                            <tr>
                                <td>@line.Str("sku") · @line.Str("name")</td>
                                <td class="num">@Format.Quantity(line.Dec("quantity"))</td>
                                <td class="num">@Format.Money(line.Dec("unitPrice"))</td>
                                <td class="num">@Format.Money(line.Dec("gross"))</td>
                                <td>@line.Str("promotionName")</td>
                                <td class="num">@Format.Money(line.Dec("promotionDiscount"))</td>
                                <td class="num">@Format.Money(line.Dec("total"))</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="3"><b>Totales</b></td>
                            <td class="num"><b>@Format.Money(_resultado.Dec("gross"))</b></td>
                            <td></td>
                            <td class="num"><b>@Format.Money(_resultado.Dec("promotionTotal"))</b></td>
                            <td class="num"><b>@Format.Money(_resultado.Dec("total"))</b></td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </div>
        }
    };

    private static readonly (string Value, string Code, string Label)[] Tipos =
    [
        ("MultiBuy", "MULTI_BUY", "Lleve N pague M"),
        ("SpecialPrice", "SPECIAL_PRICE", "Precio especial"),
        ("PercentOff", "PERCENT_OFF", "Descuento en porcentaje"),
        ("QuantityPrice", "QUANTITY_PRICE", "Precio por cantidad"),
        ("Combo", "COMBO", "Combo a precio fijo"),
    ];

    private static readonly (DayOfWeek Day, string Label)[] Dias =
    [
        (DayOfWeek.Monday, "Lun"), (DayOfWeek.Tuesday, "Mar"), (DayOfWeek.Wednesday, "Mié"), (DayOfWeek.Thursday, "Jue"),
        (DayOfWeek.Friday, "Vie"), (DayOfWeek.Saturday, "Sáb"), (DayOfWeek.Sunday, "Dom"),
    ];

    private List<JsonElement> _categories = [];
    private List<JsonElement> _brands = [];
    private List<JsonElement> _productResults = [];
    private List<JsonElement> _simResults = [];
    private List<ItemForm> _itemsForm = [];
    private List<LineaForm> _lineas = [];
    private List<Guid> _branchIds = [];
    private HashSet<DayOfWeek> _dias = [];
    private string _type = "SpecialPrice", _itemKind = "product";
    private string? _error, _name, _ticket, _productSearch, _simSearch;
    private bool _loading = true, _busy, _terminar, _formListo, _iniciado;
    private Guid? _categorySel, _brandSel, _cargado;
    private DateTime? _desde, _hasta;
    private TimeSpan? _horaDesde, _horaHasta;
    private int _buy = 3, _pay = 2;
    private int? _maxApp;
    private decimal _price, _percent, _minQty;
    private JsonElement _promo, _resultado;

    /// <summary>Id de la promoción; nulo en <c>/admin/promociones/nueva</c>.</summary>
    [Parameter]
    public Guid? Id { get; set; }

    private string Titulo => Id is null ? "Nueva promoción" : _promo.Str("name") is { Length: > 0 } name ? name : "Promoción";

    private string Miga => Id is null ? "Nueva promoción" : _promo.Str("number") is { Length: > 0 } number ? $"Promoción {number}" : "Promoción";

    private string? Subtitulo => Id is not null && _promo.ValueKind == JsonValueKind.Object
        ? $"{_promo.Str("number")} · {NombreTipo(_promo.Str("type"))} · {NombreEstado(_promo.Str("status"))}"
        : null;

    /// <summary>Solo un borrador se corrige (una activa se pausa o se termina y se crea otra).</summary>
    private bool Editable => _formListo && _promo.Str("status") == "DRAFT" && Session.Has("promotions.promotion.manage");

    protected override async Task OnParametersSetAsync()
    {
        if (_iniciado && _cargado == Id)
        {
            return;
        }

        _iniciado = true;
        _cargado = Id;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _loading = true;
        _error = null;
        _terminar = false;
        _formListo = false;
        if (Id is not { } id)
        {
            _promo = default;
            if (await CargarMaestrosAsync())
            {
                NuevoFormulario();
            }
        }
        else
        {
            try
            {
                _promo = await Api.GetAsync<JsonElement>($"api/v1/promotions/{id}");
            }
            catch (ApiException ex)
            {
                _promo = default;
                _error = ex.Texto;
            }

            if (_promo.ValueKind == JsonValueKind.Object)
            {
                if (_promo.Str("status") == "DRAFT" && Session.Has("promotions.promotion.manage") && await CargarMaestrosAsync())
                {
                    LlenarFormulario(_promo);
                }

                PrepararSimulacion(_promo);
            }
        }

        _loading = false;
    }

    internal static string NombreTipo(string code) => Tipos.FirstOrDefault(t => t.Code == code).Label ?? code;

    internal static string NombreEstado(string status) => status switch
    {
        "DRAFT" => "Borrador",
        "ACTIVE" => "Activa",
        "PAUSED" => "Pausada",
        "ENDED" => "Terminada",
        _ => status,
    };

    private static string? Nulo(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string Texto(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string Condicion(JsonElement promotion) => promotion.Str("type") switch
    {
        "MULTI_BUY" => $"Lleve {Format.Quantity(promotion.Dec("buyQuantity"))} pague {Format.Quantity(promotion.Dec("payQuantity"))}",
        "SPECIAL_PRICE" => $"Precio especial de {Format.Money(promotion.Dec("price"))} por unidad",
        "PERCENT_OFF" => $"{promotion.Dec("percent").ToString("0.##", Format.Colombia)} % de descuento",
        "QUANTITY_PRICE" => $"Desde {Format.Quantity(promotion.Dec("minQuantity"))} unidades, {Format.Money(promotion.Dec("price"))} por unidad",
        "COMBO" => $"Combo a {Format.Money(promotion.Dec("price"))}",
        _ => "—",
    };

    private static string DiasTexto(JsonElement promotion)
    {
        var days = promotion.Prop("days").Items().Select(d => Enum.TryParse<DayOfWeek>(d.ToString(), true, out var day) ? day : (DayOfWeek?)null)
            .OfType<DayOfWeek>().ToHashSet();
        return days.Count is 0 or 7 ? "Todos los días" : string.Join(", ", Dias.Where(d => days.Contains(d.Day)).Select(d => d.Label));
    }

    private async Task<bool> CargarMaestrosAsync()
    {
        try
        {
            if (_categories.Count == 0)
            {
                _categories = (await Api.GetAsync<JsonElement>("api/v1/catalog/categories")).Items();
            }

            if (_brands.Count == 0)
            {
                _brands = (await Api.GetAsync<JsonElement>("api/v1/catalog/brands")).Items();
            }

            return true;
        }
        catch (ApiException ex)
        {
            if (Id is null)
            {
                _error = ex.Texto;
            }
            else
            {
                Snackbar.Add(ex.Texto, Severity.Error);
            }

            return false;
        }
    }

    private void NuevoFormulario()
    {
        _name = _ticket = _productSearch = null;
        _type = "SpecialPrice";
        _itemKind = "product";
        _buy = 3;
        _pay = 2;
        _price = _percent = _minQty = 0;
        _maxApp = null;
        _desde = DateTime.Today;
        _hasta = null;
        _horaDesde = _horaHasta = null;
        _dias = [];
        _branchIds = [];
        _itemsForm = [];
        _productResults = [];
        _formListo = true;
    }

    private void LlenarFormulario(JsonElement promotion)
    {
        _name = promotion.Str("name");
        _type = Tipos.FirstOrDefault(t => t.Code == promotion.Str("type")).Value ?? "SpecialPrice";
        _buy = (int)promotion.Dec("buyQuantity");
        _pay = (int)promotion.Dec("payQuantity");
        _price = promotion.Dec("price");
        _percent = promotion.Dec("percent");
        _minQty = promotion.Dec("minQuantity");
        _maxApp = promotion.Dec("maxApplications") is > 0 and var max ? (int)max : null;
        _ticket = Nulo(promotion.Str("ticketText"));
        _desde = promotion.Date("validFrom")?.ToLocalTime().Date;
        _hasta = promotion.Date("validTo") is { } to ? to.ToLocalTime().AddTicks(-1).Date : null;
        _horaDesde = Hora(promotion.Str("startTime"));
        _horaHasta = Hora(promotion.Str("endTime"));
        var days = promotion.Prop("days").Items().Select(d => Enum.TryParse<DayOfWeek>(d.ToString(), true, out var day) ? day : (DayOfWeek?)null)
            .OfType<DayOfWeek>().ToHashSet();
        if (days.Count == 7)
        {
            days.Clear();
        }

        _dias = days;
        _branchIds = promotion.Prop("branchIds").Items().Select(b => b.GetGuid()).ToList();
        _itemsForm = promotion.Prop("items").Items().Select(i => new ItemForm
        {
            ProductId = Guid.TryParse(i.Str("productId"), out var p) ? p : null,
            CategoryId = Guid.TryParse(i.Str("categoryId"), out var c) ? c : null,
            BrandId = Guid.TryParse(i.Str("brandId"), out var b) ? b : null,
            Kind = i.Str("productId").Length > 0 ? "Producto" : i.Str("categoryId").Length > 0 ? "Categoría" : "Marca",
            Label = i.Str("productName") is { Length: > 0 } pn ? pn : i.Str("categoryName") is { Length: > 0 } cn ? cn : i.Str("brandName"),
            Quantity = i.Dec("quantity") > 0 ? i.Dec("quantity") : 1m,
        }).ToList();
        _itemKind = "product";
        _productSearch = null;
        _productResults = [];
        _formListo = true;
    }

    private static TimeSpan? Hora(string value) =>
        TimeOnly.TryParse(value, CultureInfo.InvariantCulture, out var time) ? time.ToTimeSpan() : null;

    private void CambiarDia(DayOfWeek day, bool selected)
    {
        if (selected)
        {
            _dias.Add(day);
        }
        else
        {
            _dias.Remove(day);
        }
    }

    private async Task BuscarProductosFormAsync(string _) => _productResults = await BuscarProductosAsync(_productSearch);

    private async Task BuscarProductosSimAsync(string _) => _simResults = await BuscarProductosAsync(_simSearch);

    private async Task<List<JsonElement>> BuscarProductosAsync(string? search)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return [];
        }

        try
        {
            return (await Api.GetAsync<JsonElement>($"api/v1/catalog/products?pageSize=10&search={Uri.EscapeDataString(search)}")).Items();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
            return [];
        }
    }

    private void AgregarProducto(JsonElement product)
    {
        var id = product.GetProperty("id").GetGuid();
        if (_itemsForm.All(i => i.ProductId != id))
        {
            _itemsForm.Add(new ItemForm { ProductId = id, Kind = "Producto", Label = $"{product.Str("sku")} · {product.Str("name")}", Quantity = 1m });
        }
    }

    private void AgregarCategoria()
    {
        if (_categorySel is { } id && _itemsForm.All(i => i.CategoryId != id))
        {
            _itemsForm.Add(new ItemForm { CategoryId = id, Kind = "Categoría", Label = _categories.First(c => c.GetProperty("id").GetGuid() == id).Str("path"), Quantity = 1m });
        }
    }

    private void AgregarMarca()
    {
        if (_brandSel is { } id && _itemsForm.All(i => i.BrandId != id))
        {
            _itemsForm.Add(new ItemForm { BrandId = id, Kind = "Marca", Label = _brands.First(b => b.GetProperty("id").GetGuid() == id).Str("name"), Quantity = 1m });
        }
    }

    private async Task GuardarAsync()
    {
        if (_desde is not { } desde)
        {
            Snackbar.Add("Indique desde qué día rige la promoción.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var combo = _type == "Combo";
            var body = new
            {
                name = Nulo(_name),
                type = _type,
                validFrom = new DateTimeOffset(desde.Date),
                validTo = _hasta is { } hasta ? new DateTimeOffset(hasta.Date.AddDays(1)) : (DateTimeOffset?)null,
                days = _dias.Count is 0 or 7 ? null : Dias.Where(d => _dias.Contains(d.Day)).Select(d => d.Day.ToString()).ToList(),
                startTime = _horaDesde is { } start ? TimeOnly.FromTimeSpan(start) : (TimeOnly?)null,
                endTime = _horaHasta is { } end ? TimeOnly.FromTimeSpan(end) : (TimeOnly?)null,
                branchIds = _branchIds,
                maxApplications = _maxApp,
                ticketText = Nulo(_ticket),
                buyQuantity = _type == "MultiBuy" ? _buy : (int?)null,
                payQuantity = _type == "MultiBuy" ? _pay : (int?)null,
                price = _type is "SpecialPrice" or "QuantityPrice" or "Combo" ? _price : (decimal?)null,
                percent = _type == "PercentOff" ? _percent : (decimal?)null,
                minQuantity = _type == "QuantityPrice" ? _minQty : (decimal?)null,
                items = _itemsForm
                    .Where(i => !combo || i.ProductId is not null)
                    .Select(i => new { productId = i.ProductId, packagingId = (Guid?)null, categoryId = i.CategoryId, brandId = i.BrandId, quantity = combo ? i.Quantity : 1m })
                    .ToList(),
            };
            if (Id is { } id)
            {
                await Api.PutAsync<JsonElement>($"api/v1/promotions/{id}", body);
                Snackbar.Add("Promoción actualizada.", Severity.Success);
                _busy = false;
                await CargarAsync();
            }
            else
            {
                var created = await Api.PostAsync<JsonElement>("api/v1/promotions", body);
                Snackbar.Add("Promoción creada en borrador. Simúlela y actívela cuando esté lista.", Severity.Success);
                _busy = false;
                Navigation.NavigateTo($"/admin/promociones/{created.GetProperty("id").GetGuid()}", replace: true);
            }

            return;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private async Task AccionAsync(string action, string message)
    {
        if (Id is not { } id)
        {
            return;
        }

        _busy = true;
        try
        {
            await Api.PostAsync<JsonElement>($"api/v1/promotions/{id}/{action}");
            Snackbar.Add(message, Severity.Success);
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private async Task TerminarAsync()
    {
        _terminar = false;
        await AccionAsync("end", "Promoción terminada.");
    }

    /// <summary>Venta de ejemplo inicial: los productos de la promoción con la cantidad que la dispara.</summary>
    private void PrepararSimulacion(JsonElement promotion)
    {
        var type = promotion.Str("type");
        _lineas = promotion.Prop("items").Items()
            .Where(i => i.Str("productId").Length > 0)
            .Select(i => new LineaForm
            {
                ProductId = i.GetProperty("productId").GetGuid(),
                Label = i.Str("productName"),
                Quantity = type switch
                {
                    "MULTI_BUY" => promotion.Dec("buyQuantity"),
                    "QUANTITY_PRICE" => promotion.Dec("minQuantity"),
                    "COMBO" => i.Dec("quantity"),
                    _ => 1m,
                },
            })
            .ToList();
        _simSearch = null;
        _simResults = [];
        _resultado = default;
    }

    private void AgregarLinea(JsonElement product)
    {
        var id = product.GetProperty("id").GetGuid();
        if (_lineas.FirstOrDefault(l => l.ProductId == id) is { } line)
        {
            line.Quantity += 1m;
        }
        else
        {
            _lineas.Add(new LineaForm { ProductId = id, Label = $"{product.Str("sku")} · {product.Str("name")}", Quantity = 1m });
        }
    }

    private async Task EjecutarSimulacionAsync()
    {
        if (Id is not { } id)
        {
            return;
        }

        if (_lineas.Count == 0)
        {
            Snackbar.Add("Agregue al menos un producto a la venta de ejemplo.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            _resultado = await Api.PostAsync<JsonElement>(
                $"api/v1/promotions/{id}/simulate",
                _lineas.Select(l => new { productId = l.ProductId, packagingId = (Guid?)null, quantity = l.Quantity }).ToList());
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private sealed class ItemForm
    {
        public Guid? ProductId { get; init; }

        public Guid? CategoryId { get; init; }

        public Guid? BrandId { get; init; }

        public string Kind { get; init; } = "";

        public string Label { get; init; } = "";

        public decimal Quantity { get; set; } = 1m;
    }

    private sealed class LineaForm
    {
        public Guid ProductId { get; init; }

        public string Label { get; init; } = "";

        public decimal Quantity { get; set; } = 1m;
    }
}
