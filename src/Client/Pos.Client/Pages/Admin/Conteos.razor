@page "/admin/conteos"
@inject ApiClient Api
@inject SessionState Session
@inject Bodegas Bodegas
@inject NavigationManager Navigation

<PageTitle>Conteos · BusinessPost</PageTitle>

<Pagina Titulo="Conteos físicos" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (Session.Has("inventory.count.manage"))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/admin/conteos/nuevo">Nuevo conteo</MudButton>
        }
    </Acciones>
    <ChildContent>
        <MudSelect T="string" Value="_estado" ValueChanged="@(v => FiltrarAsync(v))" Label="Estado" Class="mb-3" Style="max-width: 280px">
            <MudSelectItem T="string" Value="@("")">Todos</MudSelectItem>
            <MudSelectItem T="string" Value="@("DRAFT")">Borrador</MudSelectItem>
            <MudSelectItem T="string" Value="@("IN_PROGRESS")">En curso</MudSelectItem>
            <MudSelectItem T="string" Value="@("IN_REVIEW")">En revisión</MudSelectItem>
            <MudSelectItem T="string" Value="@("POSTED")">Aprobado</MudSelectItem>
            <MudSelectItem T="string" Value="@("CANCELLED")">Anulado</MudSelectItem>
        </MudSelect>
        <MudTable RowsPerPage="25" Items="_items" Dense="true" Hover="true" Striped="true" Class="fila-clic"
                  OnRowClick="@((TableRowClickEventArgs<JsonElement> e) => Ver(e.Item))">
            <HeaderContent>
                <MudTh>Número</MudTh><MudTh>Creado</MudTh><MudTh>Bodega</MudTh><MudTh>Estado</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Str("number")</MudTd>
                <MudTd>@Format.Date(context.Date("createdAt"))</MudTd>
                <MudTd>@Bodegas.Nombre(context.Str("warehouseId"))</MudTd>
                <MudTd>@Estado(context.Str("status"))</MudTd>
                @* El clic del botón sube a la fila (OnRowClick): así se navega una sola vez. *@
                <MudTd><MudButton Size="Size.Small">Ver</MudButton></MudTd>
            </RowTemplate>
            <NoRecordsContent><EstadoVacio Mensaje="No hay conteos." /></NoRecordsContent>
            <PagerContent><Paginador /></PagerContent>
        </MudTable>
    </ChildContent>
</Pagina>

@code {
    private List<JsonElement> _items = [];
    private string _estado = "";
    private string? _error;
    private bool _loading = true;

    private static readonly string[] Estados = ["DRAFT", "IN_PROGRESS", "IN_REVIEW", "POSTED", "CANCELLED"];

    [SupplyParameterFromQuery(Name = "estado")]
    public string? EstadoQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (EstadoQuery is { } estado && Estados.Contains(estado, StringComparer.Ordinal))
        {
            _estado = estado;
        }

        await Bodegas.CargarAsync();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _loading = true;
        try
        {
            _items = (await Api.GetAsync<JsonElement>($"api/v1/inventory/counts{(string.IsNullOrEmpty(_estado) ? "" : "?status=" + Uri.EscapeDataString(_estado))}")).Items();
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private async Task FiltrarAsync(string? estado)
    {
        _estado = estado ?? "";
        Filtros.Actualizar(Navigation, new Dictionary<string, object?> { ["estado"] = _estado });
        await CargarAsync();
    }

    private void Ver(JsonElement count) => Navigation.NavigateTo($"/admin/conteos/{count.GetProperty("id").GetGuid()}");

    private static string Estado(string status) => status switch
    {
        "DRAFT" => "Borrador",
        "IN_PROGRESS" => "En curso",
        "IN_REVIEW" => "En revisión",
        "POSTED" => "Aprobado",
        "CANCELLED" => "Anulado",
        _ => status,
    };
}
