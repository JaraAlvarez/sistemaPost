    // ------------------------------------------------------------------------------------------ Parámetros

    private async Task CargarParametrosAsync()
    {
        try
        {
            var query = _nivel is { } branchId ? $"?branchId={branchId}" : "";
            _parametros = [.. (await Api.GetAsync<JsonElement>("api/v1/settings" + query)).Items().OrderBy(s => s.Str("key"), StringComparer.Ordinal)];
            _errorParametros = null;
        }
        catch (ApiException ex)
        {
            _errorParametros = ex.Message;
        }
    }

    private async Task CambiarNivelAsync(Guid? nivel)
    {
        _nivel = nivel;
        await CargarParametrosAsync();
    }

    private bool FiltroParametro(JsonElement setting) =>
        string.IsNullOrWhiteSpace(_buscarParametro)
        || setting.Str("key").Contains(_buscarParametro, StringComparison.OrdinalIgnoreCase)
        || setting.Str("description").Contains(_buscarParametro, StringComparison.OrdinalIgnoreCase);

    private bool Permitido(JsonElement setting) => setting.Prop("allowedScopes").Items().Any(s => s.ToString() == Alcance);

    private void EditarParametro(JsonElement setting)
    {
        var value = setting.Prop("value");
        _valorBool = value.ValueKind == JsonValueKind.True;
        _valorTexto = value.ValueKind switch
        {
            JsonValueKind.String => value.GetString(),
            JsonValueKind.Null or JsonValueKind.Undefined => "",
            _ => value.GetRawText(),
        };
        _parametro = setting;
    }

    private async Task GuardarParametroAsync()
    {
        JsonElement value;
        var current = _parametro.Prop("value");
        if (EsBooleano(current))
        {
            value = JsonSerializer.SerializeToElement(_valorBool);
        }
        else if (current.ValueKind == JsonValueKind.String)
        {
            value = JsonSerializer.SerializeToElement(_valorTexto ?? "");
        }
        else
        {
            try
            {
                using var document = JsonDocument.Parse(string.IsNullOrWhiteSpace(_valorTexto) ? "null" : _valorTexto);
                value = document.RootElement.Clone();
            }
            catch (JsonException)
            {
                Snackbar.Add("El valor no tiene un formato válido: escriba un número (con punto decimal), una lista o un valor JSON.", Severity.Error);
                return;
            }
        }

        _busy = true;
        try
        {
            await Api.PutAsync<JsonElement?>($"api/v1/settings/{Uri.EscapeDataString(_parametro.Str("key"))}", new { scope = Alcance, scopeId = _nivel, value });
            Snackbar.Add("Parámetro guardado.", Severity.Success);
            _parametro = default;
            await CargarParametrosAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        _busy = false;
    }

    private async Task QuitarParametroAsync(JsonElement setting)
    {
        try
        {
            var scopeId = _nivel is { } id ? $"&scopeId={id}" : "";
            await Api.SendAsync<JsonElement?>(HttpMethod.Delete, $"api/v1/settings/{Uri.EscapeDataString(setting.Str("key"))}?scope={Alcance}{scopeId}", null);
            Snackbar.Add("Excepción eliminada: el parámetro vuelve a heredar.", Severity.Success);
            await CargarParametrosAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // ------------------------------------------------------------------------------------------ Comunes

    private static string? Vacio(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static bool Activo(JsonElement element) => string.Equals(element.Str("status"), "Active", StringComparison.OrdinalIgnoreCase);

    private static bool EsBooleano(JsonElement value) => value.ValueKind is JsonValueKind.True or JsonValueKind.False;

    private static string Estado(string status) => status.ToUpperInvariant() switch
    {
        "ACTIVE" => "Activo",
        "INACTIVE" => "Inactivo",
        "BLOCKED" => "Bloqueado",
        _ => status,
    };

    private static string TipoBodega(string kind) => kind switch
    {
        "SalesFloor" => "Piso de venta",
        "Storage" => "Depósito",
        "Damaged" => "Averías",
        "InTransit" => "En tránsito",
        _ => kind,
    };

    private static string TipoMedio(string kind) => kind switch
    {
        "CASH" => "Efectivo",
        "DEBIT_CARD" => "Tarjeta débito",
        "CREDIT_CARD" => "Tarjeta crédito",
        "TRANSFER" => "Transferencia",
        "WALLET" => "Billetera digital",
        "VOUCHER" => "Bono",
        "OTHER" => "Otro",
        _ => kind,
    };

    private static string Origen(string source) => source switch
    {
        "Default" => "valor por defecto",
        "Company" => "empresa",
        "Branch" => "sucursal",
        "Terminal" => "caja",
        _ => source,
    };

    private static string Valor(JsonElement value) => value.ValueKind switch
    {
        JsonValueKind.String => value.GetString() ?? "",
        JsonValueKind.True => "Sí",
        JsonValueKind.False => "No",
        JsonValueKind.Null or JsonValueKind.Undefined => "—",
        _ => value.GetRawText(),
    };
}
