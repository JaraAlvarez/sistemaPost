@page "/admin/backups"
@using Pos.Modules.Backup.Contracts
@inject ApiClient Api
@inject SessionState Session
@inject ISnackbar Snackbar

<PageTitle>Backups · BusinessPost</PageTitle>

<Pagina Titulo="Backups" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (Session.Has("backup.backup.run"))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Backup" Disabled="_busy" OnClick="RespaldarAsync">Respaldar ahora</MudButton>
        }
    </Acciones>
    <ChildContent>
        @if (_alerts is { } alerts)
        {
            @if (alerts.RecoveryCodePending)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-2">
                    Falta confirmar el código de recuperación: sin él los backups solo se abren en este equipo.
                    @if (Session.Has("backup.recovery.manage"))
                    {
                        <MudButton Size="Size.Small" Class="ml-2" OnClick="GenerarCodigoAsync">Generar el código</MudButton>
                    }
                </MudAlert>
            }
            @if (alerts.LastBackupTooOld)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-2">El último backup verificado es muy antiguo (@Format.Date(alerts.LastVerifiedBackupAt)).</MudAlert>
            }
            @if (alerts.FailingDestinations > 0)
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">@alerts.FailingDestinations destino(s) de backup fallando.</MudAlert>
            }
        }
        @if (_code is not null)
        {
            <MudPaper Class="pa-4 mb-4" Outlined="true">
                <MudText>Código de recuperación (se muestra UNA sola vez). Imprímalo y guárdelo FUERA del local:</MudText>
                <div class="cifra my-2">@_code</div>
                <MudTextField @bind-Value="_confirm" Label="Escríbalo de nuevo para confirmar" Immediate="true" />
                <MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmarAsync">Confirmar</MudButton>
            </MudPaper>
        }
        <MudText Typo="Typo.h6" Class="mb-2">Historial</MudText>
        <MudTable RowsPerPage="25" Items="_runs" Dense="true" Striped="true">
            <HeaderContent><MudTh>Fecha</MudTh><MudTh>Tipo</MudTh><MudTh>Resultado</MudTh><MudTh Class="num">Tamaño</MudTh><MudTh>Copias</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd>@Format.Date(context.StartedAt)</MudTd>
                <MudTd>@context.Kind</MudTd>
                <MudTd>@(context.Succeeded ? context.Verified ? "Correcto y verificado" : "Correcto" : "Falló: " + context.Error)</MudTd>
                <MudTd Class="num">@(context.SizeBytes is > 0 and var size ? ((decimal)size / 1024 / 1024).ToString("0.0", Format.Colombia) + " MB" : "")</MudTd>
                <MudTd>@string.Join(" · ", context.Copies.Select(c => $"{c.DestinationName}: {c.Status}"))</MudTd>
            </RowTemplate>
            <NoRecordsContent><EstadoVacio Mensaje="Aún no hay backups." /></NoRecordsContent>
            <PagerContent><Paginador /></PagerContent>
        </MudTable>
        <MudText Typo="Typo.caption" Class="mt-2 d-block">La restauración se hace desde la consola del servidor (docs/guia-recuperacion.md), nunca desde el navegador.</MudText>
    </ChildContent>
</Pagina>

@code {
    private IReadOnlyList<BackupRunDto> _runs = [];
    private BackupAlertsDto? _alerts;
    private bool _loading = true, _busy;
    private string? _error, _code, _confirm;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            _runs = await Api.GetAsync<IReadOnlyList<BackupRunDto>>("api/v1/backups?limit=30");
            _alerts = await Api.GetAsync<BackupAlertsDto>("api/v1/backups/alerts");
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private async Task RespaldarAsync()
    {
        _busy = true;
        try
        {
            await Api.PostAsync("api/v1/backups");
            Snackbar.Add("Backup en cola: aparecerá en el historial en unos minutos.", Severity.Info);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private async Task GenerarCodigoAsync()
    {
        try
        {
            _code = (await Api.PostAsync<RecoveryCodeDto>("api/v1/backups/recovery-code")).Code;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }
    }

    private async Task ConfirmarAsync()
    {
        try
        {
            await Api.PostAsync("api/v1/backups/recovery-code/confirm", new { code = _confirm });
            _code = null;
            Snackbar.Add("Código confirmado.", Severity.Success);
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }
    }
}
