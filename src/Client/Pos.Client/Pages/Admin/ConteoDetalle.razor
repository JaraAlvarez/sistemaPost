@page "/admin/conteos/nuevo"
@page "/admin/conteos/{Id:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<PageTitle>@Titulo · BusinessPost</PageTitle>

<Pagina Titulo="@Titulo" Miga="@Titulo" Subtitulo="@Resumen" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (Id is null)
        {
            <MudButton Variant="Variant.Outlined" Href="/admin/conteos">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="CrearAsync">Crear</MudButton>
        }
        else if (_conteo.ValueKind == JsonValueKind.Object)
        {
            @if (Status is "DRAFT" or "IN_PROGRESS" or "IN_REVIEW" && Session.Has("inventory.count.manage"))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_busy" OnClick="@(() => AccionAsync("cancel", "Conteo anulado."))">
                    Anular
                </MudButton>
            }
            @if (Status == "DRAFT" && Session.Has("inventory.count.manage"))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="@(() => AccionAsync("start", "Conteo iniciado: el teórico quedó congelado."))">Iniciar</MudButton>
            }
            @if (Status == "IN_PROGRESS" && Session.Has("inventory.count.manage"))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="@(() => AccionAsync("review", "Conteo en revisión: revise las diferencias."))">Pasar a revisión</MudButton>
            }
            @if (Status == "IN_REVIEW" && Session.Has("inventory.count.approve"))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="@(() => AccionAsync("approve", "Conteo aprobado: las diferencias quedaron en el kardex."))">
                    Aprobar y ajustar
                </MudButton>
            }
        }
    </Acciones>
    <ChildContent>
        @if (Id is null)
        {
            <MudPaper Outlined="true" Class="pa-4">
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudSelect T="Guid?" @bind-Value="_bodega" Label="Bodega">
                            @foreach (var warehouse in Elegibles)
                            {
                                <MudSelectItem T="Guid?" Value="@warehouse.GetProperty("id").GetGuid()">@warehouse.Str("code") · @warehouse.Str("name")</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_tipo" Label="Alcance">
                            <MudSelectItem T="string" Value="@("Full")">Completo (todos los productos inventariables)</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Partial")">Parcial (categorías o productos)</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    @if (_tipo == "Partial")
                    {
                        <MudItem xs="12" md="6">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudSelect T="Guid?" @bind-Value="_categoria" Label="Categoría">
                                    @foreach (var category in _categorias)
                                    {
                                        <MudSelectItem T="Guid?" Value="@category.GetProperty("id").GetGuid()">@category.Str("path")</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudButton Size="Size.Small" OnClick="AgregarCategoria">Agregar</MudButton>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" @bind-Value="_buscar" Label="Buscar producto (nombre, SKU o código; Enter busca)" Immediate="true"
                                          OnKeyDown="BuscarTeclaAsync" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="BuscarAsync" />
                            @if (_resultados.Count > 0)
                            {
                                <MudSimpleTable Dense="true" Class="my-2">
                                    <tbody>
                                        @foreach (var product in _resultados)
                                        {
                                            <tr>
                                                <td>@product.Str("sku")</td>
                                                <td>@product.Str("name")</td>
                                                <td><MudButton Size="Size.Small" OnClick="@(() => AgregarProducto(product))">Agregar</MudButton></td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                        </MudItem>
                        <MudItem xs="12">
                            @foreach (var (id, nombre) in _alcanceCategorias)
                            {
                                <MudChip T="string" Size="Size.Small" OnClose="@(_ => _alcanceCategorias.Remove(id))">Categoría: @nombre</MudChip>
                            }
                            @foreach (var (id, nombre) in _alcanceProductos)
                            {
                                <MudChip T="string" Size="Size.Small" OnClose="@(_ => _alcanceProductos.Remove(id))">@nombre</MudChip>
                            }
                        </MudItem>
                    }
                    <MudItem xs="12">
                        <MudCheckBox T="bool" @bind-Value="_ciego" Label="Conteo ciego (quien cuenta no ve el teórico)" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="_notas" Label="Observación (opcional)" Immediate="true" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
        else if (_conteo.ValueKind == JsonValueKind.Object)
        {
            @if (Status == "DRAFT")
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">Al iniciar se congela el teórico de cada producto; la tienda puede seguir vendiendo durante el conteo.</MudAlert>
            }
            @if (Status == "IN_REVIEW" && Session.Has("inventory.count.register"))
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">El conteo está en revisión: lo que registre ahora es un reconteo y reemplaza la primera captura del producto.</MudAlert>
            }
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2">
                @if (Status is "IN_PROGRESS" or "IN_REVIEW" && Session.Has("inventory.count.register"))
                {
                    <MudTextField @ref="_escaner" T="string" @bind-Value="_codigo" Label="Código de barras o SKU (cantidad*código; Enter registra)" Variant="Variant.Outlined"
                                  Immediate="true" OnKeyDown="EscanerTeclaAsync" AutoFocus="true" Style="min-width: 280px; flex: 1 1 360px" />
                    <MudNumericField T="decimal" @bind-Value="_cantidad" Label="Cantidad" Min="0" Variant="Variant.Outlined" Style="max-width: 140px" />
                    <MudTextField T="string" @bind-Value="_ubicacion" Label="Ubicación (opcional)" Variant="Variant.Outlined" Immediate="true" Style="max-width: 200px" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="RegistrarAsync">Registrar</MudButton>
                }
                <MudSelect T="string" @bind-Value="_filtro" Label="Mostrar" Variant="Variant.Outlined" Style="max-width: 240px">
                    <MudSelectItem T="string" Value="@("")">Todos los productos</MudSelectItem>
                    <MudSelectItem T="string" Value="@("PENDIENTES")">Sin contar</MudSelectItem>
                    <MudSelectItem T="string" Value="@("DIFERENCIAS")">Con diferencia</MudSelectItem>
                    <MudSelectItem T="string" Value="@("RECONTAR")">Por recontar</MudSelectItem>
                </MudSelect>
            </MudStack>
            @if (_ultimo is not null)
            {
                <MudText Typo="Typo.caption" Class="d-block mb-2" role="status">@_ultimo</MudText>
            }
            <MudTable Items="LineasFiltradas" Dense="true" Hover="true" Striped="true" RowsPerPage="50" FixedHeader="true" Height="max(320px, calc(100vh - 400px))">
                <HeaderContent>
                    <MudTh>SKU</MudTh><MudTh>Producto</MudTh><MudTh Class="num">Teórico</MudTh><MudTh Class="num">Esperado</MudTh>
                    <MudTh Class="num">Contado</MudTh><MudTh Class="num">Diferencia</MudTh><MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Str("sku")</MudTd>
                    <MudTd>@context.Str("productName")</MudTd>
                    <MudTd Class="num">@Cantidad(context, "systemQuantity")</MudTd>
                    <MudTd Class="num">@Cantidad(context, "expectedQuantity")</MudTd>
                    <MudTd Class="num">@Cantidad(context, "countedQuantity")</MudTd>
                    <MudTd Class="num">
                        <MudText Typo="Typo.body2" Color="@(context.Dec("difference") < 0 ? Color.Error : context.Dec("difference") > 0 ? Color.Success : Color.Default)">
                            @Cantidad(context, "difference")
                        </MudText>
                    </MudTd>
                    <MudTd>
                        @if (context.Bool("needsRecount"))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Recontar</MudChip>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><EstadoVacio Mensaje="No hay productos para mostrar." Compacto="true" /></NoRecordsContent>
                <PagerContent><Paginador /></PagerContent>
            </MudTable>
            @if (Status == "IN_REVIEW")
            {
                <MudText Typo="Typo.caption" Class="d-block mt-2">
                    Diferencia = contado − esperado (teórico congelado + movimientos posteriores). Al aprobar, las diferencias se llevan al kardex como ajuste de conteo.
                </MudText>
            }
        }
    </ChildContent>
</Pagina>

@code {
    private List<JsonElement> _bodegas = [];
    private List<JsonElement> _categorias = [];
    private List<JsonElement> _resultados = [];
    private readonly Dictionary<Guid, string> _alcanceCategorias = [];
    private readonly Dictionary<Guid, string> _alcanceProductos = [];
    private MudTextField<string>? _escaner;
    private JsonElement _conteo;
    private string _tipo = "Full", _filtro = "";
    private string? _error, _notas, _buscar, _codigo, _ubicacion, _ultimo, _cargado;
    private Guid? _bodega, _categoria;
    private decimal _cantidad = 1;
    private bool _loading = true, _busy, _ciego = true;

    /// <summary>Conteo que se muestra; nulo en <c>/admin/conteos/nuevo</c>.</summary>
    [Parameter]
    public Guid? Id { get; set; }

    private string Status => _conteo.Str("status");

    private string Titulo => Id is null ? "Nuevo conteo" : _conteo.ValueKind == JsonValueKind.Object ? $"Conteo {_conteo.Str("number")}" : "Conteo";

    private string? Resumen
    {
        get
        {
            if (Id is null || _conteo.ValueKind != JsonValueKind.Object)
            {
                return null;
            }

            var texto = $"{Estado(Status)} · Bodega {Bodega(_conteo.Str("warehouseId"))} · {(_conteo.Str("countType") == "FULL" ? "Completo" : "Parcial")} · "
                + $"{(_conteo.Bool("isBlind") ? "Ciego" : "Con teórico visible")} · Contados {_conteo.Dec("countedProducts")} de {_conteo.Dec("productCount")} producto(s)";
            return _conteo.Date("startedAt") is { } started ? $"{texto} · Iniciado {Format.Date(started)}" : texto;
        }
    }

    private IEnumerable<JsonElement> Elegibles => _bodegas.Where(b => b.Str("status") == "Active" && b.Str("kind") != "InTransit").OrderBy(b => b.Str("kind") == "SalesFloor" ? 0 : 1);

    private IEnumerable<JsonElement> LineasFiltradas
    {
        get
        {
            var lines = _conteo.Prop("lines").Items();
            return _filtro switch
            {
                "PENDIENTES" => lines.Where(l => !l.Bool("counted")),
                "DIFERENCIAS" => lines.Where(l => l.Dec("difference") != 0m),
                "RECONTAR" => lines.Where(l => l.Bool("needsRecount")),
                _ => lines,
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarBodegasAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Al crear se pasa de /nuevo a /{id} en la misma instancia: solo se recarga cuando cambia la ruta.
        var clave = Id?.ToString() ?? "nuevo";
        if (clave == _cargado)
        {
            return;
        }

        _cargado = clave;
        if (Id is { } id)
        {
            await VerAsync(id);
        }
        else
        {
            await NuevoAsync();
        }
    }

    private async Task CargarBodegasAsync()
    {
        if (Session.Me is not { } me)
        {
            return;
        }

        try
        {
            _bodegas = (await Api.GetAsync<JsonElement>($"api/v1/organization/branches/{me.BranchId}")).Prop("warehouses").Items();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"No se pudieron cargar las bodegas: {ex.Texto}", Severity.Warning);
        }
    }

    private string Bodega(string id)
    {
        var warehouse = _bodegas.FirstOrDefault(b => b.Str("id") == id);
        return warehouse.ValueKind == JsonValueKind.Object ? $"{warehouse.Str("code")} · {warehouse.Str("name")}" : "—";
    }

    private static string Estado(string status) => status switch
    {
        "DRAFT" => "Borrador",
        "IN_PROGRESS" => "En curso",
        "IN_REVIEW" => "En revisión",
        "POSTED" => "Aprobado",
        "CANCELLED" => "Anulado",
        _ => status,
    };

    private static string Cantidad(JsonElement line, string name) =>
        line.Prop(name).ValueKind == JsonValueKind.Number ? Format.Quantity(line.Dec(name)) : "—";

    private async Task NuevoAsync()
    {
        _loading = true;
        _bodega = Elegibles.Select(b => (Guid?)b.GetProperty("id").GetGuid()).FirstOrDefault();
        _tipo = "Full";
        _ciego = true;
        _notas = _buscar = null;
        _categoria = null;
        _resultados = [];
        _alcanceCategorias.Clear();
        _alcanceProductos.Clear();
        try
        {
            _categorias = (await Api.GetAsync<JsonElement>("api/v1/catalog/categories")).Items();
        }
        catch (ApiException ex)
        {
            _categorias = [];
            Snackbar.Add($"No se pudieron cargar las categorías: {ex.Texto}", Severity.Warning);
        }

        _loading = false;
    }

    private void AgregarCategoria()
    {
        if (_categoria is not { } id)
        {
            return;
        }

        _alcanceCategorias[id] = _categorias.FirstOrDefault(c => c.Prop("id").TryGetGuid(out var categoryId) && categoryId == id).Str("path");
        _categoria = null;
    }

    private async Task BuscarTeclaAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarAsync();
        }
    }

    private async Task BuscarAsync()
    {
        if (string.IsNullOrWhiteSpace(_buscar))
        {
            _resultados = [];
            return;
        }

        try
        {
            _resultados = (await Api.GetAsync<JsonElement>($"api/v1/catalog/products?pageSize=20&search={Uri.EscapeDataString(_buscar.Trim())}")).Items();
            if (_resultados.Count == 0)
            {
                Snackbar.Add("No hay productos que coincidan.", Severity.Info);
            }
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }
    }

    private void AgregarProducto(JsonElement product)
    {
        _alcanceProductos[product.GetProperty("id").GetGuid()] = $"{product.Str("sku")} · {product.Str("name")}";
        _resultados = [];
        _buscar = null;
    }

    private async Task CrearAsync()
    {
        _busy = true;
        try
        {
            var parcial = _tipo == "Partial";
            var created = await Api.PostAsync<JsonElement>("api/v1/inventory/counts", new
            {
                warehouseId = _bodega,
                type = _tipo,
                isBlind = _ciego,
                categoryIds = parcial ? _alcanceCategorias.Keys.ToList() : [],
                productIds = parcial ? _alcanceProductos.Keys.ToList() : [],
                notes = string.IsNullOrWhiteSpace(_notas) ? null : _notas.Trim(),
            });
            Snackbar.Add("Conteo creado. Inícielo cuando vaya a empezar a contar.", Severity.Success);
            Navigation.NavigateTo($"/admin/conteos/{created.GetProperty("id").GetGuid()}", replace: true);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private async Task VerAsync(Guid id)
    {
        _loading = true;
        try
        {
            _conteo = await Api.GetAsync<JsonElement>($"api/v1/inventory/counts/{id}");
            _filtro = "";
            _codigo = _ultimo = null;
            _cantidad = 1;
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private async Task EscanerTeclaAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await RegistrarAsync();
        }
    }

    private async Task RegistrarAsync()
    {
        var texto = (_codigo ?? "").Trim();
        if (texto.Length == 0 || _busy)
        {
            return;
        }

        var cantidad = _cantidad;
        var codigo = texto;
        var asterisco = texto.IndexOf('*', StringComparison.Ordinal);
        if (asterisco > 0 && decimal.TryParse(texto[..asterisco].Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed))
        {
            cantidad = parsed;
            codigo = texto[(asterisco + 1)..].Trim();
        }

        _busy = true;
        try
        {
            var id = _conteo.GetProperty("id").GetGuid();
            _conteo = await Api.PostAsync<JsonElement>($"api/v1/inventory/counts/{id}/entries", new[]
            {
                new { productId = (Guid?)null, code = codigo, quantity = cantidad, location = string.IsNullOrWhiteSpace(_ubicacion) ? null : _ubicacion.Trim() },
            });
            var line = _conteo.Prop("lines").Items().FirstOrDefault(l => l.Str("sku") == codigo);
            _ultimo = $"Registrado: {Format.Quantity(cantidad)} de {(line.ValueKind == JsonValueKind.Object ? line.Str("productName") : codigo)}.";
            _codigo = null;
            _cantidad = 1;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
        if (_escaner is not null)
        {
            await _escaner.FocusAsync();
        }
    }

    private async Task AccionAsync(string action, string message)
    {
        if (Confirmaciones.TryGetValue(action, out var confirmacion)
            && !await Dialogs.ConfirmarAsync(confirmacion.Titulo, confirmacion.Mensaje, confirmacion.Accion, action == "cancel"))
        {
            return;
        }

        _busy = true;
        var id = _conteo.GetProperty("id").GetGuid();
        try
        {
            await Api.PostAsync($"api/v1/inventory/counts/{id}/{action}");
            Snackbar.Add(message, Severity.Success);
            await VerAsync(id);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    /// <summary>Acciones que se confirman con el diálogo uniforme: título, mensaje y texto del botón.</summary>
    private static readonly Dictionary<string, (string Titulo, string Mensaje, string Accion)> Confirmaciones = new()
    {
        ["cancel"] = ("Anular conteo", "El conteo quedará anulado y lo contado no se aplicará al inventario.", "Anular"),
        ["approve"] = ("Aprobar conteo", "Las diferencias del conteo se aplicarán al inventario (kardex).", "Aprobar y ajustar"),
    };
}
