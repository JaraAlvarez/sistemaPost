@page "/admin/compras/ordenes/nueva"
@page "/admin/compras/ordenes/{Id:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject Bodegas Bodegas
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@using Pos.Modules.Purchasing.Contracts

<PageTitle>@TituloPagina · BusinessPost</PageTitle>

<Pagina Funcion="PURCHASING" Titulo="@TituloPagina" Subtitulo="@Resumen" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (Id is null)
        {
            <MudButton Variant="Variant.Text" Href="@Lista">Cancelar</MudButton>
            @if (Session.Has("purchasing.order.manage"))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="_busy || _loading" OnClick="CrearAsync" Class="ml-2">Crear orden</MudButton>
            }
        }
        else if (_orden is { } orden)
        {
            var status = EnumText.Normalize(orden.Status);
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="@Lista">Volver a la lista</MudButton>
            @if (status == "DRAFT" && Session.Has("purchasing.order.approve"))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="@(() => AccionAsync("approve", "Orden aprobada."))" Class="ml-2">Aprobar</MudButton>
            }
            @if (status == "APPROVED" && Session.Has("purchasing.order.manage"))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="@(() => AccionAsync("send", "Orden marcada como enviada al proveedor."))" Class="ml-2">Enviar</MudButton>
            }
            @if (status is "SENT" or "PARTIALLY_RECEIVED" && Session.Has("purchasing.purchase.manage"))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"/admin/compras/nueva?orden={Id}")" Class="ml-2">Registrar factura</MudButton>
            }
            @if (status is "SENT" or "PARTIALLY_RECEIVED" && Session.Has("purchasing.order.manage"))
            {
                <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="@(() => AccionAsync("close", "Orden cerrada: no admite más recepciones."))" Class="ml-2">Cerrar</MudButton>
            }
            @if (status is "DRAFT" or "APPROVED" or "SENT" && Session.Has("purchasing.order.manage"))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_busy" OnClick="CancelarAsync" Class="ml-2">Cancelar orden</MudButton>
            }
        }
    </Acciones>
    <ChildContent>
        @if (Id is null)
        {
            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Datos de la orden</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudSelect T="Guid?" @bind-Value="_proveedor" Label="Proveedor">
                            @foreach (var supplier in _proveedores)
                            {
                                <MudSelectItem T="Guid?" Value="@supplier.Id">@supplier.Name (@supplier.Identification)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="Guid?" @bind-Value="_bodega" Label="Bodega que recibe">
                            @foreach (var warehouse in Bodegas.Elegibles)
                            {
                                <MudSelectItem T="Guid?" Value="@warehouse.GetProperty("id").GetGuid()">@Bodegas.Etiqueta(warehouse)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6"><MudDatePicker @bind-Date="_fechaEsperada" Label="Fecha esperada de entrega (opcional)" DateFormat="dd/MM/yyyy" /></MudItem>
                    <MudItem xs="12"><MudTextField @bind-Value="_notas" Label="Notas" Immediate="true" /></MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Productos</MudText>
                <LineasProductos Lineas="_lineas" />
            </MudPaper>
        }
        else if (_orden is { } orden)
        {
            <MudChip T="string" Size="Size.Small" Color="@ColorEstado(orden.Status)" Class="ml-0 mb-3">@Compras.EstadoOrden(orden.Status)</MudChip>
            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Productos</MudText>
                <MudSimpleTable Dense="true" Outlined="true">
                    <thead>
                        <tr><th>Producto</th><th class="num">Cantidad</th><th class="num">Costo unitario</th><th class="num">Recibido (unid. base)</th><th class="num">Pendiente (unid. base)</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var line in orden.Lines)
                        {
                            <tr>
                                <td>@line.Sku · @line.ProductName</td>
                                <td class="num">@Format.Quantity(line.Quantity)@(line.Factor != 1 ? $" × {Format.Quantity(line.Factor)}" : "")</td>
                                <td class="num">@Format.Money(line.UnitCost)</td>
                                <td class="num">@Format.Quantity(line.ReceivedBaseQuantity)</td>
                                <td class="num">@Format.Quantity(line.PendingBaseQuantity)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                <MudText Class="num mt-3" Align="Align.Right"><b>Total: @Format.Money(orden.Total)</b></MudText>
            </MudPaper>
        }
    </ChildContent>
</Pagina>

@code {
    private const string Lista = "/admin/compras?tab=ordenes";

    private List<SupplierDto> _proveedores = [];
    private List<LineaProducto> _lineas = [];
    private string? _error, _notas;
    private Guid? _proveedor, _bodega;
    private Guid? _cargada;
    private DateTime? _fechaEsperada;
    private bool _loading = true, _busy, _iniciada;
    private PurchaseOrderDto? _orden;

    /// <summary>La orden que se muestra; sin valor (ruta <c>/nueva</c>), el formulario de una orden nueva.</summary>
    [Parameter]
    public Guid? Id { get; set; }

    private string TituloPagina => Id is null
        ? "Nueva orden de compra"
        : _orden is { } orden ? $"Orden {orden.Number}" : "Orden de compra";

    private string? Resumen
    {
        get
        {
            if (Id is null || _orden is not { } orden)
            {
                return null;
            }

            var resumen = $"{orden.SupplierName} · del {Compras.Dia(orden.OrderDate)} · entrega esperada {Compras.Dia(orden.ExpectedDate)}";
            return orden.Notes is { Length: > 0 } notes ? $"{resumen} · {notes}" : resumen;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // La misma instancia sirve /nueva y /{id}: solo se recarga cuando cambia lo que se muestra (al crear la orden ya se tiene).
        if (_iniciada && Id == _cargada)
        {
            return;
        }

        _iniciada = true;
        _cargada = Id;
        _loading = true;
        _error = null;
        try
        {
            if (Id is { } id)
            {
                _orden = await Api.GetAsync<PurchaseOrderDto>($"api/v1/purchasing/orders/{id}");
            }
            else
            {
                _orden = null;
                await PrepararNuevaAsync();
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private static Color ColorEstado(string status) => EnumText.Normalize(status) switch
    {
        "APPROVED" or "SENT" or "PARTIALLY_RECEIVED" => Color.Info,
        "RECEIVED" or "CLOSED" => Color.Success,
        "CANCELLED" => Color.Error,
        _ => Color.Default,
    };

    private static string? Texto(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task PrepararNuevaAsync()
    {
        _proveedores = [.. await Api.GetAsync<List<SupplierDto>>("api/v1/purchasing/suppliers")];
        await Bodegas.CargarAsync();

        _lineas = [];
        _notas = null;
        _fechaEsperada = null;
        _proveedor = null;
        _bodega = Bodegas.Primera(Bodegas.Elegibles);
    }

    private async Task CrearAsync()
    {
        if (_proveedor is null || _bodega is null)
        {
            Snackbar.Add("Seleccione el proveedor y la bodega.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var order = await Api.PostAsync<PurchaseOrderDto>("api/v1/purchasing/orders", new
            {
                supplierId = _proveedor, warehouseId = _bodega, orderDate = (DateOnly?)null,
                expectedDate = _fechaEsperada is { } expected ? DateOnly.FromDateTime(expected) : (DateOnly?)null, notes = Texto(_notas),
                lines = _lineas.Select(l => new
                {
                    productId = l.ProductId, code = (string?)null, packagingId = l.EmpaqueId == Guid.Empty ? (Guid?)null : l.EmpaqueId, quantity = l.Cantidad, unitCost = l.Costo,
                }).ToList(),
            });
            Snackbar.Add($"Orden {order.Number} creada en borrador.", Severity.Success);
            var id = order.Id;
            _orden = order;
            _cargada = id;
            Navigation.NavigateTo($"/admin/compras/ordenes/{id}", replace: true);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private async Task AccionAsync(string action, string message)
    {
        if (_orden is not { } orden)
        {
            return;
        }

        _busy = true;
        try
        {
            var id = orden.Id;
            await Api.PostAsync<PurchaseOrderDto>($"api/v1/purchasing/orders/{id}/{action}");
            Snackbar.Add(message, Severity.Success);
            _orden = await Api.GetAsync<PurchaseOrderDto>($"api/v1/purchasing/orders/{id}");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private async Task CancelarAsync()
    {
        if (_orden is { } orden && await Dialogs.ConfirmarAsync("Cancelar orden de compra", $"La orden {orden.Number} de {orden.SupplierName} quedará cancelada y no admitirá recepciones.", "Cancelar orden", true))
        {
            await AccionAsync("cancel", "Orden cancelada.");
        }
    }
}
