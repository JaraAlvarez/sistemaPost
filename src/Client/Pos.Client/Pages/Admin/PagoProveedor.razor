@page "/admin/cuentas-por-pagar/pago"
@inject ApiClient Api
@inject SessionState Session
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@using Pos.Modules.Cash.Contracts
@using Pos.Modules.Purchasing.Contracts

<PageTitle>Registrar pago a proveedor · BusinessPost</PageTitle>

<Pagina Titulo="Registrar pago a proveedor" Miga="Registrar pago" Cargando="_loading" Error="@_error">
    <Acciones>
        <MudButton Variant="Variant.Text" Href="@Lista">Cancelar</MudButton>
        @if (Session.Has("purchasing.payable.pay"))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Payments" Disabled="@(_busy || _loading || TotalPago <= 0)" OnClick="PagarAsync" Class="ml-2">Registrar pago</MudButton>
        }
    </Acciones>
    <ChildContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="8">
                <MudPaper Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Facturas que se pagan</MudText>
                    <MudSelect T="Guid?" Value="_pagoProveedor" ValueChanged="@(v => ElegirProveedorAsync(v))" Label="Proveedor">
                        @foreach (var supplier in _conSaldo)
                        {
                            <MudSelectItem T="Guid?" Value="@supplier.Id">@supplier.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                    @if (_aplicaciones.Count > 0)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-3">
                            <MudText Typo="Typo.body2">Marque las facturas que va a pagar; el valor de cada una se puede bajar para un abono.</MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="MarcarTodas"
                                       StartIcon="@(TodasMarcadas ? Icons.Material.Outlined.CheckBoxOutlineBlank : Icons.Material.Outlined.LibraryAddCheck)">
                                @(TodasMarcadas ? "Desmarcar todas" : "Marcar todas")
                            </MudButton>
                        </MudStack>
                        <MudSimpleTable Dense="true" Outlined="true" Class="my-2">
                            <thead><tr><th></th><th>Documento</th><th>Vence</th><th class="num">Saldo</th><th class="num">Valor a pagar</th></tr></thead>
                            <tbody>
                                @foreach (var item in _aplicaciones)
                                {
                                    <tr>
                                        <td><MudCheckBox T="bool" @bind-Value="item.Incluir" Dense="true" aria-label="@($"Incluir {item.Documento}")" /></td>
                                        <td>@item.Documento</td>
                                        <td>@item.Vence</td>
                                        <td class="num">@Format.Money(item.Saldo)</td>
                                        <td style="min-width:140px"><MudNumericField Culture="@Format.Colombia" T="decimal" @bind-Value="item.Valor" Min="0" Max="item.Saldo" Disabled="!item.Incluir" /></td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                        <MudText Class="num" Align="Align.Right"><b>Total del pago: @Format.Money(TotalPago)</b></MudText>
                        @if (TotalPago <= 0)
                        {
                            <MudText Typo="Typo.caption" Align="Align.Right" Class="d-block texto-secundario">Marque al menos una factura para registrar el pago.</MudText>
                        }
                    }
                    else if (_pagoProveedor is not null)
                    {
                        <MudText Typo="Typo.body2" Class="my-3">El proveedor no tiene facturas con saldo.</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="my-3">Elija el proveedor para ver sus facturas con saldo.</MudText>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Datos del pago</MudText>
                    <MudSelect T="Guid?" @bind-Value="_medio" Label="Medio de pago">
                        @foreach (var method in _medios)
                        {
                            <MudSelectItem T="Guid?" Value="@method.Id">@method.Name@(method.RequiresReference ? " (exige referencia)" : "")</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="_referencia" Label="Referencia (transferencia, cheque…)" Immediate="true" />
                    <MudDatePicker @bind-Date="_fecha" Label="Fecha del pago" DateFormat="dd/MM/yyyy" />
                    <MudTextField @bind-Value="_notas" Label="Notas" Immediate="true" />
                </MudPaper>
            </MudItem>
        </MudGrid>
    </ChildContent>
</Pagina>

@code {
    private const string Lista = "/admin/cuentas-por-pagar";

    private List<PaymentMethodDto> _medios = [];
    private List<Proveedor> _conSaldo = [];
    private List<Aplicacion> _aplicaciones = [];
    private Guid? _pagoProveedor, _medio;
    private DateTime? _fecha = DateTime.Today;
    private string? _error, _referencia, _notas;
    private bool _loading = true, _busy;

    /// <summary>Proveedor que se propone (el botón "Pagar" de una factura en la lista).</summary>
    [SupplyParameterFromQuery(Name = "proveedor")]
    public Guid? ProveedorInicial { get; set; }

    /// <summary>Si viene, solo esa factura del proveedor queda marcada para pagar.</summary>
    [SupplyParameterFromQuery(Name = "factura")]
    public Guid? FacturaInicial { get; set; }

    private decimal TotalPago => _aplicaciones.Where(a => a.Incluir).Sum(a => a.Valor);

    private bool TodasMarcadas => _aplicaciones.Count > 0 && _aplicaciones.All(a => a.Incluir);

    /// <summary>Marca todas las facturas (pago total al proveedor) o, si ya lo están, las desmarca.</summary>
    private void MarcarTodas()
    {
        var marcar = !TodasMarcadas;
        foreach (var item in _aplicaciones)
        {
            item.Incluir = marcar;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _medios = [.. await Api.GetAsync<List<PaymentMethodDto>>("api/v1/cash/payment-methods")];
            _conSaldo = [.. (await Api.GetAsync<List<PayableDto>>("api/v1/purchasing/payables?openOnly=true"))
                .Select(a => new Proveedor(a.SupplierId, a.SupplierName)).Distinct().OrderBy(p => p.Nombre, StringComparer.CurrentCulture)];
            if (ProveedorInicial is not null)
            {
                await ElegirProveedorAsync(ProveedorInicial);
                if (FacturaInicial is { } only)
                {
                    foreach (var item in _aplicaciones)
                    {
                        item.Incluir = item.AccountId == only;
                    }
                }
            }

            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    /// <summary>Fecha sin hora (DateOnly del servidor) como día/mes/año.</summary>
    private static string Dia(DateOnly date) => date.ToString("dd/MM/yyyy", Format.Colombia);

    private async Task ElegirProveedorAsync(Guid? supplierId)
    {
        _pagoProveedor = supplierId;
        _aplicaciones = [];
        if (supplierId is not { } id)
        {
            return;
        }

        try
        {
            var accounts = await Api.GetAsync<List<PayableDto>>($"api/v1/purchasing/payables?supplierId={id}&openOnly=true");
            _aplicaciones = [.. accounts.OrderBy(a => a.DueDate).Select(a => new Aplicacion
            {
                AccountId = a.Id,
                Documento = a.DocumentNumber,
                Vence = Dia(a.DueDate),
                Saldo = a.Balance,
                Valor = a.Balance,
                // Desmarcadas: se paga solo lo que se elige (con todas marcadas era fácil pagar facturas que no se estaban pagando).
                Incluir = false,
            })];
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }
    }

    private async Task PagarAsync()
    {
        if (_pagoProveedor is null || _medio is null)
        {
            Snackbar.Add("Seleccione el proveedor y el medio de pago.", Severity.Warning);
            return;
        }

        if (TotalPago <= 0)
        {
            Snackbar.Add("Marque al menos una factura para pagar.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var payment = await Api.PostAsync<PaymentDto>("api/v1/purchasing/payments", new
            {
                supplierId = _pagoProveedor, paymentDate = DateOnly.FromDateTime(_fecha ?? DateTime.Today), paymentMethodId = _medio,
                reference = string.IsNullOrWhiteSpace(_referencia) ? null : _referencia.Trim(), notes = string.IsNullOrWhiteSpace(_notas) ? null : _notas.Trim(),
                allocations = _aplicaciones.Where(a => a.Incluir && a.Valor > 0).Select(a => new { accountId = a.AccountId, amount = a.Valor }).ToList(),
                cashSessionId = (Guid?)null,
            });
            Snackbar.Add($"Pago {payment.Number} registrado por {Format.Money(payment.Amount)}.", Severity.Success);
            foreach (var warning in payment.Warnings ?? [])
            {
                Snackbar.Add(warning.Message, Severity.Warning);
            }

            Navigation.NavigateTo(Lista);
            return;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private sealed record Proveedor(Guid Id, string Nombre);

    private sealed class Aplicacion
    {
        public Guid AccountId { get; init; }

        public string Documento { get; init; } = "";

        public string Vence { get; init; } = "";

        public decimal Saldo { get; init; }

        public bool Incluir { get; set; }

        public decimal Valor { get; set; }
    }
}
