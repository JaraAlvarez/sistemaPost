@page "/admin/facturacion"
@using Pos.Modules.Billing.Contracts
@using Pos.Modules.Organization.Contracts
@inject ApiClient Api
@inject SessionState Session
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Facturación electrónica · BusinessPost</PageTitle>

@* Fase 11-B: configuración (modo, ambiente y credenciales de solo escritura), rangos de numeración, documentos (reintentar y corregir el
   comprador), alertas y conciliación. Los permisos los aplica también el servidor: aquí solo se ocultan las acciones no permitidas. *@
<Pagina Titulo="Facturación electrónica" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (_alerts is { } modo)
        {
            <MudChip T="string" Size="Size.Small" Color="@ColorModo(modo.Mode)">Modo: @NombreModo(modo.Mode)</MudChip>
        }
    </Acciones>
    <ChildContent>
        @if (_alerts is { Count: > 0 } aviso)
        {
            <MudAlert Severity="@(aviso.Rejected > 0 || aviso.WithoutRange > 0 ? Severity.Error : Severity.Warning)" Dense="true" Class="mb-3">
                Hay @aviso.Count.ToString("0") alerta(s) de facturación electrónica. Revise la pestaña «Alertas y conciliación».
            </MudAlert>
        }
        <MudTabs ActivePanelIndex="_tab" ActivePanelIndexChanged="CambiarPestana" Elevation="0" Outlined="true" TabPanelsClass="pa-3">
            @if (PuedeConfigurar)
            {
                <MudTabPanel Text="Configuración">
                    <FactusConexion Cambio="ConexionCambioAsync" />
                    @if (_settings is { } settings)
                    {
                        <MudText Typo="Typo.caption" Class="d-block mt-2">
                            Proveedor: @settings.Provider · adaptador activo: @settings.ActiveAdapter · última sincronización de rangos:
                            @Format.Date(settings.LastSyncAt)
                        </MudText>
                        @if (settings.LastSyncError is { Length: > 0 } syncError)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">Última sincronización: @syncError</MudAlert>
                        }
                    }
                </MudTabPanel>
            }
            @if (PuedeVer)
            {
                <MudTabPanel Text="Rangos de numeración">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
                        @if (PuedeConfigurar)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync" Disabled="_busy" OnClick="SincronizarAsync">Sincronizar desde Factus</MudButton>
                        }
                        <MudText Typo="Typo.caption">Asigne a cada sucursal (y si quiere a cada caja) un rango vigente por tipo de documento; sin rango el documento queda pendiente.</MudText>
                    </MudStack>
                    @foreach (var alert in _alerts?.Ranges ?? Array.Empty<FiscalRangeAlertDto>())
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@alert.Prefix (@NombreTipo(alert.DocumentType)): @alert.Message</MudAlert>
                    }
                    <MudTable RowsPerPage="25" Items="_ranges" Dense="true" Hover="true" Striped="true">
                        <HeaderContent>
                            <MudTh>Prefijo</MudTh><MudTh>Tipo</MudTh><MudTh Class="num">Desde</MudTh><MudTh Class="num">Hasta</MudTh><MudTh Class="num">Actual</MudTh>
                            <MudTh Class="num">Disponibles</MudTh><MudTh Class="num">Uso</MudTh><MudTh>Resolución</MudTh><MudTh>Vigencia</MudTh><MudTh>Asignado a</MudTh>
                            <MudTh>Estado</MudTh><MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Prefix</MudTd>
                            <MudTd>@NombreTipo(context.DocumentType)</MudTd>
                            <MudTd Class="num">@context.From</MudTd>
                            <MudTd Class="num">@context.To</MudTd>
                            <MudTd Class="num">@context.Current</MudTd>
                            <MudTd Class="num">@Format.Quantity(context.Remaining)</MudTd>
                            <MudTd Class="num">@context.UsagePercent.ToString("0.#", Format.Colombia) %</MudTd>
                            <MudTd>@context.ResolutionNumber</MudTd>
                            <MudTd>@Fecha(context.ValidFrom) – @Fecha(context.ValidTo)</MudTd>
                            <MudTd>@Asignacion(context)</MudTd>
                            <MudTd>
                                @if (!context.IsActive)
                                {
                                    <MudChip T="string" Size="Size.Small">Inactivo</MudChip>
                                }
                                else if (!context.IsUsable)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error">No utilizable</MudChip>
                                }
                                else if (context.NeedsAlert)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Por agotarse o vencer</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Vigente</MudChip>
                                }
                            </MudTd>
                            <MudTd>
                                @if (PuedeConfigurar)
                                {
                                    <MudButton Size="Size.Small" OnClick="@(() => Asignar(context))">Asignar</MudButton>
                                }
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent><EstadoVacio Mensaje="No hay rangos. Configure las credenciales y sincronice desde Factus." /></NoRecordsContent>
                        <PagerContent><Paginador /></PagerContent>
                    </MudTable>
                </MudTabPanel>
                <MudTabPanel Text="Documentos">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
                        <MudDatePicker @bind-Date="_desde" Label="Desde" DateFormat="dd/MM/yyyy" Style="max-width: 160px" />
                        <MudDatePicker @bind-Date="_hasta" Label="Hasta" DateFormat="dd/MM/yyyy" Style="max-width: 160px" />
                        <MudSelect T="string" @bind-Value="_fEstado" Label="Estado" Style="max-width: 190px" Clearable="true">
                            @foreach (var (codigo, nombre) in Estados)
                            {
                                <MudSelectItem T="string" Value="@codigo">@nombre</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="string" @bind-Value="_fTipo" Label="Tipo" Style="max-width: 210px" Clearable="true">
                            @foreach (var (codigo, nombre) in Tipos)
                            {
                                <MudSelectItem T="string" Value="@codigo">@nombre</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="string" @bind-Value="_fOrigen" Label="Origen" Style="max-width: 190px" Clearable="true">
                            @foreach (var (codigo, nombre) in Origenes)
                            {
                                <MudSelectItem T="string" Value="@codigo">@nombre</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField @bind-Value="_fTexto" Label="Número, número fiscal o identificación" Immediate="true" Style="max-width: 280px" OnKeyUp="@(e => e.Key == "Enter" ? FiltrarAsync() : Task.CompletedTask)" />
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Search" OnClick="FiltrarAsync">Consultar</MudButton>
                    </MudStack>
                    <MudTable RowsPerPage="25" Items="_documents" Dense="true" Hover="true" Striped="true">
                        <HeaderContent>
                            <MudTh>Fecha</MudTh><MudTh>Origen</MudTh><MudTh>Número interno</MudTh><MudTh>Tipo</MudTh><MudTh>Estado</MudTh><MudTh>Número fiscal</MudTh>
                            <MudTh>Adquirente</MudTh><MudTh Class="num">Total</MudTh><MudTh Class="num">Intentos</MudTh><MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@Fecha(context.BusinessDate)</MudTd>
                            <MudTd>@NombreOrigen(context.Source)</MudTd>
                            <MudTd>@context.SourceNumber</MudTd>
                            <MudTd>@NombreTipo(context.DocumentType)</MudTd>
                            <MudTd><MudChip T="string" Size="Size.Small" Color="@ColorEstado(context.Status)">@NombreEstado(context.Status)</MudChip></MudTd>
                            <MudTd>@context.FiscalNumber</MudTd>
                            <MudTd>@context.BuyerName · @context.BuyerIdentification</MudTd>
                            <MudTd Class="num">@Format.Money(context.Total)</MudTd>
                            <MudTd Class="num">@context.Attempts.ToString("0")</MudTd>
                            <MudTd><MudButton Size="Size.Small" OnClick="@(() => VerAsync(context))">Ver</MudButton></MudTd>
                        </RowTemplate>
                        <NoRecordsContent><EstadoVacio Mensaje="No hay documentos con esos filtros." /></NoRecordsContent>
                        <PagerContent><Paginador /></PagerContent>
                    </MudTable>
                    <MudText Typo="Typo.caption" Class="mt-2 d-block">@_documents.Count documento(s) · se muestran hasta 300.</MudText>
                </MudTabPanel>
                <MudTabPanel Text="Alertas y conciliación">
                    @if (_alerts is { } alerts)
                    {
                        <MudGrid Class="mb-4">
                            <MudItem xs="12" sm="6" md="3"><Tarjeta Titulo="Pendientes antiguos" Valor="@alerts.PendingOverdue.ToString("0")" Detalle="@($"El más antiguo: {Format.Date(alerts.OldestPendingAt)}")" /></MudItem>
                            <MudItem xs="12" sm="6" md="3"><Tarjeta Titulo="Rechazados sin atender" Valor="@alerts.Rejected.ToString("0")" Detalle="Corrija el adquirente o reintente" /></MudItem>
                            <MudItem xs="12" sm="6" md="3"><Tarjeta Titulo="Sin rango de numeración" Valor="@alerts.WithoutRange.ToString("0")" Detalle="Asigne un rango a la sucursal" /></MudItem>
                            <MudItem xs="12" sm="6" md="3"><Tarjeta Titulo="Rangos por agotarse o vencer" Valor="@alerts.Ranges.Count.ToString(Format.Colombia)" /></MudItem>
                        </MudGrid>
                    }
                    <MudText Typo="Typo.h6" Class="mb-2">Conciliación diaria</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
                        <MudDatePicker @bind-Date="_cDesde" Label="Desde" DateFormat="dd/MM/yyyy" Style="max-width: 160px" />
                        <MudDatePicker @bind-Date="_cHasta" Label="Hasta" DateFormat="dd/MM/yyyy" Style="max-width: 160px" />
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Search" OnClick="FiltrarConciliacionAsync">Consultar</MudButton>
                        @if (Session.Has("reporting.taxes.view"))
                        {
                            <MudLink Href="/admin/reportes">Reporte «Conciliación de facturación electrónica» (Excel, CSV y PDF)</MudLink>
                        }
                    </MudStack>
                    <div style="overflow-x: auto;">
                        <MudSimpleTable Dense="true" Outlined="true" Striped="true">
                            <thead>
                                <tr>
                                    <th>Fecha</th><th class="num">Ventas</th><th class="num">Anuladas</th><th class="num">Valor vendido</th><th class="num">Comprobante interno</th>
                                    <th class="num">Aceptadas</th><th class="num">Valor aceptado</th><th class="num">Pendientes</th><th class="num">Contingencia</th>
                                    <th class="num">Rechazadas</th><th class="num">Con error</th><th class="num">Canceladas</th><th class="num">Notas crédito</th><th class="num">Sin documento</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var day in _days)
                                {
                                    <tr>
                                        <td>@Fecha(day.BusinessDate)</td>
                                        <td class="num">@day.SalesCompleted.ToString("0")</td>
                                        <td class="num">@day.SalesVoided.ToString("0")</td>
                                        <td class="num">@Format.Money(day.SalesTotal)</td>
                                        <td class="num">@day.InternalReceipts.ToString("0")</td>
                                        <td class="num">@day.Accepted.ToString("0")</td>
                                        <td class="num">@Format.Money(day.AcceptedTotal)</td>
                                        <td class="num">@day.Pending.ToString("0")</td>
                                        <td class="num">@day.Contingency.ToString("0")</td>
                                        <td class="num">@day.Rejected.ToString("0")</td>
                                        <td class="num">@day.Error.ToString("0")</td>
                                        <td class="num">@day.Cancelled.ToString("0")</td>
                                        <td class="num">@day.CreditNotes.ToString("0")</td>
                                        <td class="num">@day.SalesWithoutDocument.ToString("0")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                    <MudText Typo="Typo.caption" Class="mt-2 d-block">Máximo 92 días. Una venta queda conciliada cuando su factura está aceptada por la DIAN.</MudText>
                </MudTabPanel>
            }
        </MudTabs>
    </ChildContent>
</Pagina>

@if (_asignar is { } asignar)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true">
            <h2>Asignar el rango @asignar.Prefix (@NombreTipo(asignar.DocumentType))</h2>
            <MudSelect T="Guid?" @bind-Value="_aSucursal" Label="Sucursal">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">Sin asignar (desasignar)</MudSelectItem>
                @foreach (var branch in _branches)
                {
                    <MudSelectItem T="Guid?" Value="@branch.Id">@branch.Name</MudSelectItem>
                }
            </MudSelect>
            @if (_aSucursal is { } sucursal)
            {
                <MudSelect T="Guid?" @bind-Value="_aCaja" Label="Caja (opcional)" Class="mt-2">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">Toda la sucursal</MudSelectItem>
                    @foreach (var terminal in _terminals.Where(t => t.BranchId == sucursal))
                    {
                        <MudSelectItem T="Guid?" Value="@terminal.Id">@terminal.Code · @terminal.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudText Typo="Typo.caption" Class="d-block mt-2">Solo puede haber un rango vigente por sucursal (o caja) y tipo de documento.</MudText>
            <div class="acciones">
                <MudButton OnClick="@(() => _asignar = null)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="AsignarAsync">Guardar</MudButton>
            </div>
        </div>
    </div>
}

@if (_detalle is { } detalle)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true" style="width: min(760px, 96vw);">
            <h2>@NombreTipo(detalle.DocumentType) · @detalle.SourceNumber</h2>
            <MudSimpleTable Dense="true" Outlined="true" Class="mb-3">
                <tbody>
                    <tr><td>Estado</td><td><MudChip T="string" Size="Size.Small" Color="@ColorEstado(detalle.Status)">@NombreEstado(detalle.Status)</MudChip> @detalle.ProviderStatus</td></tr>
                    <tr><td>Origen</td><td>@NombreOrigen(detalle.Source) @detalle.SourceNumber · fecha @Fecha(detalle.BusinessDate)</td></tr>
                    <tr><td>Número fiscal</td><td>@(detalle.FiscalNumber is { Length: > 0 } fiscalNumber ? fiscalNumber : "—")</td></tr>
                    <tr><td>CUFE / CUDE</td><td style="white-space: normal; word-break: break-all;">@(detalle.Cufe is { Length: > 0 } cufe ? cufe : "—")</td></tr>
                    <tr><td>Adquirente</td><td>@detalle.BuyerName · @detalle.BuyerIdentificationType @detalle.BuyerIdentification @detalle.BuyerEmail</td></tr>
                    <tr><td>Valores</td><td>Base @Format.Money(detalle.Subtotal) · impuestos @Format.Money(detalle.TaxTotal) · total <b>@Format.Money(detalle.Total)</b></td></tr>
                    <tr><td>Envíos</td><td>@detalle.Attempts.ToString("0") intento(s) · próximo @Format.Date(detalle.NextAttemptAt) · validado @Format.Date(detalle.ValidatedAt)</td></tr>
                    <tr><td>Proveedor</td><td>@detalle.Provider @detalle.ProviderDocumentId · referencia @detalle.ReferenceCode</td></tr>
                    @if (detalle.PdfUrl is { Length: > 0 } pdfUrl)
                    {
                        <tr><td>Representación gráfica</td><td><MudLink Href="@pdfUrl" Target="_blank">Abrir el PDF</MudLink></td></tr>
                    }
                    @if (detalle.QrData is { } qrData && qrData.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
                    {
                        <tr><td>Consulta DIAN</td><td><MudLink Href="@qrData" Target="_blank">Ver en la DIAN</MudLink></td></tr>
                    }
                </tbody>
            </MudSimpleTable>
            @if (detalle.RejectionMessage is { Length: > 0 } rejection)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">Rechazo: @rejection</MudAlert>
            }
            <MudText Typo="Typo.subtitle2" Class="mb-1">Eventos</MudText>
            <MudSimpleTable Dense="true" Outlined="true" Striped="true">
                <thead><tr><th>Fecha</th><th>Evento</th><th>Código</th><th>Detalle</th></tr></thead>
                <tbody>
                    @foreach (var ev in detalle.Events)
                    {
                        <tr><td>@Format.Date(ev.OccurredAt)</td><td>@ev.EventType</td><td>@ev.ProviderCode</td><td style="white-space: normal;">@ev.Detail</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
            @if (_corregir)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Corregir los datos del adquirente (la venta no cambia; el documento se reenvía)</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="8"><MudTextField @bind-Value="_bNombre" Label="Nombre o razón social" Immediate="true" /></MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="_bPersona" Label="Tipo de persona">
                            <MudSelectItem T="string" Value="@("NATURAL")">Persona natural</MudSelectItem>
                            <MudSelectItem T="string" Value="@("LEGAL")">Persona jurídica</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudSelect T="string" @bind-Value="_bTipoId" Label="Tipo de identificación">
                            @foreach (var type in new[] { "CC", "NIT", "CE", "PP", "TI", "RC", "NUIP", "PEP", "PPT", "DIE" })
                            {
                                <MudSelectItem T="string" Value="@type">@type</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="_bNumero" Label="Número" Immediate="true" /></MudItem>
                    <MudItem xs="12" sm="3"><MudTextField @bind-Value="_bDv" Label="DV (NIT)" Immediate="true" /></MudItem>
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="_bCorreo" Label="Correo (recibe la factura)" Immediate="true" /></MudItem>
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="_bRegimen" Label="Régimen tributario (código, p. ej. 48 o 49)" Immediate="true" /></MudItem>
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="_bResponsabilidades" Label="Responsabilidades fiscales (códigos separados por coma)" Immediate="true" /></MudItem>
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="_bMunicipio" Label="Municipio (código DANE)" Immediate="true" /></MudItem>
                    <MudItem xs="12" sm="8"><MudTextField @bind-Value="_bDireccion" Label="Dirección" Immediate="true" /></MudItem>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_bTelefono" Label="Teléfono" Immediate="true" /></MudItem>
                </MudGrid>
            }
            <div class="acciones">
                <MudButton OnClick="Cerrar">Cerrar</MudButton>
                @if (PuedeGestionar && Reintentable(detalle))
                {
                    @if (_corregir)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="CorregirAsync">Guardar y reenviar</MudButton>
                    }
                    else
                    {
                        @if (!EnumText.Same(detalle.Status, "SUBMITTING"))
                        {
                            <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="AbrirCorreccion">Corregir comprador</MudButton>
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="ReintentarAsync">Reintentar envío</MudButton>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    private static readonly (string Code, string Name)[] Estados =
    [
        ("PENDING", "Pendiente"), ("SUBMITTING", "Enviando"), ("ACCEPTED", "Aceptado"), ("REJECTED", "Rechazado"), ("CONTINGENCY", "En contingencia"),
        ("ERROR", "Con error"), ("CANCELLED", "Cancelado"), ("NOT_SENT", "No enviado (antes de conectar)"), ("NOT_REQUIRED", "No requerido"),
        ("VOIDED", "Anulado"),
    ];

    private static readonly (string Code, string Name)[] Tipos =
    [
        ("INVOICE_ELECTRONIC", "Factura electrónica"), ("CREDIT_NOTE", "Nota crédito"), ("SUPPORT_DOCUMENT", "Documento soporte"),
        ("INTERNAL_RECEIPT", "Comprobante interno"), ("POS_ELECTRONIC", "Documento equivalente POS"),
    ];

    private static readonly (string Code, string Name)[] Origenes =
    [
        ("SALE", "Venta"), ("SALE_VOID", "Anulación"), ("CUSTOMER_RETURN", "Cambio o garantía"), ("PURCHASE", "Compra"),
    ];

    private IReadOnlyList<FiscalRangeDto> _ranges = [];
    private IReadOnlyList<FiscalDocumentDto> _documents = [];
    private IReadOnlyList<FiscalReconciliationDayDto> _days = [];
    private IReadOnlyList<BranchDto> _branches = [];
    private IReadOnlyList<TerminalDto> _terminals = [];
    private BillingSettingsDto? _settings;
    private FiscalAlertsDto? _alerts;
    private FiscalRangeDto? _asignar;
    private FiscalDocumentDto? _detalle;
    private bool _loading = true, _busy, _corregir;
    private int _tab;
    private string? _error, _fEstado, _fTipo, _fOrigen, _fTexto;
    private string? _bNombre, _bPersona, _bTipoId, _bNumero, _bDv, _bCorreo, _bRegimen, _bResponsabilidades, _bMunicipio, _bDireccion, _bTelefono;
    private DateTime? _desde = DateTime.Today.AddDays(-6), _hasta = DateTime.Today, _cDesde = DateTime.Today.AddDays(-6), _cHasta = DateTime.Today;
    private Guid? _aSucursal, _aCaja;

    private bool PuedeConfigurar => Session.Has("billing.settings.manage");

    private bool PuedeVer => Session.Has("billing.document.view");

    private bool PuedeGestionar => Session.Has("billing.document.manage");

    [SupplyParameterFromQuery(Name = "tab")]
    public string? Pestana { get; set; }

    [SupplyParameterFromQuery(Name = "desde")]
    public string? Desde { get; set; }

    [SupplyParameterFromQuery(Name = "hasta")]
    public string? Hasta { get; set; }

    [SupplyParameterFromQuery(Name = "estado")]
    public string? EstadoQuery { get; set; }

    [SupplyParameterFromQuery(Name = "tipo")]
    public string? TipoQuery { get; set; }

    [SupplyParameterFromQuery(Name = "origen")]
    public string? OrigenQuery { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "cdesde")]
    public string? ConciliacionDesde { get; set; }

    [SupplyParameterFromQuery(Name = "chasta")]
    public string? ConciliacionHasta { get; set; }

    /// <summary>Nombres de las pestañas visibles en orden (la de configuración solo aparece con su permiso).</summary>
    private List<string> Pestanas()
    {
        var tabs = new List<string>();
        if (PuedeConfigurar)
        {
            tabs.Add("configuracion");
        }

        if (PuedeVer)
        {
            tabs.AddRange(["rangos", "documentos", "alertas"]);
        }

        return tabs;
    }

    private static string? Codigo((string Code, string Name)[] opciones, string? valor) =>
        opciones.Any(o => string.Equals(o.Code, valor, StringComparison.Ordinal)) ? valor : null;

    private void LeerFiltros()
    {
        var tab = Pestanas().IndexOf(Pestana ?? "");
        _tab = tab < 0 ? 0 : tab;
        // Sin fechas en la dirección se conserva el rango por omisión (últimos 7 días).
        _desde = Filtros.Fecha(Desde) ?? _desde;
        _hasta = Filtros.Fecha(Hasta) ?? _hasta;
        _fEstado = Codigo(Estados, EstadoQuery);
        _fTipo = Codigo(Tipos, TipoQuery);
        _fOrigen = Codigo(Origenes, OrigenQuery);
        _fTexto = Q;
        _cDesde = Filtros.Fecha(ConciliacionDesde) ?? _cDesde;
        _cHasta = Filtros.Fecha(ConciliacionHasta) ?? _cHasta;
    }

    private void ActualizarFiltros()
    {
        var tabs = Pestanas();
        Filtros.Actualizar(Navigation, new Dictionary<string, object?>
        {
            ["tab"] = _tab > 0 && _tab < tabs.Count ? tabs[_tab] : null,
            ["desde"] = _desde,
            ["hasta"] = _hasta,
            ["estado"] = _fEstado,
            ["tipo"] = _fTipo,
            ["origen"] = _fOrigen,
            ["q"] = _fTexto,
            ["cdesde"] = _cDesde,
            ["chasta"] = _cHasta,
        });
    }

    private void CambiarPestana(int tab)
    {
        _tab = tab;
        ActualizarFiltros();
    }

    private Task FiltrarAsync()
    {
        ActualizarFiltros();
        return BuscarAsync();
    }

    private Task FiltrarConciliacionAsync()
    {
        ActualizarFiltros();
        return ConciliarAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        LeerFiltros();
        if (!PuedeConfigurar && !PuedeVer)
        {
            _error = "Su usuario no tiene permiso para la facturación electrónica.";
            _loading = false;
            return;
        }

        try
        {
            if (PuedeConfigurar)
            {
                await CargarConfiguracionAsync();
                try
                {
                    _branches = await Api.GetAsync<IReadOnlyList<BranchDto>>("api/v1/organization/branches");
                    _terminals = await Api.GetAsync<IReadOnlyList<TerminalDto>>("api/v1/organization/terminals");
                }
                catch (ApiException)
                {
                    // Sin permiso para ver sucursales: la asignación muestra los identificadores.
                }
            }

            if (PuedeVer)
            {
                await CargarRangosAsync();
                await BuscarAsync();
                await ConciliarAsync();
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private async Task CargarConfiguracionAsync() => _settings = await Api.GetAsync<BillingSettingsDto>("api/v1/billing/settings");

    /// <summary>La tarjeta de Factus conectó, desconectó o cambió el modo: se recargan la configuración, los rangos y las alertas.</summary>
    private async Task ConexionCambioAsync()
    {
        try
        {
            await CargarConfiguracionAsync();
            if (PuedeVer)
            {
                await CargarRangosAsync();
            }
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }
    }

    private async Task CargarRangosAsync()
    {
        _ranges = await Api.GetAsync<IReadOnlyList<FiscalRangeDto>>("api/v1/billing/ranges");
        _alerts = await Api.GetAsync<FiscalAlertsDto>("api/v1/billing/alerts");
    }

    private async Task SincronizarAsync()
    {
        _busy = true;
        try
        {
            var ranges = await Api.PostAsync<IReadOnlyList<FiscalRangeDto>>("api/v1/billing/ranges/sync");
            Snackbar.Add($"{ranges.Count} rango(s) sincronizado(s) desde el proveedor.", Severity.Success);
            await CargarRangosAsync();
            await CargarConfiguracionAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private void Asignar(FiscalRangeDto range)
    {
        _asignar = range;
        _aSucursal = range.BranchId;
        _aCaja = range.PosTerminalId;
    }

    private async Task AsignarAsync()
    {
        if (_asignar is not { } range)
        {
            return;
        }

        _busy = true;
        try
        {
            await Api.PutAsync<FiscalRangeDto>($"api/v1/billing/ranges/{range.Id}/assignment",
                new { branchId = _aSucursal, posTerminalId = _aSucursal is null ? null : _aCaja });
            Snackbar.Add(_aSucursal is null ? "Rango desasignado." : "Rango asignado.", Severity.Success);
            _asignar = null;
            await CargarRangosAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private async Task BuscarAsync()
    {
        try
        {
            var query = new List<string> { "limit=300" };
            if (_desde is { } desde)
            {
                query.Add("from=" + desde.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture));
            }

            if (_hasta is { } hasta)
            {
                query.Add("to=" + hasta.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture));
            }

            if (!string.IsNullOrEmpty(_fEstado))
            {
                query.Add("status=" + _fEstado);
            }

            if (!string.IsNullOrEmpty(_fTipo))
            {
                query.Add("type=" + _fTipo);
            }

            if (!string.IsNullOrEmpty(_fOrigen))
            {
                query.Add("source=" + _fOrigen);
            }

            if (!string.IsNullOrWhiteSpace(_fTexto))
            {
                query.Add("search=" + Uri.EscapeDataString(_fTexto.Trim()));
            }

            _documents = await Api.GetAsync<IReadOnlyList<FiscalDocumentDto>>($"api/v1/billing/documents?{string.Join("&", query)}");
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }
    }

    private async Task ConciliarAsync()
    {
        try
        {
            var from = (_cDesde ?? DateTime.Today.AddDays(-6)).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            var to = (_cHasta ?? DateTime.Today).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            _days = await Api.GetAsync<IReadOnlyList<FiscalReconciliationDayDto>>($"api/v1/billing/reconciliation?from={from}&to={to}");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }
    }

    private async Task VerAsync(FiscalDocumentDto document)
    {
        try
        {
            _detalle = await Api.GetAsync<FiscalDocumentDto>($"api/v1/billing/documents/{document.Id}");
            _corregir = false;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }
    }

    private void Cerrar()
    {
        _detalle = null;
        _corregir = false;
    }

    private async Task ReintentarAsync()
    {
        if (_detalle is not { } documento)
        {
            return;
        }

        _busy = true;
        try
        {
            _detalle = await Api.PostAsync<FiscalDocumentDto>($"api/v1/billing/documents/{documento.Id}/retry");
            Snackbar.Add("El documento se volverá a enviar en segundo plano.", Severity.Success);
            await BuscarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private void AbrirCorreccion()
    {
        if (_detalle is not { } documento)
        {
            return;
        }

        var identification = documento.BuyerIdentification;
        var dash = identification.IndexOf('-', StringComparison.Ordinal);
        _bNombre = documento.BuyerName;
        _bTipoId = documento.BuyerIdentificationType;
        _bNumero = dash > 0 ? identification[..dash] : identification;
        _bDv = dash > 0 ? identification[(dash + 1)..] : null;
        _bCorreo = documento.BuyerEmail ?? "";
        _bPersona = _bTipoId == "NIT" ? "LEGAL" : "NATURAL";
        _bRegimen = _bResponsabilidades = _bMunicipio = _bDireccion = _bTelefono = null;
        _corregir = true;
    }

    private async Task CorregirAsync()
    {
        if (_detalle is not { } documento)
        {
            return;
        }

        _busy = true;
        try
        {
            _detalle = await Api.PutAsync<FiscalDocumentDto>($"api/v1/billing/documents/{documento.Id}/buyer", new
            {
                name = _bNombre?.Trim(),
                identificationType = _bTipoId,
                identificationNumber = _bNumero?.Trim(),
                checkDigit = Nulo(_bDv),
                email = Nulo(_bCorreo),
                personType = _bPersona,
                taxRegime = _bRegimen?.Trim(),
                responsibilities = (_bResponsabilidades ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
                address = Nulo(_bDireccion),
                municipalityCode = Nulo(_bMunicipio),
                phone = Nulo(_bTelefono),
            });
            _corregir = false;
            Snackbar.Add("Datos del adquirente corregidos: el documento se reenviará.", Severity.Success);
            await BuscarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private string Asignacion(FiscalRangeDto range)
    {
        if (range.BranchId is not { } branchId)
        {
            return "Sin asignar";
        }

        var branch = _branches.FirstOrDefault(b => b.Id == branchId)?.Name ?? "";
        var terminal = range.PosTerminalId is not { } terminalId
            ? ""
            : " · caja " + (_terminals.FirstOrDefault(t => t.Id == terminalId)?.Code is { Length: > 0 } code ? code : terminalId.ToString());
        return (branch.Length > 0 ? branch : branchId.ToString()) + terminal;
    }

    private static bool Reintentable(FiscalDocumentDto document) =>
        !EnumText.Same(document.DocumentType, "INTERNAL_RECEIPT") && EnumText.Normalize(document.Status) is "PENDING" or "ERROR" or "CONTINGENCY" or "REJECTED";

    private static string? Nulo(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string Fecha(DateOnly? date) => date?.ToString("dd/MM/yyyy", Format.Colombia) ?? "";

    private static string NombreEstado(string code) => Estados.FirstOrDefault(e => e.Code == EnumText.Normalize(code)).Name ?? code;

    private static string NombreTipo(string code) => Tipos.FirstOrDefault(e => e.Code == EnumText.Normalize(code)).Name ?? code;

    private static string NombreOrigen(string code) => Origenes.FirstOrDefault(e => e.Code == EnumText.Normalize(code)).Name ?? code;

    private static string NombreModo(string mode) => EnumText.Normalize(mode) switch
    {
        "EVERY_SALE" => "factura en cada venta",
        "ON_REQUEST" => "solo a pedido del cliente",
        _ => "apagada",
    };

    private static Color ColorModo(string mode) => EnumText.Normalize(mode) switch
    {
        "EVERY_SALE" => Color.Success,
        "ON_REQUEST" => Color.Info,
        _ => Color.Default,
    };

    private static Color ColorEstado(string status) => EnumText.Normalize(status) switch
    {
        "ACCEPTED" => Color.Success,
        "REJECTED" or "ERROR" => Color.Error,
        "CONTINGENCY" or "PENDING" or "SUBMITTING" => Color.Warning,
        _ => Color.Default,
    };
}
