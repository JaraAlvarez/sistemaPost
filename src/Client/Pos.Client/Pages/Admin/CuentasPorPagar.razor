@page "/admin/cuentas-por-pagar"
@inject ApiClient Api
@inject SessionState Session
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@using Pos.Modules.Purchasing.Contracts

<PageTitle>Cuentas por pagar · BusinessPost</PageTitle>

<Pagina Funcion="PURCHASING" Titulo="Cuentas por pagar" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (Session.Has("purchasing.payable.pay"))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Payments" Href="/admin/cuentas-por-pagar/pago">Registrar pago</MudButton>
        }
    </Acciones>
    <ChildContent>
        @if (_vencimientos is { } vencimientos)
        {
            <MudStack Row="true" Class="mb-3 flex-wrap">
                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.caption">Vencido a hoy</MudText>
                    <div class="cifra" style="color:var(--mud-palette-error)">@Format.Money(vencimientos.OverdueTotal)</div>
                    <MudText Typo="Typo.caption">@Vencidas.Count factura(s)</MudText>
                </MudPaper>
                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.caption">Vence en los próximos @vencimientos.Days días</MudText>
                    <div class="cifra">@Format.Money(vencimientos.DueSoonTotal)</div>
                    <MudText Typo="Typo.caption">@PorVencer.Count factura(s)</MudText>
                </MudPaper>
                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.caption">Total por pagar</MudText>
                    <div class="cifra">@Format.Money(_edades?.Totals.Total ?? 0m)</div>
                </MudPaper>
            </MudStack>
        }
        <MudTabs ActivePanelIndex="_tab" ActivePanelIndexChanged="CambiarPestana" Elevation="0" Class="mb-2">
            <MudTabPanel Text="Facturas por pagar">
                <MudStack Row="true" Class="my-3" AlignItems="AlignItems.Center">
                    <MudSelect T="Guid?" Value="_proveedor" ValueChanged="@(v => FiltrarProveedorAsync(v))" Label="Proveedor" Clearable="true" Style="min-width:280px">
                        @foreach (var supplier in _proveedores)
                        {
                            <MudSelectItem T="Guid?" Value="@supplier.Id">@supplier.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                    <MudCheckBox T="bool" Value="_soloAbiertas" ValueChanged="@(v => FiltrarAbiertasAsync(v))" Label="Solo con saldo" />
                </MudStack>
                <MudTable RowsPerPage="25" Items="_cuentas" Dense="true" Hover="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Proveedor</MudTh><MudTh>Documento</MudTh><MudTh>Emisión</MudTh><MudTh>Vence</MudTh><MudTh Class="num">Valor</MudTh><MudTh Class="num">Saldo</MudTh><MudTh>Estado</MudTh><MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.SupplierName</MudTd>
                        <MudTd>@context.DocumentNumber</MudTd>
                        <MudTd>@Dia(context.IssueDate)</MudTd>
                        <MudTd>@Dia(context.DueDate)</MudTd>
                        <MudTd Class="num">@Format.Money(context.OriginalAmount)</MudTd>
                        <MudTd Class="num">@Format.Money(context.Balance)</MudTd>
                        <MudTd>@EstadoCuenta(context)</MudTd>
                        <MudTd>
                            @if (Session.Has("purchasing.payable.pay") && EnumText.Same(context.Status, "OPEN") && context.Balance > 0)
                            {
                                <MudButton Size="Size.Small" Color="Color.Primary" Href="@($"/admin/cuentas-por-pagar/pago?proveedor={context.SupplierId}&factura={context.Id}")">Pagar</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><EstadoVacio Mensaje="No hay cuentas por pagar." /></NoRecordsContent>
                    <PagerContent><Paginador /></PagerContent>
                </MudTable>
            </MudTabPanel>
            <MudTabPanel Text="Cartera por edades">
                <MudText Typo="Typo.body2" Class="my-3">Saldos vencidos por días al @Dia(_edades?.AsOf).</MudText>
                <MudTable RowsPerPage="25" Items="Edades" Dense="true" Hover="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Proveedor</MudTh><MudTh Class="num">Corriente</MudTh><MudTh Class="num">1 a 30</MudTh><MudTh Class="num">31 a 60</MudTh><MudTh Class="num">61 a 90</MudTh>
                        <MudTh Class="num">Más de 90</MudTh><MudTh Class="num">Total</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.SupplierCode · @context.SupplierName</MudTd>
                        <MudTd Class="num">@Format.Money(context.Current)</MudTd>
                        <MudTd Class="num">@Format.Money(context.Days1To30)</MudTd>
                        <MudTd Class="num">@Format.Money(context.Days31To60)</MudTd>
                        <MudTd Class="num">@Format.Money(context.Days61To90)</MudTd>
                        <MudTd Class="num">@Format.Money(context.Over90)</MudTd>
                        <MudTd Class="num"><b>@Format.Money(context.Total)</b></MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTd><b>Total</b></MudTd>
                        <MudTd Class="num"><b>@Format.Money(Totales?.Current ?? 0m)</b></MudTd>
                        <MudTd Class="num"><b>@Format.Money(Totales?.Days1To30 ?? 0m)</b></MudTd>
                        <MudTd Class="num"><b>@Format.Money(Totales?.Days31To60 ?? 0m)</b></MudTd>
                        <MudTd Class="num"><b>@Format.Money(Totales?.Days61To90 ?? 0m)</b></MudTd>
                        <MudTd Class="num"><b>@Format.Money(Totales?.Over90 ?? 0m)</b></MudTd>
                        <MudTd Class="num"><b>@Format.Money(Totales?.Total ?? 0m)</b></MudTd>
                    </FooterContent>
                    <NoRecordsContent><EstadoVacio Mensaje="No hay saldos por pagar." /></NoRecordsContent>
                    <PagerContent><Paginador /></PagerContent>
                </MudTable>
            </MudTabPanel>
            <MudTabPanel Text="Vencimientos">
                <MudText Typo="Typo.h6" Class="mt-3 mb-1">Vencidas</MudText>
                <MudTable RowsPerPage="25" Items="Vencidas" Dense="true" Striped="true" Class="mb-3">
                    <HeaderContent>
                        <MudTh>Proveedor</MudTh><MudTh>Documento</MudTh><MudTh>Venció</MudTh><MudTh Class="num">Días vencida</MudTh><MudTh Class="num">Saldo</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.SupplierName</MudTd>
                        <MudTd>@context.DocumentNumber</MudTd>
                        <MudTd>@Dia(context.DueDate)</MudTd>
                        <MudTd Class="num">@context.DaysOverdue</MudTd>
                        <MudTd Class="num">@Format.Money(context.Balance)</MudTd>
                    </RowTemplate>
                    <NoRecordsContent><EstadoVacio Mensaje="No hay facturas vencidas." /></NoRecordsContent>
                    <PagerContent><Paginador /></PagerContent>
                </MudTable>
                <MudText Typo="Typo.h6" Class="mb-1">Por vencer en los próximos @(_vencimientos?.Days ?? 0) días</MudText>
                <MudTable RowsPerPage="25" Items="PorVencer" Dense="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Proveedor</MudTh><MudTh>Documento</MudTh><MudTh>Vence</MudTh><MudTh Class="num">Saldo</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.SupplierName</MudTd>
                        <MudTd>@context.DocumentNumber</MudTd>
                        <MudTd>@Dia(context.DueDate)</MudTd>
                        <MudTd Class="num">@Format.Money(context.Balance)</MudTd>
                    </RowTemplate>
                    <NoRecordsContent><EstadoVacio Mensaje="Nada vence en esos días." /></NoRecordsContent>
                    <PagerContent><Paginador /></PagerContent>
                </MudTable>
            </MudTabPanel>
            <MudTabPanel Text="Pagos">
                <MudTable RowsPerPage="25" Items="_pagos" Dense="true" Hover="true" Striped="true" Class="mt-3">
                    <HeaderContent>
                        <MudTh>Número</MudTh><MudTh>Proveedor</MudTh><MudTh>Fecha</MudTh><MudTh>Referencia</MudTh><MudTh Class="num">Valor</MudTh><MudTh>Estado</MudTh><MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Number</MudTd>
                        <MudTd>@context.SupplierName</MudTd>
                        <MudTd>@Dia(context.Date)</MudTd>
                        <MudTd>@context.Reference</MudTd>
                        <MudTd Class="num">@Format.Money(context.Total)</MudTd>
                        <MudTd>@(EnumText.Same(context.Status, "VOIDED") ? "Anulado" : "Registrado")</MudTd>
                        <MudTd>
                            @if (Session.Has("purchasing.payable.pay") && EnumText.Same(context.Status, "POSTED"))
                            {
                                <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => PedirAnulacion(context))">Anular</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><EstadoVacio Mensaje="No hay pagos registrados." /></NoRecordsContent>
                    <PagerContent><Paginador /></PagerContent>
                </MudTable>
            </MudTabPanel>
        </MudTabs>
    </ChildContent>
</Pagina>

@if (_anular is { } anular)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true">
            <h2>Anular el pago @anular.Number</h2>
            <MudText Typo="Typo.body2">@anular.SupplierName · @Format.Money(anular.Total). Los saldos de las facturas vuelven a quedar pendientes.</MudText>
            <MudTextField @bind-Value="_motivo" Label="Motivo (5 a 300 caracteres)" Immediate="true" AutoFocus="true" Lines="2" />
            <div class="acciones">
                <MudButton OnClick="@(() => _anular = null)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="_busy" OnClick="AnularAsync">Anular</MudButton>
            </div>
        </div>
    </div>
}

@code {
    private List<PayableDto> _cuentas = [];
    private List<PurchasingDocumentDto> _pagos = [];
    private List<Proveedor> _proveedores = [];
    private DuePayablesDto? _vencimientos;
    private AgingReportDto? _edades;
    private PurchasingDocumentDto? _anular;
    private Guid? _proveedor;
    private string? _error, _motivo;
    private bool _loading = true, _busy, _soloAbiertas = true;
    private int _tab;

    /// <summary>Pestañas en la dirección; la primera (facturas) no se escribe.</summary>
    private static readonly string[] Pestanas = ["facturas", "edades", "vencimientos", "pagos"];

    [SupplyParameterFromQuery(Name = "proveedor")]
    public string? ProveedorQuery { get; set; }

    /// <summary>"no" incluye las facturas sin saldo (por omisión solo se ven las que tienen saldo).</summary>
    [SupplyParameterFromQuery(Name = "saldo")]
    public string? SaldoQuery { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    public string? Pestana { get; set; }

    private IReadOnlyList<PayableDto> Vencidas => _vencimientos?.Overdue ?? [];

    private IReadOnlyList<PayableDto> PorVencer => _vencimientos?.DueSoon ?? [];

    private IReadOnlyList<AgingRowDto> Edades => _edades?.Rows ?? [];

    private AgingRowDto? Totales => _edades?.Totals;

    protected override Task OnInitializedAsync()
    {
        _proveedor = Guid.TryParse(ProveedorQuery, out var proveedor) && proveedor != Guid.Empty ? proveedor : null;
        _soloAbiertas = !string.Equals(SaldoQuery, "no", StringComparison.OrdinalIgnoreCase);
        var tab = Array.IndexOf(Pestanas, Pestana ?? "");
        _tab = tab < 0 ? 0 : tab;
        return CargarAsync();
    }

    private void ActualizarFiltros() => Filtros.Actualizar(Navigation, new Dictionary<string, object?>
    {
        ["proveedor"] = _proveedor,
        ["saldo"] = _soloAbiertas ? null : "no",
        ["tab"] = _tab > 0 && _tab < Pestanas.Length ? Pestanas[_tab] : null,
    });

    private void CambiarPestana(int tab)
    {
        _tab = tab;
        ActualizarFiltros();
    }

    private static string EstadoCuenta(PayableDto account) => EnumText.Normalize(account.Status) switch
    {
        "OPEN" when account.DaysOverdue > 0 => $"Vencida ({account.DaysOverdue} días)",
        "OPEN" => "Pendiente",
        "SETTLED" => "Pagada",
        "VOIDED" => "Anulada",
        var other => other,
    };

    /// <summary>Fecha sin hora (DateOnly del servidor) como día/mes/año.</summary>
    private static string Dia(DateOnly? date) => date is { } value ? value.ToString("dd/MM/yyyy", Format.Colombia) : "—";

    private static List<Proveedor> Proveedores(IEnumerable<PayableDto> accounts) =>
        [.. accounts.Select(a => new Proveedor(a.SupplierId, a.SupplierName)).Distinct().OrderBy(p => p.Nombre, StringComparer.CurrentCulture)];

    private async Task CargarAsync()
    {
        _loading = true;
        try
        {
            _vencimientos = await Api.GetAsync<DuePayablesDto>("api/v1/purchasing/payables/due");
            _edades = await Api.GetAsync<AgingReportDto>("api/v1/purchasing/payables/aging");
            _pagos = [.. await Api.GetAsync<List<PurchasingDocumentDto>>("api/v1/purchasing/payments")];
            await CargarCuentasAsync();
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private async Task CargarCuentasAsync()
    {
        var supplier = _proveedor is { } id ? $"supplierId={id}&" : "";
        var open = _soloAbiertas ? "true" : "false";
        _cuentas = [.. await Api.GetAsync<List<PayableDto>>($"api/v1/purchasing/payables?{supplier}openOnly={open}")];
        if (_proveedor is null)
        {
            _proveedores = Proveedores(_cuentas);
        }
        else if (_proveedores.Count == 0)
        {
            // Llegó con el proveedor en la dirección: la lista del selector sale de todas las cuentas con el mismo filtro de saldo.
            _proveedores = Proveedores(await Api.GetAsync<List<PayableDto>>($"api/v1/purchasing/payables?openOnly={open}"));
        }
    }

    private async Task FiltrarProveedorAsync(Guid? supplierId)
    {
        _proveedor = supplierId;
        ActualizarFiltros();
        await RecargarCuentasAsync();
    }

    private async Task FiltrarAbiertasAsync(bool openOnly)
    {
        _soloAbiertas = openOnly;
        ActualizarFiltros();
        await RecargarCuentasAsync();
    }

    private async Task RecargarCuentasAsync()
    {
        try
        {
            await CargarCuentasAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }
    }

    private void PedirAnulacion(PurchasingDocumentDto payment)
    {
        _motivo = null;
        _anular = payment;
    }

    private async Task AnularAsync()
    {
        if (_anular is not { } anular)
        {
            return;
        }

        _busy = true;
        try
        {
            await Api.PostAsync<PaymentDto>($"api/v1/purchasing/payments/{anular.Id}/void", new { reason = (_motivo ?? "").Trim() });
            Snackbar.Add($"Pago {anular.Number} anulado.", Severity.Success);
            _anular = null;
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private sealed record Proveedor(Guid Id, string Nombre);
}
