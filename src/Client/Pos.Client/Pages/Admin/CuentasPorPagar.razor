@page "/admin/cuentas-por-pagar"
@inject ApiClient Api
@inject SessionState Session
@inject ISnackbar Snackbar

<PageTitle>Cuentas por pagar · BusinessPost</PageTitle>

<Pagina Titulo="Cuentas por pagar" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (Session.Has("purchasing.payable.pay"))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Payments" Href="/admin/cuentas-por-pagar/pago">Registrar pago</MudButton>
        }
    </Acciones>
    <ChildContent>
        @if (_vencimientos.ValueKind == JsonValueKind.Object)
        {
            <MudStack Row="true" Class="mb-3 flex-wrap">
                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.caption">Vencido a hoy</MudText>
                    <div class="cifra" style="color:var(--mud-palette-error)">@Format.Money(_vencimientos.Dec("overdueTotal"))</div>
                    <MudText Typo="Typo.caption">@Vencidas.Count factura(s)</MudText>
                </MudPaper>
                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.caption">Vence en los próximos @_vencimientos.Dec("days") días</MudText>
                    <div class="cifra">@Format.Money(_vencimientos.Dec("dueSoonTotal"))</div>
                    <MudText Typo="Typo.caption">@PorVencer.Count factura(s)</MudText>
                </MudPaper>
                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.caption">Total por pagar</MudText>
                    <div class="cifra">@Format.Money(_edades.Prop("totals").Dec("total"))</div>
                </MudPaper>
            </MudStack>
        }
        <MudTabs Elevation="0" Class="mb-2">
            <MudTabPanel Text="Facturas por pagar">
                <MudStack Row="true" Class="my-3" AlignItems="AlignItems.Center">
                    <MudSelect T="Guid?" Value="_proveedor" ValueChanged="@(v => FiltrarProveedorAsync(v))" Label="Proveedor" Clearable="true" Style="min-width:280px">
                        @foreach (var supplier in _proveedores)
                        {
                            <MudSelectItem T="Guid?" Value="@supplier.Id">@supplier.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                    <MudCheckBox T="bool" Value="_soloAbiertas" ValueChanged="@(v => FiltrarAbiertasAsync(v))" Label="Solo con saldo" />
                </MudStack>
                <MudTable RowsPerPage="25" Items="_cuentas" Dense="true" Hover="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Proveedor</MudTh><MudTh>Documento</MudTh><MudTh>Emisión</MudTh><MudTh>Vence</MudTh><MudTh Class="num">Valor</MudTh><MudTh Class="num">Saldo</MudTh><MudTh>Estado</MudTh><MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Str("supplierName")</MudTd>
                        <MudTd>@context.Str("documentNumber")</MudTd>
                        <MudTd>@Dia(context, "issueDate")</MudTd>
                        <MudTd>@Dia(context, "dueDate")</MudTd>
                        <MudTd Class="num">@Format.Money(context.Dec("originalAmount"))</MudTd>
                        <MudTd Class="num">@Format.Money(context.Dec("balance"))</MudTd>
                        <MudTd>@EstadoCuenta(context)</MudTd>
                        <MudTd>
                            @if (Session.Has("purchasing.payable.pay") && context.Str("status") == "OPEN" && context.Dec("balance") > 0)
                            {
                                <MudButton Size="Size.Small" Color="Color.Primary" Href="@($"/admin/cuentas-por-pagar/pago?proveedor={context.GetProperty("supplierId").GetGuid()}&factura={context.GetProperty("id").GetGuid()}")">Pagar</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><EstadoVacio Mensaje="No hay cuentas por pagar." /></NoRecordsContent>
                    <PagerContent><Paginador /></PagerContent>
                </MudTable>
            </MudTabPanel>
            <MudTabPanel Text="Cartera por edades">
                <MudText Typo="Typo.body2" Class="my-3">Saldos vencidos por días al @Dia(_edades, "asOf").</MudText>
                <MudTable RowsPerPage="25" Items="Edades" Dense="true" Hover="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Proveedor</MudTh><MudTh Class="num">Corriente</MudTh><MudTh Class="num">1 a 30</MudTh><MudTh Class="num">31 a 60</MudTh><MudTh Class="num">61 a 90</MudTh>
                        <MudTh Class="num">Más de 90</MudTh><MudTh Class="num">Total</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Str("supplierCode") · @context.Str("supplierName")</MudTd>
                        <MudTd Class="num">@Format.Money(context.Dec("current"))</MudTd>
                        <MudTd Class="num">@Format.Money(context.Dec("days1To30"))</MudTd>
                        <MudTd Class="num">@Format.Money(context.Dec("days31To60"))</MudTd>
                        <MudTd Class="num">@Format.Money(context.Dec("days61To90"))</MudTd>
                        <MudTd Class="num">@Format.Money(context.Dec("over90"))</MudTd>
                        <MudTd Class="num"><b>@Format.Money(context.Dec("total"))</b></MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTd><b>Total</b></MudTd>
                        <MudTd Class="num"><b>@Format.Money(Totales.Dec("current"))</b></MudTd>
                        <MudTd Class="num"><b>@Format.Money(Totales.Dec("days1To30"))</b></MudTd>
                        <MudTd Class="num"><b>@Format.Money(Totales.Dec("days31To60"))</b></MudTd>
                        <MudTd Class="num"><b>@Format.Money(Totales.Dec("days61To90"))</b></MudTd>
                        <MudTd Class="num"><b>@Format.Money(Totales.Dec("over90"))</b></MudTd>
                        <MudTd Class="num"><b>@Format.Money(Totales.Dec("total"))</b></MudTd>
                    </FooterContent>
                    <NoRecordsContent><EstadoVacio Mensaje="No hay saldos por pagar." /></NoRecordsContent>
                    <PagerContent><Paginador /></PagerContent>
                </MudTable>
            </MudTabPanel>
            <MudTabPanel Text="Vencimientos">
                <MudText Typo="Typo.h6" Class="mt-3 mb-1">Vencidas</MudText>
                <MudTable RowsPerPage="25" Items="Vencidas" Dense="true" Striped="true" Class="mb-3">
                    <HeaderContent>
                        <MudTh>Proveedor</MudTh><MudTh>Documento</MudTh><MudTh>Venció</MudTh><MudTh Class="num">Días vencida</MudTh><MudTh Class="num">Saldo</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Str("supplierName")</MudTd>
                        <MudTd>@context.Str("documentNumber")</MudTd>
                        <MudTd>@Dia(context, "dueDate")</MudTd>
                        <MudTd Class="num">@context.Dec("daysOverdue")</MudTd>
                        <MudTd Class="num">@Format.Money(context.Dec("balance"))</MudTd>
                    </RowTemplate>
                    <NoRecordsContent><EstadoVacio Mensaje="No hay facturas vencidas." /></NoRecordsContent>
                    <PagerContent><Paginador /></PagerContent>
                </MudTable>
                <MudText Typo="Typo.h6" Class="mb-1">Por vencer en los próximos @_vencimientos.Dec("days") días</MudText>
                <MudTable RowsPerPage="25" Items="PorVencer" Dense="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Proveedor</MudTh><MudTh>Documento</MudTh><MudTh>Vence</MudTh><MudTh Class="num">Saldo</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Str("supplierName")</MudTd>
                        <MudTd>@context.Str("documentNumber")</MudTd>
                        <MudTd>@Dia(context, "dueDate")</MudTd>
                        <MudTd Class="num">@Format.Money(context.Dec("balance"))</MudTd>
                    </RowTemplate>
                    <NoRecordsContent><EstadoVacio Mensaje="Nada vence en esos días." /></NoRecordsContent>
                    <PagerContent><Paginador /></PagerContent>
                </MudTable>
            </MudTabPanel>
            <MudTabPanel Text="Pagos">
                <MudTable RowsPerPage="25" Items="_pagos" Dense="true" Hover="true" Striped="true" Class="mt-3">
                    <HeaderContent>
                        <MudTh>Número</MudTh><MudTh>Proveedor</MudTh><MudTh>Fecha</MudTh><MudTh>Referencia</MudTh><MudTh Class="num">Valor</MudTh><MudTh>Estado</MudTh><MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Str("number")</MudTd>
                        <MudTd>@context.Str("supplierName")</MudTd>
                        <MudTd>@Dia(context, "date")</MudTd>
                        <MudTd>@context.Str("reference")</MudTd>
                        <MudTd Class="num">@Format.Money(context.Dec("total"))</MudTd>
                        <MudTd>@(context.Str("status") == "VOIDED" ? "Anulado" : "Registrado")</MudTd>
                        <MudTd>
                            @if (Session.Has("purchasing.payable.pay") && context.Str("status") == "POSTED")
                            {
                                <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => PedirAnulacion(context))">Anular</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><EstadoVacio Mensaje="No hay pagos registrados." /></NoRecordsContent>
                    <PagerContent><Paginador /></PagerContent>
                </MudTable>
            </MudTabPanel>
        </MudTabs>
    </ChildContent>
</Pagina>

@if (_anular.ValueKind == JsonValueKind.Object)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true">
            <h2>Anular el pago @_anular.Str("number")</h2>
            <MudText Typo="Typo.body2">@_anular.Str("supplierName") · @Format.Money(_anular.Dec("total")). Los saldos de las facturas vuelven a quedar pendientes.</MudText>
            <MudTextField @bind-Value="_motivo" Label="Motivo (5 a 300 caracteres)" Immediate="true" AutoFocus="true" Lines="2" />
            <div class="acciones">
                <MudButton OnClick="@(() => _anular = default)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="_busy" OnClick="AnularAsync">Anular</MudButton>
            </div>
        </div>
    </div>
}

@code {
    private List<JsonElement> _cuentas = [];
    private List<JsonElement> _pagos = [];
    private List<Proveedor> _proveedores = [];
    private JsonElement _vencimientos, _edades, _anular;
    private Guid? _proveedor;
    private string? _error, _motivo;
    private bool _loading = true, _busy, _soloAbiertas = true;

    private List<JsonElement> Vencidas => _vencimientos.Prop("overdue").Items();

    private List<JsonElement> PorVencer => _vencimientos.Prop("dueSoon").Items();

    private List<JsonElement> Edades => _edades.Prop("rows").Items();

    private JsonElement Totales => _edades.Prop("totals");

    protected override Task OnInitializedAsync() => CargarAsync();

    private static string EstadoCuenta(JsonElement account) => account.Str("status") switch
    {
        "OPEN" when account.Dec("daysOverdue") > 0 => $"Vencida ({account.Dec("daysOverdue")} días)",
        "OPEN" => "Pendiente",
        "SETTLED" => "Pagada",
        "VOIDED" => "Anulada",
        var other => other,
    };

    /// <summary>Fecha sin hora (DateOnly del servidor, "yyyy-MM-dd").</summary>
    private static string Dia(JsonElement element, string name) =>
        DateOnly.TryParse(element.Str(name), CultureInfo.InvariantCulture, out var date) ? date.ToString("dd/MM/yyyy", Format.Colombia) : "—";

    private static List<Proveedor> Proveedores(IEnumerable<JsonElement> accounts) =>
        [.. accounts.Select(a => new Proveedor(a.GetProperty("supplierId").GetGuid(), a.Str("supplierName"))).Distinct().OrderBy(p => p.Nombre, StringComparer.CurrentCulture)];

    private async Task CargarAsync()
    {
        _loading = true;
        try
        {
            _vencimientos = await Api.GetAsync<JsonElement>("api/v1/purchasing/payables/due");
            _edades = await Api.GetAsync<JsonElement>("api/v1/purchasing/payables/aging");
            _pagos = (await Api.GetAsync<JsonElement>("api/v1/purchasing/payments")).Items();
            await CargarCuentasAsync();
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private async Task CargarCuentasAsync()
    {
        var supplier = _proveedor is { } id ? $"supplierId={id}&" : "";
        var open = _soloAbiertas ? "true" : "false";
        _cuentas = (await Api.GetAsync<JsonElement>($"api/v1/purchasing/payables?{supplier}openOnly={open}")).Items();
        if (_proveedor is null)
        {
            _proveedores = Proveedores(_cuentas);
        }
    }

    private async Task FiltrarProveedorAsync(Guid? supplierId)
    {
        _proveedor = supplierId;
        await RecargarCuentasAsync();
    }

    private async Task FiltrarAbiertasAsync(bool openOnly)
    {
        _soloAbiertas = openOnly;
        await RecargarCuentasAsync();
    }

    private async Task RecargarCuentasAsync()
    {
        try
        {
            await CargarCuentasAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }
    }

    private void PedirAnulacion(JsonElement payment)
    {
        _motivo = null;
        _anular = payment;
    }

    private async Task AnularAsync()
    {
        _busy = true;
        try
        {
            await Api.PostAsync<JsonElement>($"api/v1/purchasing/payments/{_anular.GetProperty("id").GetGuid()}/void", new { reason = (_motivo ?? "").Trim() });
            Snackbar.Add($"Pago {_anular.Str("number")} anulado.", Severity.Success);
            _anular = default;
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private sealed record Proveedor(Guid Id, string Nombre);
}
