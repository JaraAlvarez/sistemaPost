@page "/admin/jornadas"
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Jornadas de caja · BusinessPost</PageTitle>

<Pagina Titulo="Jornadas de caja" Cargando="_loading" Error="@_error">
    <ChildContent>
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="6" sm="3">
                <MudDatePicker @bind-Date="_desde" Label="Desde" DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudDatePicker @bind-Date="_hasta" Label="Hasta" DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudSelect T="string" @bind-Value="_estado" Label="Estado">
                    <MudSelectItem T="string" Value="@("")">Todas</MudSelectItem>
                    <MudSelectItem T="string" Value="@("OPEN")">Abiertas</MudSelectItem>
                    <MudSelectItem T="string" Value="@("CLOSING")">En cierre</MudSelectItem>
                    <MudSelectItem T="string" Value="@("CLOSED")">Cerradas</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudCheckBox T="bool" @bind-Value="_pendientes" Label="Por revisar" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_loading" OnClick="FiltrarAsync">Buscar</MudButton>
            </MudItem>
        </MudGrid>

        <MudTable RowsPerPage="25" Items="_sessions" Dense="true" Hover="true" Striped="true" Class="fila-clic"
                  OnRowClick="@((TableRowClickEventArgs<JsonElement> e) => Abrir(e.Item))">
            <HeaderContent>
                <MudTh>Jornada</MudTh><MudTh>Caja</MudTh><MudTh>Cajero</MudTh><MudTh>Fecha</MudTh><MudTh>Estado</MudTh><MudTh Class="num">Diferencia</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><a href="@($"/admin/jornadas/{context.Str("id")}")" @onclick:stopPropagation="true">@context.Str("number")</a></MudTd>
                <MudTd>@context.Str("terminalCode")</MudTd>
                <MudTd>@context.Str("cashierName")</MudTd>
                <MudTd>@context.Str("businessDate")</MudTd>
                <MudTd>
                    @JornadaDetalle.Estado(context.Str("status"))
                    @if (context.Bool("reviewRequired") && !context.Bool("reviewed"))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Por revisar</MudChip>
                    }
                </MudTd>
                <MudTd Class="num">@(context.Prop("difference").ValueKind == JsonValueKind.Number ? Format.Money(context.Dec("difference")) : "")</MudTd>
            </RowTemplate>
            <NoRecordsContent><EstadoVacio Mensaje="No hay jornadas con esos filtros." /></NoRecordsContent>
            <PagerContent><Paginador /></PagerContent>
        </MudTable>
    </ChildContent>
</Pagina>

@code {
    private List<JsonElement> _sessions = [];
    private DateTime? _desde = DateTime.Today.AddDays(-7), _hasta = DateTime.Today;
    private string _estado = "";
    private bool _pendientes, _loading = true;
    private string? _error;

    private static readonly string[] Estados = ["OPEN", "CLOSING", "CLOSED"];

    [SupplyParameterFromQuery(Name = "desde")]
    public string? Desde { get; set; }

    [SupplyParameterFromQuery(Name = "hasta")]
    public string? Hasta { get; set; }

    [SupplyParameterFromQuery(Name = "estado")]
    public string? EstadoQuery { get; set; }

    [SupplyParameterFromQuery(Name = "revisar")]
    public string? Revisar { get; set; }

    protected override Task OnInitializedAsync()
    {
        // Sin fechas en la dirección se conserva el rango por omisión (últimos 7 días).
        _desde = Filtros.Fecha(Desde) ?? _desde;
        _hasta = Filtros.Fecha(Hasta) ?? _hasta;
        if (EstadoQuery is { } estado && Estados.Contains(estado, StringComparer.Ordinal))
        {
            _estado = estado;
        }

        _pendientes = string.Equals(Revisar, "true", StringComparison.OrdinalIgnoreCase);
        return BuscarAsync();
    }

    private Task FiltrarAsync()
    {
        Filtros.Actualizar(Navigation, new Dictionary<string, object?>
        {
            ["desde"] = _desde,
            ["hasta"] = _hasta,
            ["estado"] = _estado,
            ["revisar"] = _pendientes,
        });
        return BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        _loading = true;
        try
        {
            var query = new List<string>();
            if (_desde is { } desde)
            {
                query.Add("from=" + desde.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture));
            }

            if (_hasta is { } hasta)
            {
                query.Add("to=" + hasta.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture));
            }

            if (_estado.Length > 0)
            {
                query.Add("status=" + _estado);
            }

            if (_pendientes)
            {
                query.Add("pendingReview=true");
            }

            _sessions = (await Api.GetAsync<JsonElement>("api/v1/cash/sessions?" + string.Join("&", query))).Items();
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private void Abrir(JsonElement session) => Navigation.NavigateTo($"/admin/jornadas/{session.GetProperty("id").GetGuid()}");
}
