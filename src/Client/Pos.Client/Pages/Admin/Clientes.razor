@page "/admin/clientes"
@using Pos.Modules.Catalog.Contracts
@using Pos.Modules.Customers.Contracts
@inject ApiClient Api
@inject SessionState Session
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Clientes · BusinessPost</PageTitle>

<Pagina Titulo="Clientes" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (_tab == 0 && Session.Has("customers.customer.manage"))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" Href="/admin/clientes/nuevo">Nuevo cliente</MudButton>
        }
        else if (_tab == 1 && Session.Has("customers.group.manage"))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NuevoGrupo">Nuevo grupo</MudButton>
        }
    </Acciones>
    <ChildContent>
        <MudTabs ActivePanelIndex="_tab" ActivePanelIndexChanged="CambiarPestana">
            <MudTabPanel Text="Clientes">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="my-3">
                    <MudTextField T="string" @bind-Value="_search" Label="Buscar por nombre, cédula/NIT o celular" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true" DebounceInterval="350" OnDebounceIntervalElapsed="@(_ => FiltrarAsync(_statusFilter))" />
                    <MudSelect T="string" Value="_statusFilter" ValueChanged="@(v => FiltrarAsync(v))" Label="Estado" Style="max-width: 200px">
                        <MudSelectItem T="string" Value="@("")">Todos</MudSelectItem>
                        <MudSelectItem T="string" Value="@("ACTIVE")">Activos</MudSelectItem>
                        <MudSelectItem T="string" Value="@("INACTIVE")">Inactivos</MudSelectItem>
                        <MudSelectItem T="string" Value="@("BLOCKED")">Bloqueados</MudSelectItem>
                    </MudSelect>
                </MudStack>
                <MudTable RowsPerPage="25" Items="_items" Dense="true" Hover="true" Striped="true" Class="fila-clic"
                          OnRowClick="@((TableRowClickEventArgs<JsonElement> e) => Abrir(e.Item))">
                    <HeaderContent>
                        <MudTh>Identificación</MudTh><MudTh>Nombre</MudTh><MudTh>Celular</MudTh><MudTh>Correo</MudTh><MudTh>Grupo</MudTh><MudTh>Estado</MudTh><MudTh>Autorizó datos</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@ClienteDetalle.Identificacion(context)</MudTd>
                        <MudTd><a href="@($"/admin/clientes/{context.Str("partyId")}")" @onclick:stopPropagation="true">@context.Str("displayName")</a></MudTd>
                        <MudTd>@context.Str("phone")</MudTd>
                        <MudTd>@context.Str("email")</MudTd>
                        <MudTd>@context.Str("groupCode")</MudTd>
                        <MudTd>@ClienteDetalle.NombreEstado(context.Str("status"))</MudTd>
                        <MudTd>@(context.Bool("serviceConsent") ? "Sí" : "No")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent><EstadoVacio Mensaje="No hay clientes que coincidan." /></NoRecordsContent>
                    <PagerContent><Paginador /></PagerContent>
                </MudTable>
                <MudText Typo="Typo.caption">@_total cliente(s). Se muestran los primeros 100.</MudText>
            </MudTabPanel>
            <MudTabPanel Text="Grupos">
                <MudTable RowsPerPage="25" Items="_groups" Dense="true" Hover="true" Striped="true" Class="mt-3">
                    <HeaderContent>
                        <MudTh>Código</MudTh><MudTh>Nombre</MudTh><MudTh>Lista de precios</MudTh><MudTh>Por defecto</MudTh><MudTh>Estado</MudTh><MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Code</MudTd>
                        <MudTd>@context.Name</MudTd>
                        <MudTd>@NombreLista(context.PriceListId)</MudTd>
                        <MudTd>@(context.IsDefault ? "Sí" : "")</MudTd>
                        <MudTd>@ClienteDetalle.NombreEstado(context.Status)</MudTd>
                        <MudTd>
                            @if (Session.Has("customers.group.manage"))
                            {
                                <MudButton Size="Size.Small" OnClick="@(() => EditarGrupo(context))">Editar</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><EstadoVacio Mensaje="No hay grupos de clientes." /></NoRecordsContent>
                    <PagerContent><Paginador /></PagerContent>
                </MudTable>
            </MudTabPanel>
        </MudTabs>
    </ChildContent>
</Pagina>

@if (_grupoForm)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true">
            <h2>@(_grupoId is null ? "Nuevo grupo de clientes" : "Editar grupo")</h2>
            @if (_grupoId is null)
            {
                <MudTextField @bind-Value="_grupoCode" Label="Código (p. ej. MAYORISTAS)" Immediate="true" />
            }
            <MudTextField @bind-Value="_grupoName" Label="Nombre" Immediate="true" />
            <MudSelect T="Guid?" @bind-Value="_grupoLista" Label="Lista de precios">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">Lista general</MudSelectItem>
                @foreach (var list in _priceLists)
                {
                    <MudSelectItem T="Guid?" Value="@list.Id">@list.Name</MudSelectItem>
                }
            </MudSelect>
            @if (_grupoId is not null)
            {
                <MudCheckBox T="bool" @bind-Value="_grupoActivo" Label="Activo" />
            }
            <div class="acciones">
                <MudButton OnClick="@(() => _grupoForm = false)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="GuardarGrupoAsync">Guardar</MudButton>
            </div>
        </div>
    </div>
}

@code {
    private List<JsonElement> _items = [];
    private IReadOnlyList<CustomerGroupDto> _groups = [];
    private List<PriceListDto> _priceLists = [];
    private int _tab, _total;
    private string _statusFilter = "";
    private string? _search, _error, _grupoCode, _grupoName;
    private bool _loading = true, _busy, _grupoForm, _grupoActivo;
    private Guid? _grupoId, _grupoLista;

    private static readonly string[] Estados = ["ACTIVE", "INACTIVE", "BLOCKED"];

    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "estado")]
    public string? EstadoQuery { get; set; }

    /// <summary>"grupos" abre la pestaña de grupos.</summary>
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Pestana { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _search = Q;
        if (EstadoQuery is { } estado && Estados.Contains(estado, StringComparer.Ordinal))
        {
            _statusFilter = estado;
        }

        _tab = Pestana == "grupos" ? 1 : 0;
        await CargarGruposAsync();
        try
        {
            _priceLists = (await Api.GetAsync<IReadOnlyList<PriceListDto>>("api/v1/catalog/price-lists")).Where(l => EnumText.Same(l.Status, "ACTIVE")).ToList();
        }
        catch (ApiException)
        {
            // Sin permiso para ver el catálogo: los grupos se muestran sin el nombre de la lista.
        }

        await BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        _loading = true;
        try
        {
            var status = string.IsNullOrEmpty(_statusFilter) ? "" : $"&status={_statusFilter}";
            var page = await Api.GetAsync<JsonElement>($"api/v1/customers?pageSize=100&search={Uri.EscapeDataString(_search ?? "")}{status}");
            _items = page.Items();
            _total = (int)page.Dec("totalCount");
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private Task FiltrarAsync(string status)
    {
        _statusFilter = status;
        ActualizarFiltros();
        return BuscarAsync();
    }

    private void ActualizarFiltros() => Filtros.Actualizar(Navigation, new Dictionary<string, object?>
    {
        ["q"] = _search,
        ["estado"] = _statusFilter,
        ["tab"] = _tab == 1 ? "grupos" : null,
    });

    private void CambiarPestana(int tab)
    {
        _tab = tab;
        ActualizarFiltros();
    }

    private void Abrir(JsonElement customer) => Navigation.NavigateTo($"/admin/clientes/{customer.GetProperty("partyId").GetGuid()}");

    private async Task CargarGruposAsync()
    {
        try
        {
            _groups = await Api.GetAsync<IReadOnlyList<CustomerGroupDto>>("api/v1/customers/groups");
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }
    }

    private static string? Nulo(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private string NombreLista(Guid? id) =>
        id is null ? "General" : _priceLists.FirstOrDefault(l => l.Id == id)?.Name is { Length: > 0 } name ? name : "Lista propia";

    private void NuevoGrupo()
    {
        _grupoId = null;
        _grupoCode = _grupoName = null;
        _grupoLista = null;
        _grupoActivo = true;
        _grupoForm = true;
    }

    private void EditarGrupo(CustomerGroupDto group)
    {
        _grupoId = group.Id;
        _grupoCode = group.Code;
        _grupoName = group.Name;
        _grupoLista = group.PriceListId;
        _grupoActivo = EnumText.Same(group.Status, "ACTIVE");
        _grupoForm = true;
    }

    private async Task GuardarGrupoAsync()
    {
        _busy = true;
        try
        {
            if (_grupoId is { } id)
            {
                await Api.PutAsync<CustomerGroupDto>($"api/v1/customers/groups/{id}", new { name = Nulo(_grupoName), priceListId = _grupoLista, isActive = _grupoActivo });
                Snackbar.Add("Grupo actualizado.", Severity.Success);
            }
            else
            {
                await Api.PostAsync<CustomerGroupDto>("api/v1/customers/groups", new { code = Nulo(_grupoCode), name = Nulo(_grupoName), priceListId = _grupoLista });
                Snackbar.Add("Grupo creado.", Severity.Success);
            }

            _grupoForm = false;
            await CargarGruposAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }
}
