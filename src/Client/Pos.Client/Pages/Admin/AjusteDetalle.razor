@page "/admin/ajustes/nuevo"
@page "/admin/ajustes/{Id:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject Bodegas Bodegas
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@using Pos.Modules.Catalog.Contracts
@using Pos.Modules.Inventory.Contracts

<PageTitle>@Titulo · BusinessPost</PageTitle>

<Pagina Titulo="@Titulo" Miga="@Titulo" Subtitulo="@Resumen" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (Id is null)
        {
            <MudButton Variant="Variant.Outlined" Href="/admin/ajustes">Cancelar</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_busy" OnClick="@(() => CrearAsync(false))">Guardar borrador</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="@(() => CrearAsync(true))">Guardar y aplicar</MudButton>
        }
        else if (_ajuste is not null)
        {
            @if (Status is "DRAFT" or "PENDING_APPROVAL" && Session.Has("inventory.adjustment.manage"))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_busy" OnClick="@(() => AccionAsync("cancel"))">
                    Anular
                </MudButton>
            }
            @if (Status == "DRAFT" && Session.Has("inventory.adjustment.manage"))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="@(() => AccionAsync("post"))">
                    Aplicar ajuste
                </MudButton>
            }
            @if (Status == "PENDING_APPROVAL" && Session.Has("inventory.adjustment.approve"))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="@(() => AccionAsync("approve"))">
                    Aprobar y aplicar
                </MudButton>
            }
        }
    </Acciones>
    <ChildContent>
        @if (Id is null)
        {
            <MudPaper Outlined="true" Class="pa-4">
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudSelect T="Guid?" @bind-Value="_bodega" Label="Bodega">
                            @foreach (var warehouse in Bodegas.Elegibles)
                            {
                                <MudSelectItem T="Guid?" Value="@warehouse.GetProperty("id").GetGuid()">@Bodegas.Etiqueta(warehouse)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="Guid?" @bind-Value="_motivo" Label="Motivo">
                            @foreach (var reason in _motivos.Where(r => EnumText.Same(r.Status, "ACTIVE")))
                            {
                                <MudSelectItem T="Guid?" Value="@reason.Id">@reason.Name</MudSelectItem>
                            }
                        </MudSelect>
                        @if (Motivo is { } motivo)
                        {
                            <MudText Typo="Typo.caption" Class="d-block mt-1">@AyudaMotivo(motivo.Kind)</MudText>
                        }
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="_notas" Label="@(Motivo?.RequiresNote == true ? "Observación (obligatoria para este motivo)" : "Observación (opcional)")" Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudTextField T="string" @bind-Value="_buscar" Label="Producto: nombre, SKU o código (Enter busca)" Immediate="true" OnKeyDown="BuscarTeclaAsync"
                                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="BuscarAsync" />
                            <MudNumericField Culture="@Format.Colombia" T="decimal" @bind-Value="_cantidad" Label="Cantidad" Style="max-width: 130px" />
                            @if (EsSaldoInicial)
                            {
                                <MudNumericField Culture="@Format.Colombia" T="decimal?" @bind-Value="_costo" Label="Costo unitario" Min="0" Style="max-width: 150px" />
                            }
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudStack Row="true">
                            <MudTextField T="string" @bind-Value="_lote" Label="Lote (opcional)" Immediate="true" />
                            <MudDatePicker @bind-Date="_vence" Label="Vencimiento del lote (opcional)" DateFormat="dd/MM/yyyy" />
                        </MudStack>
                    </MudItem>
                    @if (_resultados.Count > 0)
                    {
                        <MudItem xs="12">
                            <MudSimpleTable Dense="true">
                                <tbody>
                                    @foreach (var product in _resultados)
                                    {
                                        <tr>
                                            <td>@product.Sku</td>
                                            <td>@product.Name</td>
                                            <td>@product.BaseUnitCode</td>
                                            <td><MudButton Size="Size.Small" OnClick="@(() => AgregarLinea(product))">Agregar</MudButton></td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
            <MudSimpleTable Dense="true" Class="my-3">
                <thead>
                    <tr><th>SKU</th><th>Producto</th><th class="num">Cantidad</th><th class="num">Costo unitario</th><th>Lote</th><th>Vence</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var line in _lineas)
                    {
                        <tr>
                            <td>@line.Sku</td>
                            <td>@line.Nombre</td>
                            <td class="num">@Format.Quantity(line.Cantidad) @line.Unidad</td>
                            <td class="num">@Format.Money(line.Costo)</td>
                            <td>@line.Lote</td>
                            <td>@(line.Vence is { } vence ? vence.ToString("dd/MM/yyyy", Format.Colombia) : "")</td>
                            <td><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" aria-label="Quitar" OnClick="@(() => _lineas.Remove(line))" /></td>
                        </tr>
                    }
                    @if (_lineas.Count == 0)
                    {
                        <tr><td colspan="7">Agregue al menos un producto.</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
        else if (_ajuste is not null)
        {
            @if (_ajuste.Notes is { Length: > 0 } notes)
            {
                <MudText Typo="Typo.body2" Class="mb-2">Observación: @notes</MudText>
            }
            @if (Status == "PENDING_APPROVAL")
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">Supera el umbral de aprobación: debe aprobarlo un usuario distinto de quien lo creó.</MudAlert>
            }
            <MudSimpleTable Dense="true" Class="my-2">
                <thead>
                    <tr>
                        <th>SKU</th><th>Producto</th><th class="num">Cantidad</th>
                        @if (VerCostos)
                        {
                            <th class="num">Costo unitario</th>
                        }
                        <th>Lote</th><th>Vence</th><th>Nota</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in _ajuste.Lines)
                    {
                        <tr>
                            <td>@line.Sku</td>
                            <td>@line.ProductName</td>
                            <td class="num">@(line.Quantity > 0 ? "+" : "")@Format.Quantity(line.Quantity)</td>
                            @if (VerCostos)
                            {
                                <td class="num">@Format.Money(line.UnitCost)</td>
                            }
                            <td>@line.LotNumber</td>
                            <td>@Fecha(line.ExpiryDate)</td>
                            <td>@line.Notes</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
            @if (VerCostos && _ajuste.TotalValue is { } valor)
            {
                <MudText Typo="Typo.body2">Valor del ajuste: @Format.Money(valor)</MudText>
            }
        }
    </ChildContent>
</Pagina>

@code {
    private List<AdjustmentReasonDto> _motivos = [];
    private IReadOnlyList<ProductSummaryDto> _resultados = [];
    private readonly List<Linea> _lineas = [];
    private AdjustmentDto? _ajuste;
    private string? _error, _notas, _buscar, _lote, _cargado;
    private Guid? _bodega, _motivo;
    private decimal _cantidad = 1;
    private decimal? _costo;
    private DateTime? _vence;
    private bool _loading = true, _busy;

    /// <summary>Ajuste que se muestra; nulo en <c>/admin/ajustes/nuevo</c>.</summary>
    [Parameter]
    public Guid? Id { get; set; }

    private string Status => EnumText.Normalize(_ajuste?.Status);

    private bool VerCostos => Session.Has("inventory.cost.view");

    private string Titulo => Id is null ? "Nuevo ajuste" : _ajuste is { } ajuste ? $"Ajuste {ajuste.Number}" : "Ajuste";

    private string? Resumen
    {
        get
        {
            if (Id is null || _ajuste is not { } ajuste)
            {
                return null;
            }

            var texto = $"{Estado(Status)} · Bodega {Bodegas.Nombre(ajuste.WarehouseId)} · Motivo: {NombreMotivo(ajuste.ReasonId, ajuste.ReasonCode)} · "
                + $"Fecha contable {Fecha(ajuste.BusinessDate)}";
            return ajuste.PostedAt is { } posted ? $"{texto} · Aplicado {Format.Date(posted)}" : texto;
        }
    }

    private AdjustmentReasonDto? Motivo => _motivos.FirstOrDefault(r => r.Id == _motivo);

    private bool EsSaldoInicial => EnumText.Same(Motivo?.Kind, "INITIAL_BALANCE");

    protected override async Task OnInitializedAsync()
    {
        await Bodegas.CargarAsync();
        try
        {
            _motivos = await Api.GetAsync<List<AdjustmentReasonDto>>("api/v1/inventory/reasons");
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"No se pudieron cargar los motivos: {ex.Texto}", Severity.Warning);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Al crear se pasa de /nuevo a /{id} en la misma instancia: solo se recarga cuando cambia la ruta.
        var clave = Id?.ToString() ?? "nuevo";
        if (clave == _cargado)
        {
            return;
        }

        _cargado = clave;
        if (Id is { } id)
        {
            await VerAsync(id);
        }
        else
        {
            Nuevo();
        }
    }

    private string NombreMotivo(Guid id, string code) => _motivos.FirstOrDefault(r => r.Id == id)?.Name is { Length: > 0 } name ? name : code;

    private static string Estado(string status) => EnumText.Normalize(status) switch
    {
        "DRAFT" => "Borrador",
        "PENDING_APPROVAL" => "Pendiente de aprobación",
        "POSTED" => "Aplicado",
        "CANCELLED" => "Anulado",
        _ => status,
    };

    private static string AyudaMotivo(string kind) => EnumText.Normalize(kind) switch
    {
        "INITIAL_BALANCE" => "Saldo inicial: solo entradas y cada línea lleva su costo unitario.",
        "ADJUSTMENT" => "Cantidad positiva = entra; negativa = sale. Entra al costo promedio vigente.",
        _ => "Este motivo es de salida: las cantidades se descuentan del inventario.",
    };

    private static string Fecha(DateOnly? value) => value?.ToString("dd/MM/yyyy", Format.Colombia) ?? "";

    private void Nuevo()
    {
        _bodega = Bodegas.Primera(Bodegas.Elegibles);
        _motivo = null;
        _notas = _buscar = _lote = null;
        _cantidad = 1;
        _costo = null;
        _vence = null;
        _resultados = [];
        _lineas.Clear();
        _loading = false;
    }

    private async Task BuscarTeclaAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarAsync();
        }
    }

    private async Task BuscarAsync()
    {
        if (string.IsNullOrWhiteSpace(_buscar))
        {
            _resultados = [];
            return;
        }

        try
        {
            _resultados = (await Api.GetAsync<PagedResult<ProductSummaryDto>>($"api/v1/catalog/products?pageSize=20&search={Uri.EscapeDataString(_buscar.Trim())}")).Items;
            if (_resultados.Count == 0)
            {
                Snackbar.Add("No hay productos que coincidan.", Severity.Info);
            }
            else if (_resultados.Count == 1)
            {
                AgregarLinea(_resultados[0]);
            }
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }
    }

    private void AgregarLinea(ProductSummaryDto product)
    {
        var id = product.Id;
        if (_lineas.Any(l => l.ProductId == id))
        {
            Snackbar.Add("El producto ya está en el ajuste.", Severity.Warning);
            return;
        }

        var lote = string.IsNullOrWhiteSpace(_lote) ? null : _lote.Trim();
        _lineas.Add(new Linea(
            id, product.Sku, product.Name, product.BaseUnitCode, _cantidad, EsSaldoInicial ? _costo : null, lote,
            lote is not null && _vence is { } vence ? DateOnly.FromDateTime(vence) : null));
        _resultados = [];
        _buscar = _lote = null;
        _cantidad = 1;
        _costo = null;
        _vence = null;
    }

    private async Task CrearAsync(bool publicar)
    {
        _busy = true;
        Guid? creado = null;
        try
        {
            var created = await Api.PostAsync<AdjustmentDto>("api/v1/inventory/adjustments", new
            {
                warehouseId = _bodega,
                reasonId = _motivo,
                businessDate = (DateOnly?)null,
                notes = string.IsNullOrWhiteSpace(_notas) ? null : _notas.Trim(),
                lines = _lineas.Select(l => new
                {
                    productId = l.ProductId, quantity = l.Cantidad, unitCost = l.Costo, notes = (string?)null, lotNumber = l.Lote, expiryDate = l.Vence,
                }).ToList(),
            });
            creado = created.Id;
            if (publicar)
            {
                var posted = await Api.PostAsync<AdjustmentDto>($"api/v1/inventory/adjustments/{creado}/post");
                Snackbar.Add(MensajePublicacion(posted), Severity.Success);
            }
            else
            {
                Snackbar.Add("Ajuste guardado en borrador.", Severity.Success);
            }
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
        if (creado is { } id)
        {
            // Si se creó pero no se pudo publicar, queda en borrador: se abre igual para no perderlo de vista.
            Navigation.NavigateTo($"/admin/ajustes/{id}", replace: true);
        }
    }

    private static string MensajePublicacion(AdjustmentDto adjustment) => EnumText.Same(adjustment.Status, "PENDING_APPROVAL")
        ? "El ajuste supera el umbral: quedó pendiente de aprobación por otro usuario."
        : "Ajuste aplicado al inventario.";

    private async Task VerAsync(Guid id)
    {
        _loading = true;
        try
        {
            _ajuste = await Api.GetAsync<AdjustmentDto>($"api/v1/inventory/adjustments/{id}");
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private async Task AccionAsync(string action)
    {
        if (Confirmaciones.TryGetValue(action, out var confirmacion)
            && !await Dialogs.ConfirmarAsync(confirmacion.Titulo, confirmacion.Mensaje, confirmacion.Accion, action == "cancel"))
        {
            return;
        }

        if (_ajuste is not { } ajuste)
        {
            return;
        }

        _busy = true;
        var id = ajuste.Id;
        try
        {
            if (action == "cancel")
            {
                await Api.PostAsync($"api/v1/inventory/adjustments/{id}/cancel");
                Snackbar.Add("Ajuste anulado.", Severity.Success);
            }
            else
            {
                var result = await Api.PostAsync<AdjustmentDto>($"api/v1/inventory/adjustments/{id}/{action}");
                Snackbar.Add(MensajePublicacion(result), Severity.Success);
            }

            await VerAsync(id);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private sealed record Linea(Guid ProductId, string Sku, string Nombre, string Unidad, decimal Cantidad, decimal? Costo, string? Lote, DateOnly? Vence);

    /// <summary>Acciones que se confirman con el diálogo uniforme: título, mensaje y texto del botón.</summary>
    private static readonly Dictionary<string, (string Titulo, string Mensaje, string Accion)> Confirmaciones = new()
    {
        ["cancel"] = ("Anular ajuste", "El ajuste quedará anulado y no moverá el inventario.", "Anular"),
        ["post"] = ("Aplicar ajuste", "Las cantidades del ajuste se aplicarán al inventario (o quedará por aprobar si lo exige la política).", "Aplicar"),
        ["approve"] = ("Aprobar y aplicar", "Las cantidades del ajuste se aplicarán al inventario.", "Aprobar y aplicar"),
    };
}
