@page "/admin/cajas"
@using Pos.Modules.Organization.Contracts
@inject ApiClient Api
@inject SessionState Session
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@implements IDisposable

<PageTitle>Cajas y equipos · BusinessPost</PageTitle>

<Pagina Titulo="Cajas y equipos" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (PuedeEmparejar)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Computer" Class="mr-2" Disabled="_busy" OnClick="@(() => GenerarCodigoAsync(null))">
                Emparejar PC administrativo
            </MudButton>
        }
        @if (Session.Has("organization.terminal.manage"))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NuevaCaja">Nueva caja</MudButton>
        }
    </Acciones>
    <ChildContent>
        <MudTable RowsPerPage="25" Items="_cajas" Dense="true" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>Sucursal</MudTh><MudTh>Código</MudTh><MudTh>Nombre</MudTh><MudTh>Bodega</MudTh><MudTh>Equipo</MudTh><MudTh>Estado</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@NombreSucursal(context.BranchId)</MudTd>
                <MudTd>@context.Code</MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@NombreBodega(context)</MudTd>
                <MudTd>@EquipoDe(context)</MudTd>
                <MudTd>@Estado(context.Status)</MudTd>
                <MudTd>
                    @if (Session.Has("organization.terminal.manage"))
                    {
                        <MudButton Size="Size.Small" OnClick="@(() => EditarCaja(context))">Editar</MudButton>
                        <MudButton Size="Size.Small" OnClick="@(() => AbrirImpresoraAsync(context))">Impresora</MudButton>
                        @if (VerBascula(context))
                        {
                            <MudButton Size="Size.Small" OnClick="@(() => AbrirBasculaAsync(context))">Báscula</MudButton>
                        }
                        @if (Activa(context.Status))
                        {
                            <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(async () => { if (await Dialogs.ConfirmarAsync("Inactivar caja", $"La caja {context.Code} dejará de poder abrir jornadas hasta que la active de nuevo.", "Inactivar", true)) { await CambiarEstadoAsync(context, "Inactive"); } })">Inactivar</MudButton>
                            <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(async () => { if (await Dialogs.ConfirmarAsync("Bloquear caja", $"La caja {context.Code} quedará bloqueada: no podrá vender hasta que la desbloquee.", "Bloquear", true)) { await CambiarEstadoAsync(context, "Blocked"); } })">Bloquear</MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" OnClick="@(() => CambiarEstadoAsync(context, "Active"))">Activar</MudButton>
                        }
                    }
                    @if (PuedeEmparejar && Activa(context.Status))
                    {
                        <MudButton Size="Size.Small" Color="Color.Primary" Disabled="_busy" OnClick="@(() => GenerarCodigoAsync(context))">Emparejar equipo</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><EstadoVacio Mensaje="No hay cajas." /></NoRecordsContent>
            <PagerContent><Paginador /></PagerContent>
        </MudTable>
        @if (!Session.IsMulti)
        {
            <MudText Typo="Typo.caption" Class="d-block mt-2">Edición Caja Única: este equipo hace todo; no se emparejan otros equipos.</MudText>
        }

        @if (Session.Has("organization.device.manage"))
        {
            <MudText Typo="Typo.h6" Class="mt-5 mb-2">Equipos emparejados</MudText>
            <MudTable RowsPerPage="25" Items="_equipos" Dense="true" Hover="true" Striped="true">
                <HeaderContent>
                    <MudTh>Equipo</MudTh><MudTh>Tipo</MudTh><MudTh>Caja</MudTh><MudTh>Estado</MudTh><MudTh>Emparejado</MudTh><MudTh>Último contacto</MudTh><MudTh>Versión</MudTh><MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Hostname</MudTd>
                    <MudTd>@TipoEquipo(context.Kind)</MudTd>
                    <MudTd>@CodigoCaja(context.PosTerminalId)</MudTd>
                    <MudTd>@(EnumText.Same(context.Status, "REVOKED") ? "Revocado" : "Activo")</MudTd>
                    <MudTd>@Format.Date(context.PairedAt)</MudTd>
                    <MudTd>@Format.Date(context.LastSeenAt)</MudTd>
                    <MudTd>@context.AppVersion</MudTd>
                    <MudTd>
                        @if (!EnumText.Same(context.Status, "REVOKED"))
                        {
                            <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => _revocar = context)">Revocar</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><EstadoVacio Mensaje="No hay equipos emparejados." /></NoRecordsContent>
                <PagerContent><Paginador /></PagerContent>
            </MudTable>
        }
    </ChildContent>
</Pagina>

@if (_panelCaja)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true">
            <h2>@(_cajaId is null ? "Nueva caja" : "Editar caja")</h2>
            @if (_cajaId is null)
            {
                <MudSelect T="Guid?" Value="_tSucursal" ValueChanged="CambiarSucursal" Label="Sucursal">
                    @foreach (var branch in _sucursales.Where(b => Activa(b.Status)))
                    {
                        <MudSelectItem T="Guid?" Value="@branch.Id">@branch.Code · @branch.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_tCodigo" Label="Código (p. ej. C02)" Immediate="true" />
            }
            <MudTextField @bind-Value="_tNombre" Label="Nombre" Immediate="true" />
            <MudSelect T="Guid?" @bind-Value="_tBodega" Label="@(_cajaId is null ? "Bodega de la que vende (vacío = piso de venta de la sucursal)" : "Bodega de la que vende")" Clearable="@(_cajaId is null)">
                @foreach (var warehouse in BodegasDeVenta(_tSucursal))
                {
                    <MudSelectItem T="Guid?" Value="@warehouse.Id">@warehouse.Code · @warehouse.Name</MudSelectItem>
                }
            </MudSelect>
            <div class="acciones">
                <MudButton OnClick="@(() => _panelCaja = false)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="GuardarCajaAsync">Guardar</MudButton>
            </div>
        </div>
    </div>
}

@if (_impresoraDe is not null)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true">
            <h2>Impresora de tiquetes · caja @_impresoraDe.Code</h2>
            @if (!_impresoraConfigurada)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">La caja aún no tiene impresora configurada: se muestran los valores por defecto.</MudAlert>
            }
            <MudSelect T="string" @bind-Value="_iConexion" Label="Conexión">
                <MudSelectItem T="string" Value="@("File")">Archivo (pruebas o caja sin impresora)</MudSelectItem>
                <MudSelectItem T="string" Value="@("Network")">Red (IP:puerto, normalmente 9100)</MudSelectItem>
                <MudSelectItem T="string" Value="@("WindowsSpooler")">Impresora instalada en Windows</MudSelectItem>
                <MudSelectItem T="string" Value="@("Serial")">Puerto serie o USB virtual (COMx)</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_iDireccion" Label="@EtiquetaDireccion" Immediate="true" />
            <MudSelect T="int" @bind-Value="_iPapel" Label="Ancho del papel">
                <MudSelectItem T="int" Value="80">80 mm</MudSelectItem>
                <MudSelectItem T="int" Value="58">58 mm</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" @bind-Value="_iPagina" Label="Página de códigos">
                <MudSelectItem T="string" Value="@("Pc850")">PC850 (con tildes y ñ)</MudSelectItem>
                <MudSelectItem T="string" Value="@("Ascii")">ASCII (sin tildes)</MudSelectItem>
            </MudSelect>
            <MudCheckBox T="bool" @bind-Value="_iCorte" Label="Corte automático del papel" />
            <MudCheckBox T="bool" @bind-Value="_iCajon" Label="Cajón monedero conectado a la impresora" />
            @if (_iCajon)
            {
                <MudSelect T="string" @bind-Value="_iPin" Label="Pin del cajón">
                    <MudSelectItem T="string" Value="@("Pin2")">Pin 2</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Pin5")">Pin 5</MudSelectItem>
                </MudSelect>
            }
            <div class="acciones">
                <MudButton OnClick="@(() => _impresoraDe = null)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="GuardarImpresoraAsync">Guardar</MudButton>
            </div>
        </div>
    </div>
}

@if (_basculaDe is not null)
{
    <div class="panel-fondo">
        <div class="panel" style="width:min(640px, 96vw); max-height:94vh; overflow:auto" role="dialog" aria-modal="true">
            <h2>Báscula · caja @_basculaDe.Code</h2>
            <FuncionApagada Funcion="@BusinessCatalog.Scale" />
            @if (!_basculaConfigurada)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">La caja aún no tiene báscula. Conecte la báscula al computador de esta caja (cable serial o USB-serial) y elija su protocolo.</MudAlert>
            }
            <MudCheckBox T="bool" @bind-Value="_bActiva" Label="Esta caja tiene báscula conectada" />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Value="_bDriver" ValueChanged="CambiarDriver" Label="Marca o protocolo">
                        <MudSelectItem T="string" Value="@("TOLEDO_8217")">Toledo 8217 (Mettler Toledo, Torrey, Moretti y compatibles)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("CAS")">CAS (formato ST/US de 22 bytes)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("GENERIC")">Otra (genérica: número y unidad)</MudSelectItem>
                        @if (_agente?.SimulatorAvailable == true)
                        {
                            <MudSelectItem T="string" Value="@("SIMULATED")">Báscula simulada (solo desarrollo)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (_bDriver != "SIMULATED")
                    {
                        <MudSelect T="string" @bind-Value="_bPuerto" Label="Puerto" HelperText="@(_agente is null ? "No se pudo leer el agente de este equipo: escriba el puerto en Opciones avanzadas" : "Puertos serie de este equipo")">
                            @foreach (var port in PuertosDisponibles)
                            {
                                <MudSelectItem T="string" Value="@port">@port</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>
                <MudItem xs="6" sm="3"><MudTextField @bind-Value="_bMarca" Label="Marca (opcional)" Immediate="true" /></MudItem>
                <MudItem xs="6" sm="3"><MudTextField @bind-Value="_bModelo" Label="Modelo (opcional)" Immediate="true" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="_bEsperaEstable" Label="Espera peso estable (s)" Min="1" Max="15" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="_bEsperaProducto" Label="Espera producto (s)" Min="1" Max="30" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="_bPesoMinimo" Label="Peso mínimo (g)" Min="0" Max="1000" HelperText="Menos que esto = báscula vacía" /></MudItem>
            </MudGrid>
            <MudCheckBox T="bool" @bind-Value="_bDigitar" Label="Si la báscula no responde, permitir digitar el peso (con permiso o supervisor)" />
            <MudExpansionPanels Elevation="0" Class="my-2">
                <MudExpansionPanel Text="Opciones avanzadas del puerto serie (técnico)">
                    <MudGrid Spacing="2">
                        <MudItem xs="6" sm="4"><MudTextField @bind-Value="_bPuerto" Label="Puerto (COMx)" Immediate="true" /></MudItem>
                        <MudItem xs="6" sm="4">
                            <MudSelect T="int" @bind-Value="_bBaudios" Label="Velocidad">
                                @foreach (var baud in new[] { 1200, 2400, 4800, 9600, 19200, 38400, 57600, 115200 })
                                {
                                    <MudSelectItem T="int" Value="@baud">@baud</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudSelect T="int" @bind-Value="_bBits" Label="Bits de datos">
                                <MudSelectItem T="int" Value="7">7</MudSelectItem>
                                <MudSelectItem T="int" Value="8">8</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudSelect T="string" @bind-Value="_bParidad" Label="Paridad">
                                <MudSelectItem T="string" Value="@("NONE")">Ninguna</MudSelectItem>
                                <MudSelectItem T="string" Value="@("EVEN")">Par</MudSelectItem>
                                <MudSelectItem T="string" Value="@("ODD")">Impar</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudSelect T="int" @bind-Value="_bParada" Label="Bits de parada">
                                <MudSelectItem T="int" Value="1">1</MudSelectItem>
                                <MudSelectItem T="int" Value="2">2</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudSelect T="string" @bind-Value="_bModo" Label="Envío del peso">
                                <MudSelectItem T="string" Value="@("REQUEST")">La caja lo pide</MudSelectItem>
                                <MudSelectItem T="string" Value="@("CONTINUOUS")">Continuo</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" sm="4"><MudTextField @bind-Value="_bComando" Label="Comando de lectura" Immediate="true" HelperText="Toledo: W · admite \r \n \xHH" /></MudItem>
                        <MudItem xs="6" sm="4"><MudNumericField T="int" @bind-Value="_bTiempo" Label="Tiempo de espera (ms)" Min="200" Max="5000" /></MudItem>
                        <MudItem xs="6" sm="4"><MudNumericField T="int" @bind-Value="_bDecimales" Label="Decimales sin punto" Min="0" Max="4" /></MudItem>
                    </MudGrid>
                </MudExpansionPanel>
            </MudExpansionPanels>

            <MudText Typo="Typo.caption" Class="mt-2">
                @(_vinculadaEl is { } vinculada
                    ? $"Báscula vinculada con el agente de la caja el {vinculada.ToLocalTime():dd/MM/yyyy HH:mm}: sus pesos llegan firmados."
                    : "La báscula aún no está vinculada: se vincula en la pantalla de venta de esa caja (F1 → Vincular báscula, con un supervisor). Sin esto la caja no puede pesar.")
            </MudText>
            @if (!EsEsteEquipo)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                    «Probar báscula» usa la báscula conectada al computador donde está abierta esta pantalla, y este computador no es la caja @_basculaDe.Code.
                    Para probarla, abra Configuración → Cajas e impresoras en el computador de esa caja. Puede guardar la configuración desde aquí.
                </MudAlert>
            }
            <div class="caja-total-caja" style="margin:8px 0">
                <div class="caja-total-etiqueta"><span>Peso en vivo</span><span>@(_lectura?.Stable == true ? "Estable" : _lectura is null ? "" : "Sin estabilizar")</span></div>
                <div class="caja-total" aria-live="polite">@(_lectura?.Display ?? "--")</div>
                <MudText Typo="Typo.caption">@(_lectura?.Message ?? (EsEsteEquipo ? "Pulse «Probar báscula» con la báscula conectada a ESTE computador. La prueba no cambia la báscula en uso." : "La prueba solo se hace en el computador de esta caja."))@(_lectura is { TareKg: > 0 } t ? $" · Tara {t.TareKg:0.000} kg" : "")</MudText>
            </div>
            <div class="acciones">
                <MudButton OnClick="CerrarBascula">Cancelar</MudButton>
                <MudButton Variant="Variant.Outlined" Disabled="@(_probando is null)" OnClick="@(() => TaraAsync(false))">Tara</MudButton>
                <MudButton Variant="Variant.Outlined" Disabled="@(_probando is null)" OnClick="@(() => TaraAsync(true))">Quitar tara</MudButton>
                <MudButton Variant="Variant.Outlined" Disabled="@(!_bActiva || !EsEsteEquipo)" OnClick="ProbarBasculaAsync">@(_probando is null ? "Probar báscula" : "Detener prueba")</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="GuardarBasculaAsync">Guardar</MudButton>
            </div>
        </div>
    </div>
}

@if (_codigo is not null)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true">
            <h2>Código de emparejamiento @(_codigoCaja is null ? "· PC administrativo" : $"· caja {_codigoCaja}")</h2>
            <div class="cifra my-3" style="font-size: 56px; letter-spacing: 10px; text-align: center;">@_codigo.Code</div>
            <MudText Typo="Typo.body2" Class="mb-2">Vence: @Format.Date(_codigo.ExpiresAt). Sirve una sola vez.</MudText>
            <MudText Typo="Typo.body2">En el equipo nuevo abra BusinessPost, elija «Emparejar este equipo» y escriba este código.</MudText>
            @if (!string.IsNullOrEmpty(_codigo.CertificateFingerprint))
            {
                <MudText Typo="Typo.caption" Class="d-block mt-2">Código de seguridad del servidor (compárelo en el equipo nuevo): @_codigo.CertificateFingerprint</MudText>
            }
            <div class="acciones">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CerrarCodigoAsync">Listo</MudButton>
            </div>
        </div>
    </div>
}

@if (_revocar is not null)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true">
            <h2>Revocar el equipo @_revocar.Hostname</h2>
            <MudText Typo="Typo.body2">
                El equipo queda desconectado de inmediato. Para volver a usarlo hay que emparejarlo de nuevo con un código.
            </MudText>
            <div class="acciones">
                <MudButton OnClick="@(() => _revocar = null)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="_busy" OnClick="RevocarAsync">Revocar</MudButton>
            </div>
        </div>
    </div>
}

@code {
    private List<TerminalDto> _cajas = [];
    private readonly HashSet<Guid> _conBascula = [];
    private List<BranchDto> _sucursales = [];
    private List<DeviceDto> _equipos = [];
    private readonly Dictionary<Guid, IReadOnlyList<WarehouseDto>> _bodegas = [];
    private bool _loading = true, _busy, _panelCaja, _impresoraConfigurada, _iCorte, _iCajon;
    private string? _error, _tCodigo, _tNombre, _iDireccion, _codigoCaja;
    private Guid? _cajaId, _tSucursal, _tBodega;
    private TerminalDto? _impresoraDe;
    private PairingCodeDto? _codigo;
    private DeviceDto? _revocar;
    private string _iConexion = "File", _iPagina = "Pc850", _iPin = "Pin2";
    private int _iPapel = 80;

    private bool PuedeEmparejar => Session.Has("organization.device.manage") && Session.IsMulti;

    // Báscula (Fase 7-C).
    private TerminalDto? _basculaDe;
    private AgentScaleStatus? _agente;
    private ScaleRead? _lectura;
    private CancellationTokenSource? _probando;
    private bool _basculaConfigurada, _bActiva, _bDigitar = true;
    private int _bPesoMinimo = 20;
    private DateTimeOffset? _vinculadaEl;
    private string _bDriver = "TOLEDO_8217", _bParidad = "EVEN", _bModo = "REQUEST";
    private string? _bPuerto, _bMarca, _bModelo, _bComando = "W";
    private int _bBaudios = 9600, _bBits = 7, _bParada = 1, _bTiempo = 1000, _bDecimales = 3, _bEsperaEstable = 3, _bEsperaProducto = 5;

    private IEnumerable<string> PuertosDisponibles =>
        (_agente?.SerialPorts ?? []).Concat(_bPuerto is { Length: > 0 } p ? [p] : []).Distinct(StringComparer.OrdinalIgnoreCase);

    private string EtiquetaDireccion => _iConexion switch
    {
        "Network" => "Dirección IP y puerto (p. ej. 192.168.1.50:9100)",
        "WindowsSpooler" => "Nombre de la impresora en Windows",
        "Serial" => "Puerto (p. ej. COM3)",
        _ => "Carpeta donde se escriben los tiquetes (opcional)",
    };

    protected override Task OnInitializedAsync() => CargarAsync();

    private bool VerBascula(TerminalDto caja) => Session.Feature(BusinessCatalog.Scale) || _conBascula.Contains(caja.Id);

    private async Task CargarAsync()
    {
        _loading = true;
        try
        {
            _sucursales = await Api.GetAsync<List<BranchDto>>("api/v1/organization/branches");
            _cajas = await Api.GetAsync<List<TerminalDto>>("api/v1/organization/terminals");
            _bodegas.Clear();
            foreach (var branch in _sucursales)
            {
                _bodegas[branch.Id] = (await Api.GetAsync<BranchDetailDto>($"api/v1/organization/branches/{branch.Id}")).Warehouses;
            }

            if (Session.Has("organization.device.manage"))
            {
                _equipos = await Api.GetAsync<List<DeviceDto>>("api/v1/devices");
            }

            // Fase 7-C parte A: con "Báscula y PLU" apagada, el botón Báscula solo sale en las cajas que ya tienen una configurada (los datos
            // se conservan y siguen a la vista, con el aviso).
            _conBascula.Clear();
            if (!Session.Feature(BusinessCatalog.Scale))
            {
                foreach (var caja in _cajas)
                {
                    if ((await Api.GetAsync<TerminalScaleDto>($"api/v1/organization/terminals/{caja.Id}/scale")).Configured)
                    {
                        _conBascula.Add(caja.Id);
                    }
                }
            }

            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private string NombreSucursal(Guid branchId) =>
        _sucursales.FirstOrDefault(b => b.Id == branchId)?.Name is { Length: > 0 } name ? name : branchId.ToString();

    private string NombreBodega(TerminalDto terminal) =>
        _bodegas.Values.SelectMany(w => w).FirstOrDefault(w => w.Id == terminal.WarehouseId)?.Name ?? "";

    private string CodigoCaja(Guid? terminalId) =>
        terminalId is { } id ? _cajas.FirstOrDefault(t => t.Id == id)?.Code ?? "" : "";

    private string EquipoDe(TerminalDto terminal)
    {
        var device = _equipos.FirstOrDefault(d => d.PosTerminalId == terminal.Id && !EnumText.Same(d.Status, "REVOKED"));
        return device is not null ? device.Hostname
            : terminal.DeviceId is not null ? "Emparejada"
            : "Sin equipo";
    }

    private IEnumerable<WarehouseDto> BodegasDeVenta(Guid? branchId) =>
        branchId is { } id && _bodegas.TryGetValue(id, out var warehouses) ? warehouses.Where(w => Activa(w.Status) && w.AllowsSales) : [];

    // ------------------------------------------------------------------------------------------ Cajas

    private void NuevaCaja()
    {
        _cajaId = null;
        _tSucursal = _sucursales.Count == 1 ? _sucursales[0].Id : null;
        _tCodigo = _tNombre = null;
        _tBodega = null;
        _panelCaja = true;
    }

