    // ------------------------------------------------------------------------------------------ Báscula

    private async Task AbrirBasculaAsync(TerminalDto terminal)
    {
        try
        {
            var scale = await Api.GetAsync<TerminalScaleDto>($"api/v1/organization/terminals/{terminal.Id}/scale");
            _agente = await AgentScale.StatusAsync();
            _basculaConfigurada = scale.Configured;
            _vinculadaEl = scale.ReadingKeySetAt;
            _bActiva = scale.Configured ? scale.Enabled : true;
            CambiarDriver(scale.Configured ? scale.Driver : "TOLEDO_8217");
            _bPuerto = scale.Port ?? _agente?.SerialPorts.FirstOrDefault();
            _bBaudios = scale.BaudRate ?? _bBaudios;
            _bBits = scale.DataBits ?? _bBits;
            _bParidad = scale.Parity ?? _bParidad;
            _bParada = scale.StopBits ?? _bParada;
            _bModo = scale.ReadMode ?? _bModo;
            _bComando = scale.RequestCommand ?? _bComando;
            _bTiempo = scale.TimeoutMs ?? 1000;
            _bDecimales = scale.Decimals ?? 3;
            _bMarca = scale.Brand;
            _bModelo = scale.Model;
            _bEsperaEstable = scale.StableWaitSeconds;
            _bEsperaProducto = scale.EmptyWaitSeconds;
            _bDigitar = scale.AllowManualWeight;
            _bPesoMinimo = scale.MinWeightGrams;
            _lectura = null;
            _basculaDe = terminal;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }
    }

    /// <summary>Al elegir la marca se proponen sus valores de fábrica (el técnico los puede cambiar en Opciones avanzadas).</summary>
    private void CambiarDriver(string driver)
    {
        _bDriver = driver;
        var defaults = _agente?.Drivers.FirstOrDefault(d => d.Code == (driver == "SIMULATED" ? "TOLEDO_8217" : driver));
        (_bBaudios, _bBits, _bParidad, _bParada, _bModo, _bComando) = defaults is not null
            ? (defaults.BaudRate, defaults.DataBits, defaults.Parity, defaults.StopBits, defaults.ReadMode, defaults.RequestCommand)
            : driver switch
            {
                "CAS" or "GENERIC" => (9600, 8, "NONE", 1, "CONTINUOUS", (string?)null),
                _ => (9600, 7, "EVEN", 1, "REQUEST", "W"),
            };
    }

    private object ConfigBascula() => new
    {
        enabled = _bActiva,
        driver = _bDriver,
        port = _bDriver == "SIMULATED" || string.IsNullOrWhiteSpace(_bPuerto) ? null : _bPuerto.Trim().ToUpperInvariant(),
        baudRate = _bBaudios,
        dataBits = _bBits,
        parity = _bParidad,
        stopBits = _bParada,
        readMode = _bModo,
        requestCommand = string.IsNullOrEmpty(_bComando) ? null : _bComando,
        timeoutMs = _bTiempo,
        decimals = _bDecimales,
        brand = _bMarca,
        model = _bModelo,
        catalogCode = (string?)null,
        stableWaitSeconds = _bEsperaEstable,
        emptyWaitSeconds = _bEsperaProducto,
        allowManualWeight = _bDigitar,
        minWeightGrams = _bPesoMinimo,
    };

    /// <summary>
    /// La prueba usa el agente de ESTE computador: solo tiene sentido si este computador es la caja que se configura (si no, probaría la
    /// báscula de otro equipo con la configuración de esta caja).
    /// </summary>
    private bool EsEsteEquipo => _basculaDe is not null && Session.Me?.PosTerminalId == _basculaDe.Id;

    /// <summary>
    /// "Probar báscula": abre en el agente de ESTE equipo una prueba con la configuración de la pantalla (sin guardarla) y muestra el peso
    /// en vivo. La prueba va aparte: no cambia la báscula que usa la caja ni su tara, y al detenerla no queda nada de ella.
    /// </summary>
    private async Task ProbarBasculaAsync()
    {
        if (_probando is not null)
        {
            DetenerPrueba();
            return;
        }

        if (!EsEsteEquipo)
        {
            Snackbar.Add("La báscula se prueba en el computador de la caja.", Severity.Warning);
            return;
        }

        var cts = _probando = new CancellationTokenSource();
        _lectura = await AgentScale.TestAsync(ConfigBascula());
        StateHasChanged();
        try
        {
            while (!cts.IsCancellationRequested && _lectura is { Unavailable: false })
            {
                await Task.Delay(400, cts.Token);
                _lectura = await AgentScale.TestReadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
            // Prueba detenida.
        }

        if (ReferenceEquals(_probando, cts))
        {
            DetenerPrueba();
        }
    }

    private async Task TaraAsync(bool clear)
    {
        _lectura = await AgentScale.TestTareAsync(clear);
        if (!_lectura.Unavailable && _lectura.Status == "ERROR")
        {
            Snackbar.Add(_lectura.Message, Severity.Warning);
        }
    }

    private void DetenerPrueba()
    {
        if (_probando is null)
        {
            return;
        }

        _probando.Cancel();
        _probando.Dispose();
        _probando = null;
        _ = AgentScale.TestStopAsync();
    }

    private void CerrarBascula()
    {
        DetenerPrueba();
        _basculaDe = null;
    }

    private async Task GuardarBasculaAsync()
    {
        if (_basculaDe is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var saved = await Api.PutAsync<TerminalScaleDto>($"api/v1/organization/terminals/{_basculaDe.Id}/scale", ConfigBascula());
            // Si este equipo es la caja, el agente queda configurado de una vez; si no, la caja se lo entrega al abrir. La vinculación (la
            // clave que firma los pesos) se hace en la pantalla de venta de esa caja con un supervisor (BB2), no desde la administración.
            var aviso = EsEsteEquipo ? await AgentScale.PushAsync(saved) : null;
            aviso ??= _bActiva && saved.ReadingKeyId is null
                ? "Báscula guardada. Para que la caja pueda pesar, vincúlela en la pantalla de venta de esa caja: F1 → Vincular báscula (con un supervisor)."
                : null;
            Snackbar.Add(aviso ?? "Báscula guardada. La caja la usa desde que vuelva a abrir la pantalla de venta.", aviso is null ? Severity.Success : Severity.Warning);
            CerrarBascula();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    public void Dispose() => DetenerPrueba();

