@page "/admin/productos/nuevo"
@page "/admin/productos/{Id:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@using Pos.Modules.Catalog.Contracts
@using Pos.Modules.Inventory.Contracts
@using Pos.Modules.Organization.Contracts

<PageTitle>@Titulo · BusinessPost</PageTitle>

<Pagina Titulo="@Titulo" Subtitulo="@Subtitulo" Miga="@Titulo" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (EsExistente)
        {
            @if (Session.Has("catalog.price.manage"))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Sell" OnClick="AbrirPrecio">Cambiar precio</MudButton>
            }
            @if (PuedeEditar)
            {
                @if (EnumText.Same(Estado, "ACTIVE"))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => CambiarEstadoAsync("Inactive"))">Inactivar</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" OnClick="@(() => CambiarEstadoAsync("Active"))">Activar</MudButton>
                }
                @if (!EnumText.Same(Estado, "DISCONTINUED"))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => CambiarEstadoAsync("Discontinued"))">Descontinuar</MudButton>
                }
            }
        }
    </Acciones>
    <ChildContent>
        @if (Id is null || _producto is not null)
        {
            <MudTabs @bind-ActivePanelIndex="_tab" Elevation="0" Outlined="true" TabPanelsClass="pa-4">
                <MudTabPanel Text="Datos">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_sku" Label="SKU (código interno)" Immediate="true" ReadOnly="@(!PuedeEditar)"
                                          HelperText="@(EsExistente ? null : "Vacío = se genera uno automáticamente")" />
                        </MudItem>
                        <MudItem xs="12" sm="8"><MudTextField @bind-Value="_name" Label="Nombre" Immediate="true" ReadOnly="@(!PuedeEditar)" /></MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_shortName" Label="Nombre corto (tirilla y caja)" Immediate="true" ReadOnly="@(!PuedeEditar)"
                                          HelperText="Vacío = se toma del nombre" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="Guid?" @bind-Value="_category" Label="Categoría" ReadOnly="@(!PuedeEditar)">
                                @foreach (var category in _categories)
                                {
                                    <MudSelectItem T="Guid?" Value="@category.GetProperty("id").GetGuid()">@Categorias.Nombre(_categories, category)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="Guid?" @bind-Value="_brand" Label="Marca (opcional)" Clearable="true" ReadOnly="@(!PuedeEditar)">
                                @foreach (var brand in _brands.Where(b => EnumText.Same(b.Status, "ACTIVE") || b.Id == _brand))
                                {
                                    <MudSelectItem T="Guid?" Value="@brand.Id">@brand.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudSelect T="string" Value="_unit" ValueChanged="CambiarUnidad" Label="Unidad base" ReadOnly="@(!PuedeEditar)">
                                @foreach (var unit in _units)
                                {
                                    <MudSelectItem T="string" Value="@unit.Code">@unit.Name (@unit.Code)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudSelect T="string" @bind-Value="_productType" Label="Tipo" ReadOnly="@(!PuedeEditar)">
                                <MudSelectItem T="string" Value="@("Stockable")">Maneja inventario</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Service")">Servicio (sin inventario)</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_description" Label="Descripción (opcional)" Immediate="true" Lines="2" ReadOnly="@(!PuedeEditar)" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_plu" Label="@(PluObligatorio ? "PLU de báscula" : "PLU de báscula (opcional)")" Immediate="true" ReadOnly="@(!PuedeEditar)"
                                          Required="@PluObligatorio" RequiredError="Un producto de báscula necesita su PLU."
                                          HelperText="@(PluObligatorio ? "Obligatorio: es el número que la báscula imprime en la etiqueta (1 a 6 dígitos)" : "Hasta 6 dígitos")" />
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudNumericField Culture="@Format.Colombia" T="decimal?" @bind-Value="_netContent" Label="Contenido neto (opcional)" Min="0" ReadOnly="@(!PuedeEditar)" />
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudSelect T="string" @bind-Value="_netUnit" Label="Unidad del contenido" Clearable="true" ReadOnly="@(!PuedeEditar)">
                                @foreach (var unit in _units)
                                {
                                    <MudSelectItem T="string" Value="@unit.Code">@unit.Name (@unit.Code)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            @if (_unit == "KG")
                            {
                                <MudCheckBox T="bool" @bind-Value="_scale" Label="Se vende por báscula (requiere PLU)" ReadOnly="@(!PuedeEditar)" />
                            }
                            @if (ModoVenta == "Unit")
                            {
                                <MudCheckBox T="bool" @bind-Value="_decimal" Label="Permite cantidades con decimales" ReadOnly="@(!PuedeEditar)" />
                            }
                            <MudCheckBox T="bool" @bind-Value="_openPrice" Label="Permite precio abierto en la caja" ReadOnly="@(!PuedeEditar)" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            @if (_productType == "Stockable")
                            {
                                <MudCheckBox T="bool" @bind-Value="_lots" Label="Maneja lotes" ReadOnly="@(!PuedeEditar)" />
                                <MudCheckBox T="bool" @bind-Value="_expiry" Label="Maneja fecha de vencimiento (requiere lotes)" ReadOnly="@(!PuedeEditar)" />
                            }
                        </MudItem>
                        @if (!EsExistente)
                        {
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_barcode" Label="Código de barras" Immediate="true" HelperText="Vacío = se genera uno interno" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField Culture="@Format.Colombia" T="decimal" @bind-Value="_price" Label="Precio de venta (IVA incluido)" Min="0" />
                            </MudItem>
                        }
                    </MudGrid>
                    @if (PuedeEditar)
                    {
                        <MudStack Row="true" Class="mt-4" Spacing="2">
                            @if (EsExistente)
                            {
                                <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="LlenarFormulario">Descartar cambios</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || !FormularioValido)" OnClick="GuardarAsync">Guardar</MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Text" Href="/admin/productos">Cancelar</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || !FormularioValido)" OnClick="CrearAsync">Crear producto</MudButton>
                            }
                        </MudStack>
                        @if (PluObligatorio && string.IsNullOrWhiteSpace(_plu))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mt-1">Escriba el PLU de báscula para poder guardar.</MudText>
                        }
                    }
                </MudTabPanel>

                @if (EsExistente)
                {
                    <MudTabPanel Text="Precios">
                        <MudText Typo="Typo.overline" Class="d-block">Precio vigente (lista por defecto)</MudText>
                        <MudText Typo="Typo.h4" Class="num mb-3">@Format.Money(PrecioVigente)</MudText>
                        <MudTable Items="_precios" Dense="true" Striped="true" Hover="true">
                            <HeaderContent>
                                <MudTh>Lista</MudTh><MudTh>Presentación</MudTh><MudTh>Sucursal</MudTh><MudTh Class="num">Precio</MudTh>
                                <MudTh>Desde</MudTh><MudTh>Hasta</MudTh><MudTh>Estado</MudTh><MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@NombreLista(context)</MudTd>
                                <MudTd>@NombrePresentacion(context.PackagingId)</MudTd>
                                <MudTd>@NombreSucursal(context.BranchId)</MudTd>
                                <MudTd Class="num">@Format.Money(context.Price)</MudTd>
                                <MudTd>@Format.Date(context.ValidFrom)</MudTd>
                                <MudTd>@Format.Date(context.ValidTo)</MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@ColorEstadoPrecio(context.State)">@EstadoPrecio(context.State)</MudChip>
                                </MudTd>
                                <MudTd>
                                    @if (EnumText.Same(context.State, "SCHEDULED") && Session.Has("catalog.price.manage"))
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => CancelarPrecioAsync(context))">Cancelar</MudButton>
                                    }
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent><EstadoVacio Mensaje="El producto no tiene precios." Detalle="Use «Cambiar precio» para fijar el primero." Compacto="true" /></NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>

                    <MudTabPanel Text="Presentaciones">
                        <MudText Typo="Typo.body2" Class="mb-3">
                            Empaques en que se compra o se vende el producto (p. ej. «Caja × 12», «Paca × 6»). Las unidades son cuántas @_unit trae cada empaque.
                        </MudText>
                        @if (PuedeEditar)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" Class="mb-3" Disabled="_busy"
                                       OnClick="@(() => AbrirPresentacion(null))">Agregar presentación</MudButton>
                        }
                        <MudTable Items="Presentaciones" Dense="true" Striped="true" Hover="true">
                            <HeaderContent>
                                <MudTh>Nombre</MudTh><MudTh Class="num">Unidades</MudTh><MudTh>Códigos de barras</MudTh><MudTh Class="num">Precio vigente</MudTh>
                                <MudTh>Se vende</MudTh><MudTh>Se compra</MudTh><MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Name</MudTd>
                                <MudTd Class="num">@Format.Quantity(context.Factor) @_unit</MudTd>
                                <MudTd Class="num">@CodigosDe(context.Id)</MudTd>
                                <MudTd Class="num">@(PrecioActual(ListaPorDefecto, context.Id, null) is { } precio ? Format.Money(precio) : "—")</MudTd>
                                <MudTd>@(context.IsSellable ? "Sí" : "No")</MudTd>
                                <MudTd>@(context.IsPurchasable ? "Sí" : "No")</MudTd>
                                <MudTd>
                                    @if (PuedeEditar)
                                    {
                                        <MudButton Size="Size.Small" Disabled="_busy" OnClick="@(() => AbrirPresentacion(context))">Editar</MudButton>
                                        <MudButton Size="Size.Small" Color="Color.Error" Disabled="_busy" OnClick="@(() => QuitarPresentacionAsync(context))">Eliminar</MudButton>
                                    }
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent><EstadoVacio Mensaje="El producto no tiene presentaciones." Detalle="Se vende y se compra solo por unidad base." Compacto="true" /></NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>

                    <MudTabPanel Text="Códigos de barras">
                        @if (PuedeEditar)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3 flex-wrap">
                                <MudTextField @bind-Value="_nuevoCodigo" Label="Código de fábrica" Immediate="true" Style="min-width:240px" />
                                @if (Presentaciones.Count > 0)
                                {
                                    <MudSelect T="Guid" @bind-Value="_codigoPresentacion" Label="Presentación" Style="min-width:200px">
                                        <MudSelectItem T="Guid" Value="@Guid.Empty">Unidad base</MudSelectItem>
                                        @foreach (var packaging in Presentaciones)
                                        {
                                            <MudSelectItem T="Guid" Value="@packaging.Id">@packaging.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                <MudCheckBox T="bool" @bind-Value="_nuevoPrincipal" Label="Principal" />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_nuevoCodigo))"
                                           OnClick="@(() => AgregarCodigoAsync(false))">Agregar</MudButton>
                                <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="@(() => AgregarCodigoAsync(true))">Generar código interno</MudButton>
                            </MudStack>
                        }
                        <MudTable Items="Codigos" Dense="true" Striped="true" Hover="true">
                            <HeaderContent>
                                <MudTh>Código</MudTh><MudTh>Tipo</MudTh><MudTh>Presentación</MudTh><MudTh>Principal</MudTh><MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd Class="num">@context.Code</MudTd>
                                <MudTd>@TipoCodigo(context.CodeType)</MudTd>
                                <MudTd>@NombrePresentacion(context.PackagingId)</MudTd>
                                <MudTd>@(context.IsPrimary ? "Sí" : "")</MudTd>
                                <MudTd>
                                    @if (PuedeEditar)
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => QuitarCodigoAsync(context))">Quitar</MudButton>
                                    }
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent><EstadoVacio Mensaje="El producto no tiene códigos de barras." Compacto="true" /></NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>

                    <MudTabPanel Text="Impuestos">
                        @if (PuedeEditar)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3 flex-wrap">
                                <MudSelect T="Guid?" @bind-Value="_nuevoImpuesto" Label="Agregar impuesto" Style="min-width:260px">
                                    @foreach (var tax in ImpuestosDisponibles)
                                    {
                                        <MudSelectItem T="Guid?" Value="@tax.Id">@tax.Code · @tax.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                @if (ImpuestoNuevoEsFijo)
                                {
                                    <MudNumericField Culture="@Format.Colombia" T="decimal?" @bind-Value="_nuevoValorFijo" Label="Valor fijo por unidad (opcional)" Min="0" />
                                }
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || _nuevoImpuesto is null)" OnClick="AgregarImpuestoAsync">Agregar</MudButton>
                            </MudStack>
                        }
                        <MudTable Items="Impuestos" Dense="true" Striped="true" Hover="true">
                            <HeaderContent>
                                <MudTh>Código</MudTh><MudTh>Nombre</MudTh><MudTh>Clase</MudTh><MudTh Class="num">Tarifa vigente</MudTh><MudTh Class="num">Valor fijo del producto</MudTh><MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Code</MudTd>
                                <MudTd>@context.Name</MudTd>
                                <MudTd>@ClaseImpuesto(context.Kind)</MudTd>
                                <MudTd Class="num">@TarifaVigente(context)</MudTd>
                                <MudTd Class="num">@Format.Money(context.FixedAmount)</MudTd>
                                <MudTd>
                                    @if (PuedeEditar)
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => QuitarImpuestoAsync(context))">Quitar</MudButton>
                                    }
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent><EstadoVacio Mensaje="El producto no tiene impuestos." Detalle="Sin impuestos el producto se vende como excluido." Compacto="true" /></NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>

                    @if (Session.Has("inventory.stock.view"))
                    {
                        <MudTabPanel Text="Existencias">
                            @if (_errorExistencias is not null)
                            {
                                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_errorExistencias</MudAlert>
                            }
                            else
                            {
                                <MudText Typo="Typo.overline" Class="d-block">Total en la sucursal</MudText>
                                <MudText Typo="Typo.h4" Class="num mb-3">@Format.Quantity(_existencias.Sum(e => e.Quantity)) @_unit</MudText>
                                <MudTable Items="_existencias" Dense="true" Striped="true" Hover="true">
                                    <HeaderContent>
                                        <MudTh>Bodega</MudTh><MudTh Class="num">Cantidad</MudTh><MudTh Class="num">Mínimo</MudTh>
                                        <MudTh Class="num">Costo promedio</MudTh><MudTh Class="num">Valor</MudTh><MudTh>Último movimiento</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>
                                            @context.WarehouseCode
                                            @if (context.BelowMinimum)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Bajo el mínimo</MudChip>
                                            }
                                        </MudTd>
                                        <MudTd Class="num">@Format.Quantity(context.Quantity) @context.BaseUnitCode</MudTd>
                                        <MudTd Class="num">@(context.MinQuantity is { } minimo ? Format.Quantity(minimo) : "—")</MudTd>
                                        <MudTd Class="num">@Format.Money(context.AverageCost)</MudTd>
                                        <MudTd Class="num">@Format.Money(context.TotalValue)</MudTd>
                                        <MudTd>@Format.Date(context.LastMovementAt)</MudTd>
                                    </RowTemplate>
                                    <NoRecordsContent><EstadoVacio Mensaje="Sin existencias registradas en las bodegas de la sucursal." Compacto="true" /></NoRecordsContent>
                                </MudTable>
                            }
                        </MudTabPanel>
                    }
                }
            </MudTabs>
        }
    </ChildContent>
</Pagina>

@if (_cambiandoPrecio)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true" aria-labelledby="titulo-precio">
            <h2 id="titulo-precio">Precio de @(_producto?.Name)</h2>
            <MudText Typo="Typo.body2">
                Precio actual: @(PrecioSeleccionado is { } actual ? Format.Money(actual) : "sin precio"). Rige desde ahora o desde la fecha que indique.
            </MudText>
            <MudSelect T="Guid?" Value="_precioLista" ValueChanged="CambiarListaPrecio" Label="Lista de precios">
                @foreach (var list in _priceLists.Where(l => EnumText.Same(l.Status, "ACTIVE") || l.IsDefault))
                {
                    <MudSelectItem T="Guid?" Value="@list.Id">@list.Name@(list.IsDefault ? " (por defecto)" : "")</MudSelectItem>
                }
            </MudSelect>
            @if (_branches.Count > 0)
            {
                <MudSelect T="Guid" Value="_precioSucursal" ValueChanged="CambiarSucursalPrecio" Label="Sucursal">
                    <MudSelectItem T="Guid" Value="@Guid.Empty">Todas las sucursales</MudSelectItem>
                    @foreach (var branch in _branches)
                    {
                        <MudSelectItem T="Guid" Value="@branch.Id">@branch.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (PresentacionesVendibles.Any())
            {
                <MudSelect T="Guid" Value="_precioPresentacion" ValueChanged="CambiarPresentacionPrecio" Label="Presentación">
                    <MudSelectItem T="Guid" Value="@Guid.Empty">Unidad base (@_unit)</MudSelectItem>
                    @foreach (var packaging in PresentacionesVendibles)
                    {
                        <MudSelectItem T="Guid" Value="@packaging.Id">@packaging.Name (@Format.Quantity(packaging.Factor) @_unit)</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudNumericField Culture="@Format.Colombia" T="decimal" @bind-Value="_nuevoPrecio" Label="Nuevo precio (IVA incluido)" Min="0" AutoFocus="true" />
            <MudDatePicker @bind-Date="_desde" Label="Rige desde (opcional)" DateFormat="dd/MM/yyyy" MinDate="@DateTime.Today"
                           Clearable="true" HelperText="Vacío = rige desde ahora; con fecha queda programado" />
            <div class="acciones">
                <MudButton OnClick="@(() => _cambiandoPrecio = false)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="GuardarPrecioAsync">Guardar</MudButton>
            </div>
        </div>
    </div>
}

@if (_editandoPresentacion)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true" aria-labelledby="titulo-presentacion">
            <h2 id="titulo-presentacion">@(_presentacionId is null ? "Nueva presentación" : "Editar presentación")</h2>
            <MudTextField @bind-Value="_pNombre" Label="Nombre" Immediate="true" AutoFocus="true" MaxLength="60" HelperText="Ej.: Caja × 12, Paca × 6" />
            <MudNumericField Culture="@Format.Colombia" T="decimal" @bind-Value="_pFactor" Label="@($"Unidades por empaque ({_unit})")" Min="0" />
            <MudCheckBox T="bool" @bind-Value="_pVende" Label="Se vende en la caja" />
            <MudCheckBox T="bool" @bind-Value="_pCompra" Label="Se compra a proveedores" />
            @if (_presentacionId is null)
            {
                <MudTextField @bind-Value="_pCodigo" Label="Código de barras del empaque (opcional)" Immediate="true" />
                @if (Session.Has("catalog.price.manage"))
                {
                    <MudNumericField Culture="@Format.Colombia" T="decimal?" @bind-Value="_pPrecio" Label="Precio del empaque (opcional, IVA incluido)" Min="0"
                                     HelperText="Se fija en la lista por defecto para todas las sucursales" />
                }
            }
            <div class="acciones">
                <MudButton OnClick="@(() => _editandoPresentacion = false)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_pNombre) || _pFactor <= 0)"
                           OnClick="GuardarPresentacionAsync">Guardar</MudButton>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private List<JsonElement> _categories = [];
    private List<BrandDto> _brands = [];
    private List<UnitDto> _units = [];
    private List<TaxDto> _taxes = [];
    private List<PriceListDto> _priceLists = [];
    private List<BranchDto> _branches = [];
    private List<PriceDto> _precios = [];
    private List<StockDto> _existencias = [];
    private ProductDetailDto? _producto;
    private string? _clave;
    private bool _maestros, _loading = true, _busy, _cambiandoPrecio;
    private int _tab;
    private string? _error, _errorExistencias;

    // Formulario de datos.
    private string? _sku, _name, _shortName, _description, _plu, _netUnit, _barcode;
    private string _unit = "UND", _productType = "Stockable";
    private Guid? _category, _brand;
    private decimal? _netContent;
    private decimal _price;
    private bool _scale, _decimal, _openPrice, _lots, _expiry;

    // Precio, códigos e impuestos.
    private decimal _nuevoPrecio;
    private DateTime? _desde;
    private Guid? _precioLista;
    private Guid _precioSucursal, _precioPresentacion; // Guid.Empty = todas las sucursales / unidad base.
    private string? _nuevoCodigo;
    private bool _nuevoPrincipal;
    private Guid _codigoPresentacion; // Guid.Empty = unidad base.

    // Presentación en edición (_presentacionId null = nueva).
    private bool _editandoPresentacion, _pVende, _pCompra;
    private Guid? _presentacionId;
    private string? _pNombre, _pCodigo;
    private decimal _pFactor;
    private decimal? _pPrecio;
    private Guid? _nuevoImpuesto;
    private decimal? _nuevoValorFijo;

    private bool EsExistente => Id is not null && _producto is not null;

    private bool PuedeEditar => Session.Has("catalog.product.manage");

    private string Estado => _producto?.Status ?? "";

    private string Titulo => Id is not null && _producto is { } producto ? producto.Name : Id is null ? "Nuevo producto" : "Producto";

    private string? Subtitulo => Id is not null && _producto is { } producto ? $"SKU {producto.Sku} · {NombreEstado(producto.Status)}" : null;

    private bool FormularioValido => !string.IsNullOrWhiteSpace(_name) && _category is not null && !string.IsNullOrWhiteSpace(_unit)
                                     && !(PluObligatorio && string.IsNullOrWhiteSpace(_plu));

    /// <summary>El servidor exige PLU a los productos vendidos por báscula (solo kilogramos).</summary>
    private bool PluObligatorio => _unit == "KG" && _scale;

    private IReadOnlyList<BarcodeDto> Codigos => _producto?.Barcodes ?? [];

    private IReadOnlyList<ProductTaxDto> Impuestos => _producto?.Taxes ?? [];

    private IReadOnlyList<PackagingDto> Presentaciones => _producto?.Packagings ?? [];

    /// <summary>Modo de venta según la dimensión de la unidad base (el servidor exige que coincidan).</summary>
    private string ModoVenta => EnumText.Normalize(_units.FirstOrDefault(u => u.Code == _unit)?.Dimension) switch
    {
        "WEIGHT" => "Weight",
        "VOLUME" => "Volume",
        _ => "Unit",
    };

    private IEnumerable<TaxDto> ImpuestosDisponibles =>
        _taxes.Where(t => EnumText.Same(t.Status, "ACTIVE") && Impuestos.All(i => i.TaxId != t.Id));

    private bool ImpuestoNuevoEsFijo =>
        _nuevoImpuesto is { } id && EnumText.Same(_taxes.FirstOrDefault(t => t.Id == id)?.Calculation, "FIXED_PER_UNIT");

    private Guid? ListaPorDefecto => _priceLists.FirstOrDefault(l => l.IsDefault)?.Id;

    /// <summary>Precio vigente por unidad base en la lista por defecto, para todas las sucursales.</summary>
    private decimal? PrecioVigente => PrecioActual(ListaPorDefecto, null, null);

    /// <summary>Precio vigente de la combinación elegida en «Cambiar precio».</summary>
    private decimal? PrecioSeleccionado => PrecioActual(_precioLista, SinVacio(_precioPresentacion), SinVacio(_precioSucursal));

    private IEnumerable<PackagingDto> PresentacionesVendibles => Presentaciones.Where(p => p.IsSellable || p.Id == _precioPresentacion);

    /// <summary>Precio vigente en una lista (null = cualquiera), presentación (null = unidad base) y sucursal (null = todas).</summary>
    private decimal? PrecioActual(Guid? lista, Guid? presentacion, Guid? sucursal) =>
        _precios.Where(p => EnumText.Same(p.State, "CURRENT")
                            && p.PackagingId == presentacion
                            && p.BranchId == sucursal
                            && (lista is not { } l || p.PriceListId == l))
            .Select(p => (decimal?)p.Price).FirstOrDefault();

    private static Guid? SinVacio(Guid id) => id == Guid.Empty ? null : id;

    protected override async Task OnParametersSetAsync()
    {
        // Solo se carga al cambiar de ruta (nuevo → producto creado, o de un producto a otro), no en cada re-render del enrutador.
        var clave = Id?.ToString() ?? "nuevo";
        if (clave == _clave)
        {
            return;
        }

        _clave = clave;

        _loading = true;
        _error = null;
        try
        {
            await CargarMaestrosAsync();
            if (Id is { } id)
            {
                await CargarProductoAsync(id);
            }
            else
            {
                _producto = null;
                _tab = 0;
                LlenarFormulario();
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private async Task CargarMaestrosAsync()
    {
        if (_maestros)
        {
            return;
        }

        _categories = (await Api.GetAsync<JsonElement>("api/v1/catalog/categories")).Items();
        _brands = await Api.GetAsync<List<BrandDto>>("api/v1/catalog/brands");
        _units = await Api.GetAsync<List<UnitDto>>("api/v1/catalog/units");
        _taxes = await Api.GetAsync<List<TaxDto>>("api/v1/catalog/taxes");
        _priceLists = await Api.GetAsync<List<PriceListDto>>("api/v1/catalog/price-lists");
        if (Session.Has("organization.branch.view"))
        {
            try
            {
                _branches = await Api.GetAsync<List<BranchDto>>("api/v1/organization/branches");
            }
            catch (ApiException)
            {
                // Sin sucursales el precio se fija para todas; la ficha sigue funcionando.
                _branches = [];
            }
        }

        _maestros = true;
    }

    private async Task CargarProductoAsync(Guid id)
    {
        _producto = await Api.GetAsync<ProductDetailDto>($"api/v1/catalog/products/{id}");
        _precios = await Api.GetAsync<List<PriceDto>>($"api/v1/catalog/products/{id}/prices");
        LlenarFormulario();
        await CargarExistenciasAsync(id);
    }

    private async Task CargarExistenciasAsync(Guid id)
    {
        if (!Session.Has("inventory.stock.view"))
        {
            return;
        }

        try
        {
            _existencias = await Api.GetAsync<List<StockDto>>($"api/v1/inventory/stock?productId={id}");
            _errorExistencias = null;
        }
        catch (ApiException ex)
        {
            _errorExistencias = ex.Texto;
        }
    }

    /// <summary>Copia los datos del producto al formulario (o lo deja en blanco para uno nuevo).</summary>
    private void LlenarFormulario()
    {
        var p = _producto;
        _sku = p?.Sku;
        _name = p?.Name;
        _shortName = p?.ShortName;
        _description = p?.Description is { Length: > 0 } description ? description : null;
        _category = p?.CategoryId;
        _brand = p?.BrandId;
        _unit = p?.BaseUnitCode ?? "UND";
        _productType = p is not null && EnumText.Same(p.ProductType, "SERVICE") ? "Service" : "Stockable";
        _scale = p?.IsSoldByScale ?? false;
        _decimal = p?.AllowsDecimalQuantity ?? false;
        _openPrice = p?.AllowsOpenPrice ?? false;
        _lots = p?.TracksLots ?? false;
        _expiry = p?.TracksExpiry ?? false;
        _plu = p?.PluCode is { Length: > 0 } plu ? plu : null;
        _netContent = p?.NetContent;
        _netUnit = p?.NetContentUnit is { Length: > 0 } netUnit ? netUnit : null;
        _barcode = null;
        _price = 0;
    }

    private void CambiarUnidad(string unit)
    {
        _unit = unit;
        if (unit != "KG")
        {
            _scale = false;
        }
    }

    /// <summary>Cuerpo de ProductInput (enums como los espera el servidor: Unit/Weight/Volume, Stockable/Service).</summary>
    private object DatosProducto()
    {
        var mode = ModoVenta;
        var stockable = _productType == "Stockable";
        return new
        {
            sku = string.IsNullOrWhiteSpace(_sku) ? null : _sku.Trim(),
            name = (_name ?? "").Trim(),
            shortName = string.IsNullOrWhiteSpace(_shortName) ? null : _shortName.Trim(),
            description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
            categoryId = _category,
            brandId = _brand,
            baseUnitCode = _unit,
            saleMode = mode,
            productType = _productType,
            isSoldByScale = _unit == "KG" && _scale,
            allowsDecimalQuantity = mode != "Unit" || _decimal,
            allowsOpenPrice = _openPrice,
            tracksLots = stockable && _lots,
            tracksExpiry = stockable && _expiry,
            pluCode = string.IsNullOrWhiteSpace(_plu) ? null : _plu.Trim(),
            netContent = _netContent,
            netContentUnit = _netContent is null || string.IsNullOrWhiteSpace(_netUnit) ? null : _netUnit,
        };
    }

    private async Task CrearAsync()
    {
        _busy = true;
        try
        {
            var created = await Api.PostAsync<ProductDetailDto>("api/v1/catalog/products", new
            {
                product = DatosProducto(),
                barcode = string.IsNullOrWhiteSpace(_barcode) ? null : _barcode.Trim(),
                generateBarcode = string.IsNullOrWhiteSpace(_barcode),
                taxes = (object?)null,
                price = _price,
            });
            Snackbar.Add("Producto creado.", Severity.Success);
            Navigation.NavigateTo($"/admin/productos/{created.Id}", replace: true);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private async Task GuardarAsync()
    {
        await EjecutarAsync(async id =>
        {
            await Api.PutAsync<ProductDetailDto>($"api/v1/catalog/products/{id}", DatosProducto());
            return "Producto actualizado.";
        });
    }

    private async Task CambiarEstadoAsync(string status)
    {
        var name = _producto?.Name ?? "";
        var (titulo, mensaje, accion, peligro, aviso) = status switch
        {
            "Inactive" => ("Inactivar producto", $"{name} quedará inactivo: no se podrá vender hasta activarlo de nuevo.", "Inactivar", true, "Producto inactivado."),
            "Discontinued" => ("Descontinuar producto", $"{name} quedará descontinuado: deja de venderse y de comprarse.", "Descontinuar", true, "Producto descontinuado."),
            _ => ("Activar producto", $"{name} quedará activo y se podrá vender.", "Activar", false, "Producto activado."),
        };
        if (!await Dialogs.ConfirmarAsync(titulo, mensaje, accion, peligro))
        {
            return;
        }

        await EjecutarAsync(async id =>
        {
            await Api.PostAsync($"api/v1/catalog/products/{id}/status", new { status });
            return aviso;
        });
    }

    private void AbrirPrecio()
    {
        _precioLista = ListaPorDefecto;
        _precioSucursal = Guid.Empty;
        _precioPresentacion = Guid.Empty;
        _nuevoPrecio = PrecioSeleccionado ?? 0;
        _desde = null;
        _cambiandoPrecio = true;
    }

    private void CambiarListaPrecio(Guid? lista)
    {
        _precioLista = lista;
        _nuevoPrecio = PrecioSeleccionado ?? 0;
    }

    private void CambiarSucursalPrecio(Guid sucursal)
    {
        _precioSucursal = sucursal;
        _nuevoPrecio = PrecioSeleccionado ?? 0;
    }

    private void CambiarPresentacionPrecio(Guid presentacion)
    {
        _precioPresentacion = presentacion;
        _nuevoPrecio = PrecioSeleccionado ?? 0;
    }

    private async Task GuardarPrecioAsync()
    {
        await EjecutarAsync(async id =>
        {
            var result = await Api.PostAsync<SetPriceResultDto>($"api/v1/catalog/products/{id}/prices", new
            {
                price = _nuevoPrecio, priceListId = _precioLista, packagingId = SinVacio(_precioPresentacion), branchId = SinVacio(_precioSucursal),
                validFrom = _desde is { } d ? new DateTimeOffset(d.Date) : (DateTimeOffset?)null,
            });
            foreach (var warning in result.Warnings)
            {
                Snackbar.Add(warning, Severity.Warning);
            }

            _cambiandoPrecio = false;
            return _desde is null ? "Precio actualizado." : "Precio programado.";
        });
    }

    private async Task CancelarPrecioAsync(PriceDto price)
    {
        if (!await Dialogs.ConfirmarAsync("Cancelar precio programado",
                $"El precio de {Format.Money(price.Price)} que iba a regir desde el {Format.Date(price.ValidFrom)} no se aplicará.", "Cancelar precio", true))
        {
            return;
        }

        await EjecutarAsync(async id =>
        {
            await Api.SendAsync<JsonElement?>(HttpMethod.Delete, $"api/v1/catalog/products/{id}/prices/{price.Id}", null);
            return "Precio programado cancelado.";
        });
    }

    private async Task AgregarCodigoAsync(bool generar)
    {
        await EjecutarAsync(async id =>
        {
            await Api.PostAsync($"api/v1/catalog/products/{id}/barcodes", new
            {
                code = generar ? null : _nuevoCodigo?.Trim(), packagingId = _codigoPresentacion == Guid.Empty ? (Guid?)null : _codigoPresentacion,
                type = (string?)null, generate = generar, isPrimary = _nuevoPrincipal,
            });
            _nuevoCodigo = null;
            _nuevoPrincipal = false;
            _codigoPresentacion = Guid.Empty;
            return generar ? "Código interno generado." : "Código agregado.";
        });
    }

    private async Task QuitarCodigoAsync(BarcodeDto barcode)
    {
        if (!await Dialogs.ConfirmarAsync("Quitar código de barras", $"El código {barcode.Code} dejará de reconocerse en la caja.", "Quitar", true))
        {
            return;
        }

        await EjecutarAsync(async id =>
        {
            await Api.SendAsync<JsonElement?>(HttpMethod.Delete, $"api/v1/catalog/products/{id}/barcodes/{barcode.Id}", null);
            return "Código quitado.";
        });
    }

    /// <summary>Abre el formulario de presentación: vacío (nueva) o con los datos de una existente.</summary>
    private void AbrirPresentacion(PackagingDto? packaging)
    {
        _presentacionId = packaging?.Id;
        _pNombre = packaging?.Name;
        _pFactor = packaging?.Factor ?? 0;
        _pVende = packaging?.IsSellable ?? true;
        _pCompra = packaging?.IsPurchasable ?? true;
        _pCodigo = null;
        _pPrecio = null;
        _editandoPresentacion = true;
    }

    private async Task GuardarPresentacionAsync()
    {
        var name = (_pNombre ?? "").Trim();
        await EjecutarAsync(async id =>
        {
            if (_presentacionId is { } packagingId)
            {
                await Api.PutAsync<PackagingDto>($"api/v1/catalog/products/{id}/packagings/{packagingId}", new
                {
                    name, factor = _pFactor, isSellable = _pVende, isPurchasable = _pCompra,
                });
            }
            else
            {
                await Api.PostAsync<ProductDetailDto>($"api/v1/catalog/products/{id}/packagings", new
                {
                    name, factor = _pFactor, isSellable = _pVende, isPurchasable = _pCompra,
                    barcode = string.IsNullOrWhiteSpace(_pCodigo) ? null : _pCodigo.Trim(),
                    price = Session.Has("catalog.price.manage") ? _pPrecio : null,
                });
            }

            var aviso = _presentacionId is null ? "Presentación agregada." : "Presentación actualizada.";
            _editandoPresentacion = false;
            return aviso;
        });
    }

    private async Task QuitarPresentacionAsync(PackagingDto packaging)
    {
        if (!await Dialogs.ConfirmarAsync("Eliminar presentación",
                $"Se elimina {packaging.Name} con sus códigos de barras; sus precios vigentes se cierran y los programados se cancelan.", "Eliminar", true))
        {
            return;
        }

        await EjecutarAsync(async id =>
        {
            await Api.SendAsync<JsonElement?>(HttpMethod.Delete, $"api/v1/catalog/products/{id}/packagings/{packaging.Id}", null);
            return "Presentación eliminada.";
        });
    }

    private string CodigosDe(Guid packagingId) =>
        Codigos.Where(b => b.PackagingId == packagingId).Select(b => b.Code).ToList() is { Count: > 0 } codes
            ? string.Join(", ", codes)
            : "—";

    private string NombreSucursal(Guid? branchId) =>
        branchId is not { } id ? "Todas" : _branches.FirstOrDefault(b => b.Id == id)?.Name is { Length: > 0 } name ? name : "Una sucursal";

    private async Task AgregarImpuestoAsync()
    {
        if (_nuevoImpuesto is not { } taxId)
        {
            return;
        }

        var fixedAmount = ImpuestoNuevoEsFijo ? _nuevoValorFijo : null;
        var taxes = Impuestos.Select(t => new { taxId = t.TaxId, fixedAmount = t.FixedAmount })
            .Append(new { taxId, fixedAmount }).ToList();
        await GuardarImpuestosAsync(taxes, "Impuesto agregado.");
        _nuevoImpuesto = null;
        _nuevoValorFijo = null;
    }

    private async Task QuitarImpuestoAsync(ProductTaxDto tax)
    {
        if (!await Dialogs.ConfirmarAsync("Quitar impuesto", $"El producto dejará de llevar {tax.Name} en las ventas nuevas.", "Quitar", true))
        {
            return;
        }

        var taxes = Impuestos.Where(t => t.Id != tax.Id)
            .Select(t => new { taxId = t.TaxId, fixedAmount = t.FixedAmount }).ToList();
        await GuardarImpuestosAsync(taxes, "Impuesto quitado.");
    }

    private Task GuardarImpuestosAsync(object taxes, string aviso) =>
        EjecutarAsync(async id =>
        {
            await Api.PutAsync<ProductDetailDto>($"api/v1/catalog/products/{id}/taxes", taxes);
            return aviso;
        });

    /// <summary>Ejecuta una acción sobre el producto, avisa el resultado y recarga la ficha.</summary>
    private async Task EjecutarAsync(Func<Guid, Task<string>> accion)
    {
        if (Id is not { } id)
        {
            return;
        }

        _busy = true;
        try
        {
            var aviso = await accion(id);
            Snackbar.Add(aviso, Severity.Success);
            await CargarProductoAsync(id);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }

    private string NombreLista(PriceDto price) => _priceLists.FirstOrDefault(l => l.Id == price.PriceListId)?.Name ?? price.PriceListCode;

    private string NombrePresentacion(Guid? packagingId) =>
        packagingId is not { } id ? "Unidad base" : Presentaciones.FirstOrDefault(p => p.Id == id)?.Name is { Length: > 0 } name ? name : "Presentación";

    private string TarifaVigente(ProductTaxDto productTax)
    {
        if (_taxes.FirstOrDefault(t => t.Id == productTax.TaxId)?.CurrentRate is not { } rate)
        {
            return "—";
        }

        return rate.Rate is { } tarifa ? $"{tarifa.ToString("0.##", Format.Colombia)} %" : Format.Money(rate.FixedAmount ?? 0m);
    }

    private static string NombreEstado(string status) => EnumText.Normalize(status) switch
    {
        "ACTIVE" => "Activo",
        "INACTIVE" => "Inactivo",
        "DISCONTINUED" => "Descontinuado",
        _ => status,
    };

    private static string EstadoPrecio(string state) => EnumText.Normalize(state) switch
    {
        "CURRENT" => "Vigente",
        "SCHEDULED" => "Programado",
        "EXPIRED" => "Vencido",
        _ => state,
    };

    private static Color ColorEstadoPrecio(string state) => EnumText.Normalize(state) switch
    {
        "CURRENT" => Color.Success,
        "SCHEDULED" => Color.Info,
        _ => Color.Default,
    };

    private static string TipoCodigo(string type) => EnumText.Normalize(type).Replace("_", "", StringComparison.Ordinal) switch
    {
        "EAN13" => "EAN-13",
        "EAN8" => "EAN-8",
        "UPCA" => "UPC-A",
        "CODE128" => "Code 128",
        "INTERNAL" => "Interno",
        _ => type,
    };

    private static string ClaseImpuesto(string kind) => EnumText.Normalize(kind) switch
    {
        "VAT" => "IVA",
        "CONSUMPTION" => "Impuesto al consumo (INC)",
        "BAG_CONSUMPTION" => "Impuesto a las bolsas",
        "SUGARY_DRINKS" => "Bebidas azucaradas (IBUA)",
        "ULTRA_PROCESSED_FOOD" => "Ultraprocesados (ICUI)",
        "OTHER" => "Otro",
        _ => kind,
    };
}
