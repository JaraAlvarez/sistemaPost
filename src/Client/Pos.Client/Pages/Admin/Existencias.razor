@page "/admin/existencias"
@inject ApiClient Api
@inject NavigationManager Navigation
@using Pos.Modules.Inventory.Contracts

<PageTitle>Existencias · BusinessPost</PageTitle>

<Pagina Titulo="Existencias" Cargando="_loading" Error="@_error">
    <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.Center">
        <MudTextField T="string" @bind-Value="_search" Label="Buscar producto" Immediate="true" DebounceInterval="350" OnDebounceIntervalElapsed="@(_ => FiltrarAsync(_below))" />
        <MudCheckBox T="bool" Value="_below" ValueChanged="@(v => FiltrarAsync(v))" Label="Solo bajo el mínimo" />
    </MudStack>
    <MudTable RowsPerPage="25" Items="_items" Dense="true" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>Bodega</MudTh><MudTh>SKU</MudTh><MudTh>Producto</MudTh><MudTh Class="num">Cantidad</MudTh><MudTh Class="num">Mínimo</MudTh>
            <MudTh Class="num">Costo promedio</MudTh><MudTh Class="num">Valor</MudTh><MudTh>Último movimiento</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.WarehouseCode</MudTd>
            <MudTd>@context.Sku</MudTd>
            <MudTd Class="celda-texto">
                @context.ProductName
                @if (context.BelowMinimum)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Bajo el mínimo</MudChip>
                }
            </MudTd>
            <MudTd Class="num">@Format.Quantity(context.Quantity) @context.BaseUnitCode</MudTd>
            <MudTd Class="num">@(context.MinQuantity is { } minimo ? Format.Quantity(minimo) : "—")</MudTd>
            <MudTd Class="num">@Format.Money(context.AverageCost)</MudTd>
            <MudTd Class="num">@Format.Money(context.TotalValue)</MudTd>
            <MudTd>@Format.Date(context.LastMovementAt)</MudTd>
        </RowTemplate>
        <NoRecordsContent><EstadoVacio Mensaje="Sin existencias que coincidan." /></NoRecordsContent>
        <PagerContent><Paginador /></PagerContent>
    </MudTable>
</Pagina>

@code {
    private List<StockDto> _items = [];
    private string? _search, _error;
    private bool _below, _loading = true;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "bajo")]
    public string? Bajo { get; set; }

    protected override Task OnInitializedAsync()
    {
        _search = Q;
        _below = string.Equals(Bajo, "true", StringComparison.OrdinalIgnoreCase);
        return CargarAsync();
    }

    private async Task FiltrarAsync(bool below)
    {
        _below = below;
        Filtros.Actualizar(Navigation, new Dictionary<string, object?> { ["q"] = _search, ["bajo"] = _below });
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _loading = true;
        try
        {
            var below = _below ? "true" : "false";
            _items = [.. (await Api.GetAsync<List<StockDto>>($"api/v1/inventory/stock?search={Uri.EscapeDataString(_search ?? "")}&belowMinimum={below}")).Take(300)];
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }
}
