@page "/admin/productos"
@inject ApiClient Api
@inject SessionState Session
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Productos · BusinessPost</PageTitle>

<Pagina Titulo="Productos y precios" Cargando="_loading" Error="@_error">
    <Acciones>
        @if (Session.Has("catalog.product.manage"))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/admin/productos/nuevo">Nuevo producto</MudButton>
        }
    </Acciones>
    <ChildContent>
        <MudTextField T="string" @bind-Value="_search" Label="Buscar por nombre, SKU o código de barras" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" DebounceInterval="350" OnDebounceIntervalElapsed="@(_ => FiltrarAsync())" Class="mb-3" />
        <MudTable RowsPerPage="25" Items="_items" Dense="true" Hover="true" Striped="true" RowStyle="cursor:pointer"
                  OnRowClick="@((TableRowClickEventArgs<JsonElement> fila) => Abrir(fila.Item))">
            <HeaderContent>
                <MudTh>SKU</MudTh><MudTh>Nombre</MudTh><MudTh>Categoría</MudTh><MudTh>Código de barras</MudTh><MudTh Class="num">Precio</MudTh><MudTh>Estado</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Str("sku")</MudTd>
                <MudTd><a href="/admin/productos/@context.Str("id")" @onclick:stopPropagation="true">@context.Str("name")</a></MudTd>
                <MudTd>@context.Str("categoryName")</MudTd>
                <MudTd>@context.Str("primaryBarcode")</MudTd>
                <MudTd Class="num">@Format.Money(context.Dec("price"))</MudTd>
                <MudTd>@Estado(context.Str("status"))</MudTd>
                <MudTd>
                    @if (Session.Has("catalog.price.manage"))
                    {
                        @* El botón no abre la ficha: el clic no sube a la fila. *@
                        <span @onclick:stopPropagation="true">
                            <MudButton Size="Size.Small" OnClick="@(() => CambiarPrecio(context))">Cambiar precio</MudButton>
                        </span>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><EstadoVacio Mensaje="No hay productos que coincidan." /></NoRecordsContent>
            <PagerContent><Paginador /></PagerContent>
        </MudTable>
        <MudText Typo="Typo.caption">@_total producto(s). Se muestran los primeros 100.</MudText>
    </ChildContent>
</Pagina>

@if (_precioDe.ValueKind == JsonValueKind.Object)
{
    <div class="panel-fondo">
        <div class="panel" role="dialog" aria-modal="true">
            <h2>Precio de @_precioDe.Str("name")</h2>
            <MudText Typo="Typo.body2">Precio actual: @Format.Money(_precioDe.Dec("price")). El cambio queda en la auditoría y rige desde ahora o desde la fecha indicada.</MudText>
            <MudNumericField T="decimal" @bind-Value="_nuevoPrecio" Label="Nuevo precio (IVA incluido)" Min="0" AutoFocus="true" />
            <MudDatePicker @bind-Date="_desde" Label="Rige desde (opcional)" DateFormat="dd/MM/yyyy" />
            <div class="acciones">
                <MudButton OnClick="@(() => _precioDe = default)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="GuardarPrecioAsync">Guardar</MudButton>
            </div>
        </div>
    </div>
}

@code {
    private List<JsonElement> _items = [];
    private int _total;
    private string? _search, _error;
    private decimal _nuevoPrecio;
    private DateTime? _desde;
    private bool _loading = true, _busy;
    private JsonElement _precioDe;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    protected override Task OnInitializedAsync()
    {
        _search = Q;
        return BuscarAsync();
    }

    private Task FiltrarAsync()
    {
        Filtros.Actualizar(Navigation, new Dictionary<string, object?> { ["q"] = _search });
        return BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        _loading = true;
        try
        {
            var page = await Api.GetAsync<JsonElement>($"api/v1/catalog/products?pageSize=100&search={Uri.EscapeDataString(_search ?? "")}");
            _items = page.Items();
            _total = (int)page.Dec("totalCount");
            _error = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }

        _loading = false;
    }

    private void Abrir(JsonElement product) => Navigation.NavigateTo($"/admin/productos/{product.GetProperty("id").GetGuid()}");

    private static string Estado(string status) => status switch
    {
        "ACTIVE" => "Activo",
        "INACTIVE" => "Inactivo",
        "DISCONTINUED" => "Descontinuado",
        _ => status,
    };

    private void CambiarPrecio(JsonElement product)
    {
        _precioDe = product;
        _nuevoPrecio = product.Dec("price");
        _desde = null;
    }

    private async Task GuardarPrecioAsync()
    {
        _busy = true;
        try
        {
            await Api.PostAsync<JsonElement>($"api/v1/catalog/products/{_precioDe.GetProperty("id").GetGuid()}/prices", new
            {
                price = _nuevoPrecio, priceListId = (Guid?)null, packagingId = (Guid?)null, branchId = (Guid?)null,
                validFrom = _desde is { } d ? new DateTimeOffset(d.Date) : (DateTimeOffset?)null,
            });
            Snackbar.Add(_desde is null ? "Precio actualizado." : "Precio programado.", Severity.Success);
            _precioDe = default;
            await BuscarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Texto, Severity.Error);
        }

        _busy = false;
    }
}
