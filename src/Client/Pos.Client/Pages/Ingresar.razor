@page "/"
@page "/ingresar"
@layout EmptyLayout
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>Ingresar · BusinessPost</PageTitle>

<PantallaAcceso Titulo="@(_needsPairing ? "Emparejar este equipo" : "Bienvenido")"
                Ayuda="@(_needsPairing ? null : "Entre con su código de cajero para vender, o con su usuario para la administración.")">
    @if (_loading)
    {
        <MudSkeleton Height="48px" Class="mb-3" />
        <MudSkeleton Height="56px" />
        <MudSkeleton Height="56px" />
        <MudSkeleton Height="52px" Class="mt-4" />
    }
    else if (_needsPairing)
    {
        <MudAlert Severity="Severity.Info" Class="my-4" Icon="@Icons.Material.Outlined.Link">
            Este equipo aún no está emparejado con el servidor de la tienda. Pida el código de emparejamiento a un administrador.
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Href="/emparejar" StartIcon="@Icons.Material.Outlined.Link">Emparejar este equipo</MudButton>
    }
    else
    {
        <MudTabs @bind-ActivePanelIndex="_tab" Elevation="0" ApplyEffectsToContainer="true" Centered="false">
            <MudTabPanel Text="Caja" Icon="@Icons.Material.Outlined.PointOfSale">
                <EditForm Model="this" OnSubmit="CajaAsync">
                    <MudTextField @bind-Value="_code" Label="Código de cajero" InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true" AutoFocus="true" Class="mt-4"
                                  InputMode="InputMode.numeric" autocomplete="off" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Badge" />
                    <MudTextField @bind-Value="_pin" Label="PIN" InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true" Class="mt-3"
                                  InputMode="InputMode.numeric" autocomplete="off" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Pin" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Class="mt-5" Disabled="_busy"
                               StartIcon="@Icons.Material.Outlined.PointOfSale">@(_busy ? "Entrando…" : "Entrar a la caja")</MudButton>
                </EditForm>
            </MudTabPanel>
            <MudTabPanel Text="Administración" Icon="@Icons.Material.Outlined.AdminPanelSettings">
                <EditForm Model="this" OnSubmit="AdminAsync">
                    <MudTextField @bind-Value="_username" Label="Usuario" Variant="Variant.Outlined" Immediate="true" Class="mt-4" autocomplete="username"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Person" />
                    <MudTextField @bind-Value="_password" Label="Contraseña" InputType="@(_verClave ? InputType.Text : InputType.Password)" Variant="Variant.Outlined" Immediate="true" Class="mt-3"
                                  autocomplete="current-password" Adornment="Adornment.End" AdornmentIcon="@(_verClave ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                                  OnAdornmentClick="@(() => { _verClave = !_verClave; })" AdornmentAriaLabel="@(_verClave ? "Ocultar la contraseña" : "Mostrar la contraseña")" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Class="mt-5" Disabled="_busy"
                               StartIcon="@Icons.Material.Outlined.Login">@(_busy ? "Entrando…" : "Entrar")</MudButton>
                </EditForm>
            </MudTabPanel>
        </MudTabs>
        @if (Session.Device is not null)
        {
            <div class="acceso-equipo">
                <MudIcon Icon="@Icons.Material.Outlined.Devices" Size="Size.Small" />
                Equipo emparejado como @(Session.Device.DeviceKind == "Terminal" ? "caja" : "puesto administrativo").
            </div>
        }
    }
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4" role="alert">@_error</MudAlert>
    }
</PantallaAcceso>

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _needsPairing;
    private bool _verClave;
    private int _tab;
    private string? _code, _pin, _username, _password, _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Session.LoadDeviceAsync();
            Session.Setup = await Api.GetAsync<SetupStatus>("api/v1/setup/status");
            if (!Session.Setup.IsCompleted)
            {
                Navigation.NavigateTo("/instalacion", forceLoad: true);
                return;
            }

            // En Multicaja, un equipo de la red (no el propio servidor) debe estar emparejado para entrar.
            var local = Navigation.BaseUri.Contains("://localhost", StringComparison.OrdinalIgnoreCase) || Navigation.BaseUri.Contains("://127.0.0.1", StringComparison.Ordinal);
            _needsPairing = Session.IsMulti && !local && Session.Device is null;
            _tab = Session.Device?.DeviceKind == "Terminal" || !Session.IsMulti ? 0 : 1;
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con el servidor de la tienda.";
        }

        _loading = false;
    }

    private Task CajaAsync() => EntrarAsync(() => Api.PostAsync<LoginResult>("api/v1/auth/pos-login", new { posCode = _code, pin = _pin }));

    private Task AdminAsync() => EntrarAsync(() => Api.PostAsync<LoginResult>("api/v1/auth/login", new { username = _username, password = _password }));

    private async Task EntrarAsync(Func<Task<LoginResult>> login)
    {
        _busy = true;
        _error = null;
        try
        {
            Session.SignIn(await login());
            Navigation.NavigateTo(Session.IsTerminal ? "/caja" : Session.Me!.MustChangePassword ? "/cambiar-clave" : "/admin");
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
            _pin = null;
            _password = null;
        }
        finally
        {
            _busy = false;
        }
    }
}
