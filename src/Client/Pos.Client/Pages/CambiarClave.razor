@page "/cambiar-clave"
@layout EmptyLayout
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation
@using Pos.Modules.Identity.Contracts

<PageTitle>Cambiar contraseña · BusinessPost</PageTitle>

<PantallaAcceso Titulo="Cambie su contraseña"
                Ayuda="@(Session.Me?.MustChangePassword == true ? $"Su contraseña es temporal. Escriba una nueva de al menos {_minimo} caracteres." : $"Escriba su contraseña actual y la nueva, de al menos {_minimo} caracteres.")">
    @if (!Session.IsSignedIn)
    {
        <Redirigir A="/ingresar" />
    }
    <EditForm Model="this" OnSubmit="CambiarAsync">
        <MudTextField @bind-Value="_current" Label="Contraseña actual" InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true" AutoFocus="true"
                      autocomplete="current-password" Class="mt-2" />
        <MudTextField @bind-Value="_new" Label="Nueva contraseña" InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true" Class="mt-3"
                      autocomplete="new-password" HelperText="@Ayuda()" Error="@(_new is { Length: > 0 } && _new.Length < _minimo)" />
        <MudTextField @bind-Value="_repeat" Label="Repita la nueva contraseña" InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true" Class="mt-3"
                      autocomplete="new-password" Error="@(_repeat is { Length: > 0 } && _repeat != _new)" ErrorText="No coincide con la nueva contraseña." />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Class="mt-5"
                   Disabled="@(_busy || string.IsNullOrEmpty(_current) || (_new?.Length ?? 0) < _minimo || _repeat != _new)" StartIcon="@Icons.Material.Outlined.Password">
            Cambiar contraseña
        </MudButton>
        @if (Session.Me?.MustChangePassword != true)
        {
            <MudButton Variant="Variant.Text" FullWidth="true" Class="mt-2" Href="/admin">Volver</MudButton>
        }
    </EditForm>
    <MudText Typo="Typo.caption" Class="d-block mt-4" Style="color: var(--mud-palette-text-secondary)">
        La nueva contraseña no puede contener su nombre de usuario, ni ser una contraseña común (como 12345678 o «colombia»)@(_historial > 0 ? $", ni ser una de sus últimas {_historial}" : null).
    </MudText>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4" role="alert">@_error</MudAlert>
    }
</PantallaAcceso>

@code {
    private string? _current, _new, _repeat, _error;
    private bool _busy;

    // Reglas del servidor (security.password_min_length y security.password_history); si no se pueden leer, las de fábrica.
    private int _minimo = 8, _historial = 5;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsSignedIn)
        {
            return;
        }

        try
        {
            var politica = await Api.GetAsync<CredentialStatusDto>("api/v1/auth/credentials");
            _minimo = politica.PasswordMinLength;
            _historial = politica.PasswordHistory;
        }
        catch (ApiException)
        {
            // Se quedan los valores de fábrica; el servidor valida de todos modos.
        }
    }

    private string Ayuda()
    {
        var length = _new?.Length ?? 0;
        return length switch
        {
            0 => $"Mínimo {_minimo} caracteres. Use una frase fácil de recordar.",
            _ when length < _minimo => $"Faltan {_minimo - length} caracteres.",
            _ => "Longitud suficiente.",
        };
    }

    private async Task CambiarAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.PostAsync("api/v1/auth/change-password", new { currentPassword = _current, newPassword = _new });
            Session.Refresh(await Api.GetAsync<MeInfo>("api/v1/auth/me"));
            Navigation.NavigateTo("/admin");
        }
        catch (ApiException ex)
        {
            _error = ex.Texto;
        }
        finally
        {
            _busy = false;
        }
    }
}
