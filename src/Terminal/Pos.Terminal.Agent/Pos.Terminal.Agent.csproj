<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Agente de caja (D7-14): servicio de Windows que escucha solo en localhost:5490 e imprime el tiquete neutro (Pos.Printing) en
    ESC/POS por archivo, red (IP:9100), spooler de Windows (RAW) o puerto serie (COMx), y abre el cajón. No guarda ventas ni se
    autentica con el servidor: la interfaz de caja le entrega en cada petición la configuración de la impresora.
  -->
  <PropertyGroup>
    <RootNamespace>Pos.Terminal.Agent</RootNamespace>
    <AssemblyName>Pos.Terminal.Agent</AssemblyName>
    <!-- P/Invoke al spooler de Windows con LibraryImport (código generado). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\Pos.Printing\Pos.Printing.csproj" />
    <!-- Formato de la lectura firmada de la báscula (el mismo que verifica el servidor). -->
    <ProjectReference Include="..\..\BuildingBlocks\Pos.SharedKernel\Pos.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pos.Terminal.Agent.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Modo precalentar (D17C-02): el actualizador lo corre al descomprimir una versión para que el antivirus revise los archivos antes del cambio. -->
    <Compile Include="..\..\Shared\Precalentamiento\Precalentamiento.cs" Link="Precalentamiento.cs" />
  </ItemGroup>
</Project>
