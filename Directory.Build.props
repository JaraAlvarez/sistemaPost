<Project>
  <!-- Configuración común a todos los proyectos. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>

    <!-- Calidad: cualquier advertencia rompe la compilación. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: no exigir comentario XML en cada miembro público. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Identidad del producto (el nombre comercial se cambia solo aquí). -->
    <PosProductName>PosSupermercado</PosProductName>
    <Product>$(PosProductName)</Product>
    <Company>$(PosProductName)</Company>
    <Copyright>© $([System.DateTime]::UtcNow.Year) $(PosProductName)</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PosProductName" Value="$(PosProductName)" />
  </ItemGroup>
</Project>
